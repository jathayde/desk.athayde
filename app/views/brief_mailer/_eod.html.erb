<p><b>Fills today</b></p>
<ul>
  <% (brief.fills_today || []).each do |fill| %><li><%= fill.side %> <%= quantity(fill.quantity) %> <%= fill.instrument.symbol %> @ <%= money(fill.price) %> (<%= stamp(fill.executed_at) %>)</li><% end %>
  <% if brief.fills_today.nil? %><li>unknown: the activities feed is stale (last sync <%= stamp(brief.account&.last_sync(:activities)) %>)</li><% elsif brief.fills_today.none? %><li>none</li><% end %>
</ul>
<p><b>Journal rows touched today</b></p>
<ul>
  <% (brief.trades_touched_today || []).each do |trade| %><li><%= link_to "#{trade.instrument.symbol} #{trade.status}", trade_url(trade) %><%= " · needs review" if trade.needs_review? %></li><% end %>
  <% if brief.trades_touched_today.nil? %><li>unknown: the activities feed is stale</li><% elsif brief.trades_touched_today.none? %><li>none</li><% end %>
</ul>
<p><b>Missing post-mortems</b></p>
<ul>
  <% brief.missing_post_mortems.each do |trade| %><li><%= link_to trade.instrument.symbol, trade_url(trade) %> closed <%= stamp(trade.closed_at) %> <%= r_multiple(trade) %></li><% end %>
  <% if brief.missing_post_mortems.none? %><li>none</li><% end %>
  <% if brief.more_post_mortems > 0 %><li><%= link_to "and #{brief.more_post_mortems} more", trades_url(filter: "missing_post_mortem") %></li><% end %>
</ul>
<% if brief.stop_suggestions.any? %>
  <p><b>Tighten stop</b> (the latest trails; suggestion only)</p>
  <ul><% brief.stop_suggestions.each do |position| %><li><%= position.instrument.symbol %>: <%= position.suggested_stop_method %> trail <%= money(position.stop_suggestion) %> vs working stop <%= position.stop_price ? money(position.stop_price) : "none" %></li><% end %></ul>
<% end %>
<% if brief.snapshot %>
  <p>Snapshot <%= brief.snapshot.as_of %>: equity <%= money(brief.snapshot.equity) %>, drawdown <%= percent(brief.snapshot.drawdown) %>, open risk <%= brief.snapshot.open_risk_amount ? money(brief.snapshot.open_risk_amount) : "unknown" %>, unprotected <%= brief.snapshot.unprotected_count %></p>
<% elsif brief.balance %>
  <p>Today's snapshot is not yet written; equity <%= money(brief.balance.equity) %> as of <%= stamp(brief.balance.as_of) %><%= " (stale)" if brief.balance_stale? %></p>
<% else %>
  <p>No balance has synced yet.</p>
<% end %>
