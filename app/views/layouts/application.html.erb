<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), "Athayde Desk" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Athayde Desk">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="<%= asset_path "brand/crest.svg" %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= asset_path "brand/crest-180.png" %>">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="shell-header">
      <%= link_to root_path, class: "brand", "aria-label": "Athayde Desk home" do %>
        <%= image_tag "brand/crest.svg", alt: "", class: "brand-crest" %>
        <span class="brand-name">Desk</span>
      <% end %>
      <% if authenticated? %>
        <nav class="shell-nav">
          <%= nav_link "Dashboard", root_path %>
          <%= nav_link "Proposals", proposals_path %>
          <%= nav_link "Journal", trades_path %>
          <%= nav_link "System", system_path %>
          <%= button_to "Sign out", session_path, method: :delete, class: "link-button" %>
        </nav>
      <% end %>
    </header>

    <% flash.each do |kind, message| %>
      <p class="flash flash-<%= kind %>"><%= message %></p>
    <% end %>

    <main class="shell-main">
      <%= yield %>
    </main>
  </body>
</html>
