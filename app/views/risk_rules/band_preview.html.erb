<% content_for :title, "Preview #{@preview.rule.rule_type.humanize}" %>
<h1>Preview: <%= @preview.rule.rule_type.humanize %> v<%= @preview.candidate.version %></h1>
<p class="muted"><%= detail_summary(@preview.candidate.params) %>. What the latest drift check would have said under this band, from its stored rows. Nothing is written.</p>
<% unless @preview.valid? %><p class="warn"><%= @preview.candidate.errors.full_messages.to_sentence %>.</p><% end %>
<dl class="kv-list">
  <% @preview.rows.each do |row| %>
    <div class="kv"><dt><%= row.drift.target.label %> <small class="muted">drift <%= points(row.drift.drift, signed: true) %> · band <%= points(row.band) %></small></dt>
      <dd><%= row.before.humanize(capitalize: false) %> → <b class="<%= "warn" if row.after != row.before %>"><%= row.after == "reported" ? "outside band" : "within band" %></b></dd></div>
  <% end %>
  <% if @preview.valid? && @preview.rows.empty? %><div class="kv"><dt>Targets</dt><dd>no measured drift to re-judge yet</dd></div><% end %>
</dl>
<p><%= link_to "Back to rules", risk_rules_path(anchor: "book") %></p>
