<% content_for :title, "Proposal #{@proposal.instrument.symbol}" %>
<% proposal = @proposal %>
<h1><%= proposal.priced_label %> <small><%= proposal.status_label %></small></h1>
<p class="callout"><%= proposal.kind.humanize %> · <%= proposal.origin %><% if proposal.setup %> · <%= proposal.setup.name %><% end %><% if proposal.stop_price %> · stop <%= money(proposal.stop_price) %><% end %><% if proposal.shadow? %> · shadow<% end %></p>
<% if proposal.thesis.present? %><p class="thesis"><%= proposal.thesis %></p><% end %>

<%= render "proposals/evaluation", proposal: proposal, results: proposal.guardrail_results, sizing: proposal.sizing, collar: proposal.collar %>
<% if proposal.kind_exit? %>
  <h2 class="sec">Lots this sale takes, <%= proposal.tax_lot_method %> <small class="muted">(as the journal knows them, split-adjusted and net of earlier sales, frozen when proposed; Schwab's method names are unverified)</small></h2>
  <dl class="kv-list">
    <% proposal.lots.each do |lot| %>
      <div class="kv <%= "muted" if lot["selling"].to_d.zero? %>"><dt><%= lot["acquired_at"] ? stamp(Time.zone.parse(lot["acquired_at"])) : "unknown date" %></dt>
        <dd><%= quantity(lot["selling"].to_d) %> of <%= quantity(lot["quantity"].to_d) %> @ <%= money(lot["price"]) %> · <%= lot["term"] == "unknown" ? "term unknown" : "#{lot["term"]}-term" %></dd></div>
    <% end %>
    <% if proposal.lots.empty? %><div class="kv"><dt>Lots</dt><dd>no journaled entry legs for this position</dd></div><% end %>
  </dl>
<% end %>

<% if proposal.submission_unknown? %>
  <p class="warn">Submission unknown: check Schwab before doing anything else on <%= proposal.instrument.symbol %>. The app is looking for the order and says when it finds it or confirms it was never placed.<% if proposal.ambiguous_orders.any? %> More than one order at Schwab could be it (<%= proposal.ambiguous_orders.join(", ") %>): cancel the extra there and the next look will link the one that remains.<% end %></p>
<% elsif proposal.submission_failed? %>
  <p class="warn">Not placed: <%= proposal.failure_reason %></p>
<% elsif proposal.awaiting_hand_placement? %>
  <p class="warn">Shadow approval: place this order at Schwab by hand. The next orders sync matches it and records the payload check.<% if proposal.kind_exit? && @position&.working_stop_order %> Adjust the working stop by hand too; a real submission would <%= @position.working_stop_order.remaining.to_d <= proposal.quantity.to_d ? "cancel" : "shrink" %> it first.<% end %></p>
<% end %>

<% if proposal.approvable? %>
  <%= form_with url: proposal_approval_path(proposal), method: :post do |f| %>
    <% proposal.warnings.each do |rule| %>
      <label><%= f.check_box :acknowledged, { multiple: true, id: "ack_#{rule}" }, rule, nil %> I acknowledge <%= rule.humanize.downcase %><%= " (not checked)" if proposal.guardrail_results.dig(rule, "outcome") == "unavailable" %></label>
    <% end %>
    <% if proposal.needs_override? %>
      <%= f.label :override_reason, "The stop is outside the collar. Why?" %>
      <%= f.text_field :override_reason %>
    <% end %>
    <%= f.label :confirmation, "Type approve to confirm" %>
    <%= f.text_field :confirmation, autocomplete: "off" %>
    <%= f.submit "Approve", class: "danger" %>
  <% end %>
  <%= form_with url: proposal_rejection_path(proposal), method: :post do |f| %>
    <%= f.label :reason, "Reject with a reason" %>
    <%= f.text_field :reason %>
    <%= f.submit "Reject", class: "secondary" %>
  <% end %>
<% end %>
<% if proposal.rejection_reason.present? %><p class="muted">Rejected: <%= proposal.rejection_reason %></p><% end %>
<% if proposal.override_reason.present? %><p class="muted">Override: <%= proposal.override_reason %></p><% end %>
