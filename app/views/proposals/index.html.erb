<% content_for :title, "Proposals" %>
<h1>Proposals <small><%= link_to "New", new_proposal_path, class: "chip" %></small></h1>
<% if SystemSettings.instance.shadow_mode? %><p class="muted">Shadow mode: an approval records what would have been sent; place it at Schwab by hand and the sync matches it.</p><% end %>
<% if @awaiting.any? %>
  <h2 class="sec">Place by hand at Schwab</h2>
  <ul class="trades">
    <% @awaiting.each do |proposal| %>
      <li class="kv"><span><%= link_to proposal.priced_label, proposal_path(proposal) %></span><b>approved <%= stamp(proposal.decided_at) %></b></li>
    <% end %>
  </ul>
<% end %>
<h2 class="sec">Waiting for you</h2>
<% if @reviews.any? %>
  <ul class="trades">
    <% @reviews.each do |review| %>
      <li class="kv"><span><%= link_to "Thesis review: #{review.label}", thesis_review_path(review) %></span><b><%= review.decisions.to_sentence(last_word_connector: ", or ", two_words_connector: " or ") %></b></li>
    <% end %>
  </ul>
<% end %>
<% if @queue.empty? && @reviews.empty? %>
  <p class="empty">Nothing waiting on you.</p>
<% else %>
  <ul class="trades">
    <% @queue.each do |proposal| %>
      <li class="kv">
        <span><%= link_to proposal.priced_label, proposal_path(proposal) %><% if proposal.setup %> · <%= proposal.setup.name %><% end %></span>
        <b><%= proposal.status_label %></b>
      </li>
    <% end %>
  </ul>
<% end %>
<% if @decided.any? || @decided_reviews.any? %>
  <h2 class="sec">Decided</h2>
  <ul class="trades">
    <% @decided_reviews.each do |review| %>
      <li class="kv"><span><%= link_to "Thesis review: #{review.label}", thesis_review_path(review) %></span><b><%= review.decision %></b></li>
    <% end %>
    <% @decided.each do |proposal| %>
      <li class="kv"><span><%= link_to proposal.label, proposal_path(proposal) %></span><b><%= proposal.status_label %></b></li>
    <% end %>
  </ul>
<% end %>
