<section class="hero">
  <div class="stat">
    <span class="lbl">Equity</span>
    <span class="num"><%= money(desk.equity) %></span>
    <span class="sub">
      <% if desk.day_change %><%= signed_money(desk.day_change) %> (<%= signed_percent(desk.day_change_ratio) %>) <%= desk.day_change_label %><% else %><%= desk.day_change_label %><% end %>
      · <%= as_of(desk.balance.as_of, stale: desk.balance_stale?) %>
    </span>
  </div>
  <div class="stat">
    <span class="lbl">Open risk</span>
    <span class="num"><%= percent(desk.open_risk_ratio) %></span>
    <span class="sub"><%= money(desk.open_risk) %> on protected positions<% if desk.excluded_by_reason.any? %>; excludes <%= excluded_summary(desk.excluded_by_reason) %><% end %></span>
  </div>
</section>

<dl class="kv-list">
  <div class="kv"><dt>Settled / unsettled cash</dt><dd><%= money(desk.balance.settled_cash) %> / <%= money(desk.balance.unsettled_cash) %></dd></div>
  <% if desk.review_count.positive? %>
    <div class="kv callout"><dt><%= pluralize(desk.review_count, "trade") %> <%= desk.review_count == 1 ? "needs" : "need" %> review</dt><dd><%= link_to "Review now", trades_path(filter: "needs_review") %></dd></div>
  <% end %>
  <div class="kv muted"><dt>Proposals</dt><dd>Phase 2</dd></div>
</dl>

<section>
  <h2 class="sec">Positions</h2>
  <% if desk.rows.empty? %>
    <p class="empty">No open positions. All cash.</p>
  <% else %>
    <ul class="positions">
      <% desk.rows.each do |row| %>
        <% position = row.position %>
        <li class="pos <%= { protected: "protected", delisted: "delisted" }.fetch(row.protection, "at-risk") %>">
          <div class="top">
            <span><%= row.trade ? link_to(position.instrument.symbol, trade_path(row.trade)) : position.instrument.symbol %> · <%= quantity(position.quantity) %></span>
            <span class="primary"><% if position.distance_to_stop && !position.delisted? %><%= percent(position.distance_to_stop) %> to stop<% else %><%= protection_label(row.protection) %><% end %></span>
          </div>
          <div class="sub">
            <span>in @ <%= money(position.average_price) %><% if position.unprotected? && position.distance_to_stop %> · <em class="warn"><%= protection_label(row.protection) %></em><% end %></span>
            <span><%= signed_money(position.unrealized_pnl) %> · <%= as_of(row.as_of, stale: row.stale) %></span>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
