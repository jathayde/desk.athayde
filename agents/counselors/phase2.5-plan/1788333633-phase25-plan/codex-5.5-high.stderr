     9	
    10	  def call
    11	    settings = SystemSettings.instance
    12	    raise Refused, "halted: #{settings.manual_halt_reason}" if settings.manual_halt?
    13	    raise Refused, "entries are halted by #{settings.rule_halt_rule}: #{settings.rule_halt_reason}" if @arguments[:kind].to_s == "entry" && !settings.entries_allowed?
    14	    proposal = Proposals.draft(**@arguments)
    15	    open = proposal.account.order_proposals.pending.where(instrument: proposal.instrument, side: OrderProposal.sides.fetch(proposal.side)).first
    16	    raise Refused, "#{proposal.instrument.symbol} already has a #{proposal.side} proposal waiting (##{open.id}); decide it first" if open
    17	    unresolved = proposal.account.order_proposals.unresolved.where(instrument: proposal.instrument).first
    18	    raise Refused, "#{proposal.instrument.symbol} has a submission pending reconciliation (##{unresolved.id}); nothing else on it until that resolves" if unresolved
    19	    OrderProposal.transaction do
    20	      proposal.save!
    21	      AuditEvent.log("proposal_created", actor: proposal.agent? ? :agent : :human, user: proposal.user, subject: proposal,
    22	                     data: { kind: proposal.kind, side: proposal.side, symbol: proposal.instrument.symbol, quantity: proposal.quantity, limit_price: proposal.limit_price, stop_price: proposal.stop_price })
    23	      proposal.evaluate!(Guardrails::Evaluator.new(proposal).call)
    24	    end
    25	    ActiveRecord.after_all_transactions_commit { AlertMailer.new_proposal(proposal).deliver_later } if proposal.agent? # the operator made the human ones
    26	    proposal
    27	  rescue ActiveRecord::RecordNotUnique
    28	    raise Refused, "#{@arguments[:symbol].to_s.upcase} already has a #{@arguments[:side]} proposal waiting; decide it first"
    29	  rescue ActiveRecord::RecordInvalid => e
    30	    raise Refused, e.record.errors.full_messages.to_sentence
    31	  end
    32	end

