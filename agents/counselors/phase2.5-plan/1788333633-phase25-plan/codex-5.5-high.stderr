module Schwab
  # The order bodies the app sends (docs/phase-2-plan.md §0.5). Every Schwab field name lives here.
  # SCHWAB_SHAPE_UNVERIFIED: the TRIGGER strategy, the child shape, and taxLotMethod are modelled on schwab-py's
  # order builder and are confirmed only by a shadowed payload compared against an order placed by hand.
  module OrderPayload
    NORMAL = "NORMAL"
    DAY = "DAY"
    GOOD_TILL_CANCEL = "GOOD_TILL_CANCEL"
    SINGLE = "SINGLE"
    TRIGGER = "TRIGGER"
    STOP = "STOP"

    # A LIMIT entry whose child is a STOP sell of the same quantity, good until cancelled.
    def self.bracket(symbol:, quantity:, limit_price:, stop_price:)
      leg(BUY, symbol, quantity).merge(
        "orderType" => Order::LIMIT, "price" => price(limit_price), "orderStrategyType" => TRIGGER,
        "childOrderStrategies" => [ leg(SELL, symbol, quantity).merge("orderType" => STOP, "stopPrice" => price(stop_price), "duration" => GOOD_TILL_CANCEL, "orderStrategyType" => SINGLE) ]
      )
    end

    def self.sell(symbol:, quantity:, limit_price:, tax_lot_method: nil)
      leg(SELL, symbol, quantity).merge("orderType" => Order::LIMIT, "price" => price(limit_price), "orderStrategyType" => SINGLE)
                                 .merge(tax_lot_method ? { "taxLotMethod" => tax_lot_method } : {})
    end

    # A standalone STOP sell, good until cancelled: the replacement for a bracket child after a partial exit.
    def self.stop(symbol:, quantity:, stop_price:)
      leg(SELL, symbol, quantity).merge("orderType" => STOP, "stopPrice" => price(stop_price), "duration" => GOOD_TILL_CANCEL, "orderStrategyType" => SINGLE)
    end

    def self.leg(instruction, symbol, quantity)
      { "session" => NORMAL, "duration" => DAY,
        "orderLegCollection" => [ { "instruction" => instruction, "quantity" => quantity.to_i, "instrument" => { "symbol" => symbol, "assetType" => "EQUITY" } } ] }
    end

    def self.price(value) = format("%.2f", BigDecimal(value.to_s).round(2)) # two decimals, as schwab-py sends them

    BUY = Order::BUY
    SELL = Order::SELL
  end
end

 succeeded in 0ms:
# Rule 6, both directions, taxable losses only (docs/phase-2-plan.md §0.11). A buy after a recent taxable loss
# on the same CUSIP cautions or blocks per the rule's mode; a sell that would realize a loss cautions when
# replacement shares were bought in either account within the window (the lot being sold is not a replacement).
# Instrument match only; a scale-out at a loss on a still-open trade carries no realized P&L and is not seen.
class Guardrails::WashSale < Guardrails::Rule
  def evaluate
    window = (rule.params["days"] || 30).to_i.days
    if proposal.buy?
      loss = context.account.trades.closed.where(instrument: proposal.instrument).where(closed_at: window.ago..).where("realized_pnl < 0").order(closed_at: :desc).first
      return pass unless loss
      detail = { loss_closed_at: loss.closed_at, loss: loss.realized_pnl, window_days: window / 1.day }
      rule.mode_block? ? block(**detail) : caution(**detail)
    else
      trade = context.open_trade_for(proposal.instrument)
      return pass unless trade&.avg_entry && proposal.limit_price && proposal.limit_price < trade.avg_entry
      own_lots = trade.trade_legs.where.not(activity_id: nil).pluck(:activity_id)
      replacements = Activity.fill.valid_for_journal.where(instrument: proposal.instrument, side: Schwab::Order::BUY, executed_at: window.ago..).where.not(id: own_lots).includes(:account)
      return pass(would_realize_loss: true) if replacements.none?
      caution(would_realize_loss: true, recent_buys: replacements.map { |b| { account: b.account.label, at: b.executed_at, quantity: b.quantity } })
    end
  end
end

