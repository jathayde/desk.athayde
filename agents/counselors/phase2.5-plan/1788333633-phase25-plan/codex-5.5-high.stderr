     1	# A guardrail as data (docs/phase-2-plan.md §0.8): one active row per type and setup, edited by superseding,
     2	# never in place, so every proposal's results point at the exact version that judged it.
     3	class RiskRule < ApplicationRecord
     4	  TYPES = %w[ max_risk_per_trade max_positions max_position_exposure max_sector_exposure daily_loss_halt max_drawdown_halt
     5	              earnings_blackout wash_sale notional_cap stop_collar ].freeze
     6	  REQUIRED_PARAMS = { "max_risk_per_trade" => %w[ percent ], "max_positions" => %w[ count ], "max_position_exposure" => %w[ percent ],
     7	                      "daily_loss_halt" => %w[ percent ], "max_drawdown_halt" => %w[ percent ], "notional_cap" => %w[ per_order per_day ] }.freeze
     8	
     9	  # Raised when a halt is engaged and no override reason was given: the editor is locked, by design, so a
    10	  # rule cannot be loosened in the heat of the moment without saying why.
    11	  class Locked < StandardError; end
    12	
    13	  belongs_to :setup, optional: true
    14	  belongs_to :superseded_by, class_name: "RiskRule", optional: true
    15	  belongs_to :changed_by, class_name: "User", optional: true
    16	
    17	  enum :mode, { block: "block", warn: "warn" }, prefix: true
    18	
    19	  validates :rule_type, inclusion: { in: TYPES }
    20	  validate :required_params_present
    21	
    22	  scope :active, -> { where(active: true) }
    23	
    24	  def self.active_for(rule_type, setup: nil) = active.find_by(rule_type: rule_type, setup: setup) || (setup && active.find_by(rule_type: rule_type, setup: nil))
    25	
    26	  # The next version of this rule, superseding this one, in one transaction and one audit row. Under this row's
    27	  # lock and the settings lock, so two edits cannot both mint version n+1 and a halt landing mid-edit still locks.
    28	  def supersede!(params:, user:, mode: nil, note: nil, override_reason: nil)
    29	    override = override_reason.to_s.strip
    30	    transaction do
    31	      lock!
    32	      raise ActiveRecord::StaleObjectError.new(self, "supersede") unless active?
    33	      raise Locked, "a halt is engaged: say why you are editing anyway" if SystemSettings.instance.lock!.halted? && override.blank?
    34	      update!(active: false) # first, so the one-active index admits the successor
    35	      successor = self.class.create!(rule_type: rule_type, setup: setup, params: params, mode: mode.presence || self.mode, version: version + 1, changed_by: user,
    36	                                     note: [ note.presence, ("override during halt: #{override}" if override.present?) ].compact.join(" · ").presence)
    37	      update!(superseded_by: successor)
    38	      AuditEvent.log("rule_changed", actor: :human, user: user, subject: successor, reason: successor.note,
    39	                     data: { rule_type: rule_type, setup: setup&.name, before: { params: self.params, mode: self.mode }, after: { params: successor.params, mode: successor.mode },
    40	                             version: successor.version, during_halt: override.present?, override_reason: override.presence })
    41	      successor
    42	    end
    43	  end
    44	
    45	  def param(name) = params.fetch(name.to_s) { raise KeyError, "#{rule_type} rule has no #{name}" }
    46	  def param_keys = (params.keys + Array(REQUIRED_PARAMS[rule_type])).uniq
    47	  def mode_choosable? = rule_type == "wash_sale"
    48	
    49	  # Whether this is the row the evaluator would pick for the proposal: the setup's own row wins, the global row
    50	  # is the fallback for setups without one.
    51	  def applies_to?(proposal) = self.class.active_for(rule_type, setup: proposal.setup) == self
    52	
