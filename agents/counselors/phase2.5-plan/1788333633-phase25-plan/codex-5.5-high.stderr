     8	  def self.draft(account:, kind:, side:, symbol:, limit_price:, stop_price: nil, setup: nil, thesis: nil, origin:, user: nil, quantity: nil, tax_lot_method: nil)
     9	    instrument = Instrument.find_by(symbol: symbol.to_s.strip.upcase) or raise UnknownSymbol, "unknown symbol #{symbol}"
    10	    method = kind.to_s == "exit" ? tax_lot_method.presence || Schwab::Order::DEFAULT_TAX_LOT_METHOD : nil
    11	    raise Error, "unknown lot method #{method}" if method && !Schwab::Order::TAX_LOT_METHODS.include?(method)
    12	    proposal = OrderProposal.new(account: account, instrument: instrument, kind: kind, side: side, order_type: Schwab::Order::LIMIT, limit_price: limit_price, stop_price: stop_price,
    13	                                 planned_stop: stop_price, setup: setup, thesis: thesis, origin: origin, user: user, quantity: quantity, tax_lot_method: method,
    14	                                 expires_at: MarketDay.today.in_time_zone(MarketDay::ZONE).end_of_day)
    15	    if proposal.kind_entry?
    16	      desk = Desk.new(account: account)
    17	      proposal.collar = StopCollar::Calculator.new(instrument, entry_price: limit_price, params: RiskRule.active_for("stop_collar", setup: setup)&.params || {}).call.to_h
    18	      sizing = Sizing.for(limit_price: limit_price, stop_price: stop_price, equity: desk.balance_stale? ? nil : desk.equity, rule: RiskRule.active_for("max_risk_per_trade", setup: setup))
    19	      proposal.sizing = sizing.to_h
    20	      proposal.quantity = sizing.quantity
    21	    else
    22	      proposal.quantity ||= account.positions.find_by(instrument: instrument)&.quantity
    23	      proposal.lots = Proposals::Lots.for(account.trades.open.find_by(instrument: instrument), quantity: proposal.quantity.to_d, method: method) if proposal.kind_exit?
    24	    end
    25	    proposal
    26	  end
    27	end

