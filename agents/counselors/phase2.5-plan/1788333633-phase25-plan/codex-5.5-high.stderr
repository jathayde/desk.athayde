    91	
    92	  def day_change
    93	    return nil unless equity && prior_snapshot
    94	    flows = Snapshot.net_flows(account, after: prior_snapshot.as_of, through: MarketDay.today) or return nil # an unpriced flow: unknown, not zero
    95	    equity - flows - prior_snapshot.equity
    96	  end
    97	
    98	  def day_change_ratio = day_change && prior_snapshot.equity.positive? ? day_change / prior_snapshot.equity : nil
    99	  def day_change_label = prior_snapshot ? "since #{prior_snapshot.as_of.strftime('%a')} close" : "first snapshot after today's close"
   100	
   101	  def rows
   102	    @rows ||= begin
   103	      trades = account.trades.open.index_by(&:instrument_id)
   104	      account.positions.includes(:instrument, :working_stop_order).map do |position|
   105	        Row.new(position: position, protection: position.protection, as_of: as_of_for(position), stale: stale_row?(position), trade: trades[position.instrument_id])
   106	      end.sort_by { |r| [ { protected: 1, delisted: 2 }.fetch(r.protection, 0), r.position.distance_to_stop || -BigDecimal("Infinity"), r.position.instrument.symbol ] }
   107	    end
   108	  end
   109	
   110	  def open_risk = rows.select { |r| r.protection == :protected }.sum { |r| r.position.open_risk }
   111	  def open_risk_ratio = equity && equity.positive? ? open_risk / equity : nil
   112	  def excluded_by_reason = rows.reject { |r| r.protection == :protected }.group_by(&:protection).transform_values(&:size)
   113	  def review_count = account ? account.trades.needing_review.count : 0
   114	  def balance_stale? = balance && stale?(balance.as_of, :positions)
   115	  def orders_as_of = @orders_as_of ||= account&.last_sync(:orders)
   116	
   117	  # Stale: older than twice the cadence the tick would use right now plus its minute of slack, or any age once sync is paused.
   118	  def stale?(time, feed)
   119	    return true if time.nil? || sync_paused_reason.present?
   120	    time < Time.current - (sync_interval(feed) * STALE_MULTIPLIER + 1.minute)
   121	  end
   122	
   123	  private
   124	    def sync_interval(feed) = (@intervals ||= {})[feed] ||= account.sync_interval(feed, in_session: @in_session)
   125	
   126	    # Every row's protection state depends on the orders feed, judged by its own cadence: "no stop" is only as
   127	    # current as the last orders sync.
   128	    def stale_row?(position) = stale?(position.synced_at, :positions) || stale?(orders_as_of, :orders)
   129	    def as_of_for(position) = [ position.synced_at, orders_as_of ].compact.min
   130	
   131	    def unresolved_failures
   132	      SyncRun::ACCOUNT_FEEDS.filter_map { |feed| account.last_sync_failure(feed) }.select { |run| unresolved?(run) }
   133	    end
   134	
   135	    # Unresolved: nothing has succeeded on that feed since it failed.
   136	    def unresolved?(run)
   137	      succeeded_at = account.last_sync(run.feed)
   138	      succeeded_at.nil? || run.started_at > succeeded_at
   139	    end
   140	end

