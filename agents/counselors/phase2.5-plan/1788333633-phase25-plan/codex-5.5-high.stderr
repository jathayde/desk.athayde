    49	    # Another feed created or backfilled it between our lookup and our write; look once more, then give up.
    50	    raise Schwab::MappingError, "instrument #{ref.symbol} keeps colliding on identity" if attempt > 1
    51	    resolve(ref, attempt: attempt + 1)
    52	  end
    53	
    54	  def self.create_from(ref)
    55	    cusip = ref.cusip.presence || lookup_cusip(ref.symbol)
    56	    if cusip && (existing = find_by(cusip: cusip))
    57	      return existing.absorb(ref.with(cusip: cusip))
    58	    end
    59	    create!(cusip: cusip, schwab_instrument_id: ref.instrument_id, symbol: ref.symbol, asset_type: ref.asset_type, description: ref.description).tap do |instrument|
    60	      AuditEvent.log("instrument_identity_fallback", actor: :system, subject: instrument, data: { symbol: ref.symbol, asset_type: ref.asset_type }) if cusip.blank?
    61	    end
    62	  end
    63	
    64	  def self.lookup_symbol(cusip)
    65	    Schwab::InstrumentRef.from(Schwab.client(wait: false).instrument_by_cusip(cusip).first)&.symbol
    66	  rescue Schwab::Error
    67	    nil
    68	  end
    69	
    70	  def self.lookup_cusip(symbol)
    71	    Schwab::InstrumentRef.from(Schwab.client(wait: false).instrument_by_symbol(symbol).first)&.cusip
    72	  rescue Schwab::Error
    73	    nil
    74	  end
    75	
    76	  # A weaker-key match learns identifiers it lacked; a conflicting identifier already owned elsewhere is left alone.
    77	  def absorb(ref)
    78	    update!(cusip: ref.cusip) if cusip.blank? && ref.cusip.present? && !self.class.exists?(cusip: ref.cusip)
    79	    update!(schwab_instrument_id: ref.instrument_id) if schwab_instrument_id.blank? && ref.instrument_id.present? && !self.class.exists?(schwab_instrument_id: ref.instrument_id)
    80	    rename!(ref.symbol) if cusip.present? && cusip == ref.cusip && symbol != ref.symbol
    81	    self
    82	  end
    83	
    84	  def rename!(new_symbol, at: Time.current)
    85	    return if new_symbol == symbol
    86	    update!(symbol: new_symbol, symbol_history: symbol_history + [ { "symbol" => symbol, "until" => at.utc.iso8601 } ])
    87	  end
    88	
    89	  private
    90	    def predecessor_is_another_instrument
    91	      errors.add(:predecessor_instrument, "cannot be itself") if persisted? && predecessor_instrument_id == id
    92	    end
    93	end

