    24	  end
    25	
    26	  # What unfilled entries on this instrument have already committed, so a second entry sees the first.
    27	  def pending_cost_for(instrument, except: nil)
    28	    account.order_proposals.where(instrument: instrument, kind: :entry, status: %w[ validated submitting submission_unknown submitted ]).where.not(id: except&.id).sum { |p| p.quantity.to_d * p.limit_price.to_d }
