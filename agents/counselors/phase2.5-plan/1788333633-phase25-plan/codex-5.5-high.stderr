     7	  def initialize(account)
     8	    @account = account
     9	    @desk = Desk.new(account: account)
    10	    @settings = SystemSettings.instance
    11	  end
    12	
    13	  def balance = desk.balance
    14	  def equity = balance&.equity
    15	  def balance_stale? = balance.nil? || desk.balance_stale?
    16	  def fresh_equity = balance_stale? || equity.to_d <= 0 ? nil : equity
    17	  def positions = @positions ||= account.positions.includes(:instrument, :working_stop_order).to_a
    18	  def position_for(instrument) = positions.find { |p| p.instrument_id == instrument.id }
    19	  def open_trade_for(instrument) = account.trades.open.find_by(instrument: instrument)
    20	
