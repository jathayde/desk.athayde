    accounts: "accounts", positions: "positions", balances: "balances", orders: "orders",
    transactions: "transactions", market_hours: "market_hours", memory_repo: "memory_repo", snapshots: "snapshots"
  }, prefix: true
  enum :status, { running: "running", succeeded: "succeeded", failed: "failed", skipped_token: "skipped_token" }

