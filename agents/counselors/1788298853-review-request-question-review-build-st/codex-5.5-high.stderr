==> app/models/system_settings.rb <==
# One row, created on first access. Holds the global flags the PRD calls out:
# shadow mode (on by default), the manual halt, and why sync is paused.
class SystemSettings < ApplicationRecord
  self.table_name = "system_settings"

  def self.instance
    first || create!
  end

  def halted? = manual_halt
end

