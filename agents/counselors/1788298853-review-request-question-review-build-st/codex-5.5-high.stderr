==> app/models/audit_event.rb <==
# Append-only. Every "logged" action in the PRD is a row here; the database trigger
# rejects UPDATE and DELETE, and Active Record refuses them before it gets that far.
class AuditEvent < ApplicationRecord
  belongs_to :user, optional: true
  belongs_to :subject, polymorphic: true, optional: true

  enum :actor, { human: "human", system: "system", agent: "agent" }

  validates :kind, presence: true

  def self.log(kind, actor:, user: nil, subject: nil, reason: nil, **data)
    create!(kind: kind, actor: actor, user: user, subject: subject, reason: reason, data: data)
  end

  def readonly? = persisted?
end

==> app/models/market_day.rb <==
class MarketDay < ApplicationRecord
  enum :source, { schwab: "schwab", fallback: "fallback" }

  validates :date, presence: true, uniqueness: true
  validates :fetched_at, presence: true
  validates :open, inclusion: { in: [ true, false ] }

  scope :open_days, -> { where(open: true) }
end

