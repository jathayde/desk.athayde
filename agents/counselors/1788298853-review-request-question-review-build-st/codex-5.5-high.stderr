FactoryBot.define do
  factory :account do
    sequence(:schwab_hash) { |n| Digest::SHA256.hexdigest("account-#{n}").upcase }
    account_type { "taxable" }
    trading_enabled { true }
    nickname { "Taxable" }
  end

  factory :instrument do
    sequence(:cusip) { |n| format("%09d", n) }
    sequence(:symbol) { |n| "SYM#{n}" }
    asset_type { "EQUITY" }
  end

  factory :setup do
    sequence(:name) { |n| "setup-#{n}" }
  end

  factory :order do
    account
    instrument
    sequence(:broker_order_id) { |n| (1_000_000 + n).to_s }
    status { "FILLED" }
    side { "BUY" }
    quantity { 10 }
    order_type { "LIMIT" }
    entered_at { Time.current }

    trait :working_stop do
      status { "WORKING" }
      side { "SELL" }
      order_type { "STOP" }
      stop_price { 48.90 }
    end
  end

  factory :position do
    account
    instrument
    quantity { 40 }
    average_price { 51.18 }
    last_price { 53.00 }
    synced_at { Time.current }
  end

  factory :transaction do
    account
    instrument
    sequence(:broker_transaction_id) { |n| (90_000_000 + n).to_s }
    kind { "fill" }
    side { "BUY" }
    quantity { 40 }
    price { 51.18 }
    executed_at { Time.current }
  end

  factory :trade do
    account
    instrument
    status { "open" }
  end

  factory :user_audit_event, class: "AuditEvent" do
    kind { "test_event" }
    actor { "system" }
  end
end

==> spec/models/audit_event_spec.rb <==
require "rails_helper"

RSpec.describe AuditEvent do
  let!(:event) { AuditEvent.log("shadow_mode_toggled", actor: :human, reason: "testing", from: true, to: false) }

  it "stores the kind, actor, reason, and data" do
    expect(event).to have_attributes(kind: "shadow_mode_toggled", actor: "human", reason: "testing", data: { "from" => true, "to" => false })
  end

  it "refuses updates in Active Record" do
    expect { event.update!(reason: "changed") }.to raise_error(ActiveRecord::ReadOnlyRecord)
  end

  it "refuses destroy in Active Record" do
    expect { event.destroy! }.to raise_error(ActiveRecord::ReadOnlyRecord)
  end

  it "refuses updates at the database" do
    expect { AuditEvent.where(id: event.id).update_all(reason: "changed") }
      .to raise_error(ActiveRecord::StatementInvalid, /append-only/)
  end

  it "refuses deletes at the database" do
    expect { AuditEvent.where(id: event.id).delete_all }
      .to raise_error(ActiveRecord::StatementInvalid, /append-only/)
  end

  it "can point at a subject and a user" do
    user = create(:user)
    logged = AuditEvent.log("re_auth", actor: :human, user: user, subject: user)
    expect(logged.subject).to eq(user)
    expect(logged.user).to eq(user)
  end
end

==> spec/models/instrument_spec.rb <==
require "rails_helper"

RSpec.describe Instrument do
  it "requires a CUSIP or a Schwab instrument id" do
    expect(build(:instrument, cusip: nil, schwab_instrument_id: nil)).not_to be_valid
    expect(build(:instrument, cusip: nil, schwab_instrument_id: 42)).to be_valid
  end

  it "allows many instruments without a CUSIP" do
    create(:instrument, cusip: nil, schwab_instrument_id: 1)
    expect { create(:instrument, cusip: nil, schwab_instrument_id: 2) }.not_to raise_error
  end

  it "keeps CUSIP unique" do
    create(:instrument, cusip: "037833100")
    expect(build(:instrument, cusip: "037833100")).not_to be_valid
  end

  it "records ticker changes in history without changing identity" do
    instrument = create(:instrument, cusip: "037833100", symbol: "OLD")
    instrument.rename!("NEW", at: Time.zone.parse("2026-09-01 10:00"))
    expect(instrument.reload.symbol).to eq("NEW")
    expect(instrument.symbol_history).to eq([ { "symbol" => "OLD", "until" => "2026-09-01T10:00:00-04:00" } ])
    expect(instrument.cusip).to eq("037833100")
  end
end

==> spec/models/position_spec.rb <==
require "rails_helper"

RSpec.describe Position do
  let(:account) { create(:account) }
  let(:instrument) { create(:instrument) }

  context "with a working broker-side stop" do
    let(:stop) { create(:order, :working_stop, account: account, instrument: instrument, stop_price: 48.90) }
    subject(:position) { create(:position, account: account, instrument: instrument, quantity: 40, last_price: 53.00, working_stop_order: stop) }

    it "is protected and reports distance and dollars at risk" do
      expect(position).to be_protected
      expect(position.distance_to_stop).to be_within(0.0001).of(0.0774)
      expect(position.open_risk).to eq(164.0)
    end
  end

  context "without a stop" do
    subject(:position) { create(:position, account: account, instrument: instrument, working_stop_order: nil) }

    it "is unprotected and reports unknown risk, never zero" do
      expect(position).to be_unprotected
      expect(position.distance_to_stop).to be_nil
      expect(position.open_risk).to be_nil
    end
  end

  it "is unique per account and instrument" do
    create(:position, account: account, instrument: instrument)
    expect(build(:position, account: account, instrument: instrument)).not_to be_valid
  end
end

==> spec/models/trade_spec.rb <==
require "rails_helper"

RSpec.describe Trade do
  it "separates lifecycle from completeness" do
    trade = create(:trade, status: "closed", needs_review: true)
    expect(Trade.closed).to include(trade)
    expect(Trade.needing_review).to include(trade)
    expect(Trade.open).not_to include(trade)
  end

  it "lists closed trades missing a post-mortem" do
    done = create(:trade, status: "closed", post_mortem: "held to target")
    pending = create(:trade, status: "closed")
    expect(Trade.missing_post_mortem).to contain_exactly(pending)
    expect(Trade.missing_post_mortem).not_to include(done)
  end

  it "knows when R can be computed" do
    expect(build(:trade, initial_risk: nil)).not_to be_realized_r_available
    expect(build(:trade, initial_risk: 92)).to be_realized_r_available
  end
end

==> spec/models/system_settings_spec.rb <==
require "rails_helper"

RSpec.describe SystemSettings do
  it "creates the single row on first access with shadow mode on and no halt" do
    settings = SystemSettings.instance
    expect(settings).to be_persisted
    expect(settings.shadow_mode).to be(true)
    expect(settings.manual_halt).to be(false)
    expect(SystemSettings.instance).to eq(settings)
    expect(SystemSettings.count).to eq(1)
  end
end

==> spec/models/schwab_token_spec.rb <==
require "rails_helper"

RSpec.describe SchwabToken do
  it "encrypts tokens at rest" do
    token = SchwabToken.create!(access_token: "access-abc", refresh_token: "refresh-xyz")
    raw = SchwabToken.connection.select_one("SELECT access_token, refresh_token FROM schwab_tokens WHERE id = #{token.id}")
    expect(raw["access_token"]).not_to include("access-abc")
    expect(raw["refresh_token"]).not_to include("refresh-xyz")
    expect(token.reload.access_token).to eq("access-abc")
  end
end

