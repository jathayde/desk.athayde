==> app/models/account.rb <==
class Account < ApplicationRecord
  has_many :positions, dependent: :destroy
  has_many :balances, dependent: :destroy
  has_many :orders, dependent: :destroy
  has_many :transactions, dependent: :destroy
  has_many :trades, dependent: :destroy
  has_many :snapshots, dependent: :destroy
  has_many :order_proposals, dependent: :destroy

  enum :account_type, { taxable: "taxable", ira: "ira" }

  validates :schwab_hash, presence: true, uniqueness: true

  scope :trading, -> { where(trading_enabled: true) }

  def current_balance
    balances.order(as_of: :desc).first
  end
end

==> app/models/instrument.rb <==
class Instrument < ApplicationRecord
  belongs_to :predecessor_instrument, class_name: "Instrument", optional: true
  has_many :positions, dependent: :restrict_with_exception
  has_many :orders, dependent: :restrict_with_exception
  has_many :transactions, dependent: :restrict_with_exception
  has_many :trades, dependent: :restrict_with_exception

  validates :symbol, presence: true
  validates :cusip, uniqueness: true, allow_nil: true
  validates :schwab_instrument_id, uniqueness: true, allow_nil: true
  validate :has_a_broker_identity

  def rename!(new_symbol, at: Time.current)
    return if new_symbol == symbol
    update!(symbol: new_symbol, symbol_history: symbol_history + [ { "symbol" => symbol, "until" => at.iso8601 } ])
  end

  private
    def has_a_broker_identity
      errors.add(:base, "needs a CUSIP or Schwab instrument id") if cusip.blank? && schwab_instrument_id.blank?
    end
end

==> app/models/position.rb <==
class Position < ApplicationRecord
  belongs_to :account
  belongs_to :instrument
  belongs_to :working_stop_order, class_name: "Order", optional: true

  validates :quantity, :synced_at, presence: true
  validates :instrument_id, uniqueness: { scope: :account_id }

  def protected? = working_stop_order.present?
  def unprotected? = !protected?

  def stop_price = working_stop_order&.stop_price

  # Fraction of the current price between here and the stop; nil when unprotected.
  def distance_to_stop
    return if unprotected? || last_price.blank? || last_price.zero?
    (last_price - stop_price) / last_price
  end

  # Dollars at risk if the stop fills at its price; nil when unprotected, never zero for lack of a stop.
  def open_risk
    return if unprotected? || last_price.blank?
    quantity * (last_price - stop_price)
  end
end

==> app/models/balance.rb <==
class Balance < ApplicationRecord
  belongs_to :account

  validates :as_of, presence: true
end

==> app/models/order.rb <==
class Order < ApplicationRecord
  WORKING_STATUSES = %w[ WORKING ACCEPTED QUEUED PENDING_ACTIVATION ].freeze # SCHWAB_SHAPE_UNVERIFIED
  STOP_TYPES = %w[ STOP STOP_LIMIT TRAILING_STOP TRAILING_STOP_LIMIT ].freeze # SCHWAB_SHAPE_UNVERIFIED

  belongs_to :account
  belongs_to :instrument
  belongs_to :parent_order, class_name: "Order", optional: true
  belongs_to :replaces_order, class_name: "Order", optional: true
  belongs_to :order_proposal, optional: true
  has_many :child_orders, class_name: "Order", foreign_key: :parent_order_id, dependent: :nullify, inverse_of: :parent_order
  has_many :transactions, dependent: :nullify

  enum :placed_via, { schwab_direct: "schwab_direct", app: "app" }

  validates :broker_order_id, presence: true, uniqueness: { scope: :account_id }
  validates :status, presence: true

  scope :working, -> { where(status: WORKING_STATUSES) }
  scope :stops, -> { where(order_type: STOP_TYPES) }

  def working? = WORKING_STATUSES.include?(status)
  def stop? = STOP_TYPES.include?(order_type)
end

==> app/models/order_proposal.rb <==
class OrderProposal < ApplicationRecord
  belongs_to :account
  belongs_to :instrument
  belongs_to :target_order, class_name: "Order", optional: true
  belongs_to :user, optional: true
  belongs_to :setup, optional: true
  has_many :orders, dependent: :nullify
  has_many :submission_attempts, dependent: :destroy
  has_one :trade, dependent: :nullify

  enum :kind, { entry: "entry", exit: "exit", stop_adjustment: "stop_adjustment" }
  enum :origin, { agent: "agent", human: "human" }
  enum :status, {
    proposed: "proposed", validated: "validated", rejected: "rejected", approved: "approved",
    submitted: "submitted", submission_unknown: "submission_unknown", filled: "filled", cancelled: "cancelled"
  }
end

==> app/models/submission_attempt.rb <==
class SubmissionAttempt < ApplicationRecord
  belongs_to :order_proposal
  belongs_to :reconciled_order, class_name: "Order", optional: true

  enum :outcome, { submitted: "submitted", unknown: "unknown", failed: "failed", reconciled: "reconciled" }

  validates :attempted_at, presence: true
end

==> app/models/transaction.rb <==
class Transaction < ApplicationRecord
  belongs_to :account
  belongs_to :instrument, optional: true
  belongs_to :order, optional: true
  has_one :trade_leg, dependent: :restrict_with_exception, inverse_of: :source_transaction

  enum :kind, {
    fill: "fill", dividend: "dividend", interest: "interest", fee: "fee", deposit: "deposit",
    withdrawal: "withdrawal", corporate_action: "corporate_action", other: "other"
  }

  validates :broker_transaction_id, presence: true, uniqueness: { scope: :account_id }
  validates :executed_at, presence: true

  scope :unjournaled, -> { where(journaled_at: nil) }
  scope :chronological, -> { order(:executed_at, :id) }
  scope :flows, -> { where(kind: %w[ deposit withdrawal ]) }

  def journaled? = journaled_at.present?
end

==> app/models/trade.rb <==
class Trade < ApplicationRecord
  belongs_to :account
  belongs_to :instrument
  belongs_to :setup, optional: true
  belongs_to :order_proposal, optional: true
  has_many :trade_legs, dependent: :destroy

  enum :status, { open: "open", closed: "closed" }, scopes: false

  scope :open, -> { where(status: "open") }
  scope :closed, -> { where(status: "closed") }
  scope :needing_review, -> { where(needs_review: true) }
  scope :missing_post_mortem, -> { closed.where(post_mortem: [ nil, "" ]) }

  validates :status, presence: true

  def realized_r_available? = initial_risk.present? && initial_risk.nonzero?
end

==> app/models/trade_leg.rb <==
class TradeLeg < ApplicationRecord
  belongs_to :trade
  # "transaction" is reserved by Active Record, so the association carries a different name.
  belongs_to :source_transaction, class_name: "Transaction", foreign_key: :transaction_id, optional: true, inverse_of: :trade_leg

  enum :kind, { entry: "entry", exit: "exit", adjustment: "adjustment", income: "income" }

  validates :executed_at, presence: true
  validates :transaction_id, uniqueness: true, allow_nil: true
end

