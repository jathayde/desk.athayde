     1	# One instrument's position lifecycle from zero back to zero. Every aggregate here is a pure function of
     2	# the legs, recomputed after any leg changes; nothing is updated incrementally.
     3	class Trade < ApplicationRecord
     4	  DIVIDEND_AFTER_CLOSE_WINDOW = 90.days
     5	  # Reasons in order of seriousness; a more serious reason replaces a lesser one, never the reverse.
     6	  REVIEW_REASONS = %w[ corporate_action ordering_ambiguous position_missing bootstrapped missing_stop missing_setup ].freeze
     7	
     8	  belongs_to :account
     9	  belongs_to :instrument
    10	  belongs_to :setup, optional: true
    11	  belongs_to :order_proposal, optional: true
    12	  has_many :trade_legs, dependent: :destroy
