     1	# Solid Queue recurring tasks. Cron with an explicit zone so a config.time_zone change cannot shift them,
     2	# and because Solid Queue skips a schedule it cannot parse without failing boot (spec/config/recurring_spec.rb).
     3	shared: &shared
     4	  schwab_refresh_access_token:
     5	    class: Schwab::RefreshAccessTokenJob
     6	    queue: critical
     7	    schedule: "*/25 * * * * America/New_York"
     8	  schwab_token_health:
     9	    class: Schwab::TokenHealthJob
    10	    schedule: "0 8,20 * * * America/New_York"
    11	  sync_tick:
    12	    class: Sync::TickJob
    13	    schedule: "*/5 * * * * America/New_York"
    14	  sync_accounts:
    15	    class: Sync::AccountsJob
    16	    schedule: "5 6 * * * America/New_York"
    17	  agent_morning_brief:
    18	    class: Agent::MorningBriefJob
    19	    schedule: "3 7 * * 1-5 America/New_York" # after the 07:00 tick has enqueued the syncs
    20	  agent_end_of_day:
    21	    class: Agent::EndOfDayJob
    22	    schedule: "30 16 * * 1-5 America/New_York"
    23	  agent_sunday_review:
    24	    class: Agent::SundayReviewJob
    25	    schedule: "0 18 * * 0 America/New_York"
    26	  stop_collar_trails:
    27	    class: StopCollar::TrailJob
    28	    schedule: "0 17 * * 1-5 America/New_York"
    29	  memory_check_repo:
    30	    class: Memory::CheckRepoJob
    31	    schedule: "*/30 * * * * America/New_York"
    32	  failure_digest:
    33	    class: FailureDigestJob
    34	    schedule: "15 17 * * * America/New_York"
    35	
    36	development:
    37	  <<: *shared
    38	
    39	production:
    40	  <<: *shared

