    34	
    35	  # The next trade waiting after this one, in queue order.
    36	  def self.next_to_review(after:) = review_queue.excluding(after).first
    37	
    38	  # Words added to the post-mortem after the fact, dated and signed, below whatever is already there.
    39	  def annotate!(note, actor:, user: nil)
    40	    stamp = "#{Time.current.in_time_zone(MarketDay::ZONE).strftime('%Y-%m-%d')} #{actor}: #{note.to_s.strip}"
    41	    update!(post_mortem: [ post_mortem, stamp ].compact.join("\n"))
