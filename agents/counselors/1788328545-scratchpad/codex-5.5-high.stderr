     2	  include Agent::Tool::ReadsDesk
     3	
     4	  tool description: "Open positions in the trading account with last price, unrealized P&L, the working stop and its protection state, " \
     5	                    "distance to stop, and open risk. Unknown risk is null, never zero. Every number carries as_of and stale. " \
     6	                    "Money and quantities are decimal strings.",
     7	       output: { state: { type: "string" }, account: { type: "string" }, positions: { type: "array", items: { type: "object" } },
     8	                 open_risk: { type: [ "object", "null" ] } }
     9	
    10	  def call
    11	    return { state: desk.state, account: "trading", positions: [], open_risk: nil } unless desk.ready?
    12	    {
    13	      state: :ready,
    14	      account: "trading",
    15	      positions: desk.rows.map { |row| position(row) },
    16	      open_risk: { amount: desk.open_risk, ratio_of_equity: desk.open_risk_ratio, excluded: desk.excluded_by_reason,
    17	                   note: "sums protected positions only; excluded positions carry unknown or insufficient risk" }
    18	    }
    19	  end
    20	
    21	  private
    22	    # A delisted holding carries no market numbers: whatever Schwab still echoes is a stale mark, not a price.
    23	    def position(row)
    24	      p = row.position
    25	      priced = !p.delisted?
    26	      { symbol: p.instrument.symbol, cusip: p.instrument.cusip, quantity: p.quantity, average_price: p.average_price, last_price: priced ? p.last_price : nil,
    27	        market_value: priced ? p.market_value : nil, unrealized_pnl: priced ? p.unrealized_pnl : nil, protection: row.protection, stop_price: p.stop_price,
    28	        covered_quantity: p.covered_quantity, distance_to_stop: priced ? p.distance_to_stop : nil, open_risk: p.open_risk,
    29	        suggested_stop: p.suggested_stop, suggested_stop_method: p.suggested_stop_method,
    30	        trade_id: row.trade&.id, needs_review: row.trade&.needs_review?, **stamp(row.as_of, row.stale) }
    31	    end
    32	end
