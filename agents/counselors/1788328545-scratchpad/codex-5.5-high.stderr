app/models/stop_collar/trail.rb
     1	# Trailing stops for an open position (PRD §5.4.1): the chandelier exit and the ATR trail off the latest close,
     2	# from the same year of candles the collar reads. Suggested when tighter than the working stop; never placed.
     3	class StopCollar::Trail
     4	  Suggestion = Data.define(:method, :price)
     5	
     6	  def initialize(position, params: {})
     7	    @position, @params = position, StopCollar::Calculator::DEFAULTS.merge(params.to_h.transform_keys(&:to_s))
     8	  end
     9	
    10	  # The tightest trail above the working stop, or nil when nothing is tighter or the data is not there.
    11	  def suggestion
    12	    history = Agent::MarketData.price_history(@position.instrument.symbol, range: "1y")
    13	    return nil if history[:stale]
    14	    candles = Array(history[:candles]).map { |c| c.transform_keys(&:to_sym) }.sort_by { |c| c[:date] }
    15	    return nil if candles.size < StopCollar::Calculator::MIN_CANDLES
    16	    trails = {
    17	      chandelier: candles.last(param(:chandelier_bars).to_i).map { |c| c[:high] }.max - param(:chandelier_k) * atr(candles, param(:chandelier_bars).to_i),
    18	      atr: candles.last[:close] - param(:atr_k) * atr(candles, 14)
    19	    }.transform_values { |v| v.round(4) }
    20	    method, price = trails.max_by { |_, v| v }
    21	    floor = @position.stop_price
    22	    return nil if floor && price <= floor
    23	    return nil if @position.last_price && price >= @position.last_price
    24	    Suggestion.new(method: method.to_s, price: price)
    25	  rescue Schwab::Error, Agent::Tool::InvalidArguments
    26	    nil
    27	  end
    28	
    29	  private
    30	    def param(name) = BigDecimal(@params.fetch(name.to_s).to_s)
    31	
    32	    def atr(candles, n)
    33	      ranges = candles.each_cons(2).to_a.last(n).map { |prev, c| [ c[:high] - c[:low], (c[:high] - prev[:close]).abs, (c[:low] - prev[:close]).abs ].max }
    34	      ranges.sum / ranges.size
    35	    end
    36	end
app/jobs/stop_collar/trail_job.rb
     1	module StopCollar
     2	  # 17:00 New York on weekdays: recompute the trails for every open position on the trading account and keep
     3	  # the tightest one above the working stop as a suggestion for the end-of-day brief. Nothing is placed.
     4	  class TrailJob < ApplicationJob
     5	    limits_concurrency to: 1, key: ->(*) { self.class.name }, on_conflict: :discard
     6	
     7	    def perform
     8	      Account.trading.find_each do |account|
     9	        account.positions.includes(:instrument, :working_stop_order).each do |position|
    10	          next if position.delisted?
    11	          params = RiskRule.active_for("stop_collar", setup: position_setup(account, position))&.params || {}
    12	          suggestion = StopCollar::Trail.new(position, params: params).suggestion
    13	          position.update!(suggested_stop: suggestion&.price, suggested_stop_method: suggestion&.method)
    14	        end
    15	      end
    16	    end
    17	
    18	    private
    19	      def position_setup(account, position) = account.trades.open.find_by(instrument: position.instrument)&.setup
    20	  end
    21	end
