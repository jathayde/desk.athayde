app/views/brief_mailer/_eod.text.erb
     1	Fills today:
     2	<% if brief.fills_today.nil? -%>
     3	  unknown: the activities feed is stale (last sync <%= stamp(brief.account&.last_sync(:activities)) %>)
     4	<% elsif brief.fills_today.none? -%>
     5	  none
     6	<% end -%>
     7	<% (brief.fills_today || []).each do |fill| -%>
     8	  <%= fill.side %> <%= quantity(fill.quantity) %> <%= fill.instrument.symbol %> @ <%= money(fill.price) %> (<%= stamp(fill.executed_at) %>)
     9	<% end -%>
    10	
    11	Journal rows touched today:
    12	<% if brief.trades_touched_today.nil? -%>
    13	  unknown: the activities feed is stale
    14	<% elsif brief.trades_touched_today.none? -%>
    15	  none
    16	<% end -%>
    17	<% (brief.trades_touched_today || []).each do |trade| -%>
    18	  <%= trade.instrument.symbol %> <%= trade.status %><%= " · needs review" if trade.needs_review? %> <%= trade_url(trade) %>
    19	<% end -%>
    20	
    21	Missing post-mortems:
    22	<% if brief.missing_post_mortems.none? -%>
    23	  none
    24	<% end -%>
    25	<% brief.missing_post_mortems.each do |trade| -%>
    26	  <%= trade.instrument.symbol %> closed <%= stamp(trade.closed_at) %> <%= r_multiple(trade) %> <%= trade_url(trade) %>
    27	<% end -%>
    28	<% if brief.more_post_mortems > 0 -%>
    29	  and <%= brief.more_post_mortems %> more: <%= trades_url(filter: "missing_post_mortem") %>
    30	<% end -%>
    31	
    32	<% if brief.stop_suggestions.any? -%>
    33	Tighten stop (last night's trails; suggestion only):
    34	<% brief.stop_suggestions.each do |position| -%>
    35	  <%= position.instrument.symbol %>: <%= position.suggested_stop_method %> trail <%= money(position.suggested_stop) %> vs working stop <%= position.stop_price ? money(position.stop_price) : "none" %>
    36	<% end -%>
    37	
    38	<% end -%>
    39	<% if brief.snapshot -%>
    40	Snapshot <%= brief.snapshot.as_of %>: equity <%= money(brief.snapshot.equity) %>, drawdown <%= percent(brief.snapshot.drawdown) %>, open risk <%= brief.snapshot.open_risk_amount ? money(brief.snapshot.open_risk_amount) : "unknown" %>, unprotected <%= brief.snapshot.unprotected_count %>
    41	<% elsif brief.balance -%>
    42	Today's snapshot is not yet written; equity <%= money(brief.balance.equity) %> as of <%= stamp(brief.balance.as_of) %><%= " (stale)" if brief.balance_stale? %>
    43	<% else -%>
    44	No balance has synced yet.
    45	<% end -%>

