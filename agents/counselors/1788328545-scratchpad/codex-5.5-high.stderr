    21	  # Most serious reason first, never-skipped before skipped, oldest first.
    22	  scope :review_queue, -> { needing_review.in_order_of(:review_reason, REVIEW_REASONS).order(Arel.sql("review_deferred_at ASC NULLS FIRST"), :created_at) }
    23	  scope :in_setup, ->(name) { joins(:setup).where(setups: { name: name }) }
    24	  scope :in_symbol, ->(symbol) { joins(:instrument).where(instruments: { symbol: symbol.to_s.upcase }) }
    25	  scope :opened_after, ->(date) { where(opened_at: date.beginning_of_day..) }
    26	  scope :closed_after, ->(date) { where(closed_at: date.beginning_of_day..) }
    27	  scope :newest_first, -> { order(Arel.sql("COALESCE(trades.closed_at, trades.opened_at, trades.created_at) DESC"), id: :desc) }
    28	  scope :missing_post_mortem, -> { closed.where(post_mortem: nil, needs_review: false, excluded_from_stats: false) }
    29	  # bootstrapped means "has a plug leg now": a trade whose entry the journal never saw stays out of the stats.
    30	  scope :eligible_for_stats, -> { closed.where(needs_review: false, excluded_from_stats: false, bootstrapped: false).where("initial_risk > 0") }
    31	
    32	  validate :stop_below_entry, on: :review
