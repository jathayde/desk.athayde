    43	    expect(Proposals.draft(account: account, kind: :exit, side: :sell, symbol: "XYZ", limit_price: 60, origin: :human, tax_lot_method: "LIFO").tax_lot_method).to eq("LIFO")
    44	    expect(Proposals.draft(account: account, kind: :exit, side: :sell, symbol: "XYZ", limit_price: 60, origin: :human, tax_lot_method: "MAGIC").tax_lot_method).to eq("FIFO")
    45	  end
    46	end
