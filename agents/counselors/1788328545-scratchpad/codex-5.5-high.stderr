     1	<% content_for :title, "New proposal" %>
     2	<h1>Propose an order</h1>
     3	<p class="muted">Rails sizes an entry from the max-risk rule and computes the collar; preview runs the guardrails without saving.</p>
     4	<%= form_with url: new_proposal_path, method: :get, class: "account-form" do |f| %>
     5	  <%= f.label :kind, "Kind" %>
     6	  <%= f.select :kind, options_for_select([ [ "Entry (buy with a stop)", "entry" ], [ "Exit (sell)", "exit" ] ], params[:kind]) %>
     7	  <%= f.label :symbol, "Symbol" %>
     8	  <%= f.text_field :symbol, value: params[:symbol], autocapitalize: "characters" %>
     9	  <%= f.label :limit_price, "Limit price" %>
    10	  <%= f.text_field :limit_price, value: params[:limit_price], inputmode: "decimal" %>
    11	  <%= f.label :stop_price, "Stop (entries)" %>
    12	  <%= f.text_field :stop_price, value: params[:stop_price], inputmode: "decimal" %>
    13	  <%= f.label :quantity, "Quantity (exits; defaults to the position)" %>
    14	  <%= f.text_field :quantity, value: params[:quantity], inputmode: "numeric" %>
    15	  <%= f.label :tax_lot_method, "Lot method (exits)" %>
    16	  <%= f.select :tax_lot_method, options_for_select(TaxLots::METHODS, params[:tax_lot_method] || TaxLots::DEFAULT_METHOD) %>
    17	  <%= f.label :setup_id, "Setup" %>
    18	  <%= f.select :setup_id, options_from_collection_for_select(@setups, :id, :name, params[:setup_id]), include_blank: "No setup" %>
    19	  <%= f.label :thesis, "Thesis" %>
    20	  <%= f.text_area :thesis, value: params[:thesis], rows: 3 %>
    21	  <%= f.submit "Preview" %>
    22	<% end %>
    23	<% if @draft %>
    24	  <% draft, report = @draft %>
    25	  <h2 class="sec">Preview: <%= draft.side.upcase %> <%= quantity(draft.quantity) %> <%= draft.instrument.symbol %> @ <%= money(draft.limit_price) %></h2>
    26	  <%= render "proposals/evaluation", proposal: draft, results: report.to_h, sizing: draft.sizing, collar: draft.collar %>
    27	  <%= form_with url: proposals_path, method: :post do |f| %>
    28	    <% %i[ kind symbol limit_price stop_price quantity setup_id thesis tax_lot_method ].each { |key| concat f.hidden_field(key, value: params[key]) } %>
    29	    <%= f.submit report.blocked? ? "Propose anyway (it will be rejected by rules)" : "Propose" %>
    30	  <% end %>
    31	<% end %>
app/views/proposals/show.html.erb
     1	<% content_for :title, "Proposal #{@proposal.instrument.symbol}" %>
     2	<% proposal = @proposal %>
     3	<h1><%= proposal.side.upcase %> <%= quantity(proposal.quantity) %> <%= proposal.instrument.symbol %> @ <%= money(proposal.limit_price) %> <small><%= proposal_status_label(proposal) %></small></h1>
     4	<p class="callout"><%= proposal.kind.humanize %> · <%= proposal.origin %><% if proposal.setup %> · <%= proposal.setup.name %><% end %><% if proposal.stop_price %> · stop <%= money(proposal.stop_price) %><% end %><% if proposal.shadow? %> · shadow<% end %></p>
     5	<% if proposal.thesis.present? %><p class="thesis"><%= proposal.thesis %></p><% end %>
     6	
     7	<%= render "proposals/evaluation", proposal: proposal, results: proposal.guardrail_results, sizing: proposal.sizing, collar: proposal.collar %>
     8	<% if proposal.kind_exit? %>
     9	  <h2 class="sec">Lots</h2>
    10	  <dl class="kv-list">
    11	    <div class="kv"><dt>Lot method</dt><dd><%= proposal.tax_lot_method %> <small class="muted">(instrument match only; the lot method names are unverified against Schwab)</small></dd></div>
    12	    <% @lots.each do |lot| %>
    13	      <div class="kv"><dt><%= lot.acquired_at ? stamp(lot.acquired_at) : "unknown date" %></dt><dd><%= quantity(lot.quantity) %> @ <%= money(lot.price) %> · <%= lot.term == :unknown ? "term unknown" : "#{lot.term}-term" %></dd></div>
    14	    <% end %>
    15	    <% if @lots.empty? %><div class="kv"><dt>Lots</dt><dd>no journaled entry legs for this position</dd></div><% end %>
    16	  </dl>
    17	<% end %>
    18	
    19	<% if proposal.submission_unknown? %>
    20	  <p class="warn">Submission unknown: check Schwab before doing anything else on <%= proposal.instrument.symbol %>. The app is looking for the order and says when it finds it or confirms it was never placed.<% if proposal.ambiguous_orders.any? %> More than one order at Schwab could be it (<%= proposal.ambiguous_orders.join(", ") %>): cancel the extra there and the next look will link the one that remains.<% end %></p>
    21	<% elsif proposal.submission_failed? %>
    22	  <p class="warn">Not placed: <%= proposal.failure_reason %></p>
    23	<% elsif proposal.awaiting_hand_placement? %>
    24	  <p class="warn">Shadow approval: place this order at Schwab by hand. The next orders sync matches it and records the payload check.<% if proposal.kind_exit? && @position&.working_stop_order %> Adjust the working stop by hand too; a real submission would <%= @position.working_stop_order.remaining.to_d <= proposal.quantity.to_d ? "cancel" : "shrink" %> it first.<% end %></p>
    25	<% end %>
    26	
    27	<% if proposal.approvable? %>
    28	  <%= form_with url: proposal_approval_path(proposal), method: :post do |f| %>
    29	    <% proposal.warnings.each do |rule| %>
    30	      <label><%= f.check_box :acknowledged, { multiple: true, id: "ack_#{rule}" }, rule, nil %> I acknowledge <%= rule.humanize.downcase %><%= " (not checked)" if proposal.guardrail_results.dig(rule, "outcome") == "unavailable" %></label>
    31	    <% end %>
    32	    <% if proposal.needs_override? %>
    33	      <%= f.label :override_reason, "The stop is outside the collar. Why?" %>
    34	      <%= f.text_field :override_reason %>
    35	    <% end %>
    36	    <%= f.label :confirmation, "Type approve to confirm" %>
    37	    <%= f.text_field :confirmation, autocomplete: "off" %>
    38	    <%= f.submit "Approve", class: "danger" %>
    39	  <% end %>
    40	  <%= form_with url: proposal_rejection_path(proposal), method: :post do |f| %>
    41	    <%= f.label :reason, "Reject with a reason" %>
    42	    <%= f.text_field :reason %>
    43	    <%= f.submit "Reject", class: "secondary" %>
    44	  <% end %>
    45	<% end %>
    46	<% if proposal.rejection_reason.present? %><p class="muted">Rejected: <%= proposal.rejection_reason %></p><% end %>
    47	<% if proposal.override_reason.present? %><p class="muted">Override: <%= proposal.override_reason %></p><% end %>

