     1	class ProposalsController < ApplicationController
     2	  before_action :require_approver, only: %i[ new create ]
     3	
     4	  def index
     5	    @awaiting = OrderProposal.awaiting_hand_placement.includes(:instrument).order(:id)
     6	    @queue = OrderProposal.queue.includes(:instrument, :setup)
     7	    @decided = OrderProposal.where.not(status: %w[ proposed validated submission_unknown ]).where.not(id: @awaiting).order(id: :desc).limit(10).includes(:instrument)
     8	  end
     9	
    10	  def show
    11	    @proposal = OrderProposal.find(params[:id])
    12	    @position = @proposal.account.positions.find_by(instrument: @proposal.instrument)
    13	    @lots = @proposal.kind_exit? ? TaxLots.for(@proposal.account.trades.open.find_by(instrument: @proposal.instrument)) : []
    14	  end
    15	
    16	  def new
    17	    @setups = Setup.active.order(:name)
    18	    @draft = params[:symbol].present? ? preview : nil
    19	  end
    20	
    21	  def create
    22	    proposal = Proposals::Create.call(**proposal_arguments, origin: :human, user: Current.user)
    23	    redirect_to proposal_path(proposal), notice: "Proposed #{proposal.instrument.symbol}."
    24	  rescue Proposals::Error, ArgumentError => e
    25	    redirect_to new_proposal_path(params.permit(:kind, :symbol, :limit_price, :stop_price, :setup_id, :thesis, :quantity, :tax_lot_method)), alert: e.message
    26	  end
    27	
    28	  private
    29	    # The form's preview: an unsaved draft judged by the same evaluator, nothing written.
    30	    def preview
    31	      draft = Proposals.draft(**proposal_arguments, origin: :human, user: Current.user)
    32	      [ draft, Guardrails::Evaluator.new(draft).call ]
    33	    rescue Proposals::Error, ArgumentError => e
    34	      flash.now[:alert] = e.message
    35	      nil
    36	    end
    37	
    38	    def proposal_arguments
    39	      kind = params[:kind].presence_in(%w[ entry exit ]) || "entry"
    40	      { account: Account.trading.order(:id).first, kind: kind, side: kind == "entry" ? :buy : :sell, symbol: params[:symbol].to_s,
    41	        limit_price: decimal(params[:limit_price]), stop_price: decimal(params[:stop_price]), setup: Setup.find_by(id: params[:setup_id]),
    42	        thesis: params[:thesis].presence, quantity: params[:quantity].presence&.to_i, tax_lot_method: params[:tax_lot_method].presence }
    43	    end
    44	
    45	    def decimal(value) = value.present? ? BigDecimal(value.to_s.strip) : nil
    46	end
