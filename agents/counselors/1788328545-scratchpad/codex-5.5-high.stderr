    72	
    73	  # The synthetic entry leg that reconciles the journal to the broker. It sorts first and is scaled by every later
    74	  # split, so plug = (broker quantity − quantity from linked legs) / cumulative ratio. Deleted at zero, and the
    75	  # bootstrapped flag follows the plug: present while it exists, cleared when it goes.
    76	  def reconcile_plug!(broker_quantity:, average_price:)
    77	    linked = Ledger.new(ordered_legs.reject(&:plug?))
    78	    plug_quantity = (broker_quantity - linked.running) / linked.ratio
    79	    # Looked up, never built: an unsaved leg left on the association would be autosaved by recompute!.
    80	    plug = trade_legs.find_by(activity_id: nil, kind: :entry)
    81	    if plug_quantity.positive?
    82	      changed = plug.nil? || plug.quantity != plug_quantity
    83	      price = average_price && average_price * linked.ratio # the broker's post-split average, in the plug's pre-split units
    84	      attributes = { quantity: plug_quantity, price: price, cash_amount: price ? -(plug_quantity * price) : nil, note: "plug" }
    85	      plug ? plug.update!(attributes) : trade_legs.create!(attributes.merge(kind: :entry))
    86	      update!(bootstrapped: true) unless bootstrapped?
    87	      flag!(:bootstrapped) if changed
    88	    else
    89	      plug&.destroy!
    90	      update!(bootstrapped: false) if bootstrapped?
    91	      clear_flag!(:bootstrapped)
    92	      flag!(:missing_setup) if setup.nil? && order_proposal.nil? && !reviewed?
    93	    end
    94	    recompute!
    95	  end
    96	
    97	  # Legs in execution order; the plug (no time) sorts first.
    98	  def ordered_legs = trade_legs.includes(activity: :order).order(Arel.sql("executed_at ASC NULLS FIRST"), :id)
    99	
   100	  # The planned stop is kept in original-entry units; splits since then scale it for display.
   101	  def current_planned_stop = planned_stop && planned_stop / Ledger.new(ordered_legs).ratio
   102	
   103	  def recompute!
   104	    legs = ordered_legs.to_a
   105	    ledger = Ledger.new(legs)
   106	    closed = ledger.running.zero? && ledger.closing_leg.present?
   107	    initial = ledger.initial_entry_legs
   108	    initial_quantity = initial.sum(&:quantity) if initial.any?
   109	    unpriced_plug = legs.any? { |l| l.plug? && l.price.nil? }
   110	
   111	    assign_attributes(
   112	      quantity: ledger.running,
   113	      peak_quantity: ledger.peak,
   114	      status: closed ? :closed : :open,
   115	      opened_at: ledger.first_fill&.executed_at,
   116	      closed_at: closed ? ledger.closing_leg.executed_at : nil,
   117	      avg_entry: ledger.avg_entry,
   118	      avg_exit: ledger.avg_exit,
   119	      initial_quantity: initial_quantity,
   120	      initial_risk: initial_risk_for(initial, plug: legs.any?(&:plug?)),
   121	      total_risk: total_risk_for(legs),
   122	      realized_pnl: closed && !unpriced_plug ? ledger.cash : nil,
   123	      stopped_out: closed && ledger.closing_leg.activity&.order&.stop? == true
   124	    )
   125	    self.realized_r = closed && realized_r_available? ? realized_pnl / initial_risk : nil
   126	    clear_flag!(:position_missing) if closed && ledger.closing_leg.activity_id
   127	    save!
   128	  end
   129	
   130	  # The review form: the stop and setup are known now. A closed legacy holding takes setup and thesis only;
   131	  # a stop typed in after the fact would give it an R it never had. Returns false with errors when the
   132	  # rules are not met, so every caller (form or tool) gets the same answer.
   133	  def review(setup:, planned_stop:, thesis:, user:)
   134	    previous_setup = self.setup
   135	    assign_attributes(setup: setup, thesis: thesis, needs_review: false, review_reason: nil, review_deferred_at: nil, journal_completed_at: Time.current)
   136	    self.planned_stop = planned_stop unless closed? && bootstrapped?
   137	    return false unless save(context: :review)
   138	    recompute!
   139	    AuditEvent.log("trade_reviewed", actor: :human, user: user, subject: self, data: { setup: setup&.name, planned_stop: self.planned_stop&.to_s })
   140	    recompute_setup_stats(previous_setup, setup)
   141	    true
   142	  end
   143	
   144	  def review!(**)
   145	    review(**) or raise ActiveRecord::RecordInvalid, self
   146	    self
   147	  end
   148	
   149	  # Skip: later, not never.
   150	  def defer_review! = update!(review_deferred_at: Time.current)
   151	
   152	  def exclude!(user:)
   153	    update!(excluded_from_stats: true, needs_review: false, review_reason: nil)
   154	    AuditEvent.log("trade_reviewed", actor: :human, user: user, subject: self, data: { excluded: true })
   155	    recompute_setup_stats(setup)
   156	    self
   157	  end
   158	
   159	  # One walk over the legs, accumulating everything recompute! needs.
   160	  class Ledger
   161	    attr_reader :running, :peak, :cash, :ratio, :closing_leg, :first_fill
   162	
   163	    def initialize(legs)
   164	      @legs = legs
   165	      @running = @peak = @entry_qty = @entry_cost = @exit_qty = @exit_proceeds = @cash = BigDecimal("0")
   166	      @ratio = BigDecimal("1")
   167	      legs.each { |leg| apply(leg) }
   168	    end
   169	
   170	    def avg_entry = @entry_qty.positive? ? @entry_cost / @entry_qty : nil
   171	    def avg_exit = @exit_qty.positive? ? @exit_proceeds / @exit_qty : nil
   172	
   173	    # The initial entry: every fill from the first fill's order (a partial fill is one entry); without an order
   174	    # id, every entry fill on the first fill's trade date.
   175	    def initial_entry_legs
   176	      return [] unless first_fill
   177	      order_id = first_fill.activity.broker_order_id
   178	      entries = @legs.select { |l| l.kind_entry? && l.activity }
   179	      order_id ? entries.select { |l| l.activity.broker_order_id == order_id } : entries.select { |l| l.activity.trade_date == first_fill.activity.trade_date }
   180	    end
   181	
   182	    private
   183	      def apply(leg)
   184	        case leg.kind
   185	        when "entry"
   186	          @running += leg.quantity
   187	          @entry_qty += leg.quantity
   188	          @entry_cost += leg.quantity * (leg.price || 0)
   189	          @first_fill ||= leg if leg.activity_id
   190	        when "exit"
   191	          @running -= leg.quantity
   192	          @exit_qty += leg.quantity
   193	          @exit_proceeds += leg.quantity * (leg.price || 0)
   194	          @closing_leg = leg if @running.zero?
   195	        when "adjustment"
   196	          if leg.ratio
   197	            @running *= leg.ratio
   198	            @entry_qty *= leg.ratio
   199	            @exit_qty *= leg.ratio
   200	            @ratio *= leg.ratio
   201	          elsif leg.quantity
   202	            @running += leg.quantity
   203	          end
   204	        end
   205	        @cash += leg.cash_amount || 0
   206	        @peak = @running if @running > @peak
   207	      end
   208	  end
   209	
   210	  private
   211	    # Fixed to the initial entry at its weighted price, in original-entry units. Nil, never a number, when the
   212	    # stop is unknown, the stop is above the entry, or a plug means the journal never saw the real entry.
   213	    def initial_risk_for(initial_legs, plug:)
   214	      return nil if plug || planned_stop.blank? || initial_legs.empty?
   215	      quantity = initial_legs.sum(&:quantity)
   216	      average = initial_legs.sum { |l| l.quantity * (l.price || 0) } / quantity
   217	      risk = quantity * (average - planned_stop)
   218	      risk.positive? ? risk : nil
   219	    end
   220	
   221	    def total_risk_for(legs)
   222	      return nil if planned_stop.blank?
   223	      legs.select { |l| l.kind_entry? && l.price && !l.plug? }.sum { |l| [ l.quantity * (l.price - planned_stop), 0 ].max }
   224	    end
   225	
   226	    def recompute_setup_stats(*setups)
   227	      setups.compact.uniq.each { |s| Journal::RecomputeSetupStatsJob.perform_later(s) }
   228	    end
   229	
   230	    def stop_below_entry
   231	      return if planned_stop.blank? || avg_entry.blank? || planned_stop < avg_entry
   232	      errors.add(:planned_stop, "at or above the average entry gives no risk to measure; leave it blank or set it below #{avg_entry.round(2)}")
   233	    end
   234	end

