     4	  class UnknownSymbol < Error; end
     5	
     6	  # An unsaved proposal with its instrument resolved and, for an entry, its sizing and collar frozen from a
     7	  # year of candles and a fresh quote: the shape both the hypothetical tool and Proposals::Create start from.
     8	  def self.draft(account:, kind:, side:, symbol:, limit_price:, stop_price: nil, setup: nil, thesis: nil, origin:, user: nil, quantity: nil, tax_lot_method: nil)
     9	    instrument = Instrument.find_by(symbol: symbol.to_s.strip.upcase) or raise UnknownSymbol, "unknown symbol #{symbol}"
    10	    proposal = OrderProposal.new(account: account, instrument: instrument, kind: kind, side: side, order_type: Schwab::Order::LIMIT, limit_price: limit_price, stop_price: stop_price,
    11	                                 planned_stop: stop_price, setup: setup, thesis: thesis, origin: origin, user: user, quantity: quantity,
    12	                                 tax_lot_method: kind.to_s == "exit" ? (tax_lot_method.presence_in(TaxLots::METHODS) || TaxLots::DEFAULT_METHOD) : nil,
    13	                                 expires_at: MarketDay.today.in_time_zone(MarketDay::ZONE).end_of_day)
    14	    if proposal.kind_entry?
    15	      desk = Desk.new(account: account)
    16	      proposal.collar = StopCollar::Calculator.new(instrument, entry_price: limit_price, params: RiskRule.active_for("stop_collar", setup: setup)&.params || {}).call.to_h
    17	      sizing = Sizing.for(limit_price: limit_price, stop_price: stop_price, equity: desk.balance_stale? ? nil : desk.equity, rule: RiskRule.active_for("max_risk_per_trade", setup: setup))
    18	      proposal.sizing = sizing.to_h
    19	      proposal.quantity = sizing.quantity
    20	    elsif quantity.nil?
    21	      proposal.quantity = account.positions.find_by(instrument: instrument)&.quantity
    22	    end
    23	    proposal
    24	  end
    25	end
app/models/proposals/create.rb
     1	# The one way a proposal comes into being, from the tool or the form: refuse what the halts forbid before a
     2	# row exists, draft, save, evaluate (which engages any halt the rules ask for), and audit the creation.
     3	class Proposals::Create
     4	  class Refused < Proposals::Error; end
     5	
     6	  def self.call(**) = new(**).call
     7	
     8	  def initialize(**arguments) = @arguments = arguments # the keywords Proposals.draft takes
     9	
    10	  def call
    11	    settings = SystemSettings.instance
    12	    raise Refused, "halted: #{settings.manual_halt_reason}" if settings.manual_halt?
    13	    raise Refused, "entries are halted by #{settings.rule_halt_rule}: #{settings.rule_halt_reason}" if @arguments[:kind].to_s == "entry" && !settings.entries_allowed?
    14	    proposal = Proposals.draft(**@arguments)
    15	    open = proposal.account.order_proposals.where(instrument: proposal.instrument, side: OrderProposal.sides.fetch(proposal.side), status: %w[ proposed validated ]).first
    16	    raise Refused, "#{proposal.instrument.symbol} already has a #{proposal.side} proposal waiting (##{open.id}); decide it first" if open
    17	    OrderProposal.transaction do
    18	      proposal.save!
    19	      AuditEvent.log("proposal_created", actor: proposal.agent? ? :agent : :human, user: proposal.user, subject: proposal,
    20	                     data: { kind: proposal.kind, side: proposal.side, symbol: proposal.instrument.symbol, quantity: proposal.quantity, limit_price: proposal.limit_price, stop_price: proposal.stop_price })
    21	      proposal.evaluate!(Guardrails::Evaluator.new(proposal).call)
    22	    end
    23	    proposal
    24	  rescue ActiveRecord::RecordNotUnique
    25	    raise Refused, "#{@arguments[:symbol].to_s.upcase} already has a #{@arguments[:side]} proposal waiting; decide it first"
    26	  rescue ActiveRecord::RecordInvalid => e
    27	    raise Refused, e.record.errors.full_messages.to_sentence
    28	  end
    29	end

