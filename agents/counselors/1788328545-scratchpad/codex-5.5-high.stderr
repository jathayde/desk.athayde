     1	# What a sell would be selling (PRD §5.4 6a): the open trade's entry legs as lots, each with its acquisition
     2	# date and whether it is long-term yet. Schwab's lot method names are unverified (verify-on-approval item 51).
     3	module TaxLots
     4	  LONG_TERM_AFTER = 1.year
     5	  METHODS = %w[ FIFO LIFO HIGH_COST LOW_COST ].freeze # SCHWAB_SHAPE_UNVERIFIED: taxLotMethod enum values
     6	  DEFAULT_METHOD = "FIFO"
     7	
     8	  Lot = Data.define(:acquired_at, :quantity, :price, :term) do
     9	    def long_term? = term == :long
    10	  end
    11	
    12	  def self.for(trade)
    13	    return [] unless trade&.open?
    14	    trade.ordered_legs.select { |leg| leg.kind_entry? }.map do |leg|
    15	      acquired = leg.executed_at
    16	      Lot.new(acquired_at: acquired, quantity: leg.quantity, price: leg.price, term: acquired && acquired <= LONG_TERM_AFTER.ago ? :long : (acquired ? :short : :unknown))
    17	    end
    18	  end
    19	end
