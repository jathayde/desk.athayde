   123	        JSON.parse(response.body.to_s)
   124	      rescue JSON::ParserError
   125	        raise (idempotent ? ServerError : UnknownOutcome).new("Schwab returned a non-JSON body", status: response.code.to_i,
   126	                                                              body: Scrub.body(response.body), attempts: attempts)
   127	      end
   128	
   129	      # One refresh-and-retry on 401, outside the backoff budget. The token model decides whether a
   130	      # refresh is still needed, so two processes seeing the same 401 cannot double-refresh.
   131	      def authorized(uri, refreshed: false)
   132	        request = Net::HTTP::Get.new(uri)
   133	        request["Authorization"] = "Bearer #{@token.access_token}"
   134	        request["Accept"] = "application/json"
   135	        response, attempts = perform(request, template: Scrub.path(uri.path), idempotent: true)
   136	        if response.code.to_i == 401 && !refreshed && @token.respond_to?(:refresh!)
   137	          @token.refresh!(wait: @wait)
   138	          return authorized(uri, refreshed: true)
   139	        end
   140	        [ response, attempts ]
   141	      end
