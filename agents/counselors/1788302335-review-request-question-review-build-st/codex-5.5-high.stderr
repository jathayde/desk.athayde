     3	  class TickJob < ApplicationJob
     4	    INTRADAY = { positions: 15.minutes, orders: 5.minutes, activities: 5.minutes }.freeze
     5	    OFF_HOURS = 60.minutes
     6	    CALENDAR_DAYS = 7
     7	
     8	    def perform
     9	      refresh_calendar
    10	      return pause! unless SchwabToken.usable?
    11	
    12	      in_session = MarketDay.session_open?
    13	      Account.find_each do |account|
    14	        intraday = in_session && account.trading_enabled?
    15	        INTRADAY.each do |feed, interval|
    16	          every = intraday ? interval : OFF_HOURS
    17	          next unless SyncRun.due?(feed, account, every: every)
    18	          job_for(feed).perform_later(account)
    19	        end
    20	      end
    21	    end
    22	
    23	    private
    24	      def refresh_calendar
    25	        today = MarketDay.today
    26	        (today..today + CALENDAR_DAYS).each { |date| MarketDay.for(date) }
    27	      end
    28	
    29	      # One skipped row per hour and one audit per episode; nothing is enqueued, so the queue cannot grow.
    30	      def pause!
