     3	RSpec.describe Position, "#assign_working_stop! and #protection" do
     4	  let(:account) { create(:account) }
     5	  let(:instrument) { create(:instrument) }
     6	  let!(:position) { create(:position, account: account, instrument: instrument, quantity: 40, last_price: 53) }
     7	
     8	  def stop(**attrs)
     9	    create(:order, :working_stop, { account: account, instrument: instrument, quantity: 40, remaining_quantity: 40, entered_at: Time.current }.merge(attrs))
    10	  end
    11	
    12	  it "picks the newest live stop and reports full protection" do
    13	    older = stop(entered_at: 2.days.ago, stop_price: 47)
    14	    newer = stop(entered_at: 1.day.ago, stop_price: 48.9)
    15	    position.assign_working_stop!
    16	    expect(position.working_stop_order).to eq(newer)
    17	    expect(position.protection).to eq(:protected)
    18	    expect(older).to be_working
    19	  end
    20	
    21	  it "prefers a live stop over a newer awaiting bracket child" do
    22	    live = stop(entered_at: 2.days.ago)
    23	    stop(entered_at: 1.hour.ago, status: "AWAITING_PARENT_ORDER", quantity: 20, remaining_quantity: 20)
    24	    position.assign_working_stop!
    25	    expect(position.working_stop_order).to eq(live)
    26	  end
    27	
    28	  it "follows a replacement chain to the terminal order" do
    29	    replaced = stop(status: "REPLACED", entered_at: 2.days.ago)
    30	    replacement = stop(entered_at: 1.day.ago, replaces_order: replaced)
    31	    position.assign_working_stop!
    32	    expect(position.working_stop_order).to eq(replacement)
    33	  end
    34	
    35	  it "reports partial, oversized, and trailing-unknown states as not protected" do
