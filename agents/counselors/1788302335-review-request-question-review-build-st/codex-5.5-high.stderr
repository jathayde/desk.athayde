     5	    limits_concurrency to: 1, key: ->(account) { "positions-#{account.id}" }
     6	
     7	    def perform(account)
     8	      SyncRun.record(:positions, account: account) do |run|
     9	        summary = Schwab::AccountSummary.from(client.account(account.schwab_hash))
    10	        raise Schwab::MappingError, "no positions but positive long market value" if summary.positions.empty? && summary.balances.long_market_value&.positive?
    11	
    12	        now = Time.current
    13	        kept = summary.positions.filter_map do |position|
    14	          instrument = Instrument.resolve(position.instrument)
    15	          unless instrument
    16	            run.quarantine(:positions_unresolved, position.instrument.to_h)
    17	            next
    18	          end
    19	          account.positions.find_or_initialize_by(instrument: instrument).tap do |row|
    20	            row.update!(quantity: position.quantity, average_price: position.average_price, market_value: position.market_value,
    21	                        last_price: last_price_for(position), synced_at: now, raw: position.raw)
    22	          end
    23	        end
    24	        complete = kept.size == summary.positions.size
    25	        account.positions.where.not(id: kept.map(&:id)).destroy_all if complete
    26	        account.balances.create!(as_of: now, equity: summary.balances.equity, cash_available_for_trading: summary.balances.cash_available_for_trading,
    27	                                 unsettled_cash: summary.balances.unsettled_cash, settled_cash: summary.balances.settled_cash,
    28	                                 buying_power: summary.balances.buying_power, raw: summary.balances.raw)
    29	        account.update!(last_synced_at: now, raw: summary.raw_without_positions)
    30	        run.touched(kept.size)
    31	        complete ? :succeeded : :partial
    32	      end
    33	    end
    34	
    35	    private
    36	      def last_price_for(position)
    37	        return nil if position.quantity.zero? || position.market_value.nil?
    38	        position.market_value / position.quantity
    39	      end
    40	  end
    41	end

