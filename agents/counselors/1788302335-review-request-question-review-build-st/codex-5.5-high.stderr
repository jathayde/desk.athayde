   107	        when 200..299 then parse(response, attempts: attempts, idempotent: idempotent).except("id_token")
   108	        when 400, 401, 403 then raise ReauthRequired.new(error.message, status: error.status, body: error.body, attempts: attempts)
   109	        else raise error
   110	        end
   111	      end
