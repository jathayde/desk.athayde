     3	  # one type skips that type and finishes partial; anything else leaves the cursor alone.
     4	  class ActivitiesJob < FeedJob
     5	    OVERLAP = 3.days
     6	
     7	    limits_concurrency to: 1, key: ->(account) { "activities-#{account.id}" }
     8	
     9	    def perform(account)
    10	      from, to, gap_from = window_for(:activities, account, overlap: OVERLAP)
    11	      SyncRun.record(:activities, account: account, window_from: from, window_to: to) do |run|
    12	        note_gap(run, gap_from, account)
    13	        outcome = :succeeded
    14	        Schwab::Activity::CASH_ACCOUNT_TYPES.each do |type|
    15	          raws = client.transactions(account.schwab_hash, from: from, to: to, type: type)
    16	          raws.each { |raw| upsert(account, Schwab::Activity.from(raw), run) }
    17	          run.touched(raws.size)
    18	        rescue Schwab::RequestError => e
    19	          run.quarantine(:activity_types_rejected, "#{type}: #{e.message}")
    20	          outcome = :partial
    21	        rescue Schwab::MappingError => e
    22	          run.quarantine(:activities_unmapped, e.message)
    23	        end
    24	        outcome
    25	      end
    26	    end
    27	
    28	    private
    29	      def upsert(account, activity, run)
    30	        kind = activity.kind
    31	        run.quarantine(:activity_kinds_other, activity.summary) if kind == :other
    32	        instrument = activity.instrument && Instrument.resolve(activity.instrument)
    33	        row = account.activities.find_or_initialize_by(broker_activity_id: activity.activity_id)
    34	        row.update!(instrument: instrument, order: activity.order_id && account.orders.find_by(broker_order_id: activity.order_id),
    35	                    broker_order_id: activity.order_id, kind: kind, status: activity.status, sub_type: activity.type, side: activity.side,
    36	                    quantity: activity.quantity, price: activity.price, commission: activity.commission, fees: activity.fees,
    37	                    net_amount: activity.net_amount, trade_date: activity.trade_date, settlement_date: activity.settlement_date,
    38	                    executed_at: activity.executed_at, raw: activity.raw)
