     1	module Sync
     2	  # Shared shape of the per-account feeds: a client, the account hash, the cursor window, and the gap audit.
     3	  class FeedJob < ApplicationJob
     4	    LOOKBACK = 59.days # one day inside Schwab's 60-day cap so a request can never land past it
     5	
     6	    private
     7	      def client = Schwab.client
     8	
     9	      # Cursor: from the last advanced window, overlapping by `overlap`; capped at the lookback. When the
    10	      # cursor is older than the lookback, Schwab cannot return the gap and the run says so.
    11	      def window_for(feed, account, overlap:)
    12	        now = Time.current
    13	        cursor = SyncRun.last_window_to(feed, account)
    14	        floor = now - LOOKBACK
    15	        from = cursor ? [ cursor - overlap, floor ].max : floor
    16	        gap_from = cursor if cursor && cursor < floor
    17	        [ from, now.utc.end_of_day, gap_from ]
    18	      end
    19	
    20	      def note_gap(run, gap_from, account)
    21	        return unless gap_from
    22	        run.update!(gap_from: gap_from)
    23	        AuditEvent.log("sync_gap_unrecoverable", actor: :system, subject: account, data: { feed: run.feed, gap_from: gap_from, lookback_days: LOOKBACK.in_days.to_i })
    24	      end
    25	  end
    26	end

