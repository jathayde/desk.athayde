   143	      # Returns [response, attempts]. Retries live here and nowhere else.
   144	      def perform(request, template:, idempotent:)
   145	        final = idempotent && @wait ? MAX_ATTEMPTS : 1
   146	        1.upto(final) do |attempt|
   147	          begin
   148	            response = dispatch(request, template)
   149	          rescue *TRANSPORT_FAILURES => e
   150	            raise transport_failure(e, attempt, idempotent) if attempt == final
   151	            @sleeper.call(jittered(BACKOFF[attempt - 1]))
   152	            next
   153	          end
   154	          return [ response, attempt ] unless retriable?(response) && attempt < final
   155	          @sleeper.call(delay_for(response, attempt))
   156	        end
   157	      end
   158	
   159	      def dispatch(request, template)
