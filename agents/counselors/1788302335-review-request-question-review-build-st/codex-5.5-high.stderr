     8	          balances: Balances.from(account["currentBalances"]),
     9	          raw: raw)
    10	    end
    11	
    12	    # The account-level payload without the positions array, which is large and lives on the position rows.
    13	    def raw_without_positions = raw.deep_dup.tap { |r| r["securitiesAccount"]&.delete("positions") }
    14	  end
    15	end

