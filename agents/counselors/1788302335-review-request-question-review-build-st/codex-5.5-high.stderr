    46	      next unless current? && usable?
    47	      next if last_refreshed_at && last_refreshed_at > REFRESH_DEBOUNCE.ago
    48	      apply_refresh(Schwab.oauth_client(wait: wait).refresh(refresh_token))
    49	    end
    50	  rescue Schwab::ReauthRequired => e
    51	    record_failure(e, revoke: true)
    52	    raise
    53	  rescue Schwab::Error => e
    54	    record_failure(e, revoke: false)
    55	    raise
    56	  end
    57	
    58	  # Refresh ahead of expiry so a 401 is the safety net, not the routine path.
    59	  def ensure_fresh!
    60	    refresh! if access_expires_at <= REFRESH_AHEAD.from_now
    61	    self
    62	  end
    63	
    64	  private
    65	    def apply_refresh(response, now: Time.current)
    66	      update!(access_token: response.fetch("access_token") { raise Schwab::MappingError, "token response without access_token" },
    67	              refresh_token: response["refresh_token"].presence || refresh_token,
    68	              access_expires_at: now + response.fetch("expires_in") { raise Schwab::MappingError, "token response without expires_in" }.to_i.seconds - ACCESS_MARGIN,
    69	              last_refreshed_at: now, last_refresh_error: nil)
    70	    end
    71	
    72	    # The revoke-and-pause write is atomic with the currentness check: it holds the settings row lock,
    73	    # which issue! also takes, so a token issued during the failed call cannot end up paused.
    74	    def record_failure(error, revoke:)
    75	      update_columns(last_refresh_error: error.message.truncate(500), updated_at: Time.current)
    76	      return unless revoke
    77	      SystemSettings.transaction do
    78	        settings = SystemSettings.instance.lock!
    79	        next unless current?
    80	        update_columns(revoked_at: Time.current)
    81	        settings.update!(sync_paused_reason: PAUSE_REASON)
    82	        AuditEvent.log("token_refresh_failed", actor: :system, subject: self, reason: error.message.truncate(200), data: { status: error.status })
    83	      end
    84	    end
    85	end

