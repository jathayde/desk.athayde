    37	    position.update!(working_stop_order: partial)
    38	    expect(position.protection).to eq(:partial)
    39	    expect(position).to be_unprotected
    40	    position.update!(working_stop_order: stop(quantity: 60, remaining_quantity: 60))
    41	    expect(position.protection).to eq(:oversized)
    42	    position.update!(working_stop_order: create(:order, :trailing_stop, account: account, instrument: instrument, quantity: 40, remaining_quantity: 40))
    43	    expect(position.protection).to eq(:trailing_unknown)
    44	    expect(position.open_risk).to be_nil
    45	  end
    46	
    47	  it "clears the stop when nothing working remains" do
    48	    filled = stop(status: "FILLED")
    49	    position.update!(working_stop_order: filled)
    50	    position.assign_working_stop!
    51	    expect(position.working_stop_order).to be_nil
    52	    expect(position.protection).to eq(:unprotected)
    53	  end
    54	end

