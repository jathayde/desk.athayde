 succeeded in 0ms:
     1	module Schwab
     2	  # Equity session times for one date. A closed day has no sessionHours (shape SCHWAB_SHAPE_UNVERIFIED).
     3	  MarketHours = Data.define(:date, :open, :session_opens_at, :regular_opens_at, :regular_closes_at, :session_closes_at, :raw) do
     4	    def self.from(raw, date:)
     5	      equity = (raw["equity"] || {}).values.first || {}
     6	      sessions = equity["sessionHours"] || {}
     7	      pre = span(sessions["preMarket"])
     8	      regular = span(sessions["regularMarket"])
     9	      post = span(sessions["postMarket"])
    10	      new(date: date.to_date, open: equity["isOpen"] == true && regular.present?,
    11	          session_opens_at: (pre || regular)&.first, regular_opens_at: regular&.first,
    12	          regular_closes_at: regular&.last, session_closes_at: (post || regular)&.last, raw: raw)
    13	    end
    14	
    15	    def self.span(intervals)
    16	      return nil if intervals.blank?
    17	      starts = intervals.map { |i| Timestamp.parse(i["start"]) }
    18	      ends = intervals.map { |i| Timestamp.parse(i["end"]) }
    19	      [ starts.min, ends.max ]
    20	    end
    21	
    22	    def open? = open
    23	  end
    24	end

