     1	module Sync
     2	  # Orders for one account: the cursor window, a daily WORKING pass, and a re-fetch by id of any working
     3	  # stop that fell out of the list, then working-stop detection on every position. Lineage is written in a
     4	  # second pass by broker id and never nulled once set.
     5	  class OrdersJob < FeedJob
     6	    OVERLAP = 1.day
     7	    PAGE_LIMIT = 3000
     8	    LINEAGE = %i[ parent_order_id replaces_order_id order_proposal_id ].freeze
     9	
    10	    limits_concurrency to: 1, key: ->(account, **) { "orders-#{account.id}" }
    11	
    12	    def perform(account, working_pass: false)
    13	      from, to, gap_from = window_for(:orders, account, overlap: OVERLAP)
    14	      SyncRun.record(:orders, account: account, window_from: from, window_to: to) do |run|
    15	        note_gap(run, gap_from, account)
    16	        listed = client.orders(account.schwab_hash, from: from, to: to)
    17	        truncated = listed.size >= PAGE_LIMIT
    18	        listed += client.orders(account.schwab_hash, from: Time.current - LOOKBACK, to: to, status: "WORKING") if working_pass || !working_pass_today?(account)
    19	        orders = listed.map { |raw| Schwab::Order.from(raw) }.flat_map(&:flatten)
    20	        orders += refetch_missing_stops(account, orders)
    21	
    22	        rows = orders.uniq(&:order_id).map { |order| upsert(account, order, run) }.compact
    23	        link_lineage(account, orders)
    24	        account.positions.includes(:working_stop_order).each(&:assign_working_stop!)
    25	        run.touched(rows.size)
    26	        truncated ? :partial : :succeeded
    27	      end
    28	    end
    29	
    30	    private
    31	      def working_pass_today?(account)
    32	        SyncRun.for(:orders, account).advanced_cursor.where(started_at: Time.current.in_time_zone(MarketDay::ZONE).beginning_of_day..).count > 1
    33	      end
    34	
    35	      def refetch_missing_stops(account, orders)
    36	        seen = orders.map(&:order_id)
    37	        account.positions.includes(:working_stop_order).filter_map(&:working_stop_order).reject { |o| seen.include?(o.broker_order_id) }.filter_map do |stop|
    38	          Schwab::Order.from(client.order(account.schwab_hash, stop.broker_order_id)).flatten
    39	        rescue Schwab::RequestError
    40	          nil
    41	        end.flatten
    42	      end
    43	
    44	      def upsert(account, order, run)
    45	        instrument = order.instrument && Instrument.resolve(order.instrument)
    46	        return run.quarantine(:orders_unresolved, order.instrument.to_h) && nil if order.instrument && instrument.nil?
    47	        row = account.orders.find_or_initialize_by(broker_order_id: order.order_id)
    48	        row.placed_via = :schwab_direct if row.new_record?
    49	        row.update!(instrument: instrument, status: order.status, side: order.side, quantity: order.quantity, filled_quantity: order.filled_quantity,
    50	                    remaining_quantity: order.remaining_quantity, order_type: order.order_type, limit_price: order.price, stop_price: order.stop_price,
    51	                    duration: order.duration, session: order.session, tax_lot_method: order.tax_lot_method, strategy_type: order.strategy_type,
    52	                    entered_at: order.entered_at, closed_at: order.close_time, raw: order.raw)
    53	        row
    54	      rescue Schwab::MappingError => e
    55	        run.quarantine(:orders_unmapped, e.message)
    56	        nil
    57	      end
    58	
    59	      def link_lineage(account, orders)
    60	        by_broker_id = account.orders.where(broker_order_id: orders.map(&:order_id)).index_by(&:broker_order_id)
    61	        orders.each do |order|
    62	          row = by_broker_id[order.order_id] or next
    63	          parent = order.parent_order_id && by_broker_id[order.parent_order_id]
    64	          replaced = order.replaces_order_id && by_broker_id[order.replaces_order_id]
    65	          row.update!(parent_order: parent) if parent && row.parent_order_id.nil?
    66	          row.update!(replaces_order: replaced) if replaced && row.replaces_order_id.nil?
    67	        end
    68	      end
    69	  end
    70	end

