    99	      def token_request(form, idempotent:)
   100	        request = Net::HTTP::Post.new(URI("#{OAUTH}/token"))
   101	        request.basic_auth(@app_key, @app_secret)
   102	        request["Accept"] = "application/json"
   103	        request.set_form_data(form)
