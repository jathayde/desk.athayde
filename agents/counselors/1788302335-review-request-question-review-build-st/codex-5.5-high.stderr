     1	# One row per feed run. Wraps the work so token loss, Schwab failures, and quarantined records all
     2	# land as a status, never as an unhandled exception in the queue.
     3	class SyncRun < ApplicationRecord
     4	  belongs_to :account, optional: true
     5	
     6	  enum :feed, {
     7	    accounts: "accounts", positions: "positions", orders: "orders", activities: "activities",
     8	    market_hours: "market_hours", memory_repo: "memory_repo", snapshots: "snapshots"
     9	  }, prefix: true
    10	  enum :status, { running: "running", succeeded: "succeeded", partial: "partial", failed: "failed", skipped_token: "skipped_token" }
    11	
    12	  scope :recent_first, -> { order(started_at: :desc) }
    13	  scope :for, ->(feed, account) { where(feed: feed, account: account) }
    14	  scope :advanced_cursor, -> { where(status: %w[ succeeded partial ]) }
    15	
    16	  def self.record(feed, account: nil, window_from: nil, window_to: nil)
    17	    run = create!(feed: feed, account: account, status: :running, started_at: Time.current, window_from: window_from, window_to: window_to)
    18	    outcome = yield run
    19	    run.finish!(outcome == :partial || run.unmapped_values.any? ? :partial : :succeeded)
    20	  rescue Schwab::NoUsableToken, Schwab::AuthError => e
    21	    run.finish!(:skipped_token, error: e.message)
    22	  rescue Schwab::Error => e
    23	    run.finish!(:failed, error: e.message)
    24	  end
    25	
    26	  def self.last_window_to(feed, account) = self.for(feed, account).advanced_cursor.maximum(:window_to)
    27	  def self.last_started_at(feed, account) = self.for(feed, account).maximum(:started_at)
    28	  def self.running?(feed, account) = self.for(feed, account).running.exists?
    29	
    30	  # Due when nothing is running and the last start is older than the interval, with a minute of slack for cron drift.
    31	  def self.due?(feed, account, every:)
    32	    return false if running?(feed, account)
    33	    last = last_started_at(feed, account)
    34	    last.nil? || last <= (every - 1.minute).ago
    35	  end
    36	
    37	  def finish!(status, error: nil)
    38	    update!(status: status, finished_at: Time.current, error: error&.truncate(1000))
    39	    self
    40	  end
    41	
    42	  def touched(count) = update!(records_touched: records_touched.to_i + count)
    43	
    44	  def quarantine(key, detail)
    45	    unmapped_values[key.to_s] = Array(unmapped_values[key.to_s]) << detail
    46	    save!
    47	  end
    48	end

