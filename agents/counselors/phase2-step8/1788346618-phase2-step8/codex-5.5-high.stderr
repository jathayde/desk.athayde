    11	  def self.register!(user:, platform:, token:, app_version: nil, attempt: 1)
    12	    transaction do
    13	      device = find_or_initialize_by(token: token)
    14	      reason = device.new_record? ? "registered" : ("reassigned" if device.user_id != user.id)
