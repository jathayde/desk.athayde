    43	      day = date.in_time_zone(MarketDay::ZONE).all_day
    44	      OrderProposal.includes(:instrument).where(decided_at: day).or(OrderProposal.where(status: %w[ filled cancelled ], updated_at: day)).order(:id).to_a
    45	    end
    46	  end
    47	  def stop_suggestions = @stop_suggestions ||= (account ? account.positions.suggesting_a_stop.includes(:working_stop_order).select(&:stop_suggestion) : [])
    48	
    49	  # Held and delisted: an instrument the desk no longer holds is nobody's business in a brief.
    50	  def delisted_symbols
    51	    @delisted_symbols ||= account ? desk.rows.filter_map { |r| r.position.instrument.symbol if r.protection == :delisted } : []
    52	  end
    53	
    54	  # The same numbers the get_setup_stats tool returns, serialized the same way (decimal strings, never BigDecimal#to_s).
    55	  def setup_stats = @setup_stats ||= Agent.serialize(Setup.agent_stats).deep_symbolize_keys
