     1	# One row, enforced by a check constraint on id = 1. Holds the global flags the PRD calls out:
     2	# shadow mode (on by default), the manual halt, and why sync is paused.
     3	class SystemSettings < ApplicationRecord
     4	  # Two halts (docs/phase-2-plan.md §0.3): the kill switch stops everything; a rule halt (daily loss, drawdown)
     5	  # blocks new entries only, so exits and tighten-only stop adjustments stay available. Shadow mode is not a
     6	  # gate: it is the branch between "would have submitted" and a real call.
     7	  LIVE_CONFIRMATION, SHADOW_CONFIRMATION = "go live", "shadow"
     8	
     9	  def halted? = manual_halt? || rule_halted?
    10	  def entries_allowed? = !halted?
    11	  def exits_allowed? = !manual_halt?
    12	  def rule_halted? = rule_halt_tripped_at.present? && (rule_halt_resets_at.nil? || rule_halt_resets_at > Time.current)
    13	
    14	  # Under the row lock, since two evaluators can trip at once. A second rule tripping during a halt extends
    15	  # it to the later reset and records the rule; a lapsed halt is cleared with its own audit row by the tick.
    16	  def trip_rule_halt!(rule:, reason:, resets_at:)
    17	    with_lock do
    18	      if rule_halted?
    19	        # nil means until cleared by hand, later than any time; only a strictly later reset changes anything,
    20	        # so a rule re-evaluated during its own halt writes nothing.
    21	        indefinite_already = rule_halt_resets_at.nil?
    22	        extends_the_halt = !indefinite_already && (resets_at.nil? || resets_at > rule_halt_resets_at)
    23	        if extends_the_halt
    24	          update!(rule_halt_rule: rule, rule_halt_reason: reason, rule_halt_resets_at: resets_at)
    25	          AuditEvent.log("rule_halt_tripped", actor: :system, reason: reason, data: { rule: rule, resets_at: resets_at, extended: true })
    26	          AlertMailer.halt_tripped(rule: rule, reason: reason, resets_at: resets_at).deliver_later
    27	        end
    28	      else
    29	        update!(rule_halt_rule: rule, rule_halt_reason: reason, rule_halt_tripped_at: Time.current, rule_halt_resets_at: resets_at)
    30	        AuditEvent.log("rule_halt_tripped", actor: :system, reason: reason, data: { rule: rule, resets_at: resets_at })
    31	        AlertMailer.halt_tripped(rule: rule, reason: reason, resets_at: resets_at).deliver_later
    32	      end
    33	    end
    34	    self
    35	  end
    36	
    37	  def clear_rule_halt!(user: nil, reason: nil)
    38	    with_lock do
    39	      next unless rule_halt_tripped_at
    40	      AuditEvent.log("rule_halt_cleared", actor: user ? :human : :system, user: user, reason: reason, data: { rule: rule_halt_rule })
    41	      update!(rule_halt_rule: nil, rule_halt_reason: nil, rule_halt_tripped_at: nil, rule_halt_resets_at: nil)
    42	    end
    43	    self
    44	  end
    45	
    46	  class Unconfirmed < StandardError; end
    47	
    48	  # Shadow mode off means the next approve reaches Schwab; on is the same gesture in reverse. Audited both ways
    49	  # with the shadow evidence that justified it. The typed word is checked under the row lock, so two "go live"
    50	  # posts crossing cannot have the second one flip the desk straight back to shadow.
    51	  def toggle_shadow_mode!(user:, reason:, confirmation:)
    52	    with_lock do
    53	      raise Unconfirmed, "Type #{confirmation_word} to confirm." unless confirmation.to_s.strip.casecmp?(confirmation_word)
    54	      status = SystemStatus.new
