    57	  def stamp(time) = time ? I18n.l(time, format: :connection) : "never"
    58	  def percent(ratio) = ratio ? "#{(BigDecimal(ratio.to_s) * 100).round(1).to_s('F')}%" : "n/a"
    59	
    60	  # Rendered once per run: the same bytes on every turn is what makes the prompt cache hit.
    61	  def system_prompt = @system_prompt ||= render("system")
    62	  def user_prompt = @user_prompt ||= render(kind.to_s)
