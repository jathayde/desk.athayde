    67	
    68	  def self.instance = find_or_create_by!(id: 1)
    69	
    70	  # The two halves of the token pause, under the same row lock so a re-auth landing mid-tick cannot be
    71	  # marked paused: pause while the token is unusable (one audit per episode) and resume on a new token.
    72	  def self.pause_for_token!
