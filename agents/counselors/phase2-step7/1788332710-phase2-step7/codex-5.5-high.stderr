   102	    near = create(:instrument, symbol: "NEAR"); far = create(:instrument, symbol: "FAR"); bare = create(:instrument, symbol: "BARE")
   103	    create(:position, account: account, instrument: far, quantity: 40, last_price: 60, working_stop_order: create(:order, :working_stop, account: account, instrument: far, stop_price: 48))
   104	    create(:position, account: account, instrument: near, quantity: 40, last_price: 50, working_stop_order: create(:order, :working_stop, account: account, instrument: near, stop_price: 48.9), synced_at: 5.hours.ago)
   105	    create(:position, account: account, instrument: bare, quantity: 10, last_price: 20)
   106	    trade = create(:trade, account: account, instrument: near)
