   112	  # Stale: older than twice the cadence the tick would use right now plus its minute of slack, or any age once sync is paused.
   113	  def stale?(time, feed)
   114	    return true if time.nil? || sync_paused_reason.present?
   115	    time < Time.current - (sync_interval(feed) * STALE_MULTIPLIER + 1.minute)
