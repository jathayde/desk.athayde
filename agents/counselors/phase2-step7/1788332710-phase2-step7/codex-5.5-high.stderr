   110	    expect(d.rows.map(&:stale)).to eq([ false, true, false ])
   111	    expect(d.rows.find { |r| r.position.instrument == near }.trade).to eq(trade)
   112	    expect(d.excluded_by_reason).to eq(unprotected: 1)
   113	    expect(d.open_risk).to eq(40 * BigDecimal("1.1") + 40 * 12)
   114	  end
