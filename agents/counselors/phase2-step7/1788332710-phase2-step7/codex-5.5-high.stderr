     1	# What the model is told before it asks anything: the desk's freshness, the token, the calendar, the memory
     2	# files, and every reason the run is already degraded. Computed once per run from the database alone.
     3	class Agent::Context
     4	  def initialize(kind:, date:, memory: Memory::Repo.configured)
     5	    @kind, @date, @memory = kind, date, memory
     6	    @desk = Desk.new
     7	  end
     8	
     9	  attr_reader :kind, :date, :memory, :desk
    10	
    11	  def account = desk.account
    12	  def market_day = @market_day ||= MarketDay.find_by(date: date)
    13	  def token_status = desk.token_status
    14	
    15	  def as_of
    16	    @as_of ||= {
    17	      positions: account&.last_sync(:positions), orders: account&.last_sync(:orders), activities: account&.last_sync(:activities),
    18	      calendar: market_day&.source, memory: memory.last_modified_at, memory_sha: memory.head_sha
    19	    }
    20	  end
    21	
    22	  # Reasons known before the first call; the run adds what the tools report.
    23	  def degraded_reasons
    24	    @degraded_reasons ||= [].tap do |reasons|
    25	      reasons << "Schwab token #{token_status}: nothing has synced since #{desk.sync_paused_since&.in_time_zone(MarketDay::ZONE)&.strftime('%a %-l:%M %p') || 'the token died'}" unless SchwabToken.usable?
    26	      reasons << "calendar unverified (Schwab hours unavailable); today may be a holiday" if market_day&.fallback?
    27	      reasons << "positions are stale (last sync #{stamp(as_of[:positions])})" if desk.balance_stale?
    28	      reasons << "orders are stale (last sync #{stamp(as_of[:orders])}); stop and protection states may be wrong" if account && desk.stale?(as_of[:orders], :orders)
    29	      reasons << "activities are stale (last sync #{stamp(as_of[:activities])}); fills and journal rows may be missing" if account && desk.stale?(as_of[:activities], :activities)
    30	      reasons << "no trading account is set up yet" if account.nil?
    31	      reasons << "memory repo missing at #{memory.path || 'unset MEMORY_REPO_PATH'}" unless memory.present?
    32	      reasons << "memory repo has none of its files at #{memory.path}" if memory.empty?
    33	      reasons << "memory files unreadable: #{memory.unreadable.join(', ')}" if memory.unreadable.any?
    34	      reasons << "memory files truncated: #{memory.truncated.join(', ')}" if memory.truncated.any?
    35	    end
    36	  end
    37	
    38	  def watchlist = @watchlist ||= WatchlistItem.current.to_a
    39	
    40	  # The day's proposal traffic for the recap: decided today, or reached a broker outcome today.
    41	  def todays_proposals
