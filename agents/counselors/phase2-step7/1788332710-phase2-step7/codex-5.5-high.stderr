     1	# Everything that went wrong in a fixed window ending now: failed feeds, failed or capped agent runs,
     2	# briefs that never left, jobs the queue gave up on, and submissions that did not go through, plus any
     3	# submission still unresolved, which is standing state and not windowed. Token-skipped runs are the nag's business, not
     4	# this one's, and stuck runs are swept to failed before the digest reads.
     5	class FailureDigest
     6	  WINDOW = 24.hours
     7	
     8	  def initialize(now: Time.current)
     9	    @since = now - WINDOW
    10	    @now = now
    11	  end
    12	
    13	  attr_reader :since, :now
    14	
    15	  def sync_failures = @sync_failures ||= SyncRun.where(status: %w[ failed partial ]).where(finished_at: window).includes(:account).recent_first.to_a
    16	  def agent_failures = @agent_failures ||= AgentRun.where(status: %w[ failed capped ]).where(finished_at: window).recent_first.to_a
    17	  def undelivered = @undelivered ||= AgentRun.unemailed.where(finished_at: window).recent_first.to_a
    18	  def failed_jobs = @failed_jobs ||= SolidQueue::FailedExecution.where(created_at: window).includes(:job).order(created_at: :desc).to_a
    19	  def failed_attempts = @failed_attempts ||= SubmissionAttempt.where(outcome: %w[ failed not_placed ]).where(updated_at: window).includes(order_proposal: :instrument).order(updated_at: :desc).to_a
    20	  def unresolved_proposals = @unresolved_proposals ||= OrderProposal.submission_unknown.includes(:instrument).order(:id).to_a
    21	
    22	  def sync_by_feed = sync_failures.group_by { |run| [ run.account&.label, run.feed ].compact.join(" · ") }
    23	  def jobs_by_class = failed_jobs.group_by { |failure| failure.job.class_name }
    24	
    25	  def empty? = sync_failures.none? && agent_failures.none? && undelivered.none? && failed_jobs.none? && failed_attempts.none? && unresolved_proposals.none?
    26	
    27	  private
    28	    def window = since..now
    29	end

