   130	    # Unresolved: nothing has succeeded on that feed since it failed.
   131	    def unresolved?(run)
   132	      succeeded_at = account.last_sync(run.feed)
   133	      succeeded_at.nil? || run.started_at > succeeded_at
   134	    end
   135	end

