     1	# One proposed order and its whole life (docs/phase-2-state-table.md). Sizing and the collar are frozen at
     2	# creation; the approve gesture is the submission; nothing leaves the submission path by hand. Every
     3	# transition locks the row, re-reads the state, and writes its audit row in the same transaction.
     4	class OrderProposal < ApplicationRecord
     5	  class IllegalTransition < StandardError; end
     6	
     7	  belongs_to :account
     8	  belongs_to :instrument
     9	  belongs_to :target_order, class_name: "Order", optional: true
    10	  belongs_to :user, optional: true
    11	  belongs_to :decided_by, class_name: "User", optional: true
    12	  belongs_to :setup, optional: true
    13	  belongs_to :parent_proposal, class_name: "OrderProposal", optional: true
    14	  has_many :orders, dependent: :restrict_with_exception
    15	  has_many :submission_attempts, dependent: :restrict_with_exception
    16	  has_one :trade, dependent: :restrict_with_exception
    17	
    18	  enum :kind, { entry: "entry", exit: "exit", stop_adjustment: "stop_adjustment" }, prefix: true
    19	  enum :origin, { agent: "agent", human: "human" }
    20	  enum :side, { buy: Schwab::Order::BUY, sell: Schwab::Order::SELL }
    21	  enum :child_action, { cancel_stop: "cancel_stop", replace_stop: "replace_stop" }, prefix: true
    22	  enum :status, {
    23	    proposed: "proposed", validated: "validated", rejected_by_rules: "rejected_by_rules", rejected: "rejected", expired: "expired",
    24	    submitting: "submitting", submitted: "submitted", submission_unknown: "submission_unknown", submission_failed: "submission_failed",
    25	    filled: "filled", cancelled: "cancelled"
    26	  }
    27	
    28	  TERMINAL = %w[ rejected_by_rules rejected expired submission_failed filled cancelled ].freeze
    29	  STALE_SUBMITTING = 5.minutes # past two writes at their timeouts, a refresh, and slack: the worker died
    30	  LOOK_GAP = 15.minutes # an unknown row nobody has looked at for this long gets a reconcile enqueued again
    31	  APPROVABLE = %w[ validated ].freeze
    32	  UNRESOLVED = %w[ submitting submission_unknown ].freeze # locks the instrument for every other proposal
    33	  BROKER_OUTCOMES = %w[ filled cancelled ].freeze
    34	
    35	  scope :unresolved, -> { where(status: UNRESOLVED) }
    36	  scope :queue, -> { where(status: %w[ proposed validated submission_unknown ]).order(created_at: :desc) }
    37	  scope :expiring, -> { where(status: %w[ proposed validated ]).where(expires_at: ..Time.current) }
    38	  # A shadow approval the operator still has to place by hand: the phase's central concept, named once.
    39	  scope :awaiting_hand_placement, -> { submitted.where(shadow: true, broker_order_id: nil) }
    40	  scope :stale_submitting, ->(older_than) { submitting.where(updated_at: ..older_than.ago) }
    41	
    42	  validates :quantity, numericality: { greater_than: 0 }, allow_nil: true
    43	  validates :quantity, presence: true, unless: :kind_entry? # an entry may be unsized (and blocked); a sell of nothing is not a proposal
    44	
    45	  def self.instrument_locked?(instrument) = unresolved.where(instrument: instrument).exists?
    46	
    47	  # A submitting row older than the call's timeouts is a worker that died mid-submission. Shadow rows finish as
    48	  # what they were going to be; real rows become unknown and the reconcile job looks. Never back to validated.
    49	  def self.sweep_submitting!
