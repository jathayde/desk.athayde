    91	    create(:snapshot, account: account, as_of: MarketDay.today, equity: 11_500) # today's exists but is not the prior
    92	    flow(account, "deposit", 1_000, on: MarketDay.today)
    93	    d = Desk.new
    94	    expect(d.prior_snapshot.as_of).to eq(MarketDay.today - 3)
