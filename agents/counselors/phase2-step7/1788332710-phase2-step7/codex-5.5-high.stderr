    37	        <li class="pos <%= { protected: "protected", delisted: "delisted" }.fetch(row.protection, "at-risk") %>">
    38	          <div class="top">
    39	            <span><%= row.trade ? link_to(position.instrument.symbol, trade_path(row.trade)) : position.instrument.symbol %> · <%= quantity(position.quantity) %></span>
    40	            <span class="primary"><% if position.distance_to_stop && !position.delisted? %><%= percent(position.distance_to_stop) %> to stop<% else %><%= protection_label(row.protection) %><% end %></span>
    41	          </div>
    42	          <div class="sub">
    43	            <span>in @ <%= money(position.average_price) %><% if position.unprotected? && position.distance_to_stop %> · <em class="warn"><%= protection_label(row.protection) %></em><% end %></span>
    44	            <span><%= signed_money(position.unrealized_pnl) %> · <%= as_of(row.as_of, stale: row.stale) %></span>
    45	          </div>
    46	        </li>
    47	      <% end %>
    48	    </ul>
    49	  <% end %>
    50	</section>

