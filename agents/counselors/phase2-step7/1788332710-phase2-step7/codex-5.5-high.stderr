    57	      end
    58	    end
    59	  end
    60	
    61	  # An unknown row the reconcile job has not looked at in a while (its job lost, its retries spent) is looked at again.
    62	  def self.redrive_unknown!
    63	    submission_unknown.joins(:submission_attempts).merge(SubmissionAttempt.unknown.unlooked_at_since(LOOK_GAP.ago)).distinct.find_each do |proposal|
    64	      Submission::ReconcileJob.perform_later(proposal)
    65	    end
    66	  end
    67	
    68	  def terminal? = TERMINAL.include?(status)
    69	  def approvable? = APPROVABLE.include?(status)
    70	  # Everything the approver must acknowledge: warnings and the rules that could not be checked.
    71	  def warnings = guardrail_results.select { |_, r| r["outcome"].in?(%w[ caution unavailable ]) }.keys
    72	  def live_attempt = submission_attempts.live.first
    73	  def awaiting_hand_placement? = submitted? && shadow? && broker_order_id.nil?
    74	  def latest_attempt = submission_attempts.order(:id).last
    75	  # What the operator reads on a failed or unresolved submission: Schwab's answer, or the orders that could each be it.
    76	  def failure_reason = submission_failed? ? latest_attempt&.error : nil
    77	  def ambiguous_orders = submission_unknown? ? Array(latest_attempt&.ambiguous_order_ids) : []
    78	  def needs_override? = guardrail_results.any? { |_, r| r["outcome"] == "caution" && r["overridable"] }
    79	
    80	  # The approve gesture: transaction one, then the shadow or real branch (Submission::Submit).
    81	  def approve_and_submit!(user:, acknowledged: [], override_reason: nil) = Submission::Submit.call(self, user: user, acknowledged: acknowledged, override_reason: override_reason)
    82	
    83	  # ---- transitions, each a row of the table, each one audit row, each under the row lock ----------
    84	
    85	  # The evaluation's writer: stores the report and engages any halt its rules asked for, in the same transaction.
    86	  def evaluate!(report)
    87	    transaction do
    88	      Guardrails.engage_halts!(report)
    89	      transition!(from: %w[ proposed ], to: report.blocked? ? :rejected_by_rules : :validated, event: "proposal_evaluated",
    90	                  attributes: { guardrail_results: report.to_h, evaluated_at: Time.current }, data: { blocked: report.blocked?, warnings: report.warnings })
    91	    end
    92	  end
    93	
    94	  def reject!(user:, reason:)
    95	    raise ArgumentError, "a rejection needs a reason" if reason.blank?
    96	    transition!(from: APPROVABLE, to: :rejected, event: "proposal_rejected", user: user, reason: reason,
    97	                attributes: { decided_at: Time.current, decided_by: user, rejection_reason: reason })
    98	  end
    99	
   100	  def expire!
   101	    transition!(from: %w[ proposed validated ], to: :expired, event: "proposal_expired")
   102	  end
   103	
   104	  # Transaction one of the submission: the approval, the state, and the attempt row commit together, or not at all.
   105	  # One live submission per instrument: refused here in words, and by the database's partial unique index.
   106	  def start_submission!(user:, acknowledged:, override_reason:, payload:, shadow:)
   107	    transaction do
   108	      raise IllegalTransition, "#{instrument.symbol} has a submission still unresolved" if self.class.unresolved.where(instrument_id: instrument_id).where.not(id: id).exists?
   109	      transition!(from: APPROVABLE, to: :submitting, event: "proposal_approved", user: user, reason: override_reason,
   110	                  attributes: { decided_at: Time.current, decided_by: user, acknowledged_warnings: acknowledged, override_reason: override_reason, shadow: shadow },
   111	                  data: { acknowledged: acknowledged, shadow: shadow })
   112	      submission_attempts.create!(attempted_at: Time.current, payload: payload, outcome: :pending).tap do
   113	        AuditEvent.log("proposal_submitting", actor: :human, user: user, subject: self)
   114	      end
   115	    end
   116	  end
   117	
   118	  # Transaction two: what Schwab, or shadow mode, answered. The state moves first; the attempt follows.
   119	  def record_shadow!(attempt)
   120	    outcome!(attempt, from: %w[ submitting ], to: :submitted, event: "would_have_submitted", attributes: { submitted_at: Time.current }, data: { payload: attempt.payload }) do
   121	      attempt.update!(outcome: :would_have_submitted)
   122	    end
   123	  end
   124	
   125	  # A late answer with the id is authoritative, even after the sweep called the row unknown.
   126	  def record_submitted!(attempt, broker_order_id:)
   127	    outcome!(attempt, from: %w[ submitting submission_unknown ], to: :submitted, event: "proposal_submitted",
   128	             attributes: { submitted_at: Time.current, broker_order_id: broker_order_id }, data: { broker_order_id: broker_order_id }) do
   129	      attempt.update!(outcome: :submitted, broker_order_id: broker_order_id)
   130	    end
   131	  end
   132	
   133	  # Unknown is the one outcome that mails at once: the operator must not touch the instrument until it is resolved.
   134	  def record_unknown!(attempt, error:)
   135	    outcome!(attempt, from: %w[ submitting ], to: :submission_unknown, event: "submission_unknown", reason: error) do
   136	      attempt.update!(outcome: :unknown, response: { "error" => error })
   137	    end
   138	    AlertMailer.submission_unknown(self).deliver_later
   139	    self
   140	  end
   141	
   142	  # Schwab refused the payload (a 4xx): the operator reads the error and may re-propose.
   143	  def record_rejected!(attempt, error:)
   144	    outcome!(attempt, from: %w[ submitting ], to: :submission_failed, event: "submission_failed", reason: error) do
   145	      attempt.update!(outcome: :failed, response: { "error" => error })
   146	    end
   147	  end
   148	
   149	  # The reconcile job confirmed twice, ten minutes apart, that nothing was placed.
   150	  def record_not_placed!(attempt)
   151	    outcome!(attempt, from: %w[ submission_unknown ], to: :submission_failed, event: "submission_failed", reason: "confirmed not placed") do
   152	      attempt.update!(outcome: :not_placed)
   153	    end
   154	  end
   155	
   156	  # The reconcile job found the order an unknown submission placed.
   157	  def record_reconciled!(attempt, order:)
   158	    outcome!(attempt, from: %w[ submission_unknown ], to: :submitted, event: "submission_reconciled",
   159	             attributes: { submitted_at: Time.current, broker_order_id: order.broker_order_id }, data: { broker_order_id: order.broker_order_id }) do
   160	      attempt.update!(outcome: :submitted, broker_order_id: order.broker_order_id, reconciled_order: order, reconciled_at: Time.current)
   161	    end
   162	  end
   163	
   164	  # A shadowed submission matched to the order the operator placed by hand: no state change, one audit row.
   165	  def link_shadow_order!(attempt, order:)
   166	    raise IllegalTransition, "#{status} is not a shadowed submission" unless submitted? && shadow? && attempt.would_have_submitted?
   167	    transaction do
   168	      attempt.update!(reconciled_order: order, reconciled_at: Time.current, broker_order_id: order.broker_order_id)
   169	      update!(broker_order_id: order.broker_order_id)
   170	      AuditEvent.log("submission_reconciled", actor: :system, subject: self, data: { broker_order_id: order.broker_order_id, shadow: true })
   171	    end
   172	    self
   173	  end
   174	
   175	  # Written only by the orders sync, and only to the two states the broker can put an order in.
   176	  def record_broker_outcome!(status)
   177	    status = status.to_s
   178	    raise ArgumentError, "#{status} is not a broker outcome" unless BROKER_OUTCOMES.include?(status)
   179	    transition!(from: %w[ submitted ], to: status, event: "proposal_#{status}")
   180	    AlertMailer.fill_or_cancel(self).deliver_later
   181	    self
   182	  end
   183	
   184	  private
   185	    def outcome!(attempt, from:, to:, event:, attributes: {}, reason: nil, data: {})
   186	      raise ArgumentError, "attempt #{attempt.id} belongs to another proposal" unless attempt.order_proposal_id == id
   187	      transaction do
   188	        transition!(from: from, to: to, event: event, attributes: attributes, reason: reason, data: data)
   189	        yield
   190	      end
   191	      self
   192	    end
   193	
   194	    # Lock, re-read, refuse from the wrong state, write, audit: one transaction, never a stale instance's guess.
   195	    def transition!(from:, to:, event:, attributes: {}, user: nil, reason: nil, data: {})
   196	      with_lock do
   197	        raise IllegalTransition, "proposal #{id} cannot go from #{status} to #{to}" unless from.include?(status)
   198	        update!(attributes.merge(status: to))
   199	        AuditEvent.log(event, actor: user ? :human : :system, user: user, subject: self, reason: reason, data: data)
   200	      end
   201	      self
   202	    end
   203	end

