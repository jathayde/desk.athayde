     1	module Schwab
     2	  # One transaction activity. The security transfer item gives instrument, quantity, and price;
     3	  # fee items are summed. Sign conventions are SCHWAB_SHAPE_UNVERIFIED; side comes from netAmount.
     4	  Activity = Data.define(:activity_id, :type, :activity_type, :status, :sub_account, :description, :order_id,
     5	                         :net_amount, :trade_date, :settlement_date, :executed_at, :instrument, :quantity, :price,
     6	                         :position_effect, :commission, :fees, :raw) do
     7	    def self.from(raw)
     8	      activity_id = raw["activityId"] or raise MappingError, "activityId missing"
     9	      items = Array(raw["transferItems"])
    10	      security = items.find { |i| i["feeType"].blank? && !InstrumentRef.from(i["instrument"]).currency? }
    11	      fee_items = items.select { |i| i["feeType"].present? }
    12	      executed_at = Timestamp.parse(raw["time"]) || Timestamp.parse(raw["tradeDate"])
    13	      raise MappingError, "activity #{activity_id} has no time or tradeDate" unless executed_at
    14	
    15	      new(activity_id: activity_id.to_s, type: raw["type"], activity_type: raw["activityType"], status: raw["status"],
    16	          sub_account: raw["subAccount"], description: raw["description"], order_id: raw["orderId"]&.to_s,
    17	          net_amount: Decimal.parse(raw["netAmount"]),
    18	          trade_date: Timestamp.parse_date(raw["tradeDate"]), settlement_date: Timestamp.parse_date(raw["settlementDate"]),
    19	          executed_at: executed_at,
    20	          instrument: security && InstrumentRef.from(security["instrument"]),
    21	          quantity: security && Decimal.parse(security["amount"])&.abs,
    22	          price: security && Decimal.parse(security["price"]),
    23	          position_effect: security && security["positionEffect"],
    24	          commission: fee_items.select { |i| i["feeType"] == "COMMISSION" }.sum { |i| Decimal.parse(i["amount"])&.abs || 0 },
    25	          fees: fee_items.reject { |i| i["feeType"] == "COMMISSION" }.sum { |i| Decimal.parse(i["amount"])&.abs || 0 },
    26	          raw: raw)
    27	    end
    28	
    29	    def trade? = type == "TRADE"
    30	
    31	    def side
    32	      return nil unless trade? && net_amount
    33	      net_amount.negative? ? "BUY" : "SELL"
    34	    end
    35	  end
    36	end

