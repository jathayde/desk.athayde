require "rails_helper"

RSpec.describe "Schwab mappers" do
  describe Schwab::AccountSummary do
    subject(:summary) { described_class.from(Schwab::Scrub.json(schwab_fixture("account"))) }

    it "maps positions, tolerating a missing CUSIP on a cash equivalent" do
      expect(summary.account_type).to eq("CASH")
      xyz, _def, sweep = summary.positions
      expect(xyz.instrument).to have_attributes(symbol: "XYZ", cusip: "037833100", instrument_id: 1001, asset_type: "EQUITY")
      expect(xyz.quantity).to eq(40)
      expect(xyz.average_price).to eq(BigDecimal("51.18"))
      expect(sweep.instrument.cusip).to be_nil
      expect(sweep.quantity).to eq(BigDecimal("2110.5"))
    end

    it "maps balances and derives settled cash conservatively" do
      b = summary.balances
      expect(b.equity).to eq(BigDecimal("6508.55"))
      expect(b.settled_cash_by_subtraction).to eq(BigDecimal("2110"))
      expect(b.cash_available_for_withdrawal).to eq(BigDecimal("2110"))
      expect(b.settled_cash).to eq(BigDecimal("2110"))
      expect(b.buying_power).to be_nil
    end

    it "prefers the smaller settled-cash reading and survives a missing field" do
      b = Schwab::Balances.from("cashAvailableForTrading" => 1000, "unsettledCash" => 300, "cashAvailableForWithdrawal" => 650)
      expect(b.settled_cash).to eq(650)
      expect(Schwab::Balances.from("cashAvailableForWithdrawal" => 5).settled_cash).to eq(5)
      expect(Schwab::Balances.from({}).settled_cash).to be_nil
    end

    it "raises a MappingError when the account wrapper is missing" do
      expect { described_class.from({}) }.to raise_error(Schwab::MappingError)
    end
  end

  describe Schwab::Order do
    let(:orders) { schwab_fixture("orders").map { |o| described_class.from(o) } }

    it "flattens nested bracket children and replacements with lineage" do
      flat = orders.flat_map(&:flatten)
      expect(flat.map(&:order_id)).to eq(%w[ 1004055538123 1004055538124 1004055538200 1004055538201 ])
      child = flat[1]
      expect(child).to have_attributes(parent_order_id: "1004055538123", replaces_order_id: nil, order_type: "STOP", stop_price: BigDecimal("48.9"), side: "SELL")
      expect(child).to be_working.and be_stop
      replacement = flat[3]
      expect(replacement).to have_attributes(replaces_order_id: "1004055538200", parent_order_id: nil, stop_price: BigDecimal("86.5"))
    end

    it "maps the parent's fields and times" do
      parent = orders.first
      expect(parent).to have_attributes(status: "FILLED", side: "BUY", quantity: 40, filled_quantity: 40, price: BigDecimal("51.2"),
                                        tax_lot_method: "FIFO", duration: "GOOD_TILL_CANCEL", session: "NORMAL")
      expect(parent.entered_at).to eq(Time.utc(2026, 8, 14, 13, 31, 2))
      expect(parent.instrument.cusip).to eq("037833100")
    end

    it "passes unknown enum values through untouched" do
      order = described_class.from({ "orderId" => 1, "status" => "SOMETHING_NEW", "orderType" => "WEIRD" })
      expect(order.status).to eq("SOMETHING_NEW")
      expect(order).not_to be_working
    end
  end

  describe Schwab::Activity do
    let(:activities) { Schwab::Scrub.json(schwab_fixture("transactions")).map { |a| described_class.from(a) } }

    it "maps a fill: security item, fee items summed, side from net amount" do
      fill = activities[0]
      expect(fill).to have_attributes(activity_id: "95012345678", type: "TRADE", order_id: "1004055538123", side: "BUY", quantity: 40,
                                      price: BigDecimal("51.18"), position_effect: "OPENING", net_amount: BigDecimal("-2047.25"))
      expect(fill.fees).to eq(BigDecimal("0.05"))
      expect(fill.commission).to eq(0)
      expect(fill.instrument.cusip).to eq("037833100")
      expect(fill.trade_date).to eq(Date.new(2026, 8, 14))
      expect(fill.settlement_date).to eq(Date.new(2026, 8, 15))
      expect(fill.executed_at).to eq(Time.utc(2026, 8, 14, 14, 3, 11))
    end

    it "maps a dividend with its instrument and no side" do
      dividend = activities[1]
      expect(dividend).to have_attributes(type: "DIVIDEND_OR_INTEREST", side: nil, net_amount: BigDecimal("9.6"))
      expect(dividend.instrument.symbol).to eq("XYZ")
    end

    it "maps a cash deposit with no instrument" do
      deposit = activities[2]
      expect(deposit.instrument).to be_nil
      expect(deposit.net_amount).to eq(1000)
    end

    it "falls back to tradeDate when time is missing, and keeps a CUSIP-less instrument" do
      sweep = activities[3]
      expect(sweep.executed_at).to eq(Time.utc(2026, 8, 23))
      expect(sweep.instrument).to have_attributes(symbol: "SWVXX", cusip: nil)
    end

    it "raises MappingError without any time" do
      expect { described_class.from({ "activityId" => 1 }) }.to raise_error(Schwab::MappingError)
    end
  end

  describe Schwab::MarketHours do
    it "maps an open day with full session bounds in Eastern time" do
      hours = described_class.from(schwab_fixture("market_hours_open"), date: Date.new(2026, 9, 8))
      expect(hours).to be_open
      expect(hours.session_opens_at).to eq(Time.utc(2026, 9, 8, 11))
      expect(hours.regular_opens_at).to eq(Time.utc(2026, 9, 8, 13, 30))
      expect(hours.regular_closes_at).to eq(Time.utc(2026, 9, 8, 20))
      expect(hours.session_closes_at).to eq(Time.utc(2026, 9, 9, 0))
    end

    it "treats the closed-day shape as closed regardless of the product key" do
      hours = described_class.from(schwab_fixture("market_hours_closed"), date: Date.new(2026, 9, 7))
      expect(hours).not_to be_open
      expect(hours.regular_opens_at).to be_nil
    end
  end

  describe Schwab::Quote do
    it "splits quotes from invalid symbols" do
      quotes, invalid = described_class.batch(schwab_fixture("quotes"))
      expect(invalid).to eq([ "NOPE" ])
      expect(quotes.map(&:symbol)).to eq(%w[ XYZ DEF ])
      expect(quotes.first).to have_attributes(cusip: "037833100", last: BigDecimal("53.0"), net_change: BigDecimal("0.6"))
      expect(quotes.first.quote_time).to eq(Time.utc(2026, 9, 1, 13, 4))
    end
  end

  describe Schwab::PriceHistory do
    it "maps candles with New York dates" do
      history = described_class.from(schwab_fixture("price_history"))
      expect(history.symbol).to eq("XYZ")
      expect(history).not_to be_empty
      expect(history.previous_close).to eq(BigDecimal("52.4"))
      expect(history.candles.map(&:date)).to eq([ Date.new(2026, 8, 31), Date.new(2026, 9, 1) ])
      expect(history.candles.last.close).to eq(BigDecimal("53.0"))
    end
  end
end

