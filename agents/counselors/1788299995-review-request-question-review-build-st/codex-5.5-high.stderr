require "rails_helper"

RSpec.describe Schwab::Error do
  def response(code, body = "")
    Net::HTTPResponse::CODE_TO_OBJ[code.to_s].new("1.1", code.to_s, "x").tap { |r| r.instance_variable_set(:@body, body); r.instance_variable_set(:@read, true) }
  end

  it "maps statuses to classes and keeps the request id" do
    body = '{"errors":[{"id":"abc-123","status":"400","title":"Bad","detail":"startDate too early"}]}'
    expect(described_class.for_response(response(400, body), attempts: 1, idempotent: true)).to be_a(Schwab::RequestError).and have_attributes(request_id: "abc-123", message: /startDate too early/)
    expect(described_class.for_response(response(401), attempts: 1, idempotent: true)).to be_a(Schwab::AuthError)
    expect(described_class.for_response(response(429), attempts: 3, idempotent: true)).to be_a(Schwab::RateLimited).and have_attributes(attempts: 3)
    expect(described_class.for_response(response(503), attempts: 1, idempotent: true)).to be_a(Schwab::ServerError)
    expect(described_class.for_response(response(503), attempts: 1, idempotent: false)).to be_a(Schwab::UnknownOutcome)
  end

  it "scrubs account numbers out of the stored body" do
    error = described_class.for_response(response(400, '{"accountNumber":"12345678"}'), attempts: 1, idempotent: true)
    expect(error.body).not_to include("12345678")
  end
end
require "rails_helper"

RSpec.describe Schwab::Scrub do
  it "drops plaintext account numbers and user blocks anywhere in a body" do
    raw = { "securitiesAccount" => { "accountNumber" => "12345678", "positions" => [ { "accountNumber" => 1 } ] },
            "user" => { "firstName" => "John" }, "orderId" => 5 }
    expect(described_class.json(raw)).to eq("securitiesAccount" => { "accountNumber" => nil, "positions" => [ { "accountNumber" => nil } ] },
                                            "user" => nil, "orderId" => 5)
  end

  it "scrubs JSON text and passes non-JSON through" do
    expect(described_class.body('{"accountNumber":"1","x":2}')).to eq('{"accountNumber":null,"x":2}')
    expect(described_class.body("<html>gateway</html>")).to eq("<html>gateway</html>")
  end

  it "replaces account hashes in paths for logs" do
    expect(described_class.path("/trader/v1/accounts/#{Schwab::FakeClient::ACCOUNT_HASH}/orders")).to eq("/trader/v1/accounts/{hash}/orders")
  end
end
require "rails_helper"

RSpec.describe Schwab::FakeClient do
  subject(:fake) { described_class.instance.reset! }

  it "exposes exactly the real client's public interface" do
    expect(described_class.public_instance_methods(false) - %i[ reset! enqueue close_market_on calls ])
      .to match_array(Schwab::Client.public_instance_methods(false))
  end

  it "serves raw shapes the real mappers accept, already scrubbed" do
    raw = fake.account(described_class::ACCOUNT_HASH)
    expect(raw.dig("securitiesAccount", "accountNumber")).to be_nil
    expect(Schwab::AccountSummary.from(raw).positions.size).to eq(3)
    expect(Schwab::Activity.from(fake.transactions(described_class::ACCOUNT_HASH, from: 1.day.ago).first).side).to eq("BUY")
    expect(fake.account_numbers).to eq([ described_class::ACCOUNT_HASH ])
  end

  it "scripts the next response per method and records calls" do
    fake.enqueue(:orders) { raise Schwab::RateLimited.new(retry_after: 30) }
    expect { fake.orders(described_class::ACCOUNT_HASH, from: 1.day.ago) }.to raise_error(Schwab::RateLimited)
    expect(fake.orders(described_class::ACCOUNT_HASH, from: 1.day.ago)).to be_an(Array)
    expect(fake.calls.map(&:first)).to eq(%i[ orders orders ])
  end

  it "closes markets on weekends and on request" do
    expect(Schwab::MarketHours.from(fake.market_hours(Date.new(2026, 9, 5)), date: Date.new(2026, 9, 5))).not_to be_open
    expect(Schwab::MarketHours.from(fake.market_hours(Date.new(2026, 9, 8)), date: Date.new(2026, 9, 8))).to be_open
    fake.close_market_on(Date.new(2026, 9, 8))
    expect(Schwab::MarketHours.from(fake.market_hours(Date.new(2026, 9, 8)), date: Date.new(2026, 9, 8))).not_to be_open
  end

  it "scripts auth: the fake code exchanges, anything else needs re-auth" do
    expect(fake.exchange_code(described_class::FAKE_CODE)).to include("access_token")
    expect { fake.exchange_code("bogus") }.to raise_error(Schwab::ReauthRequired)
  end

  it "is what Schwab.client returns outside production" do
    expect(Schwab.client).to be(described_class.instance)
  end
end

