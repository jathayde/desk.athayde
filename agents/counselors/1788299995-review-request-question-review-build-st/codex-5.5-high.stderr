     1	module Schwab
     2	  # One request budget shared by every process (Puma and the worker) through the cache store.
     3	  # Exceeding it raises rather than sleeping so a web request never blocks on the worker.
     4	  module RateBudget
     5	    def self.take!(now: ::Time.current, budget: Schwab::RATE_BUDGET_PER_MINUTE)
     6	      key = "schwab:rate:#{now.to_i / 60}"
     7	      Rails.cache.write(key, 0, expires_in: 2.minutes, unless_exist: true)
     8	      count = Rails.cache.increment(key, 1, expires_in: 2.minutes)
     9	      return if count <= budget
    10	      raise RateLimited.new("Local Schwab rate budget spent (#{budget}/min)", retry_after: 60 - now.sec)
    11	    end
    12	  end
    13	end

