module Schwab
  # One transaction activity. The security transfer item gives instrument, quantity, and price;
  # fee items are summed. Sign conventions are SCHWAB_SHAPE_UNVERIFIED; side comes from netAmount.
  Activity = Data.define(:activity_id, :type, :activity_type, :status, :sub_account, :description, :order_id,
                         :net_amount, :trade_date, :settlement_date, :executed_at, :instrument, :quantity, :price,
                         :position_effect, :commission, :fees, :raw) do
    def self.from(raw)
      activity_id = raw["activityId"] or raise MappingError, "activityId missing"
      items = Array(raw["transferItems"])
      security = items.find { |i| i["feeType"].blank? && !InstrumentRef.from(i["instrument"]).currency? }
      fee_items = items.select { |i| i["feeType"].present? }
      executed_at = Timestamp.parse(raw["time"]) || Timestamp.parse(raw["tradeDate"])
      raise MappingError, "activity #{activity_id} has no time or tradeDate" unless executed_at

      new(activity_id: activity_id.to_s, type: raw["type"], activity_type: raw["activityType"], status: raw["status"],
          sub_account: raw["subAccount"], description: raw["description"], order_id: raw["orderId"]&.to_s,
          net_amount: Decimal.parse(raw["netAmount"]),
          trade_date: Timestamp.parse_date(raw["tradeDate"]), settlement_date: Timestamp.parse_date(raw["settlementDate"]),
          executed_at: executed_at,
          instrument: security && InstrumentRef.from(security["instrument"]),
          quantity: security && Decimal.parse(security["amount"])&.abs,
          price: security && Decimal.parse(security["price"]),
          position_effect: security && security["positionEffect"],
          commission: fee_items.select { |i| i["feeType"] == "COMMISSION" }.sum { |i| Decimal.parse(i["amount"])&.abs || 0 },
          fees: fee_items.reject { |i| i["feeType"] == "COMMISSION" }.sum { |i| Decimal.parse(i["amount"])&.abs || 0 },
          raw: raw)
    end

    def trade? = type == "TRADE"

    def side
      return nil unless trade? && net_amount
      net_amount.negative? ? "BUY" : "SELL"
    end
  end
end

