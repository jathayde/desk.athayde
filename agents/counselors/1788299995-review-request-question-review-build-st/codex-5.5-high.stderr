require "rails_helper"

# The kickoff's isolation rule: every Schwab shape assumption lives in the adapter layer.
RSpec.describe "Schwab shape isolation" do
  SCHWAB_FIELD_NAMES = %w[ hashValue securitiesAccount longQuantity orderLegCollection childOrderStrategies replacingOrderCollection
                           transferItems sessionHours activityId enteredTime cashAvailableForTrading liquidationValue ].freeze

  it "keeps Schwab field names inside app/models/schwab and its fixtures" do
    offenders = Rails.root.glob("app/**/*.rb").reject { |f| f.to_s.include?("/app/models/schwab/") }
      .select { |f| SCHWAB_FIELD_NAMES.any? { |name| f.read.include?(name) } }
    expect(offenders).to be_empty
  end
end

