module Schwab
  # Same interface as Client, same raw shapes (already scrubbed), served from lib/schwab_fixtures so seeds,
  # Playwright, and specs all run the real mappers. A per-call queue scripts failures and alternate payloads:
  #   Schwab::FakeClient.instance.enqueue(:orders) { raise Schwab::RateLimited.new(retry_after: 30) }
  class FakeClient
    include Singleton

    FIXTURES = Rails.root.join("lib/schwab_fixtures")
    ACCOUNT_HASH = "9313A0737C4E1B2D5F6A7B8C9D0E1F2A3B4C5D6E7F8091A2B3C4D5E6F708192A"
    FAKE_CODE = "fake-authorization-code@"

    attr_reader :calls

    def initialize = reset!

    def reset!
      @queues = Hash.new { |h, k| h[k] = [] }
      @calls = []
      @closed_dates = Set.new
      self
    end

    # Script the next response for a method. The block receives the call's arguments.
    def enqueue(method_name, &block) = @queues[method_name] << block

    def close_market_on(date) = @closed_dates << date.to_date

    # ---- OAuth: the fake authorize page lives in the app (step 4) and redirects straight back
    def authorize_url(state:) = "/schwab/fake_authorize?#{ { state: state }.to_query }"
    def exchange_code(code) = scripted(:exchange_code, code) { code == FAKE_CODE ? fixture("token").except("id_token") : raise(ReauthRequired.new("invalid_grant", status: 400)) }
    def refresh(refresh_token) = scripted(:refresh, refresh_token) { fixture("token").except("id_token") }

    # ---- Trader API
    def account_numbers = scripted(:account_numbers) { fixture("account_numbers").map { |row| row["hashValue"] } }
    def account(hash, fields: [ :positions ]) = scripted(:account, hash, fields) { fixture("account") }
    def orders(hash, from:, to: ::Time.current, status: nil) = scripted(:orders, hash, from, to, status) { fixture("orders") }
    def order(hash, order_id) = scripted(:order, hash, order_id) { Order.from(fixture("orders").first).flatten.map(&:raw).find { |o| o["orderId"].to_s == order_id.to_s } or raise RequestError.new("order not found", status: 404) }
    def transactions(hash, from:, to: ::Time.current, types: Client::TRANSACTION_TYPES) = scripted(:transactions, hash, from, to, types) { fixture("transactions") }

    # ---- Market Data API
    def market_hours(date, markets: [ :equity ])
      scripted(:market_hours, date, markets) do
        closed = @closed_dates.include?(date.to_date) || date.to_date.on_weekend?
        shift_market_hours(fixture(closed ? "market_hours_closed" : "market_hours_open"), date)
      end
    end
    def quotes(symbols, fields: %w[ quote reference ]) = scripted(:quotes, symbols, fields) { fixture("quotes").slice(*Array(symbols).map(&:to_s), "errors") }
    def price_history(symbol, **) = scripted(:price_history, symbol) { fixture("price_history").merge("symbol" => symbol) }
    def instrument(symbol_or_cusip) = scripted(:instrument, symbol_or_cusip) { fixture("instruments")["instruments"] }

    private
      def scripted(method_name, *args)
        @calls << [ method_name, *args ]
        block = @queues[method_name].shift
        block ? block.call(*args) : yield
      end

      def fixture(name) = Scrub.json(JSON.parse(FIXTURES.join("#{name}.json").read))

      # Fixture dates are stand-ins; the requested date replaces them so the calendar stays coherent.
      def shift_market_hours(raw, date)
        original = raw["equity"].values.first["date"]
        JSON.parse(JSON.generate(raw).gsub(original, date.to_date.iso8601))
      end
  end
end

