      raw ||= {}
      new(symbol: raw["symbol"], cusip: raw["cusip"].presence, instrument_id: raw["instrumentId"],
          asset_type: raw["assetType"], description: raw["description"])
    end

    def currency? = asset_type == "CURRENCY"
  end
