module Schwab
  class Error < StandardError
    attr_reader :status, :body, :request_id, :attempts

    def initialize(message = nil, status: nil, body: nil, request_id: nil, attempts: 1)
      super(message || self.class.name.demodulize.titleize)
      @status, @body, @request_id, @attempts = status, body, request_id, attempts
    end

    # Builds the right subclass for an HTTP response. Bodies are already scrubbed.
    def self.for_response(response, attempts:, idempotent:)
      status = response.code.to_i
      body = Scrub.body(response.body)
      klass =
        case status
        when 401 then AuthError
        when 429 then RateLimited
        when 400, 403, 404 then RequestError
        when 500.. then idempotent ? ServerError : UnknownOutcome
        else Error
        end
      klass.new("Schwab responded #{status}: #{summarize(body)}", status: status, body: body, request_id: request_id_in(body), attempts: attempts)
    end

    def self.summarize(body)
      json = JSON.parse(body) rescue nil
      return body.to_s.truncate(200) unless json.is_a?(Hash)
      Array(json["errors"]).map { |e| e["detail"] || e["title"] }.compact.join("; ").presence ||
        json["error_description"] || json["error"] || body.to_s.truncate(200)
    end

    def self.request_id_in(body)
      json = JSON.parse(body) rescue nil
      json.is_a?(Hash) ? Array(json["errors"]).first&.dig("id") : nil
    end
  end

  class AuthError < Error; end
  class ReauthRequired < AuthError; end   # any token-endpoint 4xx: the pause path
  class RateLimited < Error
    def retry_after = @retry_after
    def initialize(message = nil, retry_after: nil, **opts)
      super(message, **opts)
      @retry_after = retry_after
    end
  end
  class ServerError < Error; end
  class RequestError < Error; end          # 400/403/404: our parameters are wrong; never retried
  class TransportError < Error; end        # timeout or connection failure on an idempotent call
  class UnknownOutcome < Error; end        # the same on a non-idempotent call; Phase 2 depends on this being distinct
  class MappingError < Error; end          # required field missing; rescued per record by sync
end

