    93	        request.basic_auth(@app_key, @app_secret)
    94	        request["Accept"] = "application/json"
    95	        request.set_form_data(form)
    96	        response, attempts = perform(request, template: "/v1/oauth/token", idempotent: form[:grant_type] == "refresh_token")
    97	        raise ReauthRequired.new("Schwab token endpoint responded #{response.code}: #{Error.summarize(response.body)}", status: response.code.to_i, body: Scrub.body(response.body)) if response.code.to_i.between?(400, 499)
    98	        raise Error.for_response(response, attempts: attempts, idempotent: true) unless response.is_a?(Net::HTTPSuccess)
    99	        JSON.parse(response.body).except("id_token")
   100	      end
   101	
   102	      def get(base, path, **params)
   103	        uri = URI("#{base}#{path}")
   104	        uri.query = URI.encode_www_form(params) if params.any?
   105	        response, attempts = authorized(uri)
   106	        raise Error.for_response(response, attempts: attempts, idempotent: true) unless response.is_a?(Net::HTTPSuccess)
   107	        Scrub.json(JSON.parse(response.body))
   108	      end
   109	
   110	      # One refresh-and-retry on 401, outside the backoff budget.
   111	      def authorized(uri, refreshed: false)
   112	        request = Net::HTTP::Get.new(uri)
   113	        request["Authorization"] = "Bearer #{@token.access_token}"
   114	        request["Accept"] = "application/json"
   115	        response, attempts = perform(request, template: Scrub.path(uri.path), idempotent: true)
   116	        if response.code.to_i == 401 && !refreshed && @token.respond_to?(:refresh!)
   117	          @token.refresh!
   118	          return authorized(uri, refreshed: true)
   119	        end
   120	        [ response, attempts ]
   121	      end
   122	
   123	      # Returns [response, attempts]. Retries live here and nowhere else.
   124	      def perform(request, template:, idempotent:)
   125	        attempts = 0
   126	        begin
   127	          attempts += 1
   128	          RateBudget.take!
   129	          started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
   130	          response = http(request.uri).request(request)
   131	          log(request, template, response.code, started)
   132	          return [ response, attempts ] unless retriable?(response) && idempotent && attempts <= BACKOFF.size
   133	          @sleeper.call(delay_for(response, attempts))
   134	          raise Retry
   135	        rescue Retry
   136	          retry
   137	        rescue Net::OpenTimeout, Net::ReadTimeout, Errno::ECONNRESET, Errno::ECONNREFUSED, SocketError, OpenSSL::SSL::SSLError => e
   138	          log(request, template, "transport", started)
   139	          if idempotent && attempts <= BACKOFF.size
   140	            @sleeper.call(BACKOFF[attempts - 1])
   141	            retry
   142	          end
   143	          klass = idempotent ? TransportError : UnknownOutcome
   144	          raise klass.new("#{e.class}: #{e.message}", attempts: attempts)
   145	        end
   146	      end
   147	
   148	      Retry = Class.new(StandardError)
   149	
   150	      def retriable?(response) = response.code.to_i == 429 || response.code.to_i >= 500
   151	
   152	      def delay_for(response, attempt)
   153	        base = BACKOFF[attempt - 1]
   154	        retry_after = response["Retry-After"].to_i
   155	        retry_after.positive? ? [ retry_after, RETRY_AFTER_CAP ].min : base + rand * base * 0.25
   156	      end
   157	
   158	      def http(uri)
   159	        Net::HTTP.new(uri.host, uri.port).tap do |h|
   160	          h.use_ssl = true
   161	          h.open_timeout = OPEN_TIMEOUT
   162	          h.read_timeout = READ_TIMEOUT
   163	        end
   164	      end
   165	
   166	      def log(request, template, status, started)
   167	        ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round
   168	        Rails.logger.info("schwab #{request.method} #{template} #{status} #{ms}ms")
   169	      end
   170	  end
   171	end

