     1	module Schwab
     2	  # Plaintext account numbers arrive in the body of every Trader API response. They are removed
     3	  # here, in the client, before any body reaches raw columns, cassettes, or logs.
     4	  module Scrub
     5	    REDACTED_KEYS = %w[ accountNumber user ].freeze
     6	    ACCOUNT_HASH = /[0-9A-F]{64}/i
     7	
     8	    def self.json(value)
     9	      case value
    10	      when Hash then value.each_with_object({}) { |(k, v), h| h[k] = REDACTED_KEYS.include?(k) ? nil : json(v) }
    11	      when Array then value.map { |v| json(v) }
    12	      else value
    13	      end
    14	    end
    15	
    16	    def self.body(text)
    17	      return text if text.blank?
    18	      parsed = JSON.parse(text) rescue (return text)
    19	      JSON.generate(json(parsed))
    20	    end
    21	
    22	    # Log lines carry the route template, never the account hash.
    23	    def self.path(path) = path.gsub(ACCOUNT_HASH, "{hash}")
    24	
    25	    def self.uri(uri) = uri.gsub(ACCOUNT_HASH, "<ACCOUNT_HASH>")
    26	  end
    27	end

