# The guardrail engine (docs/phase-2-plan.md §3): rules as data, evaluated in Rails against every proposal,
# never bypassed or edited through a tool.
module Guardrails
  Result = Data.define(:rule_type, :outcome, :detail, :version, :params) do
    def pass? = outcome == :pass
    def warn? = outcome == :warn
    def fail? = outcome == :fail
    def unavailable? = outcome == :unavailable
  end

  # What one evaluation said, in the shape the proposal stores and the detail page reads.
  class Report
    attr_reader :results

    def initialize(results) = @results = results

    def blocked? = results.any?(&:fail?)
    def warnings = results.select { |r| r.warn? || r.unavailable? }.map(&:rule_type)
    def needs_override? = results.any? { |r| r.rule_type == "stop_collar" && r.warn? }
    def to_h = results.to_h { |r| [ r.rule_type, { "outcome" => r.outcome.to_s, "detail" => Agent.serialize(r.detail), "version" => r.version, "params" => r.params } ] }
  end
end

 succeeded in 0ms:
class ApplicationController < ActionController::Base
  # Approving, rejecting, overriding, editing rules, and toggling shadow mode belong to one person
  # (docs/phase-2-plan.md §0.13); the other user reads.
  def require_approver
    redirect_to root_path, alert: "Only the approver can do that." unless Current.user&.approver?
  end
  include Authentication
  # Only allow modern browsers supporting webp images, web push, badges, import maps, CSS nesting, and CSS :has.
  allow_browser versions: :modern

  # Changes to the importmap will invalidate the etag for HTML responses
  stale_when_importmap_changes
end

