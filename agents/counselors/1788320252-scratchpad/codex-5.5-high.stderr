     1	# The registry and the one dispatch entry point every transport uses.
     2	module Agent::Tools
     3	  Result = Data.define(:value, :error, :retry_after) do
     4	    def self.success(value) = new(value: value, error: nil, retry_after: nil)
     5	    def self.failure(error, retry_after: nil) = new(value: nil, error: error, retry_after: retry_after)
     6	    def ok? = error.nil?
     7	    # The text a model reads: the JSON on success, the message on failure.
     8	    def text = ok? ? JSON.generate(value) : error
     9	  end
    10	
    11	  def self.all = [ GetPortfolio, GetAccountHealth, GetQuotes, GetPriceHistory, GetJournal, GetSetupStats, GetRiskRules ]
    12	
    13	  def self.for(transport)
    14	    case transport.to_sym
    15	    when :mcp then all.select(&:mcp_allowed?)
    16	    when :scheduled then all.select { |t| t.scheduled_allowed? && t.read_only? }
    17	    else raise ArgumentError, "unknown transport #{transport}"
    18	    end
    19	  end
    20	
    21	  def self.definitions(transport) = self.for(transport).map(&:definition)
    22	  def self.find(name, transport:) = self.for(transport).find { |t| t.tool_name == name.to_s }
    23	
    24	  # Permission check, argument validation, telemetry, timing, and error normalization in one place.
    25	  # Never raises to the caller: Schwab and tool failures become results the agent can read and act on.
    26	  # Every call writes a tool_calls row, including a call the transport is not allowed to make.
    27	  def self.call(name, arguments = {}, transport:, agent_run: nil)
    28	    arguments = arguments.to_h.deep_symbolize_keys
    29	    record = ToolCall.new(agent_run: agent_run, transport: transport, tool_name: name.to_s, arguments: Agent.serialize(arguments))
    30	    started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    31	    result = if (tool = find(name, transport: transport))
    32	      AuditEvent.log("agent_tool_used", actor: :agent, data: { tool: tool.tool_name, transport: transport.to_s, arguments: Agent.serialize(arguments) }) if tool.audited?
    33	      invoke(tool, arguments)
    34	    elsif all.any? { |t| t.tool_name == name.to_s }
    35	      Result.failure("#{name} is not available on the #{transport} transport")
    36	    else
    37	      Result.failure("unknown tool #{name}")
    38	    end
    39	    record.duration_ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round
    40	    record.error = result.error
    41	    record.save!
    42	    result
    43	  end
    44	
    45	  def self.invoke(tool, arguments)
    46	    tool.validate!(arguments)
    47	    Result.success(Agent.serialize(tool.new.call(**arguments)))
    48	  rescue Schwab::RateLimited => e
    49	    Result.failure("Schwab rate limit: try again in #{e.retry_after || 60} seconds", retry_after: e.retry_after || 60)
    50	  rescue Schwab::NoUsableToken, Schwab::AuthError => e
    51	    Result.failure("Schwab connection needs re-authentication: #{e.message}")
    52	  rescue Schwab::Error => e
    53	    Result.failure("Schwab unavailable: #{e.message}")
    54	  rescue Agent::Tool::InvalidArguments => e
    55	    Result.failure("bad arguments: #{e.message}")
    56	  rescue StandardError, NotImplementedError => e # NotImplementedError is a ScriptError: the base class's own contract
    57	    Rails.error.report(e, handled: true, context: { tool: tool.tool_name })
    58	    Result.failure("#{tool.tool_name} failed: #{e.class.name}")
    59	  end
    60	  private_class_method :invoke
    61	end

