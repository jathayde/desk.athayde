    19	
    20	  # The next version of this rule, superseding this one, in one transaction and one audit row.
    21	  def supersede!(params:, user:, mode: self.mode, note: nil)
    22	    transaction do
    23	      update!(active: false) # first, so the one-active index admits the successor
    24	      successor = self.class.create!(rule_type: rule_type, setup: setup, params: params, mode: mode, note: note, version: version + 1, changed_by: user)
    25	      update!(superseded_by: successor)
    26	      AuditEvent.log("rule_changed", actor: :human, user: user, subject: successor, reason: note, data: { rule_type: rule_type, setup: setup&.name, before: self.params, after: params, version: successor.version })
    27	      successor
    28	    end
    29	  end
