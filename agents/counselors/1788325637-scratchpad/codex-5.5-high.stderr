     1	module Schwab
     2	  # The order bodies the app sends (docs/phase-2-plan.md §0.5). Every Schwab field name lives here.
     3	  # SCHWAB_SHAPE_UNVERIFIED: the TRIGGER strategy, the child shape, and taxLotMethod are modelled on schwab-py's
     4	  # order builder and are confirmed only by a shadowed payload compared against an order placed by hand.
     5	  module OrderPayload
     6	    NORMAL = "NORMAL"
     7	    DAY = "DAY"
     8	    GOOD_TILL_CANCEL = "GOOD_TILL_CANCEL"
     9	    SINGLE = "SINGLE"
    10	    TRIGGER = "TRIGGER"
    11	    STOP = "STOP"
    12	
    13	    # A LIMIT entry whose child is a STOP sell of the same quantity, good until cancelled.
    14	    def self.bracket(symbol:, quantity:, limit_price:, stop_price:)
    15	      leg(BUY, symbol, quantity).merge(
    16	        "orderType" => Order::LIMIT, "price" => price(limit_price), "orderStrategyType" => TRIGGER,
    17	        "childOrderStrategies" => [ leg(SELL, symbol, quantity).merge("orderType" => STOP, "stopPrice" => price(stop_price), "duration" => GOOD_TILL_CANCEL, "orderStrategyType" => SINGLE) ]
    18	      )
    19	    end
    20	
    21	    def self.sell(symbol:, quantity:, limit_price:, tax_lot_method: nil)
    22	      leg(SELL, symbol, quantity).merge("orderType" => Order::LIMIT, "price" => price(limit_price), "orderStrategyType" => SINGLE)
    23	                                 .merge(tax_lot_method ? { "taxLotMethod" => tax_lot_method } : {})
    24	    end
    25	
    26	    def self.leg(instruction, symbol, quantity)
    27	      { "session" => NORMAL, "duration" => DAY,
    28	        "orderLegCollection" => [ { "instruction" => instruction, "quantity" => quantity.to_i, "instrument" => { "symbol" => symbol, "assetType" => "EQUITY" } } ] }
    29	    end
    30	
    31	    def self.price(value) = BigDecimal(value.to_s).round(2).to_s("F")
    32	
    33	    BUY = Order::BUY
    34	    SELL = Order::SELL
    35	  end
    36	end

