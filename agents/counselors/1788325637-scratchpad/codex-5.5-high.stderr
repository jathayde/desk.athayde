 succeeded in 0ms:
     1	# Finds the broker order a submission produced when Schwab never told us its id: an ambiguous real submission
     2	# (step 4) or a shadowed one the operator placed by hand. Conservative by design: unlinked orders only, the
     3	# same instrument, side, quantity, type, and price, entered inside the attempt's window; two matches are
     4	# ambiguous for the operator, never "found".
     5	class Submission::Matcher
     6	  PRICE_TOLERANCE = BigDecimal("0.01")
     7	  SHADOW_WINDOW = 3.days
     8	
     9	  def initialize(proposal, attempt)
    10	    @proposal, @attempt = proposal, attempt
    11	  end
    12	
    13	  def candidates
    14	    window = @attempt.attempted_at - 5.minutes..@attempt.attempted_at + SHADOW_WINDOW
    15	    @proposal.account.orders.where(order_proposal_id: nil, instrument: @proposal.instrument, side: OrderProposal.sides.fetch(@proposal.side), order_type: @proposal.order_type, entered_at: window)
    16	             .select { |o| o.quantity.to_d == @proposal.quantity.to_d && (o.limit_price.to_d - @proposal.limit_price.to_d).abs <= PRICE_TOLERANCE }
    17	  end
    18	
    19	  # Exactly one, or nothing: the caller decides what "two" means.
    20	  def match = candidates.then { |found| found.one? ? found.first : nil }
    21	  def ambiguous? = candidates.many?
    22	end

