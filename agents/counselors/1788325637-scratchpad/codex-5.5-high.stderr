    77	    Schwab::FakeClient.instance.script_daily_history(symbol: "XYZ", close: 50) # the fake's quote fixture already knows XYZ
    78	    Proposals::Create.call(account: account, kind: :entry, side: :buy, symbol: "XYZ", limit_price: BigDecimal("50"), stop_price: BigDecimal("47"), thesis: "Adding to the base breakout on volume.", origin: :agent)
    79	  end
    80	
    81	  def delisted
