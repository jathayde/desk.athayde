     1	module Sync
     2	  # The only scheduled sync entry point. Refreshes the calendar, checks the token once, and enqueues what is due.
     3	  class TickJob < ApplicationJob
     4	    INTRADAY = { positions: 15.minutes, orders: 5.minutes, activities: 5.minutes }.freeze
     5	    OFF_HOURS = 60.minutes
     6	    CALENDAR_DAYS = 7
     7	    SNAPSHOT_DELAY = 20.minutes
     8	
     9	    def perform
    10	      SyncRun.sweep_stale!
    11	      SystemSettings.instance.sweep_rule_halt!
    12	      OrderProposal.expiring.find_each(&:expire!)
    13	      refresh_calendar
    14	      return pause! unless SchwabToken.usable?
    15	
    16	      in_session = MarketDay.session_open?
    17	      Account.find_each do |account|
    18	        INTRADAY.each_key do |feed|
    19	          next unless SyncRun.due?(feed, account, every: account.sync_interval(feed, in_session: in_session))
    20	          job_for(feed).perform_later(account)
    21	        end
    22	        Snapshots::DailyJob.perform_later(account, today) if snapshot_due?(account, today)
    23	      end
    24	    end
    25	
    26	    private
    27	      # Once per Schwab-sourced market day, 20 minutes after the regular close, after positions and orders both synced
    28	      # since the close: the risk columns are written once and read stops.
    29	      def snapshot_due?(account, date)
    30	        day = MarketDay.find_by(date: date)
    31	        return false unless account.trading_enabled? && day&.schwab? && day.trading? && Time.current >= day.regular_closes_at + SNAPSHOT_DELAY
    32	        return false if account.snapshots.exists?(as_of: date)
    33	        %i[ positions orders ].all? { |feed| SyncRun.for(feed, account).advanced_cursor.where(started_at: day.regular_closes_at..).exists? }
    34	      end
    35	
    36	      def today = MarketDay.today
    37	
    38	      def refresh_calendar
    39	        (today..today + CALENDAR_DAYS).each { |date| MarketDay.for(date) }
    40	      end
    41	
    42	      # One skipped row per hour; nothing is enqueued, so the queue cannot grow.
    43	      def pause!
    44	        reason = SystemSettings.pause_for_token!
    45	        return if reason.nil? || SyncRun.where(status: :skipped_token, started_at: 1.hour.ago..).exists?
    46	        SyncRun.create!(feed: :positions, status: :skipped_token, started_at: Time.current, finished_at: Time.current, error: reason)
    47	      end
