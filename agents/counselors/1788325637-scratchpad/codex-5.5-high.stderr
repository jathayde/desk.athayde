     4	class Orders::ProposalLink
     5	  def self.call(account) = new(account).call
     6	
     7	  def initialize(account) = @account = account
     8	
     9	  def call
    10	    link_by_broker_id
    11	    link_shadows
    12	    record_outcomes
    13	  end
    14	
    15	  private
    16	    def link_by_broker_id
    17	      @account.order_proposals.where(status: %w[ submitted filled cancelled ]).where.not(broker_order_id: nil).find_each do |proposal|
    18	        order = @account.orders.find_by(broker_order_id: proposal.broker_order_id) or next
    19	        order.update!(order_proposal: proposal, placed_via: :app) if order.order_proposal_id != proposal.id
    20	      end
    21	    end
    22	
