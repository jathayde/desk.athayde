 succeeded in 0ms:
     1	# One year of daily candles and a fresh quote in, a Collar out. Methods, each a stop price for a long entry:
     2	# ATR multiple (entry − k × ATR14), swing low (lowest low of N bars − buffer × ATR14), percent (entry × (1 − p)),
     3	# and chandelier (highest high of M bars − k × ATR(M)), computed for reference. tight and wide are the highest
     4	# and lowest of the ATR and swing stops; the percent stop is the floor under wide, and when it is tighter than
     5	# both methods it is the collar's only edge (floor_dominates), with the entry as the ceiling.
     6	class StopCollar::Calculator
     7	  MIN_CANDLES = 30
     8	  MAX_TRADING_DAYS_OLD = 2
     9	  DEFAULTS = { "atr_k" => "2.5", "swing_bars" => "10", "swing_buffer_atr" => "0.2", "percent" => "8", "chandelier_bars" => "22", "chandelier_k" => "3" }.freeze
    10	
    11	  def initialize(instrument, entry_price:, params: {})
    12	    @instrument, @entry, @params = instrument, BigDecimal(entry_price.to_s), DEFAULTS.merge(params.to_h.transform_keys(&:to_s))
    13	  end
    14	
    15	  def call
    16	    history = Agent::MarketData.price_history(@instrument.symbol, range: "1y")
    17	    return refuse("history is stale (Schwab unavailable)") if history[:stale]
    18	    candles = Array(history[:candles]).map { |c| c.transform_keys(&:to_sym) }.sort_by { |c| c[:date] }
    19	    return refuse("only #{candles.size} daily candles; #{MIN_CANDLES} needed") if candles.size < MIN_CANDLES
    20	    return refuse("latest candle is #{candles.last[:date]}, more than #{MAX_TRADING_DAYS_OLD} trading days old") if candles.last[:date].to_date < oldest_acceptable_date
    21	    quote = Agent::MarketData.quotes([ @instrument.symbol ])[:quotes].first
    22	    return refuse("no fresh quote") if quote.nil? || quote[:stale]
    23	
    24	    atr14 = atr(candles, 14)
    25	    methods = {
    26	      atr: @entry - param(:atr_k) * atr14,
    27	      swing: candles.last(param(:swing_bars).to_i).map { |c| c[:low] }.min - param(:swing_buffer_atr) * atr14,
    28	      percent: @entry * (1 - param(:percent) / 100),
    29	      chandelier: candles.last(param(:chandelier_bars).to_i).map { |c| c[:high] }.max - param(:chandelier_k) * atr(candles, param(:chandelier_bars).to_i)
    30	    }.transform_values { |v| v.round(4) }
    31	    candidates = methods.values_at(:atr, :swing).select { |v| v < @entry }
    32	    return refuse("the ATR and swing stops land at or above the entry") if candidates.empty?
    33	    floor = methods[:percent]
    34	    tight, wide = candidates.max, [ candidates.min, floor ].max
    35	    floor_dominates = tight < floor
    36	    StopCollar::Collar.new(methods: methods, tight: floor_dominates ? floor : tight, wide: floor_dominates ? floor : wide, floor: floor, floor_dominates: floor_dominates, quality: :ok, refusal: nil)
    37	  rescue Schwab::Error, Agent::Tool::InvalidArguments => e
    38	    refuse("market data unavailable: #{e.message}")
    39	  end
    40	
    41	  private
    42	    def param(name) = BigDecimal(@params.fetch(name.to_s).to_s)
    43	    def refuse(reason) = StopCollar::Collar.new(methods: {}, tight: nil, wide: nil, floor: nil, floor_dominates: false, quality: :refused, refusal: reason)
    44	
    45	    # Two trading days back, counting weekdays and any known closed day.
    46	    def oldest_acceptable_date
    47	      date = MarketDay.today
    48	      MAX_TRADING_DAYS_OLD.times do
    49	        date -= 1
    50	        date -= 1 while date.on_weekend? || MarketDay.find_by(date: date)&.trading == false
    51	      end
    52	      date
    53	    end
    54	
    55	    # Average true range over the last n bars, the plain average form.
    56	    def atr(candles, n)
    57	      ranges = candles.each_cons(2).to_a.last(n).map do |prev, c|
    58	        [ c[:high] - c[:low], (c[:high] - prev[:close]).abs, (c[:low] - prev[:close]).abs ].max
    59	      end
    60	      ranges.sum / ranges.size
    61	    end
    62	end

