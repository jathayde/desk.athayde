    32	    def record_outcomes
    33	      @account.order_proposals.submitted.where.not(broker_order_id: nil).find_each do |proposal|
    34	        order = @account.orders.find_by(broker_order_id: proposal.broker_order_id) or next
    35	        if order.status == Schwab::Order::FILLED then proposal.record_broker_outcome!(:filled)
    36	        elsif Schwab::Order::DEAD_STATUSES.include?(order.status) then proposal.record_broker_outcome!(:cancelled)
    37	        end
    38	      end
    39	    end
    40	end

