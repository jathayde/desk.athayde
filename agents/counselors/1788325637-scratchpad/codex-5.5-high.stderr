     7	<%= render "proposals/evaluation", proposal: proposal, results: proposal.guardrail_results, sizing: proposal.sizing, collar: proposal.collar %>
     8	
     9	<% if proposal.submission_unknown? %>
    10	  <p class="warn">Submission unknown: check Schwab before doing anything else on <%= proposal.instrument.symbol %>. The reconcile job is looking for the order.</p>
    11	<% elsif proposal.submitted? && proposal.shadow? && proposal.broker_order_id.nil? %>
    12	  <p class="warn">Shadow approval: place this order at Schwab by hand. The next orders sync matches it and records the payload check.</p>
    13	<% end %>
    14	
    15	<% if proposal.approvable? %>
    16	  <%= form_with url: proposal_approval_path(proposal), method: :post, class: "approve" do |f| %>
    17	    <% proposal.warnings.each do |rule| %>
    18	      <label><%= f.check_box :acknowledged, { multiple: true, id: "ack_#{rule}" }, rule, nil %> I acknowledge <%= rule.humanize.downcase %><%= " (not checked)" if proposal.guardrail_results.dig(rule, "outcome") == "unavailable" %></label>
    19	    <% end %>
    20	    <% if proposal.guardrail_results.dig("stop_collar", "overridable") && proposal.guardrail_results.dig("stop_collar", "outcome") == "caution" %>
    21	      <%= f.label :override_reason, "The stop is outside the collar. Why?" %>
    22	      <%= f.text_field :override_reason %>
    23	    <% end %>
    24	    <%= f.label :confirmation, "Type approve to confirm" %>
    25	    <%= f.text_field :confirmation, autocomplete: "off" %>
    26	    <%= f.submit "Approve", class: "danger" %>
    27	  <% end %>
    28	  <%= form_with url: proposal_rejection_path(proposal), method: :post do |f| %>
    29	    <%= f.label :reason, "Reject with a reason" %>
    30	    <%= f.text_field :reason %>
    31	    <%= f.submit "Reject", class: "secondary" %>
    32	  <% end %>
    33	<% end %>
    34	<% if proposal.rejection_reason.present? %><p class="muted">Rejected: <%= proposal.rejection_reason %></p><% end %>
    35	<% if proposal.override_reason.present? %><p class="muted">Override: <%= proposal.override_reason %></p><% end %>

