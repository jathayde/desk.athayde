    27	
    28	  TERMINAL = %w[ rejected_by_rules rejected expired submission_failed filled cancelled ].freeze
    29	  APPROVABLE = %w[ validated ].freeze
    30	  UNRESOLVED = %w[ submitting submission_unknown ].freeze # locks the instrument for every other proposal
    31	  BROKER_OUTCOMES = %w[ filled cancelled ].freeze
    32	
    33	  scope :unresolved, -> { where(status: UNRESOLVED) }
    34	  scope :queue, -> { where(status: %w[ proposed validated submission_unknown ]).order(created_at: :desc) }
    35	  scope :expiring, -> { where(status: %w[ proposed validated ]).where(expires_at: ..Time.current) }
    36	  scope :stale_submitting, ->(older_than) { submitting.where(updated_at: ..older_than.ago) }
