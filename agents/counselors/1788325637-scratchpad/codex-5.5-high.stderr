     1	# The guardrail engine (docs/phase-2-plan.md §3): rules as data, evaluated in Rails against every proposal,
     2	# never bypassed or edited through a tool. Evaluation answers; the writers (evaluate!, the approve path) act.
     3	module Guardrails
     4	  OUTCOMES = %i[ pass caution block unavailable skipped ].freeze
     5	
     6	  # One rule's verdict. overridable: a caution the approver may pass with a logged reason (today, only the
     7	  # collar). trip: a rule halt this verdict asks the writer to engage, with its reset time (nil = until cleared).
     8	  Result = Data.define(:rule_type, :outcome, :detail, :version, :params, :overridable, :trip) do
     9	    def initialize(rule_type:, outcome:, detail: {}, version: nil, params: {}, overridable: false, trip: nil) = super
    10	    def pass? = outcome == :pass
    11	    def caution? = outcome == :caution
    12	    def block? = outcome == :block
    13	    def unavailable? = outcome == :unavailable
    14	    def skipped? = outcome == :skipped
    15	  end
    16	
    17	  # What one evaluation said, in the shape the proposal stores and the detail page reads.
    18	  Report = Data.define(:results) do
    19	    def blocked? = results.any?(&:block?)
    20	    def warnings = results.select { |r| r.caution? || r.unavailable? }.map(&:rule_type)
    21	    def needs_override? = results.any? { |r| r.caution? && r.overridable }
    22	    def trips = results.filter_map(&:trip)
    23	    def to_h = results.to_h { |r| [ r.rule_type, { "outcome" => r.outcome.to_s, "detail" => Agent.serialize(r.detail), "version" => r.version, "params" => r.params, "overridable" => r.overridable } ] }
    24	  end
    25	
    26	  # The one place a report changes the desk: the halts its rules asked for, engaged by the writer that owns the transaction.
    27	  def self.engage_halts!(report, settings: SystemSettings.instance)
    28	    report.trips.each { |trip| settings.trip_rule_halt!(rule: trip[:rule], reason: trip[:reason], resets_at: trip[:resets_at]) }
    29	  end
    30	end

