 succeeded in 0ms:
     1	module Sync
     2	  # Orders for one account: the cursor window, a daily WORKING pass, and a re-fetch by id of any working
     3	  # stop that fell out of the list, then working-stop detection on every position. Each order is mapped
     4	  # inside its own rescue so one malformed record cannot poison the batch. Lineage is written in a second
     5	  # pass by broker id and never nulled once set.
     6	  class OrdersJob < FeedJob
     7	    OVERLAP = 1.day
     8	    PAGE_LIMIT = 3000
     9	
    10	    limits_concurrency to: 1, key: ->(account, **) { "orders-#{account.id}" }, on_conflict: :discard
    11	
    12	    def perform(account, working_pass: false)
    13	      from, to, gap_from = window_for(:orders, account, overlap: OVERLAP)
    14	      SyncRun.record(:orders, account: account, window_from: from, window_to: to) do |run|
    15	        note_gap(run, gap_from, account)
    16	        listed = client.orders(account.schwab_hash, from: from, to: to)
    17	        truncated = listed.size >= PAGE_LIMIT
    18	        listed += client.orders(account.schwab_hash, from: Time.current - LOOKBACK, to: to, status: Schwab::Order::WORKING) if working_pass || !working_pass_today?(account)
    19	        orders = listed.filter_map { |raw| map(raw, run) }.flat_map(&:flatten)
    20	        orders += refetch_missing_stops(account, orders, run)
    21	        orders = orders.reverse.uniq(&:order_id).reverse # the later snapshot of a repeated order wins
    22	
    23	        rows = orders.filter_map { |order| upsert(account, order, run) }
    24	        link_lineage(account, orders)
    25	        # A truncated page or an order the run could not map or resolve cannot say what is working; a stop Schwab
    26	        # no longer returns is known, and its position must lose it.
    27	        Orders::ProposalLink.call(account)
    28	        complete = !truncated && run.unmapped_values.except("stops_gone").none?
    29	        account.positions.includes(:working_stop_order).each(&:assign_working_stop!) if complete
    30	        run.touched(rows.size)
    31	        truncated ? :partial : :succeeded
    32	      end
    33	    end
    34	
    35	    private
    36	      def map(raw, run)
    37	        Schwab::Order.from(raw)
    38	      rescue Schwab::MappingError => e
    39	        run.quarantine(:orders_unmapped, e.message)
    40	        nil
    41	      end
    42	
    43	      def working_pass_today?(account)
    44	        SyncRun.for(:orders, account).advanced_cursor.where(started_at: Time.current.in_time_zone(MarketDay::ZONE).beginning_of_day..).exists?
    45	      end
    46	
    47	      # A stop Schwab no longer returns even by id is marked gone, so assignment drops it instead of trusting a stale row.
    48	      def refetch_missing_stops(account, orders, run)
    49	        seen = orders.map(&:order_id)
    50	        account.positions.includes(:working_stop_order).filter_map(&:working_stop_order).reject { |o| seen.include?(o.broker_order_id) }.flat_map do |stop|
    51	          Schwab::Order.from(client.order(account.schwab_hash, stop.broker_order_id)).flatten
    52	        rescue Schwab::RequestError => e
    53	          stop.update!(status: Schwab::Order::GONE)
    54	          run.quarantine(:stops_gone, "#{stop.broker_order_id}: #{e.message}")
    55	          []
    56	        end
    57	      end
    58	
    59	      def upsert(account, order, run)
    60	        instrument = order.instrument && Instrument.resolve(order.instrument)
    61	        if order.instrument && instrument.nil?
    62	          run.quarantine(:orders_unresolved, order.instrument.to_h)
    63	          return nil
    64	        end
    65	        row = account.orders.find_or_initialize_by(broker_order_id: order.order_id)
    66	        row.placed_via = :schwab_direct if row.new_record?
    67	        row.update!(instrument: instrument, status: order.status, side: order.side, quantity: order.quantity, filled_quantity: order.filled_quantity,
    68	                    remaining_quantity: order.remaining_quantity, order_type: order.order_type, limit_price: order.price, stop_price: order.stop_price,
    69	                    duration: order.duration, session: order.session, tax_lot_method: order.tax_lot_method, strategy_type: order.strategy_type,
    70	                    entered_at: order.entered_at, closed_at: order.close_time, raw: order.raw)
    71	        row
    72	      rescue Schwab::MappingError, ActiveRecord::RecordInvalid => e
    73	        run.quarantine(:orders_unmapped, "#{order.order_id}: #{e.message}")
    74	        nil
    75	      end
    76	
    77	      # Parents may already exist from an earlier run, so the index covers every id the batch references.
    78	      def link_lineage(account, orders)
    79	        ids = orders.flat_map { |o| [ o.order_id, o.parent_order_id, o.replaces_order_id ] }.compact.uniq
    80	        by_broker_id = account.orders.where(broker_order_id: ids).index_by(&:broker_order_id)
    81	        orders.each do |order|
    82	          row = by_broker_id[order.order_id] or next
    83	          parent = order.parent_order_id && by_broker_id[order.parent_order_id]
    84	          replaced = order.replaces_order_id && by_broker_id[order.replaces_order_id]
    85	          row.update!(parent_order: parent) if parent && row.parent_order_id.nil?
    86	          row.update!(replaces_order: replaced) if replaced && row.replaces_order_id.nil?
    87	        end
    88	      end
    89	  end
    90	end

