     1	# Runs every rule over one proposal: the built-in laws, then each data rule from one query of the active rows
     2	# (a missing row is unavailable, or a block for the rules the plan calls hard). Pure: it reads the database
     3	# and answers; the proposal's evaluate! and the approve path write.
     4	class Guardrails::Evaluator
     5	  BUILT_IN = %w[ halt pending_reconciliation settled_cash ].freeze
     6	
     7	  def initialize(proposal, context: Guardrails::Context.new(proposal.account))
     8	    @proposal, @context = proposal, context
     9	  end
    10	
    11	  def call
    12	    active = RiskRule.active.where(rule_type: RiskRule::TYPES).where(setup: [ nil, @proposal.setup ]).group_by(&:rule_type)
    13	    results = BUILT_IN.map { |type| judge(type, nil) }
    14	    results += RiskRule::TYPES.map do |type|
    15	      rule = active.fetch(type, []).find { |r| r.setup_id == @proposal.setup_id } || active.fetch(type, []).find { |r| r.setup_id.nil? }
    16	      rule ? judge(type, rule) : missing(type)
    17	    end
    18	    Guardrails::Report.new(results)
    19	  end
    20	
    21	  private
    22	    def judge(type, rule) = Guardrails::Rule.for(type).new(rule: rule, proposal: @proposal, context: @context).call
    23	
    24	    def missing(type)
    25	      klass = Guardrails::Rule.for(type)
    26	      Guardrails::Result.new(rule_type: type, outcome: klass.fatal_when_missing? ? :block : :unavailable, detail: { reason: "no #{type} rule configured" })
    27	    end
    28	end

