app/models/guardrails/context.rb
     1	# Everything the rules read about the desk, computed once per evaluation from the database for one account:
     2	# equity and its freshness, cash and what already claims it, positions, today's realized P&L, the drawdown,
     3	# and the halts.
     4	class Guardrails::Context
     5	  attr_reader :account, :desk, :settings
     6	
     7	  def initialize(account)
     8	    @account = account
     9	    @desk = Desk.new(account: account)
    10	    @settings = SystemSettings.instance
    11	  end
    12	
    13	  def balance = desk.balance
    14	  def equity = balance&.equity
    15	  def balance_stale? = balance.nil? || desk.balance_stale?
    16	  def fresh_equity = balance_stale? || equity.to_d <= 0 ? nil : equity
    17	  def positions = @positions ||= account.positions.includes(:instrument, :working_stop_order).to_a
    18	  def position_for(instrument) = positions.find { |p| p.instrument_id == instrument.id }
    19	  def open_trade_for(instrument) = account.trades.open.find_by(instrument: instrument)
    20	
    21	  # Entries not yet filled on instruments not yet held: they count as positions the desk has committed to.
    22	  def pending_new_positions
    23	    account.order_proposals.where(kind: :entry, status: %w[ validated submitting submission_unknown submitted ]).where.not(instrument_id: positions.map(&:instrument_id)).distinct.count(:instrument_id)
    24	  end
    25	
    26	  # Cash the broker reports as settled, minus every buy that already claims it (docs/phase-2-plan.md §0.9).
    27	  # The app's own resting orders are counted once, as proposals; whether the broker's figure already nets
    28	  # working buys is unverified (verify-on-approval item 58), so its other working buys are subtracted too.
    29	  def projected_settled_cash
    30	    return nil if balance_stale? || balance.settled_cash.nil?
    31	    balance.settled_cash - pending_app_buys - live_broker_buys
    32	  end
    33	
    34	  def pending_app_buys
    35	    account.order_proposals.where(status: %w[ submitting submission_unknown submitted ], side: Schwab::Order::BUY).sum { |p| p.quantity.to_d * p.limit_price.to_d }
    36	  end
    37	
    38	  # A market buy claims an unknown sum; the position's last price is the conservative stand-in.
    39	  def live_broker_buys
    40	    account.orders.working.where(side: Schwab::Order::BUY, order_proposal_id: nil).includes(:instrument).sum do |o|
    41	      o.remaining.to_d * (o.limit_price || o.stop_price || position_for(o.instrument)&.last_price || 0).to_d
    42	    end
    43	  end
    44	
    45	  # Only closed trades carry realized P&L today; a scale-out at a loss on an open trade is not seen here.
    46	  def realized_today = @realized_today ||= account.trades.closed.where(closed_at: today_range).sum(:realized_pnl)
    47	  def prior_equity = desk.prior_snapshot&.equity
    48	  def drawdown = desk.latest_snapshot&.drawdown
    49	
    50	  # What the day has already committed on the buy side, resting or filled, unknown included.
    51	  def notional_today
    52	    account.order_proposals.where(status: %w[ submitting submission_unknown submitted filled ], side: Schwab::Order::BUY, decided_at: today_range).sum { |p| p.quantity.to_d * p.limit_price.to_d }
    53	  end
    54	
    55	  private
    56	    def today_range = MarketDay.today.in_time_zone(MarketDay::ZONE).all_day
    57	end

app/models/guardrails/daily_loss_halt.rb
     1	# Rule 3: today's realized loss past the percent of yesterday's equity blocks entries and asks for a rule halt
     2	# until the end of the New York day (the tick clears it before the next open); exits are not judged here.
     3	class Guardrails::DailyLossHalt < Guardrails::Rule
     4	  def evaluate
     5	    return skipped unless entry?
     6	    return unavailable("no prior snapshot to measure the day against") unless context.prior_equity&.positive?
     7	    loss = -context.realized_today / context.prior_equity * 100
     8	    detail = { loss_percent: loss.round(2), cap: param(:percent) }
     9	    return pass(**detail) if loss < param(:percent)
    10	    trip = { rule: rule_type, reason: "down #{loss.round(2)}% today", resets_at: Time.current.in_time_zone(MarketDay::ZONE).end_of_day }
    11	    [ :block, detail, false, trip ]
    12	  end
    13	end

app/models/guardrails/earnings_blackout.rb
     1	# Rule 5: no earnings or economic calendar until FMP (Phase 2.5); shown as not checked, acknowledged on every entry.
     2	class Guardrails::EarningsBlackout < Guardrails::Rule
     3	  def evaluate = entry? ? unavailable("earnings and economic calendar are not available in Phase 2") : skipped
     4	end

app/models/guardrails/evaluator.rb
     1	# Runs every rule over one proposal: the built-in laws, then each data rule from one query of the active rows
     2	# (a missing row is unavailable, or a block for the rules the plan calls hard). Pure: it reads the database
     3	# and answers; the proposal's evaluate! and the approve path write.
     4	class Guardrails::Evaluator
     5	  BUILT_IN = %w[ halt pending_reconciliation settled_cash ].freeze
     6	
     7	  def initialize(proposal, context: Guardrails::Context.new(proposal.account))
     8	    @proposal, @context = proposal, context
     9	  end
    10	
    11	  def call
    12	    active = RiskRule.active.where(rule_type: RiskRule::TYPES).where(setup: [ nil, @proposal.setup ]).group_by(&:rule_type)
    13	    results = BUILT_IN.map { |type| judge(type, nil) }
    14	    results += RiskRule::TYPES.map do |type|
    15	      rule = active.fetch(type, []).find { |r| r.setup_id == @proposal.setup_id } || active.fetch(type, []).find { |r| r.setup_id.nil? }
    16	      rule ? judge(type, rule) : missing(type)
    17	    end
    18	    Guardrails::Report.new(results)
    19	  end
    20	
    21	  private
    22	    def judge(type, rule) = Guardrails::Rule.for(type).new(rule: rule, proposal: @proposal, context: @context).call
    23	
    24	    def missing(type)
    25	      klass = Guardrails::Rule.for(type)
    26	      Guardrails::Result.new(rule_type: type, outcome: klass.fatal_when_missing? ? :block : :unavailable, detail: { reason: "no #{type} rule configured" })
    27	    end
    28	end

app/models/guardrails/halt.rb
     1	# Built in, never a data rule: the kill switch stops everything, a rule halt stops entries (SystemSettings owns both).
     2	class Guardrails::Halt < Guardrails::Rule
     3	  def evaluate
     4	    settings = context.settings
     5	    return block(reason: "halted: #{settings.manual_halt_reason}") unless settings.exits_allowed?
     6	    return block(reason: "entries halted by #{settings.rule_halt_rule}: #{settings.rule_halt_reason}") if entry? && !settings.entries_allowed?
     7	    pass
     8	  end
     9	end

app/models/guardrails/max_drawdown_halt.rb
     1	# Rule 3: a drawdown from the high-water mark past the percent blocks entries and asks for a rule halt with no
     2	# reset time; the operator clears it by hand. Read from the latest snapshot, so an intraday collapse is seen tonight.
     3	class Guardrails::MaxDrawdownHalt < Guardrails::Rule
     4	  def evaluate
     5	    return skipped unless entry?
     6	    return unavailable("no snapshot yet") if context.drawdown.nil?
     7	    drawdown = context.drawdown * 100
     8	    detail = { drawdown_percent: drawdown.round(2), cap: param(:percent) }
     9	    return pass(**detail) if drawdown < param(:percent)
    10	    [ :block, detail, false, { rule: rule_type, reason: "#{drawdown.round(2)}% below the high-water mark", resets_at: nil } ]
    11	  end
    12	end

app/models/guardrails/max_position_exposure.rb
     1	# Rule 2a: one instrument's share of equity after this entry; no fresh equity, no answer, and no answer is a block.
     2	class Guardrails::MaxPositionExposure < Guardrails::Rule
     3	  def self.fatal_when_missing? = true
     4	
     5	  def evaluate
     6	    return skipped unless entry?
     7	    equity = context.fresh_equity or return block(reason: "no fresh equity to measure exposure against")
     8	    existing = context.position_for(proposal.instrument)&.market_value.to_d
     9	    share = (existing + cost) / equity * 100
    10	    detail = { percent: share.round(2), cap: param(:percent) }
    11	    share <= param(:percent) ? pass(**detail) : block(**detail)
    12	  end
    13	end

app/models/guardrails/max_positions.rb
     1	# Rule 2a: a new instrument may not push the count of held and pending positions past the cap.
     2	class Guardrails::MaxPositions < Guardrails::Rule
     3	  def self.fatal_when_missing? = true
     4	
     5	  def evaluate
     6	    return skipped unless entry?
     7	    held = context.positions.count
     8	    pending = context.pending_new_positions
     9	    detail = { held: held, pending: pending, cap: param(:count) }
    10	    return pass(**detail, adding: false) if context.position_for(proposal.instrument)
    11	    held + pending + 1 <= param(:count) ? pass(**detail) : block(**detail)
    12	  end
    13	end

app/models/guardrails/max_risk_per_trade.rb
     1	# Rule 1: the frozen quantity's dollars at risk against today's equity and the current percent, so an equity
     2	# drop between proposal and approval turns a pass into a block, as docs/phase-2-plan.md §0.4 requires.
     3	class Guardrails::MaxRiskPerTrade < Guardrails::Rule
     4	  def self.fatal_when_missing? = true
     5	
     6	  def evaluate
     7	    return skipped unless entry?
     8	    return block(reason: proposal.sizing["reason"] || "not sized") if proposal.sizing["quantity"].blank?
     9	    equity = context.fresh_equity or return block(reason: "no fresh equity to measure risk against")
    10	    at_risk = proposal.quantity.to_d * (proposal.limit_price.to_d - proposal.stop_price.to_d)
    11	    budget = (equity * param(:percent) / 100).round(2)
    12	    detail = { at_risk: at_risk, budget: budget, equity: equity, frozen_budget: proposal.sizing["risk_budget"] }
    13	    at_risk <= budget ? pass(**detail) : block(**detail)
    14	  end
    15	end

