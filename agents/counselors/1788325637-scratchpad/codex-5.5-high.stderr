   109	    trade = account.trades.create!(instrument: xyz, status: :closed, avg_entry: 51.18, avg_exit: 55.31, peak_quantity: 40, realized_pnl: 165.2, initial_risk: 91.2, realized_r: 1.81,
   110	                                   planned_stop: 48.9, setup: Setup.create!(name: "breakout-A"), opened_at: 5.days.ago, closed_at: 1.day.ago)
