     1	# How many shares an entry may carry (docs/phase-2-plan.md §0.4): the max-risk-per-trade rule's percent of
     2	# equity, divided by the per-share risk from the proposal's limit and stop, floored to whole shares. Frozen on
     3	# the proposal at creation; the numbers behind the quantity are kept so the detail page can show its work.
     4	Sizing = Data.define(:equity, :risk_percent, :risk_budget, :per_share_risk, :quantity, :reason) do
     5	  def self.for(limit_price:, stop_price:, equity:, rule:)
     6	    limit_price, stop_price, equity = [ limit_price, stop_price, equity ].map { |v| v && BigDecimal(v.to_s) } # never Float past this line
     7	    return refused("no fresh equity", equity: equity) unless equity&.positive?
     8	    return refused("no max_risk_per_trade rule", equity: equity) unless rule
     9	    return refused("stop must be below the entry", equity: equity) unless limit_price && stop_price && stop_price < limit_price
    10	    percent = BigDecimal(rule.param(:percent).to_s)
    11	    return refused("max_risk_per_trade percent must be positive", equity: equity, percent: percent) unless percent.positive?
    12	    budget = (equity * percent / 100).round(2)
    13	    per_share = limit_price - stop_price
    14	    quantity = (budget / per_share).floor
    15	    return refused("risk budget of #{budget.to_s('F')} buys no whole share at #{per_share.to_s('F')} risk each", equity: equity, percent: percent, budget: budget, per_share: per_share) if quantity < 1
    16	    new(equity: equity, risk_percent: percent, risk_budget: budget, per_share_risk: per_share, quantity: quantity, reason: nil)
    17	  end
    18	
    19	  def self.refused(reason, equity: nil, percent: nil, budget: nil, per_share: nil)
    20	    new(equity: equity, risk_percent: percent, risk_budget: budget, per_share_risk: per_share, quantity: nil, reason: reason)
    21	  end
