app/models/guardrails/notional_cap.rb
     1	# Rule 7: fat-finger protection on what the desk commits, per buy order and per day (today's resting, unknown,
     2	# and filled buys count). Selling what is held is not a commitment and is not capped here.
     3	class Guardrails::NotionalCap < Guardrails::Rule
     4	  def self.fatal_when_missing? = true
     5	
     6	  def evaluate
     7	    return skipped unless proposal.buy?
     8	    return block(reason: "no price to cap") if cost.zero?
     9	    return block(cost: cost, per_order: param(:per_order)) if cost > param(:per_order)
    10	    today = context.notional_today + cost
    11	    detail = { cost: cost, today: today, per_order: param(:per_order), per_day: param(:per_day) }
    12	    today <= param(:per_day) ? pass(**detail) : block(**detail)
    13	  end
    14	end

app/models/guardrails/pending_reconciliation.rb
     1	# Built in: while a submission on this instrument is unresolved, nothing else on it may be approved.
     2	class Guardrails::PendingReconciliation < Guardrails::Rule
     3	  def evaluate
     4	    locked = OrderProposal.unresolved.where(instrument: proposal.instrument).where.not(id: proposal.id).exists?
     5	    locked ? block(reason: "a submission on #{proposal.instrument.symbol} is still unresolved") : pass
     6	  end
     7	end

app/models/guardrails/rule.rb
     1	# One guardrail, keyed by rule_type, judging one proposal over a context. Subclasses implement #evaluate and
     2	# answer with pass, caution, block, unavailable, or skipped plus the numbers; the base turns that into a Result
     3	# carrying the rule's version. A malformed rule row is unavailable, never a crash for the whole report.
     4	class Guardrails::Rule
     5	  attr_reader :rule, :proposal, :context
     6	
     7	  def self.for(rule_type) = "Guardrails::#{rule_type.to_s.camelize}".constantize
     8	  # A rule the plan calls a hard block (docs/phase-2-plan.md §0.10) blocks when its row is missing too.
     9	  def self.fatal_when_missing? = false
    10	
    11	  def initialize(rule:, proposal:, context:)
    12	    @rule, @proposal, @context = rule, proposal, context
    13	  end
    14	
    15	  def call
    16	    build(*evaluate)
    17	  rescue KeyError => e
    18	    build(:unavailable, { reason: e.message })
    19	  end
    20	
    21	  def rule_type = self.class.name.demodulize.underscore
    22	  def param(name) = BigDecimal(rule.param(name).to_s)
    23	  def entry? = proposal.kind_entry?
    24	  def cost = proposal.quantity.to_d * proposal.limit_price.to_d
    25	
    26	  def pass(**detail) = [ :pass, detail ]
    27	  def caution(overridable: false, **detail) = [ :caution, detail, overridable ]
    28	  def block(**detail) = [ :block, detail ]
    29	  def unavailable(reason, **detail) = [ :unavailable, detail.merge(reason: reason) ]
    30	  def skipped = [ :skipped, { reason: "does not apply to a #{proposal.kind.humanize.downcase}" } ]
    31	
    32	  private
    33	    def build(outcome, detail, overridable = false, trip = nil)
    34	      Guardrails::Result.new(rule_type: rule_type, outcome: outcome, detail: detail, version: rule&.version, params: rule&.params || {}, overridable: overridable, trip: trip)
    35	    end
    36	end

app/models/guardrails/settled_cash.rb
     1	# Rule 4, a law rather than a parameter: a buy must be fully covered by settled cash after every buy that
     2	# already claims it; a stale or missing balance is a block, since unavailable here cannot be acknowledged.
     3	class Guardrails::SettledCash < Guardrails::Rule
     4	  def evaluate
     5	    return skipped unless proposal.buy?
     6	    projected = context.projected_settled_cash
     7	    return block(reason: "settled cash unavailable (balance stale or missing)") if projected.nil?
     8	    projected >= cost ? pass(cost: cost, projected_settled_cash: projected) : block(cost: cost, projected_settled_cash: projected)
     9	  end
    10	end

app/models/guardrails/stop_collar.rb
     1	# Rule 8: the stop must sit inside the computed collar; bad or missing data is a block, and only a stop
     2	# computed and outside the range is the overrideable caution (docs/phase-2-plan.md §0.10). When the percent
     3	# floor is tighter than every method, the collar is the floor up to the entry.
     4	class Guardrails::StopCollar < Guardrails::Rule
     5	  def self.fatal_when_missing? = true
     6	
     7	  def evaluate
     8	    return skipped unless entry?
     9	    collar = proposal.collar
    10	    return block(reason: "no collar computed") if collar.blank?
    11	    return block(reason: collar["refusal"]) unless collar["quality"] == "ok"
    12	    stop = proposal.stop_price.to_d
    13	    ceiling = collar["floor_dominates"] ? proposal.limit_price.to_d : BigDecimal(collar["tight"].to_s)
    14	    inside = stop >= BigDecimal(collar["wide"].to_s) && stop <= ceiling
    15	    detail = { stop: stop, tight: collar["tight"], wide: collar["wide"], floor: collar["floor"], floor_dominates: collar["floor_dominates"], methods: collar["methods"] }
    16	    inside ? pass(**detail) : caution(overridable: true, reason: "stop outside the collar", **detail)
    17	  end
    18	end

app/models/guardrails/wash_sale.rb
     1	# Rule 6, both directions, taxable losses only (docs/phase-2-plan.md §0.11). A buy after a recent taxable loss
     2	# on the same CUSIP cautions or blocks per the rule's mode; a sell that would realize a loss cautions when
     3	# replacement shares were bought in either account within the window (the lot being sold is not a replacement).
     4	# Instrument match only; a scale-out at a loss on a still-open trade carries no realized P&L and is not seen.
     5	class Guardrails::WashSale < Guardrails::Rule
     6	  def evaluate
     7	    window = (rule.params["days"] || 30).to_i.days
     8	    if proposal.buy?
     9	      loss = context.account.trades.closed.where(instrument: proposal.instrument).where(closed_at: window.ago..).where("realized_pnl < 0").order(closed_at: :desc).first
    10	      return pass unless loss
    11	      detail = { loss_closed_at: loss.closed_at, loss: loss.realized_pnl, window_days: window / 1.day }
    12	      rule.mode_block? ? block(**detail) : caution(**detail)
    13	    else
    14	      trade = context.open_trade_for(proposal.instrument)
    15	      return pass unless trade&.avg_entry && proposal.limit_price && proposal.limit_price < trade.avg_entry
    16	      own_lots = trade.trade_legs.where.not(activity_id: nil).pluck(:activity_id)
    17	      replacements = Activity.fill.valid_for_journal.where(instrument: proposal.instrument, side: Schwab::Order::BUY, executed_at: window.ago..).where.not(id: own_lots).includes(:account)
    18	      return pass(would_realize_loss: true) if replacements.none?
    19	      caution(would_realize_loss: true, recent_buys: replacements.map { |b| { account: b.account.label, at: b.executed_at, quantity: b.quantity } })
    20	    end
    21	  end
    22	end

