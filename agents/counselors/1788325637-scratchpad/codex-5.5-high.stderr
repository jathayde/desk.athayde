    71	      "max_sector_exposure" => {}, "daily_loss_halt" => { "percent" => "3" }, "max_drawdown_halt" => { "percent" => "10" }, "earnings_blackout" => {},
    72	      "wash_sale" => { "days" => "30" }, "notional_cap" => { "per_order" => "2500", "per_day" => "5000" }, "stop_collar" => StopCollar::Calculator::DEFAULTS }.each do |type, params|
    73	      RiskRule.create!(rule_type: type, params: params, mode: type == "wash_sale" ? "warn" : "block")
    74	    end
    75	    account = Account.first
