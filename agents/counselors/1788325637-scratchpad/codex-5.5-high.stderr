    15	                       annotations: tool.annotations) do |server_context: nil, **arguments|
    16	        result = Agent::Tools.call(tool.tool_name, arguments, transport: :mcp)
    17	        if result.ok?
    18	          MCP::Tool::Response.new([ { type: "text", text: result.text } ], structured_content: result.value)
    19	        else
    20	          MCP::Tool::Response.new([ { type: "text", text: result.text } ], error: true, meta: { retry_after: result.retry_after }.compact.presence)
    21	        end
    22	      end
    23	    end
    24	  end
    25	end

