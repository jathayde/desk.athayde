   160	  end
   161	
   162	  # The review form: the stop and setup are known now. A closed legacy holding takes setup and thesis only;
   163	  # a stop typed in after the fact would give it an R it never had. Returns false with errors when the
   164	  # rules are not met, so every caller (form or tool) gets the same answer.
   165	  def review(setup:, planned_stop:, thesis:, user:)
   166	    previous_setup = self.setup
   167	    assign_attributes(setup: setup, thesis: thesis, needs_review: false, review_reason: nil, review_deferred_at: nil, journal_completed_at: Time.current)
   168	    self.planned_stop = planned_stop unless closed? && bootstrapped?
   169	    return false unless save(context: :review)
   170	    recompute!
   171	    AuditEvent.log("trade_reviewed", actor: :human, user: user, subject: self, data: { setup: setup&.name, planned_stop: self.planned_stop&.to_s })
   172	    recompute_setup_stats(previous_setup, setup)
   173	    true
   174	  end
   175	
   176	  def review!(**)
