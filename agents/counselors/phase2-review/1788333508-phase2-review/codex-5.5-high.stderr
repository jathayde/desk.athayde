     5	    locked ? block(reason: "a submission on #{proposal.instrument.symbol} is still unresolved") : pass
     6	  end
     7	end
     1	# Rule 4, a law rather than a parameter: a buy must be fully covered by settled cash after every buy that
     2	# already claims it; a stale or missing balance is a block, since unavailable here cannot be acknowledged.
