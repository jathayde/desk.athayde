     1	require "rails_helper"
     2	
     3	# Every status times every transition: allowed only where docs/phase-2-state-table.md has a row.
     4	RSpec.describe OrderProposal, "transition matrix" do
     5	  let(:account) { create(:account) }
     6	  let(:instrument) { create(:instrument) }
     7	  let(:john) { create(:user, email_address: "john@athayde.com", approver: true) }
     8	  let(:report) { Guardrails::Report.new([]) }
     9	
    10	  # action => { from state => to state }, straight from the table
    11	  def self.allowed
    12	    { evaluate: { "proposed" => "validated" }, reject: { "validated" => "rejected" }, expire: { "proposed" => "expired", "validated" => "expired" },
    13	      start_submission: { "validated" => "submitting" }, record_shadow: { "submitting" => "submitted" }, record_submitted: { "submitting" => "submitted", "submission_unknown" => "submitted" },
    14	      record_unknown: { "submitting" => "submission_unknown" }, record_rejected: { "submitting" => "submission_failed" },
    15	      record_not_placed: { "submission_unknown" => "submission_failed" }, record_reconciled: { "submission_unknown" => "submitted" },
    16	      record_broker_outcome: { "submitted" => "filled" } }
    17	  end
    18	
    19	  def proposal_in(status)
    20	    OrderProposal.create!(account: account, instrument: instrument, kind: :entry, origin: :human, side: :buy, status: status).tap do |p|
    21	      p.submission_attempts.create!(attempted_at: Time.current, outcome: :pending) if status.in?(%w[ submitting submission_unknown submitted ])
    22	    end
    23	  end
    24	
    25	  def attempt_of(proposal) = proposal.submission_attempts.first || proposal.submission_attempts.create!(attempted_at: Time.current, outcome: :failed)
    26	
    27	  def perform(action, proposal)
    28	    case action
    29	    when :evaluate then proposal.evaluate!(report)
    30	    when :reject then proposal.reject!(user: john, reason: "no")
    31	    when :expire then proposal.expire!
    32	    when :start_submission then proposal.start_submission!(user: john, acknowledged: [], override_reason: nil, payload: {}, shadow: true)
    33	    when :record_shadow then proposal.record_shadow!(attempt_of(proposal))
    34	    when :record_submitted then proposal.record_submitted!(attempt_of(proposal), broker_order_id: "1")
    35	    when :record_unknown then proposal.record_unknown!(attempt_of(proposal), error: "timeout")
    36	    when :record_rejected then proposal.record_rejected!(attempt_of(proposal), error: "400")
    37	    when :record_not_placed then proposal.record_not_placed!(attempt_of(proposal))
    38	    when :record_reconciled then proposal.record_reconciled!(attempt_of(proposal), order: create(:order, account: account, instrument: instrument, broker_order_id: "9"))
    39	    when :record_broker_outcome then proposal.record_broker_outcome!(:filled)
    40	    end
    41	  end
    42	
    43	  OrderProposal.statuses.each_key do |status|
    44	    allowed.each do |action, transitions|
    45	      it "#{transitions.key?(status) ? 'allows' : 'refuses'} #{action} from #{status}" do
    46	        proposal = proposal_in(status)
    47	        if transitions.key?(status)
    48	          expect { perform(action, proposal) }.not_to raise_error
    49	          expect(proposal.reload.status).to eq(transitions[status])
