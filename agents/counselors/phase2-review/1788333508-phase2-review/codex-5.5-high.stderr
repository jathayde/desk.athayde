   135	  def recompute!
   136	    legs = ordered_legs.to_a
   137	    ledger = Ledger.new(legs)
   138	    closed = ledger.running.zero? && ledger.closing_leg.present?
   139	    initial = ledger.initial_entry_legs
   140	    initial_quantity = initial.sum(&:quantity) if initial.any?
   141	    unpriced_plug = legs.any? { |l| l.plug? && l.price.nil? }
   142	
   143	    assign_attributes(
   144	      quantity: ledger.running,
   145	      peak_quantity: ledger.peak,
   146	      status: closed ? :closed : :open,
   147	      opened_at: ledger.first_fill&.executed_at,
   148	      closed_at: closed ? ledger.closing_leg.executed_at : nil,
   149	      avg_entry: ledger.avg_entry,
   150	      avg_exit: ledger.avg_exit,
   151	      initial_quantity: initial_quantity,
   152	      initial_risk: initial_risk_for(initial, plug: legs.any?(&:plug?)),
   153	      total_risk: total_risk_for(legs),
   154	      realized_pnl: closed && !unpriced_plug ? ledger.cash : nil,
   155	      stopped_out: closed && ledger.closing_leg.activity&.order&.stop? == true
   156	    )
   157	    self.realized_r = closed && realized_r_available? ? realized_pnl / initial_risk : nil
