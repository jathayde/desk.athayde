   155	  end
   156	
   157	  # Schwab refused the payload (a 4xx): the operator reads the error and may re-propose.
   158	  def record_rejected!(attempt, error:)
   159	    outcome!(attempt, from: %w[ submitting ], to: :submission_failed, event: "submission_failed", reason: error) do
   160	      attempt.update!(outcome: :failed, response: { "error" => error })
   161	    end
   162	  end
   163	
   164	  # The reconcile job confirmed twice, ten minutes apart, that nothing was placed.
   165	  def record_not_placed!(attempt)
   166	    outcome!(attempt, from: %w[ submission_unknown ], to: :submission_failed, event: "submission_failed", reason: "confirmed not placed") do
   167	      attempt.update!(outcome: :not_placed)
   168	    end
   169	  end
   170	
   171	  # The reconcile job found the order an unknown submission placed.
   172	  def record_reconciled!(attempt, order:)
   173	    outcome!(attempt, from: %w[ submission_unknown ], to: :submitted, event: "submission_reconciled",
   174	             attributes: { submitted_at: Time.current, broker_order_id: order.broker_order_id }, data: { broker_order_id: order.broker_order_id }) do
   175	      attempt.update!(outcome: :submitted, broker_order_id: order.broker_order_id, reconciled_order: order, reconciled_at: Time.current)
   176	    end
   177	  end
   178	
   179	  # A shadowed submission matched to the order the operator placed by hand: no state change, one audit row.
   180	  def link_shadow_order!(attempt, order:)
   181	    raise IllegalTransition, "#{status} is not a shadowed submission" unless submitted? && shadow? && attempt.would_have_submitted?
   182	    transaction do
   183	      attempt.update!(reconciled_order: order, reconciled_at: Time.current, broker_order_id: order.broker_order_id)
   184	      update!(broker_order_id: order.broker_order_id)
   185	      AuditEvent.log("submission_reconciled", actor: :system, subject: self, data: { broker_order_id: order.broker_order_id, shadow: true })
   186	    end
   187	    self
   188	  end
   189	
   190	  # Written only by the orders sync, and only to the two states the broker can put an order in.
   191	  def record_broker_outcome!(status)
   192	    status = status.to_s
   193	    raise ArgumentError, "#{status} is not a broker outcome" unless BROKER_OUTCOMES.include?(status)
   194	    transition!(from: %w[ submitted ], to: status, event: "proposal_#{status}")
   195	    ActiveRecord.after_all_transactions_commit { AlertMailer.fill_or_cancel(self).deliver_later }
   196	    self
   197	  end
   198	
   199	  private
   200	    def outcome!(attempt, from:, to:, event:, attributes: {}, reason: nil, data: {})
   201	      raise ArgumentError, "attempt #{attempt.id} belongs to another proposal" unless attempt.order_proposal_id == id
   202	      transaction do
   203	        transition!(from: from, to: to, event: event, attributes: attributes, reason: reason, data: data)
   204	        yield
   205	      end
   206	      self
   207	    end
   208	
   209	    # Lock, re-read, refuse from the wrong state, write, audit: one transaction, never a stale instance's guess.
   210	    def transition!(from:, to:, event:, attributes: {}, user: nil, reason: nil, data: {})
   211	      with_lock do
   212	        raise IllegalTransition, "proposal #{id} cannot go from #{status} to #{to}" unless from.include?(status)
   213	        update!(attributes.merge(status: to))
   214	        AuditEvent.log(event, actor: user ? :human : :system, user: user, subject: self, reason: reason, data: data)
   215	      end
   216	      self
   217	    end
   218	end

