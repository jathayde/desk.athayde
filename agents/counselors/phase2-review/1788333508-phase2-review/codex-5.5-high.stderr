     1	# An unknown submission is resolved only by looking (docs/phase-2-plan.md §0.7): after a quiet period, sync
     2	# the orders feed and search; exactly one unlinked match links it, two stay with the operator and are looked
     3	# at again, and nothing found is believed only when the sync itself was whole and a second look ten minutes
     4	# later agrees. A look that could not see (a failed, partial, or quarantining sync) counts for nothing.
     5	class Submission::ReconcileJob < ApplicationJob
     6	  QUIET_PERIOD = 60.seconds
     7	  CONFIRMATION_GAP = 10.minutes
     8	  REAL_WINDOW = 15.minutes
     9	  ORDER_QUARANTINES = %w[ orders_unmapped orders_unresolved ].freeze
    10	
    11	  limits_concurrency to: 1, key: ->(proposal) { "reconcile-#{proposal.instrument_id}" }, on_conflict: :discard
    12	  retry_on ActiveRecord::Deadlocked, ActiveRecord::RecordNotUnique, wait: 1.minute, attempts: 3 # a database race is not a verdict
    13	
    14	  def perform(proposal)
    15	    return unless proposal.submission_unknown?
    16	    attempt = proposal.submission_attempts.unknown.first or return
    17	    return look_again(proposal) if SyncRun.running?(:orders, proposal.account) # the scheduled sync has the feed; look after it
    18	    run = Sync::OrdersJob.perform_now(proposal.account)
    19	    attempt.looked!(could_see: whole?(run))
    20	    matcher = Submission::Matcher.new(proposal, attempt, window: REAL_WINDOW)
    21	    if (order = matcher.match)
    22	      OrderProposal.transaction do
    23	        order.update!(order_proposal: proposal, placed_via: :app)
    24	        proposal.record_reconciled!(attempt, order: order)
    25	      end
    26	    elsif matcher.ambiguous?
    27	      attempt.ambiguous!(matcher.candidates) # the operator resolves it at Schwab; the next look may find one
    28	      look_again(proposal)
    29	    elsif !attempt.last_look_could_see
    30	      look_again(proposal)
    31	    elsif attempt.absent_since?(CONFIRMATION_GAP)
    32	      proposal.record_not_placed!(attempt)
    33	    else
    34	      attempt.absent!
    35	      look_again(proposal)
    36	    end
    37	  end
    38	
    39	  private
    40	    # A sync that succeeded and quarantined no order: only then does "not found" mean not there.
    41	    def whole?(run) = run.is_a?(SyncRun) && run.succeeded? && run.unmapped_values.slice(*ORDER_QUARANTINES).none?
    42	    def look_again(proposal) = self.class.set(wait: CONFIRMATION_GAP).perform_later(proposal)
    43	end

