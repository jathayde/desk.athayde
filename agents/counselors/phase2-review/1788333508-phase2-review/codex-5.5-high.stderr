     1	# Rule 3: today's realized loss past the percent of yesterday's equity blocks entries and asks for a rule halt
     2	# until the end of the New York day (the tick clears it before the next open); exits are not judged here.
     3	class Guardrails::DailyLossHalt < Guardrails::Rule
     4	  def evaluate
     5	    return skipped unless entry?
     6	    return unavailable("no prior snapshot to measure the day against") unless context.prior_equity&.positive?
     7	    loss = -context.realized_today / context.prior_equity * 100
     8	    detail = { loss_percent: loss.round(2), cap: param(:percent) }
     9	    return pass(**detail) if loss < param(:percent)
    10	    trip = { rule: rule_type, reason: "down #{loss.round(2)}% today", resets_at: Time.current.in_time_zone(MarketDay::ZONE).end_of_day }
    11	    [ :block, detail, false, trip ]
    12	  end
    13	end
     1	# Rule 3: a drawdown from the high-water mark past the percent blocks entries and asks for a rule halt with no
     2	# reset time; the operator clears it by hand. Read from the latest snapshot, so an intraday collapse is seen tonight.
     3	class Guardrails::MaxDrawdownHalt < Guardrails::Rule
     4	  def evaluate
     5	    return skipped unless entry?
     6	    return unavailable("no snapshot yet") if context.drawdown.nil?
     7	    drawdown = context.drawdown * 100
     8	    detail = { drawdown_percent: drawdown.round(2), cap: param(:percent) }
     9	    return pass(**detail) if drawdown < param(:percent)
    10	    [ :block, detail, false, { rule: rule_type, reason: "#{drawdown.round(2)}% below the high-water mark", resets_at: nil } ]
    11	  end
    12	end
     1	# Rule 2a: a new instrument may not push the count of held and pending positions past the cap.
     2	class Guardrails::MaxPositions < Guardrails::Rule
     3	  def self.fatal_when_missing? = true
     4	
     5	  def evaluate
     6	    return skipped unless entry?
     7	    held = context.positions.count
     8	    pending = context.pending_new_positions
     9	    detail = { held: held, pending: pending, cap: param(:count) }
    10	    return pass(**detail, adding: false) if context.position_for(proposal.instrument)
    11	    held + pending + 1 <= param(:count) ? pass(**detail) : block(**detail)
    12	  end
    13	end
     1	# Rule 2a: one instrument's share of equity after this entry, counting what unfilled entries on it have already
     2	# committed; no fresh equity, no answer, and no answer is a block.
     3	class Guardrails::MaxPositionExposure < Guardrails::Rule
     4	  def self.fatal_when_missing? = true
     5	
     6	  def evaluate
     7	    return skipped unless entry?
     8	    equity = context.fresh_equity or return block(reason: "no fresh equity to measure exposure against")
