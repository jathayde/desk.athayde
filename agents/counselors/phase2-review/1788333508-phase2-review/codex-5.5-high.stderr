     1	# After every orders sync: the orders the app placed are linked by the broker id Schwab gave us and their
     2	# broker outcomes recorded; the orders the operator placed by hand for shadowed proposals are matched and
     3	# linked; a parent filled with no live child is the unprotected alert (step 4).
     4	class Orders::ProposalLink
     5	  def self.call(account) = new(account).call
     6	
     7	  def initialize(account) = @account = account
     8	
     9	  def call
    10	    link_by_broker_id
    11	    link_shadows
    12	    record_outcomes
    13	  end
    14	
    15	  private
    16	    def link_by_broker_id
    17	      @account.order_proposals.where(status: %w[ submitted filled cancelled ]).where.not(broker_order_id: nil).find_each do |proposal|
    18	        order = @account.orders.find_by(broker_order_id: proposal.broker_order_id) or next
    19	        next if order.order_proposal_id == proposal.id
    20	        order.update!(order_proposal: proposal, placed_via: proposal.shadow? ? :schwab_direct : :app) # a hand-placed shadow stays the operator's
    21	      end
    22	    end
    23	
    24	    def link_shadows
    25	      @account.order_proposals.awaiting_hand_placement.find_each do |proposal|
    26	        attempt = proposal.submission_attempts.would_have_submitted.first or next
    27	        order = Submission::Matcher.new(proposal, attempt).match or next
    28	        order.update!(order_proposal: proposal)
    29	        proposal.link_shadow_order!(attempt, order: order)
    30	      end
    31	    end
    32	
    33	    def record_outcomes
    34	      @account.order_proposals.submitted.where.not(broker_order_id: nil).find_each do |proposal|
    35	        order = @account.orders.find_by(broker_order_id: proposal.broker_order_id) or next
    36	        outcome = :filled if order.status == Schwab::Order::FILLED
    37	        outcome = :cancelled if Schwab::Order::DEAD_STATUSES.include?(order.status)
    38	        proposal.record_broker_outcome!(outcome) if outcome
    39	      rescue OrderProposal::IllegalTransition => e
    40	        Rails.error.report(e, handled: true, context: { proposal: proposal.id }) # one raced row is not the sync's problem
    41	      end
    42	    end
    43	end

