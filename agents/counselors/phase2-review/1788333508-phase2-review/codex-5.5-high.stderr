     1	module Schwab
     2	  class Error < StandardError
     3	    attr_reader :status, :body, :request_id, :attempts
     4	
     5	    def initialize(message = nil, status: nil, body: nil, request_id: nil, attempts: 1)
     6	      super(message || self.class.name.demodulize.titleize)
     7	      @status, @body, @request_id, @attempts = status, body, request_id, attempts
     8	    end
     9	
    10	    # Builds the right subclass for an HTTP response. The body is scrubbed before anything reads it.
    11	    def self.for_response(response, attempts:, idempotent:)
    12	      status = response.code.to_i
    13	      body = Scrub.body(response.body)
    14	      json = JSON.parse(body) rescue nil
    15	      message = "Schwab responded #{status}: #{summarize(json, body)}"
    16	      opts = { status: status, body: body, request_id: request_id_in(json), attempts: attempts }
    17	      case status
    18	      when 401 then AuthError.new(message, **opts)
    19	      when 429 then RateLimited.new(message, retry_after: retry_after_in(response), **opts)
    20	      when 400..499 then RequestError.new(message, **opts)
    21	      when 500.. then (idempotent ? ServerError : UnknownOutcome).new(message, **opts)
    22	      else new(message, **opts)
    23	      end
    24	    end
    25	
    26	    def self.summarize(json, body)
    27	      return body.to_s.truncate(200) unless json.is_a?(Hash)
    28	      Array(json["errors"]).filter_map { |e| e["detail"] || e["title"] }.join("; ").presence ||
    29	        json["error_description"] || json["error"] || body.to_s.truncate(200)
    30	    end
    31	
    32	    def self.request_id_in(json) = json.is_a?(Hash) ? Array(json["errors"]).first&.dig("id") : nil
    33	
    34	    def self.retry_after_in(response)
    35	      seconds = response["Retry-After"].to_i
    36	      seconds.positive? ? seconds : nil
    37	    end
    38	  end
    39	
    40	  class AuthError < Error; end
    41	  class ReauthRequired < AuthError; end   # token endpoint says the grant is dead: the pause path
    42	  class RateLimited < Error
    43	    attr_reader :retry_after
    44	
    45	    def initialize(message = nil, retry_after: nil, **opts)
    46	      super(message, **opts)
    47	      @retry_after = retry_after
    48	    end
    49	  end
    50	  class ServerError < Error; end
    51	  class RequestError < Error; end          # 4xx other than auth and rate limit: our parameters are wrong; never retried
    52	  class TransportError < Error; end        # timeout or connection failure on an idempotent call
    53	  class UnknownOutcome < Error; end        # the same on a non-idempotent call; Phase 2 depends on this being distinct
    54	  class MappingError < Error; end          # required field missing or malformed; rescued per record by sync
    55	  class NotConfigured < Error; end         # app credentials missing; raised before any request is built
    56	end

