     1	module Schwab
     2	  # One order as Schwab returns it. Bracket children and replacements arrive nested; #flatten walks them.
     3	  # Container strategies (OCO, TRIGGER parents) can have no legs, so instrument may be nil.
     4	  class Order < Data.define(:order_id, :status, :order_type, :session, :duration, :strategy_type, :instruction, :quantity,
     5	                            :filled_quantity, :remaining_quantity, :price, :stop_price, :tax_lot_method, :entered_at,
     6	                            :close_time, :instrument, :children, :replacements, :parent_order_id, :replaces_order_id, :raw)
     7	    # SCHWAB_SHAPE_UNVERIFIED: see docs/schwab-api-contract.md for the status and type vocabularies.
     8	    WORKING_STATUSES = %w[ WORKING ACCEPTED QUEUED PENDING_ACTIVATION AWAITING_PARENT_ORDER AWAITING_STOP_CONDITION
     9	                           AWAITING_CONDITION NEW AWAITING_RELEASE_TIME ].freeze
    10	    LIVE_STATUSES = %w[ WORKING ACCEPTED QUEUED PENDING_ACTIVATION ].freeze # in the market, not awaiting a parent or condition
    11	    STOP_TYPES = %w[ STOP STOP_LIMIT TRAILING_STOP TRAILING_STOP_LIMIT ].freeze
    12	    LIMIT = "LIMIT"
    13	    TAX_LOT_METHODS = %w[ FIFO LIFO HIGH_COST LOW_COST ].freeze # SCHWAB_SHAPE_UNVERIFIED: taxLotMethod enum values (verify-on-approval item 51)
    14	    DEFAULT_TAX_LOT_METHOD = "FIFO"
    15	    WORKING = "WORKING"
    16	    SELL = "SELL"
    17	    BUY = "BUY"
    18	    FILLED = "FILLED"
    19	    DEAD_STATUSES = %w[ CANCELED REJECTED EXPIRED REPLACED ].freeze # the broker will never fill these
    20	    GONE = "UNKNOWN_TO_SCHWAB" # local sentinel: Schwab no longer returns this order by id
    21	
    22	    def self.from(raw, parent_order_id: nil, replaces_order_id: nil)
    23	      leg = Array(raw["orderLegCollection"]).first || {}
    24	      order_id = raw.fetch("orderId") { raise MappingError, "order without orderId" }.to_s
    25	      new(order_id: order_id, status: raw["status"], order_type: raw["orderType"], session: raw["session"],
    26	          duration: raw["duration"], strategy_type: raw["orderStrategyType"], instruction: leg["instruction"],
    27	          quantity: Decimal.parse(raw["quantity"]) || Decimal.parse(leg["quantity"]),
    28	          filled_quantity: Decimal.parse(raw["filledQuantity"]), remaining_quantity: Decimal.parse(raw["remainingQuantity"]),
    29	          price: Decimal.parse(raw["price"]), stop_price: Decimal.parse(raw["stopPrice"]), tax_lot_method: raw["taxLotMethod"],
    30	          entered_at: Timestamp.parse(raw["enteredTime"]), close_time: Timestamp.parse(raw["closeTime"]),
    31	          instrument: InstrumentRef.from(leg["instrument"]),
    32	          children: Array(raw["childOrderStrategies"]).map { |c| from(c, parent_order_id: order_id) },
    33	          replacements: Array(raw["replacingOrderCollection"]).map { |r| from(r, parent_order_id: parent_order_id, replaces_order_id: order_id) },
    34	          parent_order_id: parent_order_id, replaces_order_id: replaces_order_id, raw: raw)
    35	    end
    36	
    37	    # Self plus every nested child and replacement, depth first, lineage already stamped.
    38	    def flatten = [ self, *children.flat_map(&:flatten), *replacements.flat_map(&:flatten) ]
    39	
    40	    def side
    41	      case instruction
    42	      when /\ABUY/ then "BUY"
    43	      when /\ASELL/ then "SELL"
    44	      end
    45	    end
    46	
    47	    def container? = instrument.nil?
    48	    def working? = WORKING_STATUSES.include?(status)
    49	    def stop? = STOP_TYPES.include?(order_type)
    50	  end
    51	end

