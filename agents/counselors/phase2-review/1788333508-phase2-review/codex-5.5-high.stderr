     1	# Rule 6, both directions, taxable losses only (docs/phase-2-plan.md §0.11). A buy after a recent taxable loss
     2	# on the same CUSIP cautions or blocks per the rule's mode; a sell that would realize a loss cautions when
     3	# replacement shares were bought in either account within the window (the lot being sold is not a replacement).
     4	# Instrument match only; a scale-out at a loss on a still-open trade carries no realized P&L and is not seen.
     5	class Guardrails::WashSale < Guardrails::Rule
     6	  def evaluate
     7	    window = (rule.params["days"] || 30).to_i.days
     8	    if proposal.buy?
     9	      loss = context.account.trades.closed.where(instrument: proposal.instrument).where(closed_at: window.ago..).where("realized_pnl < 0").order(closed_at: :desc).first
    10	      return pass unless loss
    11	      detail = { loss_closed_at: loss.closed_at, loss: loss.realized_pnl, window_days: window / 1.day }
    12	      rule.mode_block? ? block(**detail) : caution(**detail)
    13	    else
    14	      trade = context.open_trade_for(proposal.instrument)
    15	      return pass unless trade&.avg_entry && proposal.limit_price && proposal.limit_price < trade.avg_entry
    16	      own_lots = trade.trade_legs.where.not(activity_id: nil).pluck(:activity_id)
    17	      replacements = Activity.fill.valid_for_journal.where(instrument: proposal.instrument, side: Schwab::Order::BUY, executed_at: window.ago..).where.not(id: own_lots).includes(:account)
    18	      return pass(would_realize_loss: true) if replacements.none?
    19	      caution(would_realize_loss: true, recent_buys: replacements.map { |b| { account: b.account.label, at: b.executed_at, quantity: b.quantity } })
    20	    end
    21	  end
    22	end
     1	# Rule 8: the stop must sit inside the computed collar; bad or missing data is a block, and only a stop
     2	# computed and outside the range is the overrideable caution (docs/phase-2-plan.md §0.10). When the percent
     3	# floor is tighter than every method, the collar is the floor up to the entry.
     4	class Guardrails::StopCollar < Guardrails::Rule
     5	  def self.fatal_when_missing? = true
     6	
     7	  def evaluate
     8	    return skipped unless entry?
     9	    collar = proposal.collar
    10	    return block(reason: "no collar computed") if collar.blank?
    11	    return block(reason: collar["refusal"]) unless collar["quality"] == "ok"
    12	    stop = proposal.stop_price.to_d
    13	    ceiling = collar["floor_dominates"] ? proposal.limit_price.to_d : BigDecimal(collar["tight"].to_s)
    14	    inside = stop >= BigDecimal(collar["wide"].to_s) && stop <= ceiling
    15	    detail = { stop: stop, tight: collar["tight"], wide: collar["wide"], floor: collar["floor"], floor_dominates: collar["floor_dominates"], methods: collar["methods"] }
    16	    inside ? pass(**detail) : caution(overridable: true, reason: "stop outside the collar", **detail)
    17	  end
    18	end

