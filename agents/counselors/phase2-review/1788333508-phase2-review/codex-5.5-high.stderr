     1	# One guardrail, keyed by rule_type, judging one proposal over a context. Subclasses implement #evaluate and
     2	# answer with pass, caution, block, unavailable, or skipped plus the numbers; the base turns that into a Result
     3	# carrying the rule's version. A malformed rule row is unavailable, never a crash for the whole report.
     4	class Guardrails::Rule
     5	  attr_reader :rule, :proposal, :context
     6	
     7	  def self.for(rule_type) = "Guardrails::#{rule_type.to_s.camelize}".constantize
     8	  # A rule the plan calls a hard block (docs/phase-2-plan.md §0.10) blocks when its row is missing too.
     9	  def self.fatal_when_missing? = false
    10	
    11	  def initialize(rule:, proposal:, context:)
    12	    @rule, @proposal, @context = rule, proposal, context
    13	  end
    14	
    15	  def call
    16	    build(*evaluate)
    17	  rescue KeyError => e
    18	    build(:unavailable, { reason: e.message })
    19	  end
    20	
    21	  def rule_type = self.class.name.demodulize.underscore
    22	  def param(name) = BigDecimal(rule.param(name).to_s)
    23	  def entry? = proposal.kind_entry?
    24	  def cost = proposal.quantity.to_d * proposal.limit_price.to_d
    25	
    26	  def pass(**detail) = [ :pass, detail ]
    27	  def caution(overridable: false, **detail) = [ :caution, detail, overridable ]
    28	  def block(**detail) = [ :block, detail ]
    29	  def unavailable(reason, **detail) = [ :unavailable, detail.merge(reason: reason) ]
    30	  def skipped = [ :skipped, { reason: "does not apply to #{proposal.kind_exit? ? "an exit" : "a #{proposal.kind.humanize.downcase}"}" } ]
    31	
    32	  private
    33	    def build(outcome, detail, overridable = false, trip = nil)
    34	      Guardrails::Result.new(rule_type: rule_type, outcome: outcome, detail: detail, version: rule&.version, params: rule&.params || {}, overridable: overridable, trip: trip)
    35	    end
    36	end

