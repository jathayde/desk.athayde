 succeeded in 0ms:
     1	module Schwab
     2	  # One transaction activity. The primary security transfer item gives instrument, quantity, and price
     3	  # (trades only; on a dividend the item's amount is dollars); fee items are summed; every security item
     4	  # is kept in `securities` because a CUSIP succession arrives as two of them in one activity.
     5	  # Sign conventions are SCHWAB_SHAPE_UNVERIFIED; side prefers positionEffect, then the sign of netAmount.
     6	  class Activity < Data.define(:activity_id, :type, :activity_type, :status, :sub_account, :description, :order_id,
     7	                               :net_amount, :trade_date, :settlement_date, :executed_at, :instrument, :securities, :quantity, :price,
     8	                               :position_effect, :commission, :fees, :raw)
     9	    Security = Data.define(:instrument, :amount, :cost, :price, :position_effect)
    10	
    11	    # The transaction types a cash account produces; one request each. SCHWAB_SHAPE_UNVERIFIED.
    12	    CASH_ACCOUNT_TYPES = %w[ TRADE RECEIVE_AND_DELIVER DIVIDEND_OR_INTEREST ELECTRONIC_FUND ACH_RECEIPT ACH_DISBURSEMENT WIRE_IN WIRE_OUT
    13	                             JOURNAL CASH_RECEIPT CASH_DISBURSEMENT MONEY_MARKET ].freeze
    14	    VALID = "VALID"
    15	    SHARE_TYPES = %w[ TRADE RECEIVE_AND_DELIVER JOURNAL ].freeze # the security item's amount is a share count
    16	    INBOUND_TYPES = %w[ ACH_RECEIPT WIRE_IN CASH_RECEIPT ].freeze
    17	    OUTBOUND_TYPES = %w[ ACH_DISBURSEMENT WIRE_OUT CASH_DISBURSEMENT ].freeze
    18	    SIGNED_TYPES = %w[ ELECTRONIC_FUND ].freeze # direction only from the sign of netAmount
    19	
    20	    def self.from(raw)
    21	      activity_id = raw.fetch("activityId") { raise MappingError, "activity without activityId" }.to_s
    22	      items = Array(raw["transferItems"])
    23	      securities = items.select { |i| i["feeType"].blank? && !(InstrumentRef.from(i["instrument"])&.currency?) }
    24	        .map { |i| Security.new(instrument: InstrumentRef.from(i["instrument"]), amount: Decimal.parse(i["amount"]), cost: Decimal.parse(i["cost"]),
    25	                                price: Decimal.parse(i["price"]), position_effect: i["positionEffect"]) }
    26	      fee_items = items.select { |i| i["feeType"].present? }
    27	      executed_at = Timestamp.parse(raw["time"]) || Timestamp.parse(raw["tradeDate"]) or raise MappingError, "activity #{activity_id} has no time or tradeDate"
    28	      primary = securities.first
    29	      trade = raw["type"] == "TRADE"
    30	
    31	      new(activity_id: activity_id, type: raw["type"], activity_type: raw["activityType"], status: raw["status"],
    32	          sub_account: raw["subAccount"], description: raw["description"], order_id: raw["orderId"]&.to_s,
    33	          net_amount: Decimal.parse(raw["netAmount"]),
    34	          trade_date: Timestamp.parse_date(raw["tradeDate"]), settlement_date: Timestamp.parse_date(raw["settlementDate"]),
    35	          executed_at: executed_at,
    36	          instrument: primary&.instrument, securities: securities,
    37	          quantity: SHARE_TYPES.include?(raw["type"]) && securities.one? ? primary.amount&.abs : nil, # shares on a trade or a single delivery; a dividend's amount is dollars
    38	          price: trade ? primary&.price : nil,
    39	          position_effect: primary&.position_effect,
    40	          commission: fee_items.select { |i| i["feeType"] == "COMMISSION" }.sum(Decimal::ZERO) { |i| Decimal.parse_or_zero(i["amount"]).abs },
    41	          fees: fee_items.reject { |i| i["feeType"] == "COMMISSION" }.sum(Decimal::ZERO) { |i| Decimal.parse_or_zero(i["amount"]).abs },
    42	          raw: raw)
    43	    end
    44	
    45	    def trade? = type == "TRADE"
    46	    def valid? = status.nil? || status == "VALID"
    47	
    48	    # The app's classification of this activity. :other is never a quiet success; the sync counts it.
    49	    def kind
    50	      return :fee if fee_only?
    51	      cash_equivalent = instrument&.asset_type == "CASH_EQUIVALENT"
    52	      case type
    53	      when "TRADE" then cash_equivalent ? :sweep : :fill
    54	      when "MONEY_MARKET" then :sweep
    55	      when "DIVIDEND_OR_INTEREST" then instrument && !cash_equivalent ? :dividend : :interest
    56	      when *INBOUND_TYPES then :deposit
    57	      when *OUTBOUND_TYPES then :withdrawal
    58	      when *SIGNED_TYPES then signed_flow
    59	      when "JOURNAL", "RECEIVE_AND_DELIVER"
    60	        if securities.size >= 2 then :corporate_action
    61	        elsif securities.one? then :transfer
    62	        elsif type == "JOURNAL" then signed_flow
    63	        else :other
    64	        end
    65	      else :other
    66	      end
    67	    end
    68	    # A sign-classified type with no amount is unclassifiable, never a zero deposit.
    69	    def signed_flow = net_amount.nil? ? :other : (net_amount.negative? ? :withdrawal : :deposit)
    70	    def fee_only? = raw.fetch("transferItems", []).then { |items| items.any? && items.all? { |i| i["feeType"].present? } }
    71	
    72	    # What the sync records about an activity it could not classify.
    73	    def summary = { type: type, activity_type: activity_type, sub_account: sub_account, description: description, net_amount: net_amount&.to_s }
    74	
    75	    def side
    76	      return nil unless trade?
    77	      case position_effect
    78	      when "OPENING" then "BUY"
    79	      when "CLOSING" then "SELL"
    80	      else net_amount&.negative? ? "BUY" : (net_amount ? "SELL" : nil)
    81	      end
    82	    end
    83	  end
    84	end

