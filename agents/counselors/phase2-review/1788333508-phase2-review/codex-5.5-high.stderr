     2	# the hard alert (PRD §5.4.2), once per position per day, audited.
     3	class Orders::ProtectionWatch
     4	  ALERT_GAP = 1.day
     5	
     6	  def self.call(account) = new(account).call
     7	
     8	  def initialize(account) = @account = account
     9	
    10	  def call
    11	    @account.positions.includes(:instrument, :working_stop_order).each do |position|
    12	      next unless position.unprotected? && expected_protection?(position) && !alerted_recently?(position)
    13	      AlertMailer.unprotected_position(position).deliver_later
    14	      AuditEvent.log("unprotected_alert_sent", actor: :system, subject: position, data: { symbol: position.instrument.symbol, protection: position.protection })
    15	    end
    16	  end
    17	
    18	  private
    19	    # "Should be protected": we bought it with a bracket, we just touched its stop, or its stop died at the broker today.
    20	    def expected_protection?(position) = we_bought_it?(position) || we_touched_its_stop?(position) || its_stop_died?(position)
    21	
    22	    def we_bought_it?(position) = @account.order_proposals.filled.where(instrument: position.instrument, kind: :entry).exists?
    23	    def we_touched_its_stop?(position) = @account.order_proposals.where(instrument: position.instrument, decided_at: ALERT_GAP.ago..).where.not(child_action: nil).exists?
    24	    def its_stop_died?(position) = @account.orders.where(instrument: position.instrument).stops.sells.where(status: Schwab::Order::DEAD_STATUSES + [ Schwab::Order::GONE ], closed_at: ALERT_GAP.ago..).exists?
