     1	# One row per feed run. Wraps the work so token loss, Schwab failures, and quarantined records all
     2	# land as a status; anything else is recorded as failed and re-raised so the queue sees it too.
     3	class SyncRun < ApplicationRecord
     4	  STALE_AFTER = 10.minutes # a running row older than this is a crashed or restarted worker, not a run
     5	  ACCOUNT_FEEDS = %i[ positions orders activities ].freeze
     6	
     7	  belongs_to :account, optional: true
     8	
     9	  enum :feed, {
    10	    accounts: "accounts", positions: "positions", orders: "orders", activities: "activities",
    11	    market_hours: "market_hours", memory_repo: "memory_repo", snapshots: "snapshots"
    12	  }, prefix: true
    13	  enum :status, { running: "running", succeeded: "succeeded", partial: "partial", failed: "failed", skipped_token: "skipped_token" }
    14	
    15	  scope :recent_first, -> { order(started_at: :desc, id: :desc) }
    16	  scope :for, ->(feed, account) { where(feed: feed, account: account) }
    17	  scope :advanced_cursor, -> { where(status: %w[ succeeded partial ]) }
    18	  scope :live, -> { running.where(started_at: STALE_AFTER.ago..) }
    19	  scope :stale_running, -> { running.where(started_at: ..STALE_AFTER.ago) }
    20	
    21	  # A worker killed mid-feed leaves a running row; the tick and the digest both sweep it so the system page and
    22	  # the digest see a failure, not a run that never ends.
    23	  def self.sweep_stale!
    24	    stale_running.find_each { |run| run.finish!(:failed, error: "left running") }
    25	  end
    26	
    27	  def self.record(feed, account: nil, window_from: nil, window_to: nil)
    28	    run = create!(feed: feed, account: account, status: :running, started_at: Time.current, window_from: window_from, window_to: window_to)
    29	    outcome = yield run
    30	    run.finish!(outcome == :failed ? :failed : (outcome == :partial || run.unmapped_values.any? ? :partial : :succeeded), error: run.error)
    31	  rescue Schwab::NoUsableToken, Schwab::AuthError => e
    32	    run.finish!(:skipped_token, error: e.message)
    33	  rescue Schwab::Error => e
    34	    run.finish!(:failed, error: e.message)
    35	  rescue StandardError => e
    36	    run.finish!(:failed, error: "#{e.class}: #{e.message}")
    37	    raise
    38	  ensure
    39	    run&.finish!(:failed, error: "left running") if run&.running? && !run.destroyed?
    40	  end
    41	
    42	  def self.last_window_to(feed, account) = self.for(feed, account).advanced_cursor.maximum(:window_to)
    43	  def self.last_started_at(feed, account) = self.for(feed, account).maximum(:started_at)
    44	  def self.running?(feed, account) = self.for(feed, account).live.exists?
    45	
    46	  # Due when nothing is live and the last start is older than the interval, with a minute of slack for cron drift.
    47	  def self.due?(feed, account, every:)
    48	    return false if running?(feed, account)
    49	    last = last_started_at(feed, account)
    50	    last.nil? || last <= (every - 1.minute).ago
    51	  end
    52	
    53	  def finish!(status, error: nil)
    54	    update!(status: status, finished_at: Time.current, error: error&.truncate(1000))
    55	    self
    56	  end
    57	
    58	  def touched(count) = update!(records_touched: records_touched.to_i + count)
