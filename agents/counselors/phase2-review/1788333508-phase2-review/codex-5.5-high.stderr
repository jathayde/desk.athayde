     1	module Schwab
     2	  # Plaintext account numbers arrive in the body of every Trader API response. They are removed
     3	  # here, in the client, before any body reaches raw columns, cassettes, or logs.
     4	  module Scrub
     5	    REDACTED_KEYS = %w[ accountNumber user access_token refresh_token id_token client_secret ].freeze
     6	    ACCOUNT_HASH = /[0-9A-F]{64}/i
     7	    LONG_DIGIT_RUN = /\b\d{8,}\b/
     8	
     9	    def self.json(value)
    10	      case value
    11	      when Hash then value.each_with_object({}) { |(k, v), h| h[k] = REDACTED_KEYS.include?(k) ? nil : json(v) }
    12	      when Array then value.map { |v| json(v) }
    13	      else value
    14	      end
    15	    end
    16	
    17	    # JSON bodies are scrubbed by key; anything else (gateway HTML) loses long digit runs, which is
    18	    # the shape an account number would take in prose.
    19	    def self.body(text)
    20	      return text if text.blank?
    21	      parsed = JSON.parse(text) rescue (return text.gsub(LONG_DIGIT_RUN, "<REDACTED>"))
    22	      JSON.generate(json(parsed))
    23	    end
    24	
    25	    # Log lines carry the route template, never the account hash.
    26	    def self.path(path) = path.gsub(ACCOUNT_HASH, "{hash}")
    27	  end
    28	end

