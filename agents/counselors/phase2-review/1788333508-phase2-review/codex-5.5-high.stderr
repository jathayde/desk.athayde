   101	  def clear_flag!(reason)
   102	    update!(needs_review: false, review_reason: nil) if needs_review? && review_reason == reason.to_s
   103	  end
   104	
   105	  # The synthetic entry leg that reconciles the journal to the broker. It sorts first and is scaled by every later
   106	  # split, so plug = (broker quantity − quantity from linked legs) / cumulative ratio. Deleted at zero, and the
   107	  # bootstrapped flag follows the plug: present while it exists, cleared when it goes.
   108	  def reconcile_plug!(broker_quantity:, average_price:)
   109	    linked = Ledger.new(ordered_legs.reject(&:plug?))
   110	    plug_quantity = (broker_quantity - linked.running) / linked.ratio
   111	    # Looked up, never built: an unsaved leg left on the association would be autosaved by recompute!.
   112	    plug = trade_legs.find_by(activity_id: nil, kind: :entry)
   113	    if plug_quantity.positive?
   114	      changed = plug.nil? || plug.quantity != plug_quantity
   115	      price = average_price && average_price * linked.ratio # the broker's post-split average, in the plug's pre-split units
   116	      attributes = { quantity: plug_quantity, price: price, cash_amount: price ? -(plug_quantity * price) : nil, note: "plug" }
