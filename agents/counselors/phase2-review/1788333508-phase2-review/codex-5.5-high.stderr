   112	      order_id_from(response) or raise UnknownOutcome.new("Schwab replaced the order without a Location header", status: response.code.to_i, body: Scrub.body(response.body), attempts: 1)
   113	    end
   114	
   115	    def instrument_by_cusip(cusip)
   116	      get(MARKET, "/instruments/#{cusip}").fetch("instruments", [])
   117	    end
   118	
   119	    private
   120	      def token_request(form, idempotent:)
   121	        request = Net::HTTP::Post.new(URI("#{OAUTH}/token"))
   122	        request.basic_auth(@app_key, @app_secret)
   123	        request["Accept"] = "application/json"
   124	        request.set_form_data(form)
   125	        response, attempts = perform(request, template: "/v1/oauth/token", idempotent: idempotent)
   126	        error = Error.for_response(response, attempts: attempts, idempotent: idempotent)
   127	        case response.code.to_i
   128	        when 200..299 then parse(response, attempts: attempts, idempotent: idempotent).except("id_token")
   129	        when 400, 401, 403 then raise ReauthRequired.new(error.message, status: error.status, body: error.body, attempts: attempts)
   130	        else raise error
   131	        end
   132	      end
   133	
   134	      def get(base, path, **params)
   135	        uri = URI("#{base}#{path}")
   136	        uri.query = URI.encode_www_form(params) if params.any?
   137	        response, attempts = authorized(Net::HTTP::Get.new(uri))
   138	        raise Error.for_response(response, attempts: attempts, idempotent: true) unless response.is_a?(Net::HTTPSuccess)
   139	        Scrub.json(parse(response, attempts: attempts, idempotent: true))
   140	      end
   141	
   142	      # One attempt, no retries, the response itself on success; a 5xx or a dropped connection is an UnknownOutcome
   143	      # for a write that may have landed.
   144	      def write(method, base, path, payload = nil)
   145	        request = { post: Net::HTTP::Post, put: Net::HTTP::Put, delete: Net::HTTP::Delete }.fetch(method).new(URI("#{base}#{path}"))
   146	        if payload
   147	          request["Content-Type"] = "application/json"
   148	          request.body = JSON.generate(payload)
   149	        end
   150	        response, attempts = authorized(request, idempotent: false)
   151	        raise Error.for_response(response, attempts: attempts, idempotent: false) unless response.is_a?(Net::HTTPSuccess)
   152	        response
   153	      end
   154	
   155	      def order_id_from(response) = response["Location"].to_s[%r{/orders/([^/?]+)/?\z}, 1]
   156	
   157	      # A non-JSON success body is a gateway page, not data.
   158	      def parse(response, attempts:, idempotent:)
   159	        JSON.parse(response.body.to_s)
   160	      rescue JSON::ParserError
   161	        raise (idempotent ? ServerError : UnknownOutcome).new("Schwab returned a non-JSON body", status: response.code.to_i,
   162	                                                              body: Scrub.body(response.body), attempts: attempts)
   163	      end
   164	
   165	      # One refresh-and-retry on 401, outside the backoff budget. The token model decides whether a
   166	      # refresh is still needed, so two processes seeing the same 401 cannot double-refresh.
   167	      # A 401 means nothing was accepted, so the one refresh-and-retry is safe for writes too.
   168	      def authorized(request, idempotent: true, refreshed: false)
   169	        request["Authorization"] = "Bearer #{@token.access_token}"
   170	        request["Accept"] = "application/json"
   171	        response, attempts = perform(request, template: Scrub.path(request.uri.path), idempotent: idempotent)
   172	        if response.code.to_i == 401 && !refreshed && @token.respond_to?(:refresh!)
   173	          @token.refresh!(wait: @wait)
   174	          return authorized(request, idempotent: idempotent, refreshed: true)
   175	        end
   176	        [ response, attempts ]
   177	      end
   178	
   179	      # Returns [response, attempts]. Retries live here and nowhere else.
   180	      def perform(request, template:, idempotent:)
   181	        final = idempotent && @wait ? MAX_ATTEMPTS : 1
   182	        1.upto(final) do |attempt|
   183	          begin
   184	            response = dispatch(request, template)
   185	          rescue *TRANSPORT_FAILURES => e
   186	            raise transport_failure(e, attempt, idempotent) if attempt == final
   187	            @sleeper.call(jittered(BACKOFF[attempt - 1]))
   188	            next
   189	          end
   190	          return [ response, attempt ] unless retriable?(response) && attempt < final
   191	          @sleeper.call(delay_for(response, attempt))
   192	        end
   193	      end
   194	
   195	      def dispatch(request, template)
   196	        RateBudget.take!(budget: @budget)
   197	        started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
   198	        http(request.uri).request(request).tap { |response| log(request, template, response.code, started) }
   199	      rescue *TRANSPORT_FAILURES
   200	        log(request, template, "transport", started)
   201	        raise
   202	      end
   203	
   204	      def transport_failure(error, attempts, idempotent)
   205	        (idempotent ? TransportError : UnknownOutcome).new("#{error.class}: #{error.message}", attempts: attempts)
   206	      end
   207	
   208	      def retriable?(response) = response.code.to_i == 429 || response.code.to_i >= 500
   209	
   210	      def delay_for(response, attempt)
   211	        retry_after = Error.retry_after_in(response)
   212	        retry_after ? [ retry_after, RETRY_AFTER_CAP ].min : jittered(BACKOFF[attempt - 1])
   213	      end
   214	
   215	      def jittered(seconds) = seconds + rand * seconds * 0.25
   216	
   217	      def http(uri)
   218	        Net::HTTP.new(uri.host, uri.port).tap do |h|
   219	          h.use_ssl = true
   220	          h.open_timeout = OPEN_TIMEOUT
   221	          h.read_timeout = READ_TIMEOUT
   222	        end
   223	      end
   224	
   225	      def log(request, template, status, started)
   226	        ms = started ? ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round : 0
   227	        Rails.logger.info("schwab #{request.method} #{template} #{status} #{ms}ms")
   228	      end
   229	  end
   230	end

