     1	module Sync
     2	  # Positions and balances for one account. Rows absent from the broker are deleted only when every
     3	  # position resolved and the payload is sane. Zero-quantity positions are treated as absent.
     4	  class PositionsJob < FeedJob
     5	    limits_concurrency to: 1, key: ->(account) { "positions-#{account.id}" }, on_conflict: :discard
     6	
     7	    def perform(account)
     8	      SyncRun.record(:positions, account: account) do |run|
     9	        summary = Schwab::AccountSummary.from(client.account(account.schwab_hash))
    10	        raise Schwab::MappingError, "no positions but positive long market value" if summary.positions.empty? && summary.balances.long_market_value&.positive?
    11	
    12	        now = Time.current
    13	        held = summary.positions.reject { |p| p.quantity.zero? || p.cash_equivalent? } # the sweep fund is cash, not a holding
    14	        kept = held.filter_map do |position|
    15	          instrument = Instrument.resolve(position.instrument)
    16	          unless instrument
    17	            run.quarantine(:positions_unresolved, position.instrument.to_h)
    18	            next
    19	          end
    20	          account.positions.find_or_initialize_by(instrument: instrument).tap do |row|
    21	            row.update!(quantity: position.quantity, average_price: position.average_price, cost_basis: position.cost_basis,
    22	                        market_value: position.market_value, last_price: last_price_for(position), synced_at: now, raw: position.raw)
    23	            # row.last_price, not last_price_for: the stored value is rounded to the column, so an uneven quotient cannot relist every sync.
    24	            instrument.relist!(reason: "Schwab priced it again at #{row.last_price.to_s('F')}") if instrument.priced_again?(row.last_price)
    25	          end
    26	        rescue Schwab::MappingError => e
    27	          run.quarantine(:positions_unmapped, e.message)
    28	          nil
    29	        end
    30	        complete = kept.size == held.size
    31	        account.positions.where.not(id: kept.map(&:id)).destroy_all if complete
    32	        account.balances.create!(as_of: now, equity: summary.balances.equity, cash_available_for_trading: summary.balances.cash_available_for_trading,
    33	                                 unsettled_cash: summary.balances.unsettled_cash, settled_cash: summary.balances.settled_cash,
    34	                                 buying_power: summary.balances.buying_power, raw: summary.balances.raw)
    35	        account.update!(last_synced_at: now, raw: summary.raw_without_positions)
    36	        run.touched(kept.size)
    37	        hand_off_to_journal(account, summary.balances.equity) if complete && account.trading_enabled?
    38	        complete ? :succeeded : :partial
    39	      end
    40	    end
    41	
    42	    private
    43	      # The journal reconciles to the new positions; today's snapshot is rechained only when its equity moved.
    44	      def hand_off_to_journal(account, equity)
    45	        Journal::BootstrapJob.perform_later(account)
    46	        today = MarketDay.today
    47	        snapshot = account.snapshots.find_by(as_of: today)
    48	        Snapshots::RebuildJob.perform_later(account, from: today) if snapshot && snapshot.equity != equity
    49	      end
    50	
    51	      def last_price_for(position)
    52	        return nil if position.quantity.zero? || position.market_value.nil?
    53	        position.market_value / position.quantity
    54	      end
    55	  end
    56	end

