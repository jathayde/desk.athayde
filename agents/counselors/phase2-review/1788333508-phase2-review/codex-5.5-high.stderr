     1	# Built in: a sell may not exceed what the desk holds, and must sell something. A desk that cannot short has
     2	# no other reading of a larger number.
     3	class Guardrails::PositionCoverage < Guardrails::Rule
     4	  def evaluate
     5	    return skipped if entry?
     6	    held = context.position_for(proposal.instrument)&.quantity.to_d
     7	    return block(reason: "no position in #{proposal.instrument.symbol} to sell") unless held.positive?
     8	    return block(reason: "no quantity to sell") unless proposal.quantity.to_d.positive?
     9	    detail = { selling: proposal.quantity.to_d, held: held }
    10	    proposal.quantity.to_d <= held ? pass(**detail) : block(**detail)
    11	  end
    12	end
     1	# Rule 1: the frozen quantity's dollars at risk against today's equity and the current percent, so an equity
     2	# drop between proposal and approval turns a pass into a block, as docs/phase-2-plan.md §0.4 requires.
     3	class Guardrails::MaxRiskPerTrade < Guardrails::Rule
     4	  def self.fatal_when_missing? = true
     5	
     6	  def evaluate
     7	    return skipped unless entry?
     8	    return block(reason: proposal.sizing["reason"] || "not sized") if proposal.sizing["quantity"].blank?
     9	    equity = context.fresh_equity or return block(reason: "no fresh equity to measure risk against")
    10	    at_risk = proposal.quantity.to_d * (proposal.limit_price.to_d - proposal.stop_price.to_d)
    11	    budget = (equity * param(:percent) / 100).round(2)
    12	    detail = { at_risk: at_risk, budget: budget, equity: equity, frozen_budget: proposal.sizing["risk_budget"] }
    13	    at_risk <= budget ? pass(**detail) : block(**detail)
    14	  end
    15	end
     1	# Rule 7: fat-finger protection on what the desk commits, per buy order and per day (today's resting, unknown,
     2	# and filled buys count). Selling what is held is not a commitment and is not capped here.
     3	class Guardrails::NotionalCap < Guardrails::Rule
     4	  def self.fatal_when_missing? = true
     5	
     6	  def evaluate
