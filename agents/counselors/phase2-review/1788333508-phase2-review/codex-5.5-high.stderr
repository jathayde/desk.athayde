     1	# The real branch (docs/phase-2-plan.md §0.5, §0.6): the exit's stop action first, then the order, one call each,
     2	# never retried; every answer Schwab can give lands as one named outcome on the proposal. A call that may have
     3	# reached Schwab is unknown until the reconcile job says otherwise; one that certainly did not (a 4xx, an
     4	# auth or budget refusal, a missing token) is a rejection that says the order was not sent.
     5	class Submission::Place
     6	  MAYBE_SENT = [ Schwab::UnknownOutcome, Schwab::ServerError, Schwab::TransportError ].freeze
     7	
     8	  # The stop step failed or went quiet: the sell is not sent, and the operator is told what to check.
     9	  class StopNotAdjusted < StandardError; end
    10	
    11	  def self.call(proposal, attempt) = new(proposal, attempt).call
    12	
    13	  def initialize(proposal, attempt)
    14	    @proposal, @attempt = proposal, attempt
    15	    @account = proposal.account
    16	  end
    17	
    18	  def call
    19	    adjust_stop if @proposal.kind_exit?
    20	    order_id = client.place_order(@account.schwab_hash, @attempt.payload)
    21	    @proposal.record_submitted!(@attempt, broker_order_id: order_id)
    22	  rescue StopNotAdjusted => e
    23	    @proposal.record_rejected!(@attempt, error: e.message)
    24	  rescue *MAYBE_SENT => e
    25	    @proposal.record_unknown!(@attempt, error: "#{e.class.name.demodulize}: #{e.message}")
    26	    Submission::ReconcileJob.set(wait: Submission::ReconcileJob::QUIET_PERIOD).perform_later(@proposal)
    27	  rescue Schwab::Error => e # a 4xx, a rate limit, an auth failure, no token: nothing was accepted
    28	    @proposal.record_rejected!(@attempt, error: "#{stop_note}order not sent: #{e.message}")
    29	  rescue OrderProposal::IllegalTransition => e
    30	    # The sweep called the row not placed before Schwab answered with an id: the id is the last fact that
    31	    # says otherwise, so it goes on the row and the record, and the sync links the order from it.
    32	    @proposal.update!(broker_order_id: order_id) if order_id
    33	    AuditEvent.log("proposal_submitted", actor: :system, subject: @proposal, reason: "late answer after #{@proposal.status}", data: { broker_order_id: order_id })
    34	    Rails.error.report(e, handled: true, context: { proposal: @proposal.id, broker_order_id: order_id })
    35	  end
    36	
    37	  private
    38	    def client = Schwab.client(wait: false)
    39	    def stop_note = @proposal.child_action ? "the stop was #{@proposal.child_action_cancel_stop? ? "cancelled" : "shrunk"} first; " : ""
    40	
    41	    # Selling what a working stop covers: cancel the stop for a full exit, shrink it for a partial one, before
    42	    # the sell goes in.
    43	    def adjust_stop
    44	      stop = @account.positions.find_by(instrument: @proposal.instrument)&.working_stop_order
    45	      return unless stop&.working?
    46	      remaining = stop.remaining.to_d - @proposal.quantity.to_d
    47	      action = remaining <= 0 ? :cancel_stop : :replace_stop
    48	      new_id = perform_stop_action(action, stop, remaining)
    49	      @proposal.update!(child_action: action)
    50	      AuditEvent.log("stop_adjusted", actor: :system, subject: @proposal, reason: action == :cancel_stop ? "stop cancelled" : "stop shrunk",
    51	                     data: { stop_order: stop.broker_order_id, remaining: remaining, replacement_order: new_id })
    52	    end
    53	
    54	    def perform_stop_action(action, stop, remaining)
    55	      if action == :cancel_stop
    56	        client.cancel_order(@account.schwab_hash, stop.broker_order_id)
    57	        nil
    58	      else
    59	        client.replace_order(@account.schwab_hash, stop.broker_order_id, Schwab::OrderPayload.stop(symbol: @proposal.instrument.symbol, quantity: remaining, stop_price: stop.stop_price))
    60	      end
    61	    rescue *MAYBE_SENT => e
    62	      raise StopNotAdjusted, "the stop #{action == :cancel_stop ? 'cancel' : 'shrink'} got no answer (#{e.message}); check the stop at Schwab before anything else; order not sent"
    63	    rescue Schwab::Error => e
    64	      raise StopNotAdjusted, "the stop could not be adjusted (#{e.message}); order not sent"
    65	    end
    66	end

