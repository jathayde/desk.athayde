   186	    AuditEvent.log("trade_reviewed", actor: :human, user: user, subject: self, data: { excluded: true })
   187	    recompute_setup_stats(setup)
   188	    self
   189	  end
   190	
   191	  # One walk over the legs, accumulating everything recompute! needs.
   192	  class Ledger
   193	    attr_reader :running, :peak, :cash, :ratio, :closing_leg, :first_fill
   194	
   195	    def initialize(legs)
   196	      @legs = legs
   197	      @running = @peak = @entry_qty = @entry_cost = @exit_qty = @exit_proceeds = @cash = BigDecimal("0")
   198	      @ratio = BigDecimal("1")
   199	      legs.each { |leg| apply(leg) }
   200	    end
   201	
   202	    def avg_entry = @entry_qty.positive? ? @entry_cost / @entry_qty : nil
   203	    def avg_exit = @exit_qty.positive? ? @exit_proceeds / @exit_qty : nil
   204	
   205	    # The initial entry: every fill from the first fill's order (a partial fill is one entry); without an order
   206	    # id, every entry fill on the first fill's trade date.
   207	    def initial_entry_legs
   208	      return [] unless first_fill
   209	      order_id = first_fill.activity.broker_order_id
   210	      entries = @legs.select { |l| l.kind_entry? && l.activity }
   211	      order_id ? entries.select { |l| l.activity.broker_order_id == order_id } : entries.select { |l| l.activity.trade_date == first_fill.activity.trade_date }
   212	    end
   213	
   214	    private
   215	      def apply(leg)
   216	        case leg.kind
   217	        when "entry"
   218	          @running += leg.quantity
   219	          @entry_qty += leg.quantity
   220	          @entry_cost += leg.quantity * (leg.price || 0)
   221	          @first_fill ||= leg if leg.activity_id
   222	        when "exit"
   223	          @running -= leg.quantity
   224	          @exit_qty += leg.quantity
   225	          @exit_proceeds += leg.quantity * (leg.price || 0)
   226	          @closing_leg = leg if @running.zero?
   227	        when "adjustment"
   228	          if leg.ratio
   229	            @running *= leg.ratio
   230	            @entry_qty *= leg.ratio
   231	            @exit_qty *= leg.ratio
   232	            @ratio *= leg.ratio
   233	          elsif leg.quantity
   234	            @running += leg.quantity
   235	          end
   236	        end
   237	        @cash += leg.cash_amount || 0
   238	        @peak = @running if @running > @peak
   239	      end
   240	  end
   241	
   242	  private
   243	    # Fixed to the initial entry at its weighted price, in original-entry units. Nil, never a number, when the
   244	    # stop is unknown, the stop is above the entry, or a plug means the journal never saw the real entry.
   245	    def initial_risk_for(initial_legs, plug:)
   246	      return nil if plug || planned_stop.blank? || initial_legs.empty?
   247	      quantity = initial_legs.sum(&:quantity)
   248	      average = initial_legs.sum { |l| l.quantity * (l.price || 0) } / quantity
   249	      risk = quantity * (average - planned_stop)
   250	      risk.positive? ? risk : nil
   251	    end
   252	
   253	    def total_risk_for(legs)
   254	      return nil if planned_stop.blank?
   255	      legs.select { |l| l.kind_entry? && l.price && !l.plug? }.sum { |l| [ l.quantity * (l.price - planned_stop), 0 ].max }
   256	    end
   257	
   258	    def recompute_setup_stats(*setups)
   259	      setups.compact.uniq.each { |s| Journal::RecomputeSetupStatsJob.perform_later(s) }
   260	    end

