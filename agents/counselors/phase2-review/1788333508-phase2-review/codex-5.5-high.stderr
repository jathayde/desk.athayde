    33	  BROKER_OUTCOMES = %w[ filled cancelled ].freeze
    34	
    35	  STATUS_LABELS = { "proposed" => "evaluating", "validated" => "waiting for you", "rejected_by_rules" => "rejected by rules", "rejected" => "rejected",
    36	                    "expired" => "expired", "submitting" => "submitting", "submitted" => "submitted", "submission_unknown" => "submission unknown",
    37	                    "submission_failed" => "not placed", "filled" => "filled", "cancelled" => "cancelled" }.freeze
