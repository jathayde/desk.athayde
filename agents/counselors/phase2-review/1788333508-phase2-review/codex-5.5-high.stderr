 succeeded in 0ms:
     1	module Sync
     2	  # Activities for one account, one request per transaction type a cash account produces. A bad request on
     3	  # one type fails the run so the cursor does not advance past rows that were never fetched; the rows that
     4	  # did arrive are still upserted and will simply be seen again. A malformed record is quarantined alone.
     5	  class ActivitiesJob < FeedJob
     6	    OVERLAP = 3.days
     7	
     8	    limits_concurrency to: 1, key: ->(account) { "activities-#{account.id}" }, on_conflict: :discard
     9	
    10	    def perform(account)
    11	      from, to, gap_from = window_for(:activities, account, overlap: OVERLAP)
    12	      SyncRun.record(:activities, account: account, window_from: from, window_to: to) do |run|
    13	        note_gap(run, gap_from, account)
    14	        @earliest_flow = nil
    15	        outcome = :succeeded
    16	        Schwab::Activity::CASH_ACCOUNT_TYPES.each do |type|
    17	          raws = client.transactions(account.schwab_hash, from: from, to: to, type: type)
    18	          raws.each { |raw| upsert(account, raw, run) }
    19	          run.touched(raws.size)
    20	        rescue Schwab::RequestError => e
    21	          run.quarantine(:activity_types_rejected, "#{type}: #{e.message}")
    22	          outcome = :failed
    23	        end
    24	        hand_off_to_journal(account) if account.trading_enabled?
    25	        outcome
    26	      end
    27	    end
    28	
    29	    private
    30	      def hand_off_to_journal(account)
    31	        Journal::LinkFillsJob.perform_later(account)
    32	        Snapshots::RebuildJob.perform_later(account, from: @earliest_flow) if @earliest_flow
    33	      end
    34	
    35	      # A directional type whose cash sign points the other way is recorded but called out.
    36	      def sign_disagrees?(activity, kind)
    37	        return false if activity.net_amount.nil? || activity.net_amount.zero?
    38	        (kind == :deposit && activity.net_amount.negative?) || (kind == :withdrawal && activity.net_amount.positive?)
    39	      end
    40	
    41	      def upsert(account, raw, run)
    42	        activity = Schwab::Activity.from(raw)
    43	        instrument = activity.instrument && Instrument.resolve(activity.instrument)
    44	        if activity.instrument && instrument.nil?
    45	          run.quarantine(:activities_unresolved, activity.instrument.to_h)
    46	          return
    47	        end
    48	        row = account.activities.find_or_initialize_by(broker_activity_id: activity.activity_id)
    49	        kind = activity.kind
    50	        new_record = row.new_record?
    51	        run.quarantine(:activity_kinds_other, activity.summary) if kind == :other && new_record
    52	        row.update!(instrument: instrument, order: activity.order_id && account.orders.find_by(broker_order_id: activity.order_id),
    53	                    broker_order_id: activity.order_id, kind: kind, status: activity.status, sub_type: activity.type, side: activity.side,
    54	                    quantity: activity.quantity, price: activity.price, commission: activity.commission, fees: activity.fees,
    55	                    net_amount: activity.net_amount, trade_date: activity.trade_date, settlement_date: activity.settlement_date,
    56	                    executed_at: activity.executed_at, raw: activity.raw)
    57	        changed = row.saved_changes.keys.intersect?(%w[ quantity price status net_amount kind order_id ])
    58	        row.unjournal! if row.journaled? && changed && !new_record
    59	        run.quarantine(:flow_sign_disagreement, activity.summary) if new_record && sign_disagrees?(activity, kind)
    60	        if row.cash_flow? && (new_record || changed) && row.trade_date
    61	          @earliest_flow = [ @earliest_flow, row.trade_date ].compact.min
    62	        end
    63	      rescue Schwab::MappingError, ActiveRecord::RecordInvalid => e
    64	        run.quarantine(:activities_unmapped, e.message)
    65	      end
    66	  end
    67	end

