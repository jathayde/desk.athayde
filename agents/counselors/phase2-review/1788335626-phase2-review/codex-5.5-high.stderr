     1	# Everything the rules read about the desk, computed once per evaluation from the database for one account:
     2	# equity and its freshness, cash and what already claims it, positions, today's realized P&L, the drawdown,
     3	# and the halts.
     4	class Guardrails::Context
     5	  attr_reader :account, :desk, :settings
     6	
     7	  def initialize(account)
     8	    @account = account
     9	    @desk = Desk.new(account: account)
    10	    @settings = SystemSettings.instance
    11	  end
    12	
    13	  def balance = desk.balance
    14	  def equity = balance&.equity
    15	  def balance_stale? = balance.nil? || desk.balance_stale?
    16	  def fresh_equity = balance_stale? || equity.to_d <= 0 ? nil : equity
    17	  def positions = @positions ||= account.positions.includes(:instrument, :working_stop_order).to_a
    18	  def position_for(instrument) = positions.find { |p| p.instrument_id == instrument.id }
    19	  def open_trade_for(instrument) = account.trades.open.find_by(instrument: instrument)
    20	
    21	  # Entries not yet filled on instruments not yet held: they count as positions the desk has committed to. The
    22	  # proposal being judged is left out, so its own validated row is not counted twice at approval.
    23	  def pending_new_positions(except: nil)
    24	    scope = account.order_proposals.committed.where(kind: :entry).where.not(instrument_id: positions.map(&:instrument_id))
    25	    scope = scope.where.not(id: except.id) if except&.persisted?
    26	    scope.distinct.count(:instrument_id)
    27	  end
    28	
    29	  # What unfilled entries on this instrument have already committed, so a second entry sees the first.
    30	  def pending_cost_for(instrument, except: nil)
    31	    account.order_proposals.committed.where(instrument: instrument, kind: :entry).where.not(id: except&.id).sum(&:cost)
    32	  end
    33	
    34	  # Cash the broker reports as settled, minus every buy that already claims it (docs/phase-2-plan.md §0.9).
    35	  # The app's own resting orders are counted once, as proposals; whether the broker's figure already nets
    36	  # working buys is unverified (verify-on-approval item 58), so its other working buys are subtracted too.
    37	  def projected_settled_cash
    38	    return nil if balance_stale? || balance.settled_cash.nil?
    39	    balance.settled_cash - pending_app_buys - live_broker_buys
    40	  end
    41	
    42	  def pending_app_buys
    43	    account.order_proposals.at_broker.buy.sum(&:cost)
    44	  end
    45	
    46	  # A market buy claims an unknown sum; the position's last price is the conservative stand-in.
    47	  def live_broker_buys
    48	    account.orders.working.where(side: Schwab::Order::BUY, order_proposal_id: nil).includes(:instrument).sum do |o|
    49	      o.remaining.to_d * (o.limit_price || o.stop_price || position_for(o.instrument)&.last_price || 0).to_d
    50	    end
    51	  end
    52	
    53	  # Today's realized P&L: the trades that closed today, plus every scale-out on a still-open trade, priced
    54	  # against that trade's average entry, so a loss taken in parts is seen before the trade is done.
    55	  def realized_today
    56	    @realized_today ||= account.trades.closed.where(closed_at: today_range).sum(:realized_pnl) +
    57	      account.trades.open.joins(:trade_legs).where(trade_legs: { kind: "exit", executed_at: today_range }).where.not(trade_legs: { cash_amount: nil }).where.not(avg_entry: nil)
    58	             .sum("trade_legs.cash_amount - trade_legs.quantity * trades.avg_entry")
    59	  end
    60	  def prior_equity = desk.prior_snapshot&.equity
    61	  def drawdown = desk.latest_snapshot&.drawdown
    62	
    63	  # What the day has already committed on the buy side, resting or filled, unknown included.
    64	  def notional_today
    65	    account.order_proposals.where(status: OrderProposal::AT_BROKER + %w[ filled ]).buy.where(decided_at: today_range).sum(&:cost)
    66	  end
    67	
    68	  private
