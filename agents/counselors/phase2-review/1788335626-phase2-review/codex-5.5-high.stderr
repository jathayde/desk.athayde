     1	# The real branch (docs/phase-2-plan.md §0.5, §0.6): the exit's stop action first, then the order, one call each,
     2	# never retried; every answer Schwab can give lands as one named outcome on the proposal. A call that may have
     3	# reached Schwab is unknown until the reconcile job says otherwise; one that certainly did not (a 4xx, an
     4	# auth or budget refusal, a missing token) is a rejection that says the order was not sent.
     5	class Submission::Place
     6	  MAYBE_SENT = [ Schwab::UnknownOutcome, Schwab::ServerError, Schwab::TransportError ].freeze
     7	
     8	  # The stop step failed or went quiet: the sell is not sent, and the operator is told what to check.
     9	  class StopNotAdjusted < StandardError; end
    10	
    11	  def self.call(proposal, attempt) = new(proposal, attempt).call
    12	
    13	  def initialize(proposal, attempt)
    14	    @proposal, @attempt = proposal, attempt
    15	    @account = proposal.account
    16	  end
    17	
    18	  # A worker that wakes after the sweep already called its row unknown does not send: the reconcile job owns
    19	  # the row now, and a second send would be the double submission this whole path exists to prevent.
    20	  def call
    21	    return swept unless @proposal.reload.submitting?
    22	    adjust_stop if @proposal.kind_exit?
    23	    order_id = client.place_order(@account.schwab_hash, @attempt.payload)
    24	    record { @proposal.record_submitted!(@attempt, broker_order_id: order_id) }
    25	  rescue StopNotAdjusted => e
    26	    record { @proposal.record_rejected!(@attempt, error: e.message) }
    27	  rescue *MAYBE_SENT => e
    28	    record do
    29	      @proposal.record_unknown!(@attempt, error: "#{e.class.name.demodulize}: #{e.message}")
    30	      Submission::ReconcileJob.set(wait: Submission::ReconcileJob::QUIET_PERIOD).perform_later(@proposal)
    31	    end
    32	  rescue Schwab::Error => e # a 4xx, a rate limit, an auth failure, no token: nothing was accepted
    33	    record { @proposal.record_rejected!(@attempt, error: "#{stop_note}order not sent: #{e.message}") }
    34	  end
    35	
    36	  private
    37	    def client = Schwab.client(wait: false)
    38	    def stop_note = @proposal.child_action ? "the stop was #{@proposal.child_action_cancel_stop? ? "cancelled" : "shrunk"} first; " : ""
    39	
    40	    def swept
    41	      AuditEvent.log("submission_skipped", actor: :system, subject: @proposal, reason: "swept to #{@proposal.status} before the call; not sent")
    42	      @proposal
    43	    end
    44	
    45	    # An answer the row can no longer take (the reconcile job already found the order, or a verdict this
    46	    # answer cannot overturn) is kept on the record and reported, never retried and never a 500 for the operator.
    47	    def record
    48	      yield
    49	    rescue OrderProposal::IllegalTransition => e
    50	      AuditEvent.log("submission_answer_ignored", actor: :system, subject: @proposal, reason: e.message, data: { status: @proposal.status })
    51	      Rails.error.report(e, handled: true, context: { proposal: @proposal.id })
    52	      @proposal
    53	    end
    54	
    55	    # Selling what a working stop covers: cancel the stop for a full exit, shrink it for a partial one, before
    56	    # the sell goes in.
    57	    def adjust_stop
    58	      stop = @account.positions.find_by(instrument: @proposal.instrument)&.working_stop_order
    59	      return unless stop&.working?
    60	      remaining = stop.remaining.to_d - @proposal.quantity.to_d
    61	      action = remaining <= 0 ? :cancel_stop : :replace_stop
    62	      new_id = perform_stop_action(action, stop, remaining)
    63	      @proposal.update!(child_action: action)
    64	      AuditEvent.log("stop_adjusted", actor: :system, subject: @proposal, reason: action == :cancel_stop ? "stop cancelled" : "stop shrunk",
    65	                     data: { stop_order: stop.broker_order_id, remaining: remaining, replacement_order: new_id })
    66	    end
    67	
    68	    def perform_stop_action(action, stop, remaining)
    69	      if action == :cancel_stop
    70	        client.cancel_order(@account.schwab_hash, stop.broker_order_id)
    71	        nil
    72	      else
    73	        client.replace_order(@account.schwab_hash, stop.broker_order_id, Schwab::OrderPayload.stop(symbol: @proposal.instrument.symbol, quantity: remaining, stop_price: stop.stop_price))
    74	      end
    75	    rescue *MAYBE_SENT => e
    76	      raise StopNotAdjusted, "the stop #{action == :cancel_stop ? 'cancel' : 'shrink'} got no answer (#{e.message}); check the stop at Schwab before anything else; order not sent"
    77	    rescue Schwab::Error => e
    78	      raise StopNotAdjusted, "the stop could not be adjusted (#{e.message}); order not sent"
    79	    end
    80	end

