    26	                                           order_type: @proposal.order_type, session: Schwab::OrderPayload::NORMAL, duration: Schwab::OrderPayload::DAY, entered_at: window)
    27	                                    .where.not(status: Schwab::Order::DEAD_STATUSES + [ Schwab::Order::GONE ])
    28	    scope.includes(:child_orders).select { |o| o.quantity.to_d == @proposal.quantity.to_d && close?(o.limit_price, @proposal.limit_price) && shape_matches?(o) }
    29	  end
    30	
    31	    def close?(a, b) = (a.to_d - b.to_d).abs <= PRICE_TOLERANCE
    32	
    33	    def shape_matches?(order)
    34	      return order.child_orders.none? unless @proposal.kind_entry?
    35	      child = order.child_orders.one? ? order.child_orders.first : nil
    36	      child.present? && child.side == Schwab::Order::SELL && child.stop? && child.quantity.to_d == @proposal.quantity.to_d && close?(child.stop_price, @proposal.stop_price)
    37	    end
    38	end

