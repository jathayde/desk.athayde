<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), "Athayde Desk" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Athayde Desk">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="<%= asset_path "brand/crest.svg" %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= asset_path "brand/crest.svg" %>">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="shell-header">
      <%= link_to root_path, class: "brand", "aria-label": "Athayde Desk home" do %>
        <%= image_tag "brand/crest.svg", alt: "", class: "brand-crest" %>
        <span class="brand-name">Athayde Desk</span>
      <% end %>
      <% if authenticated? %>
        <%= button_to "Sign out", session_path, method: :delete, class: "link-button" %>
      <% end %>
    </header>

    <% if flash.any? %>
      <div class="flash">
        <% flash.each do |kind, message| %>
          <p class="flash-<%= kind %>"><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <main class="shell-main">
      <%= yield %>
    </main>
  </body>
</html>

