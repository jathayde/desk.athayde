require "rails_helper"

RSpec.describe User do
  subject(:user) { create(:user, email_address: " John@Athayde.com ") }

  it "normalizes the email address" do
    expect(user.email_address).to eq("john@athayde.com")
  end

  describe "magic links" do
    it "resolves a fresh token back to the user" do
      token = user.generate_token_for(:magic_link)
      expect(User.find_by_magic_link(token)).to eq(user)
    end

    it "expires after the TTL" do
      token = user.generate_token_for(:magic_link)
      travel User::MAGIC_LINK_TTL + 1.second
      expect(User.find_by_magic_link(token)).to be_nil
    end

    it "is single use: logging in invalidates outstanding links" do
      token = user.generate_token_for(:magic_link)
      user.record_login!
      expect(User.find_by_magic_link(token)).to be_nil
    end

    it "rejects garbage" do
      expect(User.find_by_magic_link("nope")).to be_nil
    end
  end

  it "sends the magic link by mail" do
    expect { user.send_magic_link }.to have_enqueued_mail(MagicLinkMailer, :sign_in).with(user)
  end
end

