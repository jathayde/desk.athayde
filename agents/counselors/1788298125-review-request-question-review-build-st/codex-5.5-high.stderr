/* Base shell. Screen-level styles land with each screen. */
:root {
  --ink: #1a1a1a;
  --mid: #6b6b6b;
  --line: #d9d9d9;
  --surface: #ffffff;
  --ground: #f6f6f6;
  --azure: #0B5FAE;
}

* { box-sizing: border-box; }
html { color-scheme: light; }
body {
  margin: 0;
  font: 15px/1.45 system-ui, -apple-system, "Helvetica Neue", sans-serif;
  color: var(--ink);
  background: var(--ground);
}

.shell-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.6rem 1rem;
  background: var(--surface);
  border-bottom: 1px solid var(--line);
}
.brand { display: inline-flex; align-items: center; gap: 0.6rem; color: inherit; text-decoration: none; font-weight: 600; }
.brand-crest { width: 28px; height: 32px; }
.link-button { background: none; border: 0; padding: 0; color: var(--azure); font: inherit; cursor: pointer; }

.flash { padding: 0.5rem 1rem; }
.flash p { margin: 0.25rem 0; }
.flash-alert { color: #9b1c1c; }
.flash-notice { color: #1c6b3a; }

.shell-main { max-width: 64rem; margin: 0 auto; padding: 1rem; }
.auth, .empty-state { max-width: 28rem; }
.auth label { display: block; margin-bottom: 0.25rem; }
.auth input[type="email"] { width: 100%; padding: 0.6rem; font: inherit; border: 1px solid var(--line); border-radius: 6px; margin-bottom: 0.75rem; }
.auth input[type="submit"] { padding: 0.6rem 1rem; font: inherit; font-weight: 600; color: #fff; background: var(--azure); border: 0; border-radius: 6px; cursor: pointer; }
.empty-state { color: var(--mid); }

