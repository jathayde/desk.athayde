require "rails_helper"
require "rake"

RSpec.describe "login:link" do
  before { Rails.application.load_tasks unless Rake::Task.task_defined?("login:link") }

  it "prints a usable magic link for the given email" do
    user = create(:user, email_address: "john@athayde.com")
    output = capture_stdout { Rake::Task["login:link"].execute(email: "john@athayde.com") }
    token = output[%r{/session/magic/([^\s]+)}, 1]
    expect(User.find_by_magic_link(token)).to eq(user)
  end

  def capture_stdout
    original = $stdout
    $stdout = StringIO.new
    yield
    $stdout.string
  ensure
    $stdout = original
  end
end

