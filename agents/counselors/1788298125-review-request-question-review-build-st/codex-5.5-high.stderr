require "rails_helper"

RSpec.describe "Sessions" do
  let!(:user) { create(:user, email_address: "john@athayde.com") }

  describe "POST /session" do
    it "emails a link to a known address" do
      expect {
        post session_path, params: { email_address: "john@athayde.com" }
      }.to have_enqueued_mail(MagicLinkMailer, :sign_in).with(user)
      expect(response).to redirect_to(new_session_path)
      follow_redirect!
      expect(response.body).to include("a sign-in link is on its way")
    end

    it "gives an unknown address the identical response and no email" do
      expect {
        post session_path, params: { email_address: "stranger@example.com" }
      }.not_to have_enqueued_mail
      expect(response).to redirect_to(new_session_path)
      follow_redirect!
      expect(response.body).to include("a sign-in link is on its way")
    end
  end

  describe "GET /session/magic/:token" do
    it "signs the user in and records the login" do
      get magic_session_path(user.generate_token_for(:magic_link))
      expect(response).to redirect_to(root_url)
      expect(user.reload.last_login_at).to be_present
      get root_path
      expect(response).to have_http_status(:ok)
    end

    it "honors the return-to path captured before login" do
      get root_path
      expect(response).to redirect_to(new_session_path)
      get magic_session_path(user.generate_token_for(:magic_link))
      expect(response).to redirect_to(root_url)
    end

    it "rejects a used link" do
      token = user.generate_token_for(:magic_link)
      get magic_session_path(token)
      delete session_path
      get magic_session_path(token)
      expect(response).to redirect_to(new_session_path)
      expect(flash[:alert]).to match(/invalid or has expired/)
    end

    it "rejects an expired link" do
      token = user.generate_token_for(:magic_link)
      travel User::MAGIC_LINK_TTL + 1.minute
      get magic_session_path(token)
      expect(response).to redirect_to(new_session_path)
    end
  end

  describe "DELETE /session" do
    it "signs out" do
      get magic_session_path(user.generate_token_for(:magic_link))
      delete session_path
      expect(response).to redirect_to(new_session_path)
      get root_path
      expect(response).to redirect_to(new_session_path)
    end
  end
end

