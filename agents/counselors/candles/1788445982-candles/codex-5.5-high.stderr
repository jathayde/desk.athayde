     1	# A year of daily candles and a fresh quote in, a Collar out. Methods, each a stop price for a long entry:
     2	# ATR multiple (entry − k × ATR14), swing low (lowest low of N bars − buffer × ATR14), percent (entry × (1 − p)),
     3	# and chandelier (highest high of M bars − k × ATR(M)), computed for reference. tight and wide are the highest
     4	# and lowest of the ATR and swing stops; the percent stop is the floor under wide, and when it is tighter than
     5	# both methods it is the collar's only edge (floor_dominates), with the entry as the ceiling.
     6	class StopCollar::Calculator
     7	  DEFAULTS = { "atr_k" => "2.5", "swing_bars" => "10", "swing_buffer_atr" => "0.2", "percent" => "8", "chandelier_bars" => "22", "chandelier_k" => "3" }.freeze
     8	
     9	  def initialize(instrument, entry_price:, params: {})
    10	    @instrument, @entry, @params = instrument, BigDecimal(entry_price.to_s), DEFAULTS.merge(params.to_h.transform_keys(&:to_s))
    11	  end
    12	
    13	  def call
    14	    candles = StopCollar::Candles.for(@instrument)
    15	    quote = Agent::MarketData.quotes([ @instrument.symbol ])[:quotes].first
    16	    return refuse("no fresh quote") if quote.nil? || quote[:stale]
    17	
    18	    atr14 = candles.atr(14)
    19	    methods = {
    20	      atr: @entry - param(:atr_k) * atr14,
    21	      swing: candles.last(param(:swing_bars).to_i).map { |c| c[:low] }.min - param(:swing_buffer_atr) * atr14,
    22	      percent: @entry * (1 - param(:percent) / 100),
    23	      chandelier: candles.last(param(:chandelier_bars).to_i).map { |c| c[:high] }.max - param(:chandelier_k) * candles.atr(param(:chandelier_bars).to_i)
    24	    }.transform_values { |v| v.round(4) }
    25	    candidates = methods.values_at(:atr, :swing).select { |v| v < @entry }
    26	    return refuse("the ATR and swing stops land at or above the entry") if candidates.empty?
    27	    floor = methods[:percent]
    28	    tight, wide = candidates.max, [ candidates.min, floor ].max
    29	    floor_dominates = tight < floor
    30	    StopCollar::Collar.new(methods: methods, tight: floor_dominates ? floor : tight, wide: floor_dominates ? floor : wide, floor: floor, floor_dominates: floor_dominates, quality: :ok, refusal: nil)
    31	  rescue StopCollar::Candles::Refused => e
    32	    refuse(e.message)
    33	  rescue Schwab::RateLimited
    34	    raise # a budget spent is not a verdict on the stop
    35	  rescue Schwab::Error, Agent::Tool::InvalidArguments => e
    36	    refuse("market data unavailable: #{e.message}")
    37	  end
    38	
