    11	  def self.for(instrument)
    12	    history = Agent::MarketData.price_history(instrument.symbol, range: "1y")
    13	    raise Refused, "history is stale (Schwab unavailable)" if history[:stale]
    14	    candles = Array(history[:candles]).map { |c| c.transform_keys(&:to_sym) }.sort_by { |c| c[:date] }
    15	    raise Refused, "only #{candles.size} daily candles; #{MIN_CANDLES} needed" if candles.size < MIN_CANDLES
