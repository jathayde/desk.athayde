    40	    def param(name) = BigDecimal(@params.fetch(name.to_s).to_s)
    41	    def refuse(reason) = StopCollar::Collar.new(methods: {}, tight: nil, wide: nil, floor: nil, floor_dominates: false, quality: :refused, refusal: reason)
