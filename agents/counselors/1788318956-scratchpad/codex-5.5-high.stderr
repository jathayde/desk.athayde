     1	module Sync
     2	  # Positions and balances for one account. Rows absent from the broker are deleted only when every
     3	  # position resolved and the payload is sane. Zero-quantity positions are treated as absent.
     4	  class PositionsJob < FeedJob
     5	    limits_concurrency to: 1, key: ->(account) { "positions-#{account.id}" }, on_conflict: :discard
     6	
     7	    def perform(account)
     8	      SyncRun.record(:positions, account: account) do |run|
     9	        summary = Schwab::AccountSummary.from(client.account(account.schwab_hash))
    10	        raise Schwab::MappingError, "no positions but positive long market value" if summary.positions.empty? && summary.balances.long_market_value&.positive?
    11	
    12	        now = Time.current
    13	        held = summary.positions.reject { |p| p.quantity.zero? || p.cash_equivalent? } # the sweep fund is cash, not a holding
    14	        kept = held.filter_map do |position|
    15	          instrument = Instrument.resolve(position.instrument)
    16	          unless instrument
    17	            run.quarantine(:positions_unresolved, position.instrument.to_h)
    18	            next
    19	          end
    20	          account.positions.find_or_initialize_by(instrument: instrument).tap do |row|
    21	            row.update!(quantity: position.quantity, average_price: position.average_price, cost_basis: position.cost_basis,
    22	                        market_value: position.market_value, last_price: last_price_for(position), synced_at: now, raw: position.raw)
    23	            instrument.relist!(reason: "Schwab priced it again") if instrument.delisted? && row.last_price&.positive?
    24	          end
    25	        rescue Schwab::MappingError => e
    26	          run.quarantine(:positions_unmapped, e.message)
    27	          nil
    28	        end
    29	        complete = kept.size == held.size
    30	        account.positions.where.not(id: kept.map(&:id)).destroy_all if complete
    31	        account.balances.create!(as_of: now, equity: summary.balances.equity, cash_available_for_trading: summary.balances.cash_available_for_trading,
    32	                                 unsettled_cash: summary.balances.unsettled_cash, settled_cash: summary.balances.settled_cash,
    33	                                 buying_power: summary.balances.buying_power, raw: summary.balances.raw)
    34	        account.update!(last_synced_at: now, raw: summary.raw_without_positions)
    35	        run.touched(kept.size)
    36	        hand_off_to_journal(account, summary.balances.equity) if complete && account.trading_enabled?
    37	        complete ? :succeeded : :partial
    38	      end
    39	    end
    40	
    41	    private
    42	      # The journal reconciles to the new positions; today's snapshot is rechained only when its equity moved.
    43	      def hand_off_to_journal(account, equity)
    44	        Journal::BootstrapJob.perform_later(account)
    45	        today = MarketDay.today
    46	        snapshot = account.snapshots.find_by(as_of: today)
    47	        Snapshots::RebuildJob.perform_later(account, from: today) if snapshot && snapshot.equity != equity
    48	      end
    49	
    50	      def last_price_for(position)
    51	        return nil if position.quantity.zero? || position.market_value.nil?
    52	        position.market_value / position.quantity
    53	      end
    54	  end
    55	end

