    20	  def delist!(user:)
    21	    return self if delisted?
    22	    update!(delisted_at: Time.current)
    23	    AuditEvent.log("instrument_delisted", actor: :human, user: user, subject: self, data: { symbol: symbol })
    24	    self
    25	  end
    26	
    27	  def relist!(reason:, user: nil)
    28	    return self unless delisted?
    29	    update!(delisted_at: nil)
    30	    AuditEvent.log("instrument_relisted", actor: user ? :human : :system, user: user, subject: self, reason: reason, data: { symbol: symbol })
    31	    self
    32	  end
    33	
    34	  # Identity in order of trust: CUSIP, Schwab instrument id, then symbol and asset type among rows that have
    35	  # no CUSIP, then a Schwab lookup by symbol, then a provisional row. A weaker match backfills a missing
    36	  # identifier from the ref but never overwrites a differing one.
    37	  def self.resolve(ref, attempt: 1)
    38	    return nil if ref.nil? || (ref.symbol.blank? && ref.cusip.blank?)
    39	    found = find_by(cusip: ref.cusip) if ref.cusip.present?
    40	    ref = ref.with(symbol: lookup_symbol(ref.cusip)) if found.nil? && ref.symbol.blank?
    41	    return nil if ref.symbol.blank? # a CUSIP Schwab cannot name is quarantined by the caller, not invented here
    42	    found ||= find_by(schwab_instrument_id: ref.instrument_id) if ref.instrument_id.present?
    43	    found ||= where(cusip: nil, symbol: ref.symbol, asset_type: ref.asset_type).first
    44	    found ? found.absorb(ref) : create_from(ref)
    45	  rescue ActiveRecord::RecordNotUnique
    46	    # Another feed created or backfilled it between our lookup and our write; look once more, then give up.
    47	    raise Schwab::MappingError, "instrument #{ref.symbol} keeps colliding on identity" if attempt > 1
    48	    resolve(ref, attempt: attempt + 1)
    49	  end
