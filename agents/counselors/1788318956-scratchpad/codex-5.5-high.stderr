    41	    account = create(:account, account_type: nil, trading_enabled: false)
    42	    patch account_path(account), params: { account_type: "ira", trading_enabled: "1" }
    43	    expect(flash[:alert]).to include("only for the taxable account")
    44	    expect(account.reload.trading_enabled).to be(false)
    45	  end
    46	
    47	  it "warns on Sunday morning only when the token dies before tonight's email" do
    48	    travel_to Time.zone.parse("2026-09-06 09:00 EDT") do
    49	      create(:schwab_token, issued_at: Time.zone.parse("2026-08-30 17:00 EDT"))
    50	      get system_path
    51	      expect(response.body).to include("dies before Sunday")
    52	      SchwabToken.delete_all
    53	      create(:schwab_token, issued_at: Time.zone.parse("2026-08-30 19:00 EDT"))
    54	      get system_path
    55	      expect(response.body).not_to include("dies before Sunday")
    56	    end
    57	  end
    58	
    59	  it "shows the month's API spend, the memory repo, and recent briefs" do
    60	    sign_in(user)
    61	    AgentRun.create!(kind: :morning_brief, market_date: Date.new(2026, 9, 1), status: :succeeded, started_at: Time.current, finished_at: Time.current, estimated_cost: BigDecimal("0.0456"), model: Agent::MODEL, degraded: true)
    62	    AgentRun.create!(kind: :eod, market_date: Date.new(2026, 9, 1), status: :failed, started_at: Time.current, finished_at: Time.current, error: "deadline passed", model: Agent::MODEL)
    63	    AgentRun.create!(kind: :eod, market_date: Date.new(2026, 9, 7), status: :skipped, started_at: Time.current, finished_at: Time.current, error: "market closed")
    64	    get system_path
    65	    expect(response.body).to include("$0.05", "plus unpriced runs", "morning brief, Tue Sep 1", "degraded", "not emailed", "deadline passed", "missing", "end of day, Mon Sep 7")
    66	    expect(response.body.scan("not emailed").size).to eq(2)
    67	  end
    68	
    69	  it "marks a holding delisted and relists it from the system page, auditing both" do
    70	    sign_in(user)
    71	    account = create(:account)
    72	    position = create(:position, account: account, instrument: create(:instrument, symbol: "GONE"))
    73	    get system_path
    74	    expect(response.body).to include("GONE", "Mark delisted")
    75	    patch instrument_path(position.instrument), params: { delisted: "1" }
    76	    expect(position.instrument.reload).to be_delisted
    77	    get system_path
    78	    expect(response.body).to include("Relist", "delisted")
    79	    patch instrument_path(position.instrument), params: { delisted: "0" }
    80	    expect(position.instrument.reload).not_to be_delisted
    81	    expect(AuditEvent.where(kind: %w[ instrument_delisted instrument_relisted ]).count).to eq(2)
    82	  end
    83	end

