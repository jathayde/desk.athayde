    58	  private
    59	    def open_trade_for(instrument) = @account.trades.open.find_by(instrument: instrument)
    60	    def latest_fill_at(trade) = trade.trade_legs.where.not(activity_id: nil).maximum(:executed_at) || Time.at(0)
    61	    def activities_caught_up_past?(time) = (SyncRun.last_window_to(:activities, @account) || Time.at(0)) >= time
