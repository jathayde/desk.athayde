    34	  # Reconciles every open trade to the broker, but only when the broker row is newer than what the journal
    35	  # has seen, so the positions/activities race cannot manufacture a plug or a missing-position flag.
    36	  def reconcile_positions!
    37	    positions = @account.positions.includes(:instrument).index_by(&:instrument_id)
    38	    @account.trades.open.includes(:instrument).find_each do |trade|
    39	      next if @account.activities.unjournaled.where(instrument_id: trade.instrument_id).exists?
    40	      position = positions[trade.instrument_id]
    41	      if position
    42	        next if position.quantity <= 0 || position.average_price.nil? || position.synced_at < latest_fill_at(trade)
    43	        trade.reconcile_plug!(broker_quantity: position.quantity, average_price: position.average_price)
    44	      elsif activities_caught_up_past?(latest_fill_at(trade))
    45	        trade.flag!(:position_missing)
    46	      end
    47	    end
    48	    positions.each_value do |position|
    49	      next if position.quantity <= 0 || position.average_price.nil? || @account.trades.open.exists?(instrument_id: position.instrument_id)
    50	      next if @account.activities.unjournaled.where(instrument_id: position.instrument_id).exists?
    51	      trade = @account.trades.create!(instrument: position.instrument, status: :open)
    52	      trade.reconcile_plug!(broker_quantity: position.quantity, average_price: position.average_price)
    53	    rescue ActiveRecord::RecordNotUnique
    54	      next
    55	    end
    56	  end
