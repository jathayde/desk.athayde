     1	class Position < ApplicationRecord
     2	  belongs_to :account
     3	  belongs_to :instrument
     4	  belongs_to :working_stop_order, class_name: "Order", optional: true
     5	
     6	  validates :instrument_id, uniqueness: { scope: :account_id }
     7	
     8	  def stop_price = working_stop_order&.stop_price
     9	
    10	  # Every live terminal sell stop on this instrument, so a scale-in covered by two stops reads as covered.
    11	  def live_stops = @live_stops ||= account.orders.where(instrument: instrument).stops.sells.live.terminal.to_a
    12	
    13	  def covered_quantity
    14	    return nil unless working_stop_order
    15	    live_stops.filter_map(&:remaining).sum
    16	  end
    17	
    18	  # Why this position is or is not protected. Only :protected counts; every other state is unknown or
    19	  # insufficient risk, and the dashboard says which. Memoized: it costs a query and views ask repeatedly.
    20	  def protection
    21	    @protection = @live_stops = nil if @protection_for != working_stop_order_id
    22	    @protection_for = working_stop_order_id
    23	    @protection ||= compute_protection
    24	  end
    25	
    26	  def reload(...)
    27	    @protection = @live_stops = nil
    28	    super
    29	  end
    30	
    31	  def compute_protection
    32	    return :delisted if instrument.delisted?
    33	    return :unprotected unless working_stop_order&.working?
    34	    return :awaiting if !working_stop_order.live?
    35	    return :trailing_unknown if stop_price.blank? || live_stops.any? { |o| o.stop_price.blank? }
    36	    return :oversized if covered_quantity > quantity
    37	    return :partial if covered_quantity < quantity
    38	    return :unpriced if last_price.blank?
    39	    :protected
    40	  end
    41	
    42	  def protected? = protection == :protected
    43	  def delisted? = protection == :delisted
    44	  def unprotected? = !protected? && !delisted?
    45	
    46	  # Signed fraction of price between here and the stop; negative once price has gapped through it. Shown
    47	  # whenever a stop price exists, since a partially covered stop is still the number to act on.
    48	  def distance_to_stop
    49	    return unless working_stop_order&.working? && stop_price.present? && last_price.present? && last_price.nonzero?
    50	    (last_price - stop_price) / last_price
    51	  end
    52	
    53	  def unrealized_pnl = market_value && cost_basis ? market_value - cost_basis : nil
    54	
    55	  # Dollars still at risk if the stops fill, each tranche at its own stop price. Unknown (nil) without a usable
    56	  # stop, never zero for that reason, and never negative: a tranche already through its stop has nothing left to protect.
    57	  def open_risk
    58	    return unless protected?
    59	    live_stops.sum { |stop| [ stop.remaining * (last_price - stop.stop_price), 0 ].max }
    60	  end
    61	
    62	  # The newest terminal working sell stop on this instrument, preferring live statuses over AWAITING_* so a
    63	  # new bracket child cannot displace the stop on an existing lot. Assigned regardless of price; #protection decides.
    64	  def assign_working_stop!
    65	    candidates = account.orders.where(instrument: instrument).stops.sells.working.terminal.to_a
    66	    pick = newest(candidates.select(&:live?)) || newest(candidates)
    67	    @live_stops = nil
    68	    update!(working_stop_order: pick)
    69	  end
    70	
    71	  private
    72	    def newest(orders) = orders.max_by { |o| o.entered_at || Time.at(0) }
    73	end

