     3	class Brief
     4	  LIST_LIMIT = 10
     5	
     6	  def initialize(run)
     7	    @run = run
     8	    @dashboard = Dashboard.new
     9	  end
    10	
    11	  attr_reader :run
    12	  delegate :kind, :market_date, :degraded_reasons, :output_markdown, to: :run
    13	
    14	  def account = @dashboard.account
    15	  def date = market_date || Time.current.in_time_zone(MarketDay::ZONE).to_date
    16	
    17	  def subject
    18	    prefix = run.failed? ? "FAILED" : run.capped? ? "CAPPED" : run.degraded? ? "DEGRADED" : nil
    19	    [ prefix, "Athayde Desk: #{run.title}" ].compact.join(": ")
    20	  end
    21	
    22	  def token_line
    23	    status = SchwabToken.status
    24	    token = SchwabToken.current
    25	    return "Schwab: #{status}" unless token && status.in?(%i[ healthy expiring ])
    26	    "Schwab: #{status}, token expires #{stamp(token.refresh_expires_at, date: true)}"
    27	  end
    28	
    29	  def as_of_lines
    30	    return [ "No trading account is set up." ] unless account
    31	    SyncRun::ACCOUNT_FEEDS.map { |feed| "#{feed.to_s.humanize}: #{stamp(account.last_sync(feed))}" }
    32	  end
    33	
    34	  def unavailable = run.failed? ? "The brief is unavailable: #{run.error}" : nil
    35	  def cut_off = run.stop_reason == "max_tokens" ? "The model's output was cut off; what follows is incomplete." : nil
    36	  def body = output_markdown.to_s.strip
    37	
    38	  # End-of-day sections, from the database. Only fills the journal would accept count as fills, and while the
    39	  # activities feed is stale the database cannot say what filled today: nil, rendered as unknown, not "none".
    40	  def activities_stale? = account.nil? || @dashboard.stale?(account.last_sync(:activities), :activities)
    41	  def fills_today = @fills_today ||= activities_stale? ? nil : account.activities.fill.valid_for_journal.where(executed_at: day_range).chronological.includes(:instrument).to_a
    42	  def trades_touched_today = @trades_touched_today ||= activities_stale? ? nil : account.trades.where(updated_at: day_range).includes(:instrument, :setup).order(:id).to_a
    43	  def balance_stale? = @dashboard.balance_stale?
    44	  def missing_post_mortems = @missing_post_mortems ||= Trade.journaled.missing_post_mortem.includes(:instrument).order(closed_at: :desc).limit(LIST_LIMIT).to_a
    45	  def missing_post_mortem_count = @missing_post_mortem_count ||= Trade.journaled.missing_post_mortem.count
    46	  def more_post_mortems = [ missing_post_mortem_count - missing_post_mortems.size, 0 ].max
    47	  def snapshot = account && account.snapshots.find_by(as_of: date)
    48	  def balance = @dashboard.balance
    49	
    50	  def footer
    51	    parts = [ "#{run.tool_turns} #{'turn'.pluralize(run.tool_turns)}", "#{run.tool_calls_count} tool #{'call'.pluralize(run.tool_calls_count)}",
    52	              "#{run.total_input_tokens} in / #{run.output_tokens.to_i} out tokens" ]
    53	    parts << (run.estimated_cost ? "$#{'%.4f' % run.estimated_cost}" : "unpriced")
    54	    parts << "stopped: #{run.stop_reason}" if !run.failed? && run.stop_reason.present? && run.stop_reason != "end_turn"
    55	    parts << run.error if run.capped? && run.error.present?
    56	    parts.join(" · ")
    57	  end
    58	
