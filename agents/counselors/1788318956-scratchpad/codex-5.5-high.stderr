    98	    # The originating proposal's plan, taken whenever it becomes known (the order may sync after the fill).
    99	    def adopt_proposal(trade, activity)
   100	      proposal = activity.order&.order_proposal
   101	      return if proposal.nil? || trade.order_proposal_id
   102	      trade.update!(order_proposal: proposal, setup: proposal.setup, thesis: proposal.thesis, planned_stop: proposal.planned_stop, planned_target: proposal.target_price)
   103	      trade.flag!(:missing_stop) if trade.planned_stop.nil?
   104	      trade.clear_flag!(:missing_setup)
