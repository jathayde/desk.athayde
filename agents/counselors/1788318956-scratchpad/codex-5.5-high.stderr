    62	  # The synthetic entry leg that reconciles the journal to the broker. It sorts first and is scaled by every later
    63	  # split, so plug = (broker quantity − quantity from linked legs) / cumulative ratio. Deleted at zero, and the
    64	  # bootstrapped flag follows the plug: present while it exists, cleared when it goes.
    65	  def reconcile_plug!(broker_quantity:, average_price:)
    66	    linked = Ledger.new(ordered_legs.reject(&:plug?))
    67	    plug_quantity = (broker_quantity - linked.running) / linked.ratio
    68	    # Looked up, never built: an unsaved leg left on the association would be autosaved by recompute!.
    69	    plug = trade_legs.find_by(activity_id: nil, kind: :entry)
    70	    if plug_quantity.positive?
    71	      changed = plug.nil? || plug.quantity != plug_quantity
    72	      price = average_price && average_price * linked.ratio # the broker's post-split average, in the plug's pre-split units
    73	      attributes = { quantity: plug_quantity, price: price, cash_amount: price ? -(plug_quantity * price) : nil, note: "plug" }
    74	      plug ? plug.update!(attributes) : trade_legs.create!(attributes.merge(kind: :entry))
    75	      update!(bootstrapped: true) unless bootstrapped?
    76	      flag!(:bootstrapped) if changed
    77	    else
    78	      plug&.destroy!
    79	      update!(bootstrapped: false) if bootstrapped?
    80	      clear_flag!(:bootstrapped)
    81	      flag!(:missing_setup) if setup.nil? && order_proposal.nil? && !reviewed?
    82	    end
    83	    recompute!
    84	  end
