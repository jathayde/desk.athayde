    34	<%- setup_stats[:setups].each do |s| -%>
    35	- <%= s[:name] %><%= s[:active] ? "" : " (inactive)" %>: n=<%= s[:sample_size] %>, win rate <%= percent(s[:win_rate]) %>, avg R <%= s[:avg_r] || "n/a" %>, expectancy <%= s[:expectancy] || "n/a" %>
    36	<%- end -%>
    37	<%- if setup_stats[:setups].empty? -%>
    38	- none defined yet
    39	<%- end -%>
