   106	
   107	    # Income lands on the open trade, else on a trade closed recently enough to have held the shares on the record date.
   108	    def link_income(activity)
   109	      return true if activity.instrument.nil?
   110	      trade = open_trade_for(activity.instrument) ||
   111	        @account.trades.closed.where(instrument: activity.instrument, closed_at: (activity.executed_at - Trade::DIVIDEND_AFTER_CLOSE_WINDOW)..).order(closed_at: :desc).first
   112	      return true unless trade
   113	      trade.trade_legs.find_or_create_by!(activity: activity) { |l| l.kind = :income; l.cash_amount = activity.net_amount; l.executed_at = activity.executed_at }
   114	      trade.recompute!
   115	      true
   116	    end
   117	
   118	    # Shares delivered onto an open trade: a clean ratio is a split or stock dividend, anything else is a transfer to review.
   119	    def link_transfer(activity)
   120	      delivered = activity.delivered_quantity
   121	      return true if delivered.nil?
   122	      trade = open_trade_for(activity.instrument) or return true
   123	      return true if trade.trade_legs.exists?(activity: activity)
   124	      ratio = split_ratio(trade.quantity, delivered)
   125	      if ratio
   126	        trade.trade_legs.create!(activity: activity, kind: :adjustment, ratio: ratio, quantity: delivered, cash_amount: 0, executed_at: activity.executed_at, note: "split or stock dividend")
   127	      else
   128	        trade.trade_legs.create!(activity: activity, kind: :adjustment, quantity: delivered, cash_amount: activity.net_amount, executed_at: activity.executed_at, note: "transfer")
   129	        trade.flag!(:corporate_action)
   130	      end
   131	      trade.recompute!
   132	      true
   133	    end
   134	
   135	    def split_ratio(running, delivered)
   136	      return nil unless running.positive? && delivered.positive?
   137	      ratio = (running + delivered) / running
   138	      ratio if ratio > 1 && ratio == ratio.round(RATIO_SCALE)
   139	    end
   140	
   141	    # CUSIP succession: the predecessor's open trade moves to the successor, absorbing any unreviewed
   142	    # bootstrapped trade the positions sync already opened there.
   143	    def link_corporate_action(activity)
   144	      securities = Schwab::Activity.from(activity.raw).securities
   145	      delivered_out = securities.find { |s| s.amount&.negative? }
   146	      delivered_in = securities.find { |s| s.amount&.positive? }
   147	      predecessor = delivered_out && Instrument.resolve(delivered_out.instrument)
   148	      successor = delivered_in && Instrument.resolve(delivered_in.instrument)
   149	      trade = predecessor && open_trade_for(predecessor)
   150	      unless trade && successor
   151	        [ predecessor, successor ].compact.each { |i| open_trade_for(i)&.flag!(:corporate_action) }
   152	        return true
   153	      end
   154	      absorb_bootstrapped_trade(trade, successor)
   155	      successor.update!(predecessor_instrument: predecessor) if successor.predecessor_instrument_id.nil? && successor != predecessor
   156	      ratio = delivered_out.amount.abs.positive? ? delivered_in.amount / delivered_out.amount.abs : nil
   157	      trade.update!(instrument: successor)
   158	      trade.trade_legs.create!(activity: activity, kind: :adjustment, ratio: ratio, cash_amount: activity.net_amount, executed_at: activity.executed_at,
   159	                               note: "succession #{predecessor.symbol} -> #{successor.symbol}")
   160	      trade.flag!(:corporate_action) unless ratio
   161	      trade.recompute!
   162	      true
   163	    end
   164	
   165	    def absorb_bootstrapped_trade(trade, successor)
   166	      other = open_trade_for(successor)
   167	      return unless other && other.bootstrapped? && other.needs_review?
   168	      other.trade_legs.where.not(activity_id: nil).update_all(trade_id: trade.id)
   169	      other.destroy!
   170	    end
   171	end

