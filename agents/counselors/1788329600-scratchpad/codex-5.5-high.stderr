     1	module StopCollar
     2	  # 17:00 New York on weekdays: recompute the trails for every open position on the trading account and keep
     3	  # the tightest one above the working stop as a suggestion for the end-of-day brief. Nothing is placed.
     4	  class TrailJob < ApplicationJob
     5	    limits_concurrency to: 1, key: ->(*) { self.class.name }, on_conflict: :discard
     6	
     7	    def perform
     8	      Account.trading.find_each do |account|
     9	        account.positions.includes(:instrument, :working_stop_order).each do |position|
    10	          next if position.delisted?
    11	          params = RiskRule.active_for("stop_collar", setup: position_setup(account, position))&.params || {}
    12	          suggestion = StopCollar::Trail.new(position, params: params).suggestion
    13	          position.update!(suggested_stop: suggestion&.price, suggested_stop_method: suggestion&.method)
    14	        end
    15	      end
    16	    end
    17	
    18	    private
    19	      def position_setup(account, position) = account.trades.open.find_by(instrument: position.instrument)&.setup
    20	  end
    21	end

