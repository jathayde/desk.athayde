require "rails_helper"

RSpec.describe "Watchlist and annotations" do
  let!(:account) { create(:account) }
  let(:john) { create(:user, email_address: "john@athayde.com", approver: true) }

  it "adds a watchlist item through the tool, one watching row per symbol, audited as the agent's" do
    result = Agent::Tools.call("add_watchlist_item", { symbol: "abc", trigger: "close above 20 on volume", thesis: "base breakout" }, transport: :mcp)
    expect(result.ok?).to be(true)
    item = WatchlistItem.find(result.value["watchlist_item_id"])
    expect(item).to have_attributes(symbol: "ABC", origin: "agent", status: "watching", trigger: "close above 20 on volume")
    expect(Agent::Tools.call("add_watchlist_item", { symbol: "ABC", trigger: "again" }, transport: :mcp).error).to include("already watched")
    expect(Agent::Tools.call("add_watchlist_item", { symbol: "NO TICK", trigger: "x" }, transport: :mcp).error).to include("ticker")
    expect(Agent::Tools.call("add_watchlist_item", { symbol: "DEF", trigger: "x" }, transport: :scheduled).error).to include("not available")
    item.drop!(user: john)
    expect(WatchlistItem.add!(symbol: "ABC", trigger: "later", origin: :human, user: john)).to be_watching
  end

  it "appends to a trade's post-mortem, dated and signed, without touching the human's words or followed_setup" do
    trade = create(:trade, account: account, status: :closed, post_mortem: "held to target", followed_setup: true)
    result = Agent::Tools.call("annotate_trade", { trade_id: trade.id, note: "exit was into strength; consider trailing next time" }, transport: :mcp)
    expect(result.ok?).to be(true)
    expect(trade.reload.post_mortem).to eq("held to target\n#{MarketDay.today} agent: exit was into strength; consider trailing next time")
    expect(trade.followed_setup).to be(true)
    expect(AuditEvent.where(kind: "trade_annotated", subject: trade)).to exist
    expect(Agent::Tools.call("annotate_trade", { trade_id: 999_999, note: "x" }, transport: :mcp).error).to include("no journaled trade")
  end

  it "lists lots for a sell with their terms, FIFO by default, and refuses an unknown lot method quietly" do
    xyz = create(:instrument, symbol: "XYZ")
    trade = create(:trade, account: account, instrument: xyz, status: :open, quantity: 30, avg_entry: 50)
    old = fill(account, xyz, "BUY", 10, 40, at: 2.years.ago)
    recent = fill(account, xyz, "BUY", 20, 55, at: 3.months.ago)
    trade.trade_legs.create!(kind: :entry, quantity: 10, price: 40, cash_amount: -400, executed_at: 2.years.ago, activity: old)
    trade.trade_legs.create!(kind: :entry, quantity: 20, price: 55, cash_amount: -1100, executed_at: 3.months.ago, activity: recent)
    lots = TaxLots.for(trade)
    expect(lots.map(&:term)).to eq(%i[ long short ])
    expect(lots.first).to have_attributes(quantity: 10, price: 40)
    expect(TaxLots.for(nil)).to eq([])
    create(:position, account: account, instrument: xyz, quantity: 30)
    draft = Proposals.draft(account: account, kind: :exit, side: :sell, symbol: "XYZ", limit_price: 60, origin: :human)
    expect(draft.tax_lot_method).to eq("FIFO")
    expect(Proposals.draft(account: account, kind: :exit, side: :sell, symbol: "XYZ", limit_price: 60, origin: :human, tax_lot_method: "LIFO").tax_lot_method).to eq("LIFO")
    expect(Proposals.draft(account: account, kind: :exit, side: :sell, symbol: "XYZ", limit_price: 60, origin: :human, tax_lot_method: "MAGIC").tax_lot_method).to eq("FIFO")
  end
end

