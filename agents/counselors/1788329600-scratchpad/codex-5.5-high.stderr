require "rails_helper"

RSpec.describe StopCollar::TrailJob do
  let!(:account) { create(:account, schwab_hash: Schwab::FakeClient::ACCOUNT_HASH) }
  let!(:token) { create(:schwab_token) }
  let(:xyz) { create(:instrument, symbol: "XYZ", cusip: "037833100") }

  it "keeps the tightest trail above the working stop as a suggestion, clears it when nothing is tighter, and skips delisted holdings" do
    script_price_history(close: 60, range: 1)
    stop = create(:order, :working_stop, account: account, instrument: xyz, stop_price: 40, quantity: 10, remaining_quantity: 10)
    position = create(:position, account: account, instrument: xyz, quantity: 10, last_price: 60, working_stop_order: stop)
    described_class.perform_now
    expect(position.reload.suggested_stop).to be > 40
    expect(position.suggested_stop).to be < 60
    expect(position.suggested_stop_method).to be_in(%w[ chandelier atr ])

    stop.update!(stop_price: 59.9) # already tighter than any trail
    described_class.perform_now
    expect(position.reload.suggested_stop).to be_nil

    stop.update!(stop_price: 40)
    xyz.update!(delisted_at: Time.current)
    described_class.perform_now
    expect(position.reload.suggested_stop).to be_nil
  end

  it "suggests nothing on thin or stale data" do
    position = create(:position, account: account, instrument: xyz, quantity: 10, last_price: 60)
    described_class.perform_now # the shipped two-candle fixture
    expect(position.reload.suggested_stop).to be_nil
  end
end

