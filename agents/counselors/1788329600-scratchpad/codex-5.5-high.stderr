class WatchlistItemsController < ApplicationController
  def index
    @items = WatchlistItem.current.includes(:instrument)
    @dropped = WatchlistItem.dropped.order(updated_at: :desc).limit(10)
  end

  def create
    item = WatchlistItem.add!(symbol: params[:symbol], trigger: params[:trigger], thesis: params[:thesis], origin: :human, user: Current.user)
    AuditEvent.log("watchlist_changed", actor: :human, user: Current.user, subject: item, reason: "added", data: { symbol: item.symbol })
    redirect_to watchlist_items_path, notice: "Watching #{item.symbol}."
  rescue ActiveRecord::RecordInvalid => e
    redirect_to watchlist_items_path, alert: e.record.errors.full_messages.to_sentence
  end

  # The one change a row takes: dropped.
  def update
    item = WatchlistItem.watching.find(params[:id])
    item.drop!(user: Current.user)
    AuditEvent.log("watchlist_changed", actor: :human, user: Current.user, subject: item, reason: "dropped", data: { symbol: item.symbol })
    redirect_to watchlist_items_path, notice: "Dropped #{item.symbol}."
  end
end

