module StopCollar
  # 17:00 New York on weekdays: recompute the trails for every open position on the trading account and keep
  # the tightest one above the working stop as a suggestion for the end-of-day brief. Nothing is placed.
  class TrailJob < ApplicationJob
    limits_concurrency to: 1, key: ->(*) { self.class.name }, on_conflict: :discard

    def perform
      Account.trading.find_each do |account|
        account.positions.includes(:instrument, :working_stop_order).each do |position|
          next if position.delisted?
          params = RiskRule.active_for("stop_collar", setup: position_setup(account, position))&.params || {}
          suggestion = StopCollar::Trail.new(position, params: params).suggestion
          position.update!(suggested_stop: suggestion&.price, suggested_stop_method: suggestion&.method)
        end
      end
    end

    private
      def position_setup(account, position) = account.trades.open.find_by(instrument: position.instrument)&.setup
  end
end

