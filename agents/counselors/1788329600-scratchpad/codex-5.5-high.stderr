 succeeded in 0ms:
# Trailing stops for an open position (PRD §5.4.1): the chandelier exit and the ATR trail off the latest close,
# from the same year of candles the collar reads. Suggested when tighter than the working stop; never placed.
class StopCollar::Trail
  Suggestion = Data.define(:method, :price)

  def initialize(position, params: {})
    @position, @params = position, StopCollar::Calculator::DEFAULTS.merge(params.to_h.transform_keys(&:to_s))
  end

  # The tightest trail above the working stop, or nil when nothing is tighter or the data is not there.
  def suggestion
    history = Agent::MarketData.price_history(@position.instrument.symbol, range: "1y")
    return nil if history[:stale]
    candles = Array(history[:candles]).map { |c| c.transform_keys(&:to_sym) }.sort_by { |c| c[:date] }
    return nil if candles.size < StopCollar::Calculator::MIN_CANDLES
    trails = {
      chandelier: candles.last(param(:chandelier_bars).to_i).map { |c| c[:high] }.max - param(:chandelier_k) * atr(candles, param(:chandelier_bars).to_i),
      atr: candles.last[:close] - param(:atr_k) * atr(candles, 14)
    }.transform_values { |v| v.round(4) }
    method, price = trails.max_by { |_, v| v }
    floor = @position.stop_price
    return nil if floor && price <= floor
    return nil if @position.last_price && price >= @position.last_price
    Suggestion.new(method: method.to_s, price: price)
  rescue Schwab::Error, Agent::Tool::InvalidArguments
    nil
  end

  private
    def param(name) = BigDecimal(@params.fetch(name.to_s).to_s)

    def atr(candles, n)
      ranges = candles.each_cons(2).to_a.last(n).map { |prev, c| [ c[:high] - c[:low], (c[:high] - prev[:close]).abs, (c[:low] - prev[:close]).abs ].max }
      ranges.sum / ranges.size
    end
end

