# What a sell would be selling (PRD §5.4 6a): the open trade's entry legs as lots, each with its acquisition
# date and whether it is long-term yet. Schwab's lot method names are unverified (verify-on-approval item 51).
module TaxLots
  LONG_TERM_AFTER = 1.year
  METHODS = %w[ FIFO LIFO HIGH_COST LOW_COST ].freeze # SCHWAB_SHAPE_UNVERIFIED: taxLotMethod enum values
  DEFAULT_METHOD = "FIFO"

  Lot = Data.define(:acquired_at, :quantity, :price, :term) do
    def long_term? = term == :long
  end

  def self.for(trade)
    return [] unless trade&.open?
    trade.ordered_legs.select { |leg| leg.kind_entry? }.map do |leg|
      acquired = leg.executed_at
      Lot.new(acquired_at: acquired, quantity: leg.quantity, price: leg.price, term: acquired && acquired <= LONG_TERM_AFTER.ago ? :long : (acquired ? :short : :unknown))
    end
  end
end

