    12	  def link_all!
    13	    @account.activities.unjournaled.valid_for_journal.chronological.includes(:instrument, order: :order_proposal).each { |activity| link!(activity) }
    14	    @account.activities.unjournaled.where.not(status: Schwab::Activity::VALID).update_all(journaled_at: Time.current)
    15	    Setup.where(id: @closed_setups.uniq).find_each { |setup| Journal::RecomputeSetupStatsJob.perform_later(setup) }
    16	  end
    17	
    18	  def link!(activity)
    19	    Activity.transaction do
    20	      linked = case activity.kind.to_sym
    21	      when :fill then link_fill(activity)
    22	      when :dividend, :interest then link_income(activity)
    23	      when :transfer then link_transfer(activity)
    24	      when :corporate_action then link_corporate_action(activity)
    25	      else true
    26	      end
    27	      activity.update!(journaled_at: Time.current) if linked
    28	    end
    29	  rescue ActiveRecord::RecordInvalid, ActiveRecord::RecordNotUnique, Schwab::MappingError => e
    30	    open_trade_for(activity.instrument)&.flag!(:corporate_action) if activity.instrument
    31	    Rails.logger.warn("journal: skipped activity #{activity.broker_activity_id}: #{e.class} #{e.message}")
    32	  end
    33	
    34	  # Reconciles every open trade to the broker, but only when the broker row is newer than what the journal
    35	  # has seen, so the positions/activities race cannot manufacture a plug or a missing-position flag.
    36	  def reconcile_positions!
    37	    positions = @account.positions.includes(:instrument).index_by(&:instrument_id)
    38	    @account.trades.open.includes(:instrument).find_each do |trade|
    39	      next if @account.activities.unjournaled.where(instrument_id: trade.instrument_id).exists?
    40	      position = positions[trade.instrument_id]
    41	      if position
    42	        next if position.quantity <= 0 || position.average_price.nil? || position.synced_at < latest_fill_at(trade)
    43	        trade.reconcile_plug!(broker_quantity: position.quantity, average_price: position.average_price)
    44	      elsif activities_caught_up_past?(latest_fill_at(trade))
    45	        trade.flag!(:position_missing)
    46	      end
    47	    end
    48	    positions.each_value do |position|
    49	      next if position.quantity <= 0 || position.average_price.nil? || @account.trades.open.exists?(instrument_id: position.instrument_id)
    50	      next if @account.activities.unjournaled.where(instrument_id: position.instrument_id).exists?
    51	      trade = @account.trades.create!(instrument: position.instrument, status: :open)
    52	      trade.reconcile_plug!(broker_quantity: position.quantity, average_price: position.average_price)
    53	    rescue ActiveRecord::RecordNotUnique
    54	      next
    55	    end
    56	  end
    57	
    58	  private
    59	    def open_trade_for(instrument) = @account.trades.open.find_by(instrument: instrument)
    60	    def latest_fill_at(trade) = trade.trade_legs.where.not(activity_id: nil).maximum(:executed_at) || Time.at(0)
    61	    def activities_caught_up_past?(time) = (SyncRun.last_window_to(:activities, @account) || Time.at(0)) >= time
    62	
    63	    # A fill with no side, quantity, or instrument stays unjournaled and visible rather than silently stamped.
    64	    def link_fill(activity)
    65	      return false if activity.instrument.nil? || activity.side.nil? || activity.quantity.nil?
    66	      trade = open_trade_for(activity.instrument) || open_trade_from(activity)
    67	      adopt_proposal(trade, activity)
    68	      leg = trade.trade_legs.find_or_create_by!(activity: activity) do |l|
    69	        l.kind = activity.buy? ? :entry : :exit
    70	        l.quantity = activity.quantity
    71	        l.price = activity.price
    72	        l.cash_amount = activity.net_amount
    73	        l.executed_at = activity.executed_at
    74	      end
    75	      earlier_legs = TradeLeg.joins(:trade).where(trades: { account_id: @account.id, instrument_id: activity.instrument_id }).where.not(id: leg.id).where.not(activity_id: nil)
    76	      trade.flag!(:ordering_ambiguous) if earlier_legs.where("executed_at >= ?", leg.executed_at).exists?
    77	      trade.recompute!
    78	      @closed_setups << trade.setup_id if trade.closed? && trade.setup_id
    79	      true
    80	    end
    81	
    82	    # A buy with no open trade starts one. A sell with no open trade is a legacy holding: bootstrap a plug that
    83	    # covers what was held before the sale, priced from the position when there is one and unpriced otherwise.
    84	    def open_trade_from(activity)
    85	      trade = Trade.transaction(requires_new: true) { @account.trades.create!(instrument: activity.instrument, status: :open) }
    86	      if activity.buy?
    87	        proposal = activity.order&.order_proposal
    88	        trade.flag!(:missing_setup) if proposal.nil?
    89	      else
    90	        position = @account.positions.find_by(instrument: activity.instrument)
    91	        trade.reconcile_plug!(broker_quantity: (position&.quantity || 0) + activity.quantity, average_price: position&.average_price)
    92	      end
    93	      trade
    94	    rescue ActiveRecord::RecordNotUnique
    95	      open_trade_for(activity.instrument)
    96	    end
    97	
    98	    # The originating proposal's plan, taken whenever it becomes known (the order may sync after the fill).
    99	    def adopt_proposal(trade, activity)
   100	      proposal = activity.order&.order_proposal
   101	      return if proposal.nil? || trade.order_proposal_id
   102	      trade.update!(order_proposal: proposal, setup: proposal.setup, thesis: proposal.thesis, planned_stop: proposal.planned_stop, planned_target: proposal.target_price)
   103	      trade.flag!(:missing_stop) if trade.planned_stop.nil?
   104	      trade.clear_flag!(:missing_setup)
   105	    end
   106	
   107	    # Income lands on the open trade, else on a trade closed recently enough to have held the shares on the record date.
   108	    def link_income(activity)
   109	      return true if activity.instrument.nil?
   110	      trade = open_trade_for(activity.instrument) ||
   111	        @account.trades.closed.where(instrument: activity.instrument, closed_at: (activity.executed_at - Trade::DIVIDEND_AFTER_CLOSE_WINDOW)..).order(closed_at: :desc).first
   112	      return true unless trade
   113	      trade.trade_legs.find_or_create_by!(activity: activity) { |l| l.kind = :income; l.cash_amount = activity.net_amount; l.executed_at = activity.executed_at }
   114	      trade.recompute!
   115	      true
   116	    end
   117	
   118	    # Shares delivered onto an open trade: a clean ratio is a split or stock dividend, anything else is a transfer to review.
   119	    def link_transfer(activity)
   120	      delivered = activity.delivered_quantity
   121	      return true if delivered.nil?
   122	      trade = open_trade_for(activity.instrument) or return true
   123	      return true if trade.trade_legs.exists?(activity: activity)
   124	      ratio = split_ratio(trade.quantity, delivered)
   125	      if ratio
   126	        trade.trade_legs.create!(activity: activity, kind: :adjustment, ratio: ratio, quantity: delivered, cash_amount: 0, executed_at: activity.executed_at, note: "split or stock dividend")
   127	      else
   128	        trade.trade_legs.create!(activity: activity, kind: :adjustment, quantity: delivered, cash_amount: activity.net_amount, executed_at: activity.executed_at, note: "transfer")
   129	        trade.flag!(:corporate_action)
   130	      end
   131	      trade.recompute!
   132	      true
   133	    end
   134	
   135	    def split_ratio(running, delivered)
   136	      return nil unless running.positive? && delivered.positive?
   137	      ratio = (running + delivered) / running
   138	      ratio if ratio > 1 && ratio == ratio.round(RATIO_SCALE)
   139	    end
   140	
   141	    # CUSIP succession: the predecessor's open trade moves to the successor, absorbing any unreviewed
   142	    # bootstrapped trade the positions sync already opened there.
   143	    def link_corporate_action(activity)
   144	      securities = Schwab::Activity.from(activity.raw).securities
   145	      delivered_out = securities.find { |s| s.amount&.negative? }
   146	      delivered_in = securities.find { |s| s.amount&.positive? }
   147	      predecessor = delivered_out && Instrument.resolve(delivered_out.instrument)
   148	      successor = delivered_in && Instrument.resolve(delivered_in.instrument)
   149	      trade = predecessor && open_trade_for(predecessor)
   150	      unless trade && successor
   151	        [ predecessor, successor ].compact.each { |i| open_trade_for(i)&.flag!(:corporate_action) }
   152	        return true
   153	      end
   154	      absorb_bootstrapped_trade(trade, successor)
   155	      successor.update!(predecessor_instrument: predecessor) if successor.predecessor_instrument_id.nil? && successor != predecessor
   156	      ratio = delivered_out.amount.abs.positive? ? delivered_in.amount / delivered_out.amount.abs : nil
   157	      trade.update!(instrument: successor)
   158	      trade.trade_legs.create!(activity: activity, kind: :adjustment, ratio: ratio, cash_amount: activity.net_amount, executed_at: activity.executed_at,
   159	                               note: "succession #{predecessor.symbol} -> #{successor.symbol}")
   160	      trade.flag!(:corporate_action) unless ratio
   161	      trade.recompute!
   162	      true
   163	    end
   164	
   165	    def absorb_bootstrapped_trade(trade, successor)
   166	      other = open_trade_for(successor)
   167	      return unless other && other.bootstrapped? && other.needs_review?
   168	      other.trade_legs.where.not(activity_id: nil).update_all(trade_id: trade.id)
   169	      other.destroy!
   170	    end
   171	end

