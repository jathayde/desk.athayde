    16	    return render :nothing_pending, status: :conflict unless pending && pending["at"] > STATE_TTL.ago.to_i
    17	    return reject_with("State mismatch", data: { csrf: true }) unless ActiveSupport::SecurityUtils.secure_compare(pending["value"], params[:state].to_s)
    18	    return reject_with("Schwab returned #{params[:error]}") if params[:error].present?
    19	
    20	    SchwabToken::Reauth.complete!(params.expect(:code), user: Current.user)
    21	    redirect_to schwab_connected_path
    22	  rescue SchwabToken::Reauth::Failure, Schwab::Error => e
    23	    reject_with(e.message)
    24	  end
    25	
    26	  def connected
    27	    @token = SchwabToken.current
    28	  end
    29	
    30	  # Development and Playwright only: stands in for Schwab's hosted login.
    31	  def fake_authorize
    32	    code = params[:fail].present? ? "bad-code" : Schwab::FakeClient::FAKE_CODE
    33	    redirect_to schwab_callback_path(code: code, state: params[:state])
    34	  end
    35	
    36	  private
    37	    def reject_with(message, data: {})
    38	      AuditEvent.log("re_auth_failed", actor: :human, user: Current.user, reason: message.truncate(200), data: data)
    39	      @message = message
    40	      render :failed, status: :unprocessable_content
    41	    end
    42	
    43	    def request_authentication
    44	      redirect_to new_session_path, alert: "Sign in, then start the Schwab connection again."
    45	    end
    46	
    47	    def require_fake_adapter
    48	      head :not_found unless Schwab.fake? && !Rails.env.production?
    49	    end
    50	end

