    38	    stop = params[:planned_stop].presence&.to_d
    39	    @trade.review!(setup: setup || nil, planned_stop: stop, thesis: params[:thesis], user: Current.user)
    40	    redirect_to next_in_queue, notice: "Reviewed #{@trade.instrument.symbol}."
