    13	  <div class="banner expiring"><b>Token expires <%= l(d.token.refresh_expires_at, format: :weekday_time) %>.</b> <%= link_to "Re-authenticate now", schwab_authorize_path %><% if d.token.refresh_expires_at >= Time.current.next_occurring(:sunday).change(hour: 18) %>, or wait for Sunday's email<% end %>.</div>
    14	<% end %>
    15	<% d.secondary_statuses.each do |status| %>
    16	  <p class="status-line">
    17	    <% case status
    18	       when :revoked, :expired, :missing %>Schwab connection is down; <%= link_to "re-authenticate", schwab_authorize_path %>.
    19	    <% when :expiring %>Token expires <%= l(d.token.refresh_expires_at, format: :weekday_time) %>; <%= link_to "re-authenticate", schwab_authorize_path %>.
    20	    <% when :sync_paused %>Sync paused: <%= d.sync_paused_reason %>.
    21	    <% when :sync_failed %>Last <%= d.sync_failure.feed %> sync failed: <%= d.sync_failure.error.to_s.truncate(100) %>.
    22	    <% when :calendar_fallback %>Market calendar unavailable from Schwab today; assuming a normal session.
    23	    <% end %>
    24	  </p>
    25	<% end %>

