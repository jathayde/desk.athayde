     1	module Schwab
     2	  # Runs 08:00 and 20:00 ET. Nags when there is no usable token (every run), on Monday and Tuesday when the
     3	  # token will not outlive the coming Sunday email, and once per token when it enters the 24-hour window
     4	  # without the Sunday email covering it.
     5	  class TokenHealthJob < ApplicationJob
     6	    SUNDAY_EMAIL_HOUR = 18
     7	
     8	    def perform
     9	      token = SchwabToken.current
    10	      reason = nag_reason(token)
    11	      return unless reason
    12	      TokenMailer.nag(reason, token).deliver_now
    13	      AuditEvent.log("token_nag_sent", actor: :system, subject: token, reason: reason.to_s)
    14	    end
    15	
    16	    private
    17	      def nag_reason(token)
    18	        case SchwabToken.status(token)
    19	        when :missing, :revoked, :expired then SchwabToken.status(token)
    20	        else
    21	          return :missed_sunday if missed_sunday?(token)
