     1	# One row per account per market day, chain-linked so deposits and withdrawals never move the drawdown.
     2	class Snapshot < ApplicationRecord
     3	  CLOSE_DELAY = 20.minutes
     4	
     5	  belongs_to :account
     6	
     7	  scope :chronological, -> { order(:as_of) }
     8	
     9	  # Writes (or rechains) the snapshot for one day from balances, flows, and positions. Returns nil, writing
    10	  # nothing, when the day has no usable balance yet: a stale or intraday balance is never smeared across days.
    11	  # Risk columns are stamped only when the row is first written; a rebuild cannot know past positions.
    12	  def self.record(account, date, run: nil)
    13	    day = MarketDay.find_by(date: date)
    14	    return nil unless day&.schwab? && day.trading? && Time.current >= day.regular_closes_at + CLOSE_DELAY
    15	    balance = balance_for(account, day) or return nil
    16	    return nil unless balance.equity&.positive?
    17	
    18	    prior = account.snapshots.where(as_of: ...date).order(as_of: :desc).first
    19	    flows = net_flows(account, after: prior&.as_of, through: date, run: run)
    20	    daily_return = prior ? (balance.equity - flows - prior.equity) / prior.equity : BigDecimal("0")
    21	    index = prior ? prior.index_value * (1 + daily_return) : BigDecimal("1")
    22	    high_water = [ prior&.high_water_index || BigDecimal("1"), index ].max
    23	
    24	    snapshot = account.snapshots.find_or_initialize_by(as_of: date)
    25	    snapshot.assign_attributes(equity: balance.equity, net_flows: flows, daily_return: daily_return, index_value: index,
    26	                               high_water_index: high_water, drawdown: 1 - index / high_water)
    27	    snapshot.assign_attributes(risk_now(account, balance.equity)) if snapshot.new_record?
    28	    snapshot.save!
    29	    snapshot
    30	  end
    31	
    32	  # Latest balance at or after the regular close on the day, else the day's latest, else nothing.
    33	  def self.balance_for(account, day)
    34	    window = day.date.in_time_zone(MarketDay::ZONE).all_day
    35	    on_day = account.balances.where(as_of: window)
    36	    on_day.where(as_of: day.regular_closes_at..).order(as_of: :desc).first || on_day.order(as_of: :desc).first
    37	  end
    38	
    39	  # Deposits positive, withdrawals negative, over every day since the prior snapshot so a flow on a missing
    40	  # day is still neutralized. Share transfers count at their cash value when they carry one; a split has an
    41	  # adjustment ratio and is not a flow; anything else unpriced is quarantined, never silently zero.
    42	  def self.net_flows(account, after:, through:, run: nil)
    43	    range = after ? (after + 1)..through : through..through
    44	    cash = account.activities.flows.where(trade_date: range).sum(&:flow_amount)
    45	    transfers = account.activities.transfer.where(trade_date: range).where.not(instrument_id: nil).includes(:trade_leg)
    46	    shares = transfers.sum do |activity|
    47	      next 0 if activity.trade_leg&.ratio
    48	      next activity.net_amount if activity.net_amount&.nonzero?
    49	      run&.quarantine(:unpriced_transfers, activity.broker_activity_id)
    50	      0
    51	    end
    52	    cash + shares
    53	  end
    54	
    55	  def self.risk_now(account, equity)
    56	    positions = account.positions.includes(:working_stop_order).to_a
    57	    protected_positions = positions.select(&:protected?)
    58	    open_risk = protected_positions.sum(&:open_risk)
    59	    { open_risk_amount: open_risk, open_risk_ratio: open_risk / equity, unprotected_count: positions.size - protected_positions.size }
    60	  end
    61	end

