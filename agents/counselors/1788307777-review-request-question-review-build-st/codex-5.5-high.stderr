 succeeded in 0ms:
     1	# One row per feed run. Wraps the work so token loss, Schwab failures, and quarantined records all
     2	# land as a status; anything else is recorded as failed and re-raised so the queue sees it too.
     3	class SyncRun < ApplicationRecord
     4	  STALE_AFTER = 10.minutes # a running row older than this is a crashed or restarted worker, not a run
     5	
     6	  belongs_to :account, optional: true
     7	
     8	  enum :feed, {
     9	    accounts: "accounts", positions: "positions", orders: "orders", activities: "activities",
    10	    market_hours: "market_hours", memory_repo: "memory_repo", snapshots: "snapshots"
    11	  }, prefix: true
    12	  enum :status, { running: "running", succeeded: "succeeded", partial: "partial", failed: "failed", skipped_token: "skipped_token" }
    13	
    14	  scope :recent_first, -> { order(started_at: :desc) }
    15	  scope :for, ->(feed, account) { where(feed: feed, account: account) }
    16	  scope :advanced_cursor, -> { where(status: %w[ succeeded partial ]) }
    17	  scope :live, -> { running.where(started_at: STALE_AFTER.ago..) }
    18	
    19	  def self.record(feed, account: nil, window_from: nil, window_to: nil)
    20	    run = create!(feed: feed, account: account, status: :running, started_at: Time.current, window_from: window_from, window_to: window_to)
    21	    outcome = yield run
    22	    run.finish!(outcome == :failed ? :failed : (outcome == :partial || run.unmapped_values.any? ? :partial : :succeeded))
    23	  rescue Schwab::NoUsableToken, Schwab::AuthError => e
    24	    run.finish!(:skipped_token, error: e.message)
    25	  rescue Schwab::Error => e
    26	    run.finish!(:failed, error: e.message)
    27	  rescue StandardError => e
    28	    run.finish!(:failed, error: "#{e.class}: #{e.message}")
    29	    raise
    30	  ensure
    31	    run&.finish!(:failed, error: "left running") if run&.running? && !run.destroyed?
    32	  end
    33	
    34	  def self.last_window_to(feed, account) = self.for(feed, account).advanced_cursor.maximum(:window_to)
    35	  def self.last_started_at(feed, account) = self.for(feed, account).maximum(:started_at)
    36	  def self.running?(feed, account) = self.for(feed, account).live.exists?
    37	
    38	  # Due when nothing is live and the last start is older than the interval, with a minute of slack for cron drift.
    39	  def self.due?(feed, account, every:)
    40	    return false if running?(feed, account)
    41	    last = last_started_at(feed, account)
    42	    last.nil? || last <= (every - 1.minute).ago
    43	  end
    44	
    45	  def finish!(status, error: nil)
    46	    update!(status: status, finished_at: Time.current, error: error&.truncate(1000))
    47	    self
    48	  end
    49	
    50	  def touched(count) = update!(records_touched: records_touched.to_i + count)
    51	
    52	  def quarantine(key, detail)
    53	    unmapped_values[key.to_s] = Array(unmapped_values[key.to_s]) << detail
    54	    save!
    55	  end
    56	end

