   142	    def avg_exit = @exit_qty.positive? ? @exit_proceeds / @exit_qty : nil
   143	
   144	    # The initial entry: every fill from the first fill's order (a partial fill is one entry); without an order
   145	    # id, every entry fill on the first fill's trade date.
   146	    def initial_entry_legs
   147	      return [] unless first_fill
   148	      order_id = first_fill.activity.broker_order_id
   149	      entries = @legs.select { |l| l.kind_entry? && l.activity }
   150	      order_id ? entries.select { |l| l.activity.broker_order_id == order_id } : entries.select { |l| l.activity.trade_date == first_fill.activity.trade_date }
   151	    end
   152	
   153	    private
   154	      def apply(leg)
   155	        case leg.kind
   156	        when "entry"
   157	          @running += leg.quantity
   158	          @entry_qty += leg.quantity
   159	          @entry_cost += leg.quantity * (leg.price || 0)
   160	          @first_fill ||= leg if leg.activity_id
   161	        when "exit"
   162	          @running -= leg.quantity
   163	          @exit_qty += leg.quantity
   164	          @exit_proceeds += leg.quantity * (leg.price || 0)
   165	          @closing_leg = leg if @running.zero?
   166	        when "adjustment"
   167	          if leg.ratio
   168	            @running *= leg.ratio
   169	            @entry_qty *= leg.ratio
   170	            @exit_qty *= leg.ratio
   171	            @ratio *= leg.ratio
   172	          elsif leg.quantity
   173	            @running += leg.quantity
   174	          end
   175	        end
   176	        @cash += leg.cash_amount || 0
   177	        @peak = @running if @running > @peak
   178	      end
   179	  end
   180	
   181	  private
   182	    # Fixed to the initial entry at its weighted price, in original-entry units. Nil, never a number, when the
   183	    # stop is unknown, the stop is above the entry, or a plug means the journal never saw the real entry.
   184	    def initial_risk_for(initial_legs, plug:)
   185	      return nil if plug || planned_stop.blank? || initial_legs.empty?
   186	      quantity = initial_legs.sum(&:quantity)
   187	      average = initial_legs.sum { |l| l.quantity * (l.price || 0) } / quantity
   188	      risk = quantity * (average - planned_stop)
   189	      risk.positive? ? risk : nil
   190	    end
   191	
   192	    def total_risk_for(legs)
   193	      return nil if planned_stop.blank?
   194	      legs.select { |l| l.kind_entry? && l.price && !l.plug? }.sum { |l| [ l.quantity * (l.price - planned_stop), 0 ].max }
   195	    end
   196	
   197	    def recompute_setup_stats(*setups)
   198	      setups.compact.uniq.each { |s| Journal::RecomputeSetupStatsJob.perform_later(s) }
   199	    end
   200	end

