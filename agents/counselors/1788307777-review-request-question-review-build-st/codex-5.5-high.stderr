     4	  def index
     5	    @filter = params[:filter].presence_in(%w[ open closed needs_review missing_post_mortem ]) || "open"
     6	    @trades = Trade.joins(:account).merge(Account.trading).includes(:instrument, :setup).then do |scope|
     7	      case @filter
     8	      when "open" then scope.open.order(opened_at: :desc, id: :desc)
     9	      when "closed" then scope.closed.order(closed_at: :desc)
    10	      when "needs_review" then scope.review_queue
    11	      when "missing_post_mortem" then scope.missing_post_mortem.order(closed_at: :desc)
    12	      end
    13	    end
    14	    @review_count = Trade.needing_review.count
    15	  end
    16	
    17	  def show
