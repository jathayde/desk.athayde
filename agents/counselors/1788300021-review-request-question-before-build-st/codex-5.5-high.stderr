## OAuth

| Item | Value |
|---|---|
| Authorize | `GET /v1/oauth/authorize?response_type=code&client_id={app_key}&redirect_uri={callback}&state={csrf}` |
| Callback | `{callback}?code=...&session=...`; `code` ends in `@` after one URL-decode. Rails `params[:code]` is already decoded once; do not decode again |
| Token endpoint | `POST /v1/oauth/token`, `Authorization: Basic base64("#{app_key}:#{app_secret}")`, `Content-Type: application/x-www-form-urlencoded` |
| Code grant | `grant_type=authorization_code&code={code}&redirect_uri={callback}` |
| Refresh grant | `grant_type=refresh_token&refresh_token={token}` |
| Token response | `{"expires_in":1800,"token_type":"Bearer","scope":"api","refresh_token","access_token","id_token"}`; `id_token` is not persisted |
| Access token | 30 minutes; expired tokens are rejected outright (API 401) |
| Refresh token | 7 days from the authorization-code grant. **Refreshing does not extend it.** `refresh_expires_at` is set once at issuance and never moved |
| Refresh response | includes a `refresh_token`; store whatever comes back, keep `refresh_expires_at` |

The refresh job runs every 25 minutes. A token-endpoint 4xx is `ReauthRequired`: no backoff, no retry, pause sync.

require "net/http"

module Schwab
  # The only code that speaks HTTP to Schwab. Returns scrubbed raw hashes; the structs in this
  # namespace turn them into typed values. Every field name here is SCHWAB_SHAPE_UNVERIFIED
  # until docs/verify-on-approval.md is worked through.
  class Client
    TRADER = "https://api.schwabapi.com/trader/v1"
    MARKET = "https://api.schwabapi.com/marketdata/v1"
    OAUTH = "https://api.schwabapi.com/v1/oauth"
    OPEN_TIMEOUT = 5
    READ_TIMEOUT = 20
    BACKOFF = [ 1, 4, 16 ].freeze
    RETRY_AFTER_CAP = 60
    TRANSACTION_TYPES = %w[ TRADE RECEIVE_AND_DELIVER DIVIDEND_OR_INTEREST ELECTRONIC_FUND ACH_RECEIPT ACH_DISBURSEMENT
                            WIRE_IN WIRE_OUT JOURNAL CASH_RECEIPT CASH_DISBURSEMENT ].freeze

    # token responds to #access_token and, if it can renew itself, #refresh!
    def initialize(token: nil, app_key: Schwab.app_key, app_secret: Schwab.app_secret, callback_url: Schwab.callback_url, sleeper: method(:sleep))
      @token, @app_key, @app_secret, @callback_url, @sleeper = token, app_key, app_secret, callback_url, sleeper
    end

    # ---- OAuth -----------------------------------------------------------------------------

    def authorize_url(state:)
      "#{OAUTH}/authorize?" + URI.encode_www_form(response_type: "code", client_id: @app_key, redirect_uri: @callback_url, state: state)
    end

    # params[:code] is already URL-decoded once by Rails; it ends in "@". Do not decode again.
    def exchange_code(code)
      token_request(grant_type: "authorization_code", code: code, redirect_uri: @callback_url)
    end

    def refresh(refresh_token)
      token_request(grant_type: "refresh_token", refresh_token: refresh_token)
    end

    # ---- Trader API ------------------------------------------------------------------------

    # Hash values only; the plaintext numbers never leave this method.
    def account_numbers
      get(TRADER, "/accounts/accountNumbers").map { |row| row["hashValue"] }
    end

    def account(hash, fields: [ :positions ])
      get(TRADER, "/accounts/#{hash}", fields: Array(fields).join(","))
    end

    def orders(hash, from:, to: ::Time.current, status: nil)
      params = { fromEnteredTime: Timestamp.iso_ms(from), toEnteredTime: Timestamp.iso_ms(to), maxResults: 3000 }
      params[:status] = status if status
      get(TRADER, "/accounts/#{hash}/orders", **params)
    end

    def order(hash, order_id)
      get(TRADER, "/accounts/#{hash}/orders/#{order_id}")
    end

    # One request per type the sync cares about; whether omitting `types` returns everything is unverified.
    def transactions(hash, from:, to: ::Time.current, types: TRANSACTION_TYPES)
      Array(types).flat_map do |type|
        get(TRADER, "/accounts/#{hash}/transactions", startDate: Timestamp.iso_ms(from), endDate: Timestamp.iso_ms(to), types: type)
      end
    end

    # ---- Market Data API -------------------------------------------------------------------

    def market_hours(date, markets: [ :equity ])
      get(MARKET, "/markets", markets: Array(markets).join(","), date: Timestamp.date(date))
    end

    def quotes(symbols, fields: %w[ quote reference ])
      Array(symbols).each_slice(Schwab::QUOTE_BATCH).reduce({}) do |acc, batch|
        acc.merge(get(MARKET, "/quotes", symbols: batch.join(","), fields: fields.join(","), indicative: false))
      end
    end

    def price_history(symbol, period_type: :month, period: 3, frequency_type: :daily, frequency: 1, from: nil, to: nil)
      params = { symbol: symbol, periodType: period_type, period: period, frequencyType: frequency_type, frequency: frequency,
                 needExtendedHoursData: false, needPreviousClose: true }
      params[:startDate] = Timestamp.epoch_ms(from) if from
      params[:endDate] = Timestamp.epoch_ms(to) if to
      get(MARKET, "/pricehistory", **params)
    end

    def instrument(symbol_or_cusip)
      get(MARKET, "/instruments", symbol: symbol_or_cusip, projection: "symbol-search").fetch("instruments", [])
    end

    private
      def token_request(**form)
        request = Net::HTTP::Post.new(URI("#{OAUTH}/token"))
        request.basic_auth(@app_key, @app_secret)
        request["Accept"] = "application/json"
        request.set_form_data(form)
        response, attempts = perform(request, template: "/v1/oauth/token", idempotent: form[:grant_type] == "refresh_token")
        raise ReauthRequired.new("Schwab token endpoint responded #{response.code}: #{Error.summarize(response.body)}", status: response.code.to_i, body: Scrub.body(response.body)) if response.code.to_i.between?(400, 499)
        raise Error.for_response(response, attempts: attempts, idempotent: true) unless response.is_a?(Net::HTTPSuccess)
        JSON.parse(response.body).except("id_token")
      end

      def get(base, path, **params)
        uri = URI("#{base}#{path}")
        uri.query = URI.encode_www_form(params) if params.any?
        response, attempts = authorized(uri)
        raise Error.for_response(response, attempts: attempts, idempotent: true) unless response.is_a?(Net::HTTPSuccess)
        Scrub.json(JSON.parse(response.body))
      end

      # One refresh-and-retry on 401, outside the backoff budget.
      def authorized(uri, refreshed: false)
        request = Net::HTTP::Get.new(uri)
        request["Authorization"] = "Bearer #{@token.access_token}"
        request["Accept"] = "application/json"
        response, attempts = perform(request, template: Scrub.path(uri.path), idempotent: true)
        if response.code.to_i == 401 && !refreshed && @token.respond_to?(:refresh!)
          @token.refresh!
          return authorized(uri, refreshed: true)
        end
        [ response, attempts ]
      end

      # Returns [response, attempts]. Retries live here and nowhere else.
      def perform(request, template:, idempotent:)
        attempts = 0
        begin
          attempts += 1
          RateBudget.take!
          started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
          response = http(request.uri).request(request)
          log(request, template, response.code, started)
          return [ response, attempts ] unless retriable?(response) && idempotent && attempts <= BACKOFF.size
          @sleeper.call(delay_for(response, attempts))
          raise Retry
        rescue Retry
          retry
        rescue Net::OpenTimeout, Net::ReadTimeout, Errno::ECONNRESET, Errno::ECONNREFUSED, SocketError, OpenSSL::SSL::SSLError => e
          log(request, template, "transport", started)
          if idempotent && attempts <= BACKOFF.size
            @sleeper.call(BACKOFF[attempts - 1])
            retry
          end
          klass = idempotent ? TransportError : UnknownOutcome
          raise klass.new("#{e.class}: #{e.message}", attempts: attempts)
        end
      end

      Retry = Class.new(StandardError)

      def retriable?(response) = response.code.to_i == 429 || response.code.to_i >= 500

      def delay_for(response, attempt)
        base = BACKOFF[attempt - 1]
        retry_after = response["Retry-After"].to_i
        retry_after.positive? ? [ retry_after, RETRY_AFTER_CAP ].min : base + rand * base * 0.25
      end

      def http(uri)
        Net::HTTP.new(uri.host, uri.port).tap do |h|
          h.use_ssl = true
          h.open_timeout = OPEN_TIMEOUT
          h.read_timeout = READ_TIMEOUT
        end
      end

      def log(request, template, status, started)
        ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round
        Rails.logger.info("schwab #{request.method} #{template} #{status} #{ms}ms")
      end
  end
end
module Schwab
  # Same interface as Client, same raw shapes (already scrubbed), served from lib/schwab_fixtures so seeds,
  # Playwright, and specs all run the real mappers. A per-call queue scripts failures and alternate payloads:
  #   Schwab::FakeClient.instance.enqueue(:orders) { raise Schwab::RateLimited.new(retry_after: 30) }
  class FakeClient
    include Singleton

    FIXTURES = Rails.root.join("lib/schwab_fixtures")
    ACCOUNT_HASH = "9313A0737C4E1B2D5F6A7B8C9D0E1F2A3B4C5D6E7F8091A2B3C4D5E6F708192A"
    FAKE_CODE = "fake-authorization-code@"

    attr_reader :calls

    def initialize = reset!

    def reset!
      @queues = Hash.new { |h, k| h[k] = [] }
      @calls = []
      @closed_dates = Set.new
      self
    end

    # Script the next response for a method. The block receives the call's arguments.
    def enqueue(method_name, &block) = @queues[method_name] << block

    def close_market_on(date) = @closed_dates << date.to_date

    # ---- OAuth: the fake authorize page lives in the app (step 4) and redirects straight back
    def authorize_url(state:) = "/schwab/fake_authorize?#{ { state: state }.to_query }"
    def exchange_code(code) = scripted(:exchange_code, code) { code == FAKE_CODE ? fixture("token").except("id_token") : raise(ReauthRequired.new("invalid_grant", status: 400)) }
    def refresh(refresh_token) = scripted(:refresh, refresh_token) { fixture("token").except("id_token") }

    # ---- Trader API
    def account_numbers = scripted(:account_numbers) { fixture("account_numbers").map { |row| row["hashValue"] } }
    def account(hash, fields: [ :positions ]) = scripted(:account, hash, fields) { fixture("account") }
    def orders(hash, from:, to: ::Time.current, status: nil) = scripted(:orders, hash, from, to, status) { fixture("orders") }
    def order(hash, order_id) = scripted(:order, hash, order_id) { Order.from(fixture("orders").first).flatten.map(&:raw).find { |o| o["orderId"].to_s == order_id.to_s } or raise RequestError.new("order not found", status: 404) }
    def transactions(hash, from:, to: ::Time.current, types: Client::TRANSACTION_TYPES) = scripted(:transactions, hash, from, to, types) { fixture("transactions") }

    # ---- Market Data API
    def market_hours(date, markets: [ :equity ])
      scripted(:market_hours, date, markets) do
        closed = @closed_dates.include?(date.to_date) || date.to_date.on_weekend?
        shift_market_hours(fixture(closed ? "market_hours_closed" : "market_hours_open"), date)
      end
    end
    def quotes(symbols, fields: %w[ quote reference ]) = scripted(:quotes, symbols, fields) { fixture("quotes").slice(*Array(symbols).map(&:to_s), "errors") }
    def price_history(symbol, **) = scripted(:price_history, symbol) { fixture("price_history").merge("symbol" => symbol) }
    def instrument(symbol_or_cusip) = scripted(:instrument, symbol_or_cusip) { fixture("instruments")["instruments"] }

    private
      def scripted(method_name, *args)
        @calls << [ method_name, *args ]
        block = @queues[method_name].shift
        block ? block.call(*args) : yield
      end

      def fixture(name) = Scrub.json(JSON.parse(FIXTURES.join("#{name}.json").read))

      # Fixture dates are stand-ins; the requested date replaces them so the calendar stays coherent.
      def shift_market_hours(raw, date)
        original = raw["equity"].values.first["date"]
        JSON.parse(JSON.generate(raw).gsub(original, date.to_date.iso8601))
      end
  end
end

