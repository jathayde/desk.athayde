# Append-only. Every "logged" action in the PRD is a row here; the database triggers reject
# UPDATE, DELETE, and TRUNCATE, and Active Record refuses updates before it gets that far.
class AuditEvent < ApplicationRecord
  KINDS = %w[
    re_auth_succeeded re_auth_failed token_refresh_failed sync_paused_token_expired sync_resumed
    token_nag_sent shadow_mode_toggled manual_halt_set manual_halt_cleared trade_reviewed
    instrument_identity_fallback
  ].freeze

  belongs_to :user, optional: true
  belongs_to :subject, polymorphic: true, optional: true

  enum :actor, { human: "human", system: "system", agent: "agent" }, prefix: true

  validates :kind, inclusion: { in: KINDS }

  def self.log(kind, actor:, data: {}, user: nil, subject: nil, reason: nil)
    create!(kind: kind, actor: actor, user: user, subject: subject, reason: reason, data: data)
  end

  def readonly? = persisted?
end
# One row, enforced by a check constraint on id = 1. Holds the global flags the PRD calls out:
# shadow mode (on by default), the manual halt, and why sync is paused.
class SystemSettings < ApplicationRecord
  def self.instance = find_or_create_by!(id: 1)

  def halted? = manual_halt
end

