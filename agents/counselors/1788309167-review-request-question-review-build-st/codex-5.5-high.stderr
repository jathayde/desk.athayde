app/models/dashboard.rb:49:  end
app/models/dashboard.rb:50:
app/models/dashboard.rb:51:  # The latest feed failure nothing has succeeded since. Nil until an account exists and the token works.
app/models/dashboard.rb:52:  def sync_failure
app/models/dashboard.rb:53:    return @sync_failure if defined?(@sync_failure)
app/models/dashboard.rb:54:    @sync_failure = account && SchwabToken.usable? ? unresolved_failures.max_by(&:started_at) : nil
app/models/dashboard.rb:55:  end
app/models/dashboard.rb:56:
app/models/dashboard.rb:57:  def balance = @balance ||= account&.current_balance
