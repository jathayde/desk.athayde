app/models/dashboard.rb:45:    statuses << :sync_paused if sync_paused_reason.present? && %i[ revoked expired missing ].exclude?(token_status)
app/models/dashboard.rb:46:    statuses << :sync_failed if sync_failure
app/models/dashboard.rb:47:    statuses << :calendar_fallback if MarketDay.find_by(date: MarketDay.today)&.fallback?
