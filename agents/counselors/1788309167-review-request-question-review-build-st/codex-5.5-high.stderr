app/models/dashboard.rb:63:    @prior_snapshot = account && account.snapshots.where(as_of: ...MarketDay.today).order(as_of: :desc).first
app/models/dashboard.rb:64:  end
app/models/dashboard.rb:65:
app/models/dashboard.rb:66:  def day_change
