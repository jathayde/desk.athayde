      BODY_METHODS = { to_ary: true, each: true, call: true, to_path: true }

      def respond_to?(method, include_private = false)
        if BODY_METHODS.key?(method)
          @response.stream.respond_to?(method)
        else
          super
        end
      end

      def to_ary
        @response.stream.to_ary
      end

