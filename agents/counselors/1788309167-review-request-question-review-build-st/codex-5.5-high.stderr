# Everything that knows a Schwab field name lives under this namespace. See docs/schwab-api-contract.md.
module Schwab
  LOOKBACK = 60.days # orders and transactions; SCHWAB_SHAPE_UNVERIFIED (one source says a year)
  RATE_BUDGET_PER_MINUTE = 100 # community figure is 120/min per app; SCHWAB_SHAPE_UNVERIFIED
  QUOTE_BATCH = 100 # SCHWAB_SHAPE_UNVERIFIED

  class NoUsableToken < Error; end

  # Anything a client needs from a token: a bearer string. SchwabToken rows satisfy it; so does this for a
  # token that has no row yet.
  BearerToken = Data.define(:access_token)

  def self.fake? = Rails.configuration.x.schwab.adapter == :fake

  def self.client(token: nil, wait: true)
    return FakeClient.instance if fake?
    Client.new(token: token || usable_token!, wait: wait)
  end

  # The three-legged flow and the refresh grant authenticate with the app key, not a bearer token.
  def self.oauth_client(wait: true) = fake? ? FakeClient.instance : Client.new(wait: wait)

  # Refreshes ahead of expiry, so a 401 mid-sync is the safety net rather than the routine path.
  def self.usable_token!
    SchwabToken.current.tap do |token|
      raise NoUsableToken, "no usable Schwab token; re-authenticate" unless token&.usable?
    end.ensure_fresh!
  end

  def self.app_key = Rails.application.credentials.dig(:schwab, :app_key)
  def self.app_secret = Rails.application.credentials.dig(:schwab, :app_secret)
  # Production reads exactly this dokku config var; elsewhere the app's own route serves as the fake callback.
  def self.callback_url
    ENV.fetch("SCHWAB_CALLBACK_URL") do
      raise KeyError, "SCHWAB_CALLBACK_URL is not set" if Rails.env.production?
      Rails.application.routes.url_helpers.schwab_callback_url
    end
  end
end
module Schwab
  class Quote < Data.define(:symbol, :cusip, :asset_main_type, :last, :bid, :ask, :mark, :net_change, :net_percent_change,
                            :quote_time, :trade_time, :raw)
    Batch = Data.define(:quotes, :invalid_symbols)

    # Each page is keyed by symbol, with unknown symbols reported under "errors" in the same 200.
    def self.batch(pages)
      pages = Array.wrap(pages)
      Batch.new(quotes: pages.flat_map { |page| page.except("errors").map { |symbol, body| from(symbol, body) } },
                invalid_symbols: pages.flat_map { |page| Array(page.dig("errors", "invalidSymbols")) })
    end

    def self.from(symbol, raw)
      q = raw["quote"] || {}
      new(symbol: raw["symbol"] || symbol, cusip: raw.dig("reference", "cusip"), asset_main_type: raw["assetMainType"],
          last: Decimal.parse(q["lastPrice"]), bid: Decimal.parse(q["bidPrice"]), ask: Decimal.parse(q["askPrice"]),
          mark: Decimal.parse(q["mark"]), net_change: Decimal.parse(q["netChange"]), net_percent_change: Decimal.parse(q["netPercentChange"]),
          quote_time: Timestamp.parse(q["quoteTime"]), trade_time: Timestamp.parse(q["tradeTime"]), raw: raw)
    end
  end
end
module Schwab
  Candle = Data.define(:date, :time, :open, :high, :low, :close, :volume) do
    def self.from(raw)
      new(date: Timestamp.candle_date(raw["datetime"]), time: Timestamp.parse(raw["datetime"]),
          open: Decimal.parse(raw["open"]), high: Decimal.parse(raw["high"]), low: Decimal.parse(raw["low"]),
          close: Decimal.parse(raw["close"]), volume: raw["volume"])
    end
  end

  PriceHistory = Data.define(:symbol, :candles, :previous_close, :empty, :raw) do
    def self.from(raw)
      new(symbol: raw["symbol"], candles: Array(raw["candles"]).map { |c| Candle.from(c) },
          previous_close: Decimal.parse(raw["previousClose"]), empty: raw["empty"] == true, raw: raw)
    end

    def empty? = empty
  end
end
module Schwab
  class Error < StandardError
    attr_reader :status, :body, :request_id, :attempts

    def initialize(message = nil, status: nil, body: nil, request_id: nil, attempts: 1)
      super(message || self.class.name.demodulize.titleize)
      @status, @body, @request_id, @attempts = status, body, request_id, attempts
    end

    # Builds the right subclass for an HTTP response. The body is scrubbed before anything reads it.
    def self.for_response(response, attempts:, idempotent:)
      status = response.code.to_i
      body = Scrub.body(response.body)
      json = JSON.parse(body) rescue nil
      message = "Schwab responded #{status}: #{summarize(json, body)}"
      opts = { status: status, body: body, request_id: request_id_in(json), attempts: attempts }
      case status
      when 401 then AuthError.new(message, **opts)
      when 429 then RateLimited.new(message, retry_after: retry_after_in(response), **opts)
      when 400..499 then RequestError.new(message, **opts)
      when 500.. then (idempotent ? ServerError : UnknownOutcome).new(message, **opts)
      else new(message, **opts)
      end
    end

    def self.summarize(json, body)
      return body.to_s.truncate(200) unless json.is_a?(Hash)
      Array(json["errors"]).filter_map { |e| e["detail"] || e["title"] }.join("; ").presence ||
        json["error_description"] || json["error"] || body.to_s.truncate(200)
    end

    def self.request_id_in(json) = json.is_a?(Hash) ? Array(json["errors"]).first&.dig("id") : nil

    def self.retry_after_in(response)
      seconds = response["Retry-After"].to_i
      seconds.positive? ? seconds : nil
    end
  end

  class AuthError < Error; end
  class ReauthRequired < AuthError; end   # token endpoint says the grant is dead: the pause path
  class RateLimited < Error
    attr_reader :retry_after

    def initialize(message = nil, retry_after: nil, **opts)
      super(message, **opts)
      @retry_after = retry_after
    end
  end
  class ServerError < Error; end
  class RequestError < Error; end          # 4xx other than auth and rate limit: our parameters are wrong; never retried
  class TransportError < Error; end        # timeout or connection failure on an idempotent call
  class UnknownOutcome < Error; end        # the same on a non-idempotent call; Phase 2 depends on this being distinct
  class MappingError < Error; end          # required field missing or malformed; rescued per record by sync
  class NotConfigured < Error; end         # app credentials missing; raised before any request is built
end

