app/models/dashboard.rb:68:    equity - Snapshot.net_flows(account, after: prior_snapshot.as_of, through: MarketDay.today) - prior_snapshot.equity
app/models/dashboard.rb:69:  end
app/models/dashboard.rb:70:
app/models/dashboard.rb:71:  def day_change_ratio = day_change && prior_snapshot.equity.positive? ? day_change / prior_snapshot.equity : nil
