app/models/dashboard.rb:35:
app/models/dashboard.rb:36:  # The primary banner, highest severity first. Everything else active shows as a secondary status line.
app/models/dashboard.rb:37:  def banner
app/models/dashboard.rb:38:    return :halted if halted?
app/models/dashboard.rb:39:    token_status if %i[ revoked expired expiring ].include?(token_status)
app/models/dashboard.rb:40:  end
app/models/dashboard.rb:41:
app/models/dashboard.rb:42:  def secondary_statuses
app/models/dashboard.rb:43:    statuses = []
