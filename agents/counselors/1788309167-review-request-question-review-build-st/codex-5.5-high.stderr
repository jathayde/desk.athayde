app/models/dashboard.rb:73:
app/models/dashboard.rb:74:  def rows
app/models/dashboard.rb:75:    @rows ||= begin
app/models/dashboard.rb:76:      trades = account.trades.open.index_by(&:instrument_id)
app/models/dashboard.rb:77:      account.positions.includes(:instrument, :working_stop_order).map do |position|
app/models/dashboard.rb:78:        Row.new(position: position, protection: position.protection, as_of: as_of_for(position), stale: stale_row?(position), trade: trades[position.instrument_id])
app/models/dashboard.rb:79:      end.sort_by { |r| [ r.protection == :protected ? 1 : 0, r.position.distance_to_stop || -BigDecimal("Infinity"), r.position.instrument.symbol ] }
app/models/dashboard.rb:80:    end
app/models/dashboard.rb:81:  end
app/models/dashboard.rb:82:
app/models/dashboard.rb:83:  def open_risk = rows.select { |r| r.protection == :protected }.sum { |r| r.position.open_risk }
app/models/dashboard.rb:84:  def open_risk_ratio = equity && equity.positive? ? open_risk / equity : nil
app/models/dashboard.rb:85:  def excluded_by_reason = rows.reject { |r| r.protection == :protected }.group_by(&:protection).transform_values(&:size)
app/models/dashboard.rb:86:  def review_count = account ? account.trades.needing_review.count : 0
app/models/dashboard.rb:87:  def balance_stale? = balance && stale?(balance.as_of, :positions)
app/models/dashboard.rb:88:  def orders_as_of = @orders_as_of ||= account&.last_sync(:orders)
app/models/dashboard.rb:89:
app/models/dashboard.rb:90:  # Stale: older than twice the cadence the tick would use right now plus its minute of slack, or any age once sync is paused.
app/models/dashboard.rb:91:  def stale?(time, feed)
app/models/dashboard.rb:92:    return true if time.nil? || sync_paused_reason.present?
app/models/dashboard.rb:93:    time < Time.current - (sync_interval(feed) * STALE_MULTIPLIER + 1.minute)
app/models/dashboard.rb:94:  end
app/models/dashboard.rb:95:
app/models/dashboard.rb:96:  private
app/models/dashboard.rb:97:    def sync_interval(feed) = (@intervals ||= {})[feed] ||= account.sync_interval(feed, in_session: @in_session)
app/models/dashboard.rb:98:
app/models/dashboard.rb:99:    # A number that depends on a stop depends on the orders feed too, judged by its own cadence.
app/models/dashboard.rb:100:    def stale_row?(position)
app/models/dashboard.rb:101:      stale?(position.synced_at, :positions) || (position.working_stop_order.present? && stale?(orders_as_of, :orders))
app/models/dashboard.rb:102:    end
app/models/dashboard.rb:103:
app/models/dashboard.rb:104:    def as_of_for(position) = position.working_stop_order ? [ position.synced_at, orders_as_of ].compact.min : position.synced_at
app/models/dashboard.rb:105:
app/models/dashboard.rb:106:    def unresolved_failures
app/models/dashboard.rb:107:      SyncRun::ACCOUNT_FEEDS.filter_map { |feed| account.last_sync_failure(feed) }.select { |run| unresolved?(run) }
app/models/dashboard.rb:108:    end
app/models/dashboard.rb:109:
app/models/dashboard.rb:110:    # Unresolved: nothing has succeeded on that feed since it failed.
app/models/dashboard.rb:111:    def unresolved?(run)
app/models/dashboard.rb:112:      succeeded_at = account.last_sync(run.feed)
app/models/dashboard.rb:113:      succeeded_at.nil? || run.started_at > succeeded_at
app/models/dashboard.rb:114:    end
app/models/dashboard.rb:115:end
app/models/schwab/rate_budget.rb:1:module Schwab
app/models/schwab/rate_budget.rb:2:  # One request budget shared by every process (Puma and the worker) through the cache store.
app/models/schwab/rate_budget.rb:3:  # Exceeding it raises rather than sleeping so a web request never blocks on the worker.
app/models/schwab/rate_budget.rb:4:  module RateBudget
app/models/schwab/rate_budget.rb:5:    def self.take!(now: ::Time.current, budget: Schwab::RATE_BUDGET_PER_MINUTE)
app/models/schwab/rate_budget.rb:6:      key = "schwab:rate:#{now.to_i / 60}"
app/models/schwab/rate_budget.rb:7:      Rails.cache.write(key, 0, expires_in: 2.minutes, unless_exist: true)
app/models/schwab/rate_budget.rb:8:      count = Rails.cache.increment(key, 1, expires_in: 2.minutes)
app/models/schwab/rate_budget.rb:9:      return if count.nil? || count <= budget # a cache hiccup fails open; the API's own limit still applies
app/models/schwab/rate_budget.rb:10:      raise RateLimited.new("Local Schwab rate budget spent (#{budget}/min)", retry_after: 60 - now.sec)
app/models/schwab/rate_budget.rb:11:    end
app/models/schwab/rate_budget.rb:12:  end
app/models/schwab/rate_budget.rb:13:end

