app/models/schwab/client.rb:123:      # A non-JSON success body is a gateway page, not data.
app/models/schwab/client.rb:124:      def parse(response, attempts:, idempotent:)
app/models/schwab/client.rb:125:        JSON.parse(response.body.to_s)
app/models/schwab/client.rb:126:      rescue JSON::ParserError
app/models/schwab/client.rb:127:        raise (idempotent ? ServerError : UnknownOutcome).new("Schwab returned a non-JSON body", status: response.code.to_i,
app/models/schwab/client.rb:128:                                                              body: Scrub.body(response.body), attempts: attempts)
app/models/schwab/client.rb:129:      end
app/models/schwab/client.rb:130:
app/models/schwab/client.rb:131:      # One refresh-and-retry on 401, outside the backoff budget. The token model decides whether a
app/models/schwab/client.rb:132:      # refresh is still needed, so two processes seeing the same 401 cannot double-refresh.
app/models/schwab/client.rb:133:      def authorized(uri, refreshed: false)
app/models/schwab/client.rb:134:        request = Net::HTTP::Get.new(uri)
app/models/schwab/client.rb:135:        request["Authorization"] = "Bearer #{@token.access_token}"
app/models/schwab/client.rb:136:        request["Accept"] = "application/json"
app/models/schwab/client.rb:137:        response, attempts = perform(request, template: Scrub.path(uri.path), idempotent: true)
app/models/schwab/client.rb:138:        if response.code.to_i == 401 && !refreshed && @token.respond_to?(:refresh!)
app/models/schwab/client.rb:139:          @token.refresh!(wait: @wait)
app/models/schwab/client.rb:140:          return authorized(uri, refreshed: true)
app/models/schwab/client.rb:141:        end
app/models/schwab/client.rb:142:        [ response, attempts ]
app/models/schwab/client.rb:143:      end
app/models/schwab/client.rb:144:
app/models/schwab/client.rb:145:      # Returns [response, attempts]. Retries live here and nowhere else.
app/models/schwab/client.rb:146:      def perform(request, template:, idempotent:)
app/models/schwab/client.rb:147:        final = idempotent && @wait ? MAX_ATTEMPTS : 1
app/models/schwab/client.rb:148:        1.upto(final) do |attempt|
app/models/schwab/client.rb:149:          begin
app/models/schwab/client.rb:150:            response = dispatch(request, template)
app/models/schwab/client.rb:151:          rescue *TRANSPORT_FAILURES => e
app/models/schwab/client.rb:152:            raise transport_failure(e, attempt, idempotent) if attempt == final
app/models/schwab/client.rb:153:            @sleeper.call(jittered(BACKOFF[attempt - 1]))
app/models/schwab/client.rb:154:            next
app/models/schwab/client.rb:155:          end
app/models/schwab/client.rb:156:          return [ response, attempt ] unless retriable?(response) && attempt < final
app/models/schwab/client.rb:157:          @sleeper.call(delay_for(response, attempt))
app/models/schwab/client.rb:158:        end
app/models/schwab/client.rb:159:      end
app/models/schwab/client.rb:160:
app/models/schwab/client.rb:161:      def dispatch(request, template)
app/models/schwab/client.rb:162:        RateBudget.take!
app/models/schwab/client.rb:163:        started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
app/models/schwab/client.rb:164:        http(request.uri).request(request).tap { |response| log(request, template, response.code, started) }
app/models/schwab/client.rb:165:      rescue *TRANSPORT_FAILURES
app/models/schwab/client.rb:166:        log(request, template, "transport", started)
app/models/schwab/client.rb:167:        raise
app/models/schwab/client.rb:168:      end
app/models/schwab/client.rb:169:
app/models/schwab/client.rb:170:      def transport_failure(error, attempts, idempotent)
app/models/schwab/client.rb:171:        (idempotent ? TransportError : UnknownOutcome).new("#{error.class}: #{error.message}", attempts: attempts)
app/models/schwab/client.rb:172:      end
app/models/schwab/client.rb:173:
app/models/schwab/client.rb:174:      def retriable?(response) = response.code.to_i == 429 || response.code.to_i >= 500
app/models/schwab/client.rb:175:
app/models/schwab/client.rb:176:      def delay_for(response, attempt)
app/models/schwab/client.rb:177:        retry_after = Error.retry_after_in(response)
app/models/schwab/client.rb:178:        retry_after ? [ retry_after, RETRY_AFTER_CAP ].min : jittered(BACKOFF[attempt - 1])
app/models/schwab/client.rb:179:      end
app/models/schwab/client.rb:180:
app/models/schwab/client.rb:181:      def jittered(seconds) = seconds + rand * seconds * 0.25
app/models/schwab/client.rb:182:
app/models/schwab/client.rb:183:      def http(uri)
app/models/schwab/client.rb:184:        Net::HTTP.new(uri.host, uri.port).tap do |h|
app/models/schwab/client.rb:185:          h.use_ssl = true
app/models/schwab/client.rb:186:          h.open_timeout = OPEN_TIMEOUT
app/models/schwab/client.rb:187:          h.read_timeout = READ_TIMEOUT
app/models/schwab/client.rb:188:        end
app/models/schwab/client.rb:189:      end
app/models/schwab/client.rb:190:
app/models/schwab/client.rb:191:      def log(request, template, status, started)
app/models/schwab/client.rb:192:        ms = started ? ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round : 0
app/models/schwab/client.rb:193:        Rails.logger.info("schwab #{request.method} #{template} #{status} #{ms}ms")
app/models/schwab/client.rb:194:      end
