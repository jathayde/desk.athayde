    15	      presented = request.authorization.to_s.delete_prefix("Bearer ")
    16	      expected = Rails.application.credentials.dig(:mcp, :bearer_token).to_s
    17	      return if expected.present? && presented.bytesize == expected.bytesize && ActiveSupport::SecurityUtils.secure_compare(presented, expected)
