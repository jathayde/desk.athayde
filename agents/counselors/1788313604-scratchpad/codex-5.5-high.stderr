     1	module Sync
     2	  # Positions and balances for one account. Rows absent from the broker are deleted only when every
     3	  # position resolved and the payload is sane. Zero-quantity positions are treated as absent.
     4	  class PositionsJob < FeedJob
     5	    limits_concurrency to: 1, key: ->(account) { "positions-#{account.id}" }, on_conflict: :discard
     6	
     7	    def perform(account)
     8	      SyncRun.record(:positions, account: account) do |run|
     9	        summary = Schwab::AccountSummary.from(client.account(account.schwab_hash))
    10	        raise Schwab::MappingError, "no positions but positive long market value" if summary.positions.empty? && summary.balances.long_market_value&.positive?
    11	
    12	        now = Time.current
    13	        held = summary.positions.reject { |p| p.quantity.zero? || p.cash_equivalent? } # the sweep fund is cash, not a holding
    14	        kept = held.filter_map do |position|
    15	          instrument = Instrument.resolve(position.instrument)
    16	          unless instrument
    17	            run.quarantine(:positions_unresolved, position.instrument.to_h)
    18	            next
    19	          end
    20	          account.positions.find_or_initialize_by(instrument: instrument).tap do |row|
    21	            row.update!(quantity: position.quantity, average_price: position.average_price, cost_basis: position.cost_basis,
    22	                        market_value: position.market_value, last_price: last_price_for(position), synced_at: now, raw: position.raw)
    23	          end
    24	        rescue Schwab::MappingError => e
    25	          run.quarantine(:positions_unmapped, e.message)
    26	          nil
    27	        end
    28	        complete = kept.size == held.size
    29	        account.positions.where.not(id: kept.map(&:id)).destroy_all if complete
    30	        account.balances.create!(as_of: now, equity: summary.balances.equity, cash_available_for_trading: summary.balances.cash_available_for_trading,
    31	                                 unsettled_cash: summary.balances.unsettled_cash, settled_cash: summary.balances.settled_cash,
    32	                                 buying_power: summary.balances.buying_power, raw: summary.balances.raw)
    33	        account.update!(last_synced_at: now, raw: summary.raw_without_positions)
    34	        run.touched(kept.size)
    35	        hand_off_to_journal(account, summary.balances.equity) if complete && account.trading_enabled?
    36	        complete ? :succeeded : :partial
    37	      end
    38	    end
    39	
    40	    private
    41	      # The journal reconciles to the new positions; today's snapshot is rechained only when its equity moved.
    42	      def hand_off_to_journal(account, equity)
    43	        Journal::BootstrapJob.perform_later(account)
    44	        today = MarketDay.today
    45	        snapshot = account.snapshots.find_by(as_of: today)
    46	        Snapshots::RebuildJob.perform_later(account, from: today) if snapshot && snapshot.equity != equity
    47	      end
    48	
    49	      def last_price_for(position)
    50	        return nil if position.quantity.zero? || position.market_value.nil?
    51	        position.market_value / position.quantity
    52	      end
    53	  end
    54	end
     1	module Sync
     2	  # Orders for one account: the cursor window, a daily WORKING pass, and a re-fetch by id of any working
     3	  # stop that fell out of the list, then working-stop detection on every position. Each order is mapped
     4	  # inside its own rescue so one malformed record cannot poison the batch. Lineage is written in a second
     5	  # pass by broker id and never nulled once set.
     6	  class OrdersJob < FeedJob
     7	    OVERLAP = 1.day
     8	    PAGE_LIMIT = 3000
     9	
    10	    limits_concurrency to: 1, key: ->(account, **) { "orders-#{account.id}" }, on_conflict: :discard
    11	
    12	    def perform(account, working_pass: false)
    13	      from, to, gap_from = window_for(:orders, account, overlap: OVERLAP)
    14	      SyncRun.record(:orders, account: account, window_from: from, window_to: to) do |run|
    15	        note_gap(run, gap_from, account)
    16	        listed = client.orders(account.schwab_hash, from: from, to: to)
    17	        truncated = listed.size >= PAGE_LIMIT
    18	        listed += client.orders(account.schwab_hash, from: Time.current - LOOKBACK, to: to, status: Schwab::Order::WORKING) if working_pass || !working_pass_today?(account)
    19	        orders = listed.filter_map { |raw| map(raw, run) }.flat_map(&:flatten)
    20	        orders += refetch_missing_stops(account, orders, run)
    21	        orders = orders.reverse.uniq(&:order_id).reverse # the later snapshot of a repeated order wins
    22	
    23	        rows = orders.filter_map { |order| upsert(account, order, run) }
    24	        link_lineage(account, orders)
    25	        account.positions.includes(:working_stop_order).each(&:assign_working_stop!)
    26	        run.touched(rows.size)
    27	        truncated ? :partial : :succeeded
    28	      end
    29	    end
    30	
    31	    private
    32	      def map(raw, run)
    33	        Schwab::Order.from(raw)
    34	      rescue Schwab::MappingError => e
    35	        run.quarantine(:orders_unmapped, e.message)
    36	        nil
    37	      end
    38	
    39	      def working_pass_today?(account)
    40	        SyncRun.for(:orders, account).advanced_cursor.where(started_at: Time.current.in_time_zone(MarketDay::ZONE).beginning_of_day..).exists?
    41	      end
    42	
    43	      # A stop Schwab no longer returns even by id is marked gone, so assignment drops it instead of trusting a stale row.
    44	      def refetch_missing_stops(account, orders, run)
    45	        seen = orders.map(&:order_id)
    46	        account.positions.includes(:working_stop_order).filter_map(&:working_stop_order).reject { |o| seen.include?(o.broker_order_id) }.flat_map do |stop|
    47	          Schwab::Order.from(client.order(account.schwab_hash, stop.broker_order_id)).flatten
    48	        rescue Schwab::RequestError => e
    49	          stop.update!(status: Schwab::Order::GONE)
    50	          run.quarantine(:stops_gone, "#{stop.broker_order_id}: #{e.message}")
    51	          []
    52	        end
    53	      end
    54	
    55	      def upsert(account, order, run)
    56	        instrument = order.instrument && Instrument.resolve(order.instrument)
    57	        if order.instrument && instrument.nil?
    58	          run.quarantine(:orders_unresolved, order.instrument.to_h)
    59	          return nil
    60	        end
    61	        row = account.orders.find_or_initialize_by(broker_order_id: order.order_id)
    62	        row.placed_via = :schwab_direct if row.new_record?
    63	        row.update!(instrument: instrument, status: order.status, side: order.side, quantity: order.quantity, filled_quantity: order.filled_quantity,
    64	                    remaining_quantity: order.remaining_quantity, order_type: order.order_type, limit_price: order.price, stop_price: order.stop_price,
    65	                    duration: order.duration, session: order.session, tax_lot_method: order.tax_lot_method, strategy_type: order.strategy_type,
    66	                    entered_at: order.entered_at, closed_at: order.close_time, raw: order.raw)
    67	        row
    68	      rescue Schwab::MappingError, ActiveRecord::RecordInvalid => e
    69	        run.quarantine(:orders_unmapped, "#{order.order_id}: #{e.message}")
    70	        nil
    71	      end
    72	
    73	      # Parents may already exist from an earlier run, so the index covers every id the batch references.
    74	      def link_lineage(account, orders)
    75	        ids = orders.flat_map { |o| [ o.order_id, o.parent_order_id, o.replaces_order_id ] }.compact.uniq
    76	        by_broker_id = account.orders.where(broker_order_id: ids).index_by(&:broker_order_id)
    77	        orders.each do |order|
    78	          row = by_broker_id[order.order_id] or next
    79	          parent = order.parent_order_id && by_broker_id[order.parent_order_id]
    80	          replaced = order.replaces_order_id && by_broker_id[order.replaces_order_id]
    81	          row.update!(parent_order: parent) if parent && row.parent_order_id.nil?
    82	          row.update!(replaces_order: replaced) if replaced && row.replaces_order_id.nil?
    83	        end
    84	      end
    85	  end
    86	end
     1	module Sync
     2	  # Activities for one account, one request per transaction type a cash account produces. A bad request on
     3	  # one type fails the run so the cursor does not advance past rows that were never fetched; the rows that
     4	  # did arrive are still upserted and will simply be seen again. A malformed record is quarantined alone.
     5	  class ActivitiesJob < FeedJob
     6	    OVERLAP = 3.days
     7	
     8	    limits_concurrency to: 1, key: ->(account) { "activities-#{account.id}" }, on_conflict: :discard
     9	
    10	    def perform(account)
    11	      from, to, gap_from = window_for(:activities, account, overlap: OVERLAP)
    12	      SyncRun.record(:activities, account: account, window_from: from, window_to: to) do |run|
    13	        note_gap(run, gap_from, account)
    14	        @earliest_flow = nil
    15	        outcome = :succeeded
    16	        Schwab::Activity::CASH_ACCOUNT_TYPES.each do |type|
    17	          raws = client.transactions(account.schwab_hash, from: from, to: to, type: type)
    18	          raws.each { |raw| upsert(account, raw, run) }
    19	          run.touched(raws.size)
    20	        rescue Schwab::RequestError => e
    21	          run.quarantine(:activity_types_rejected, "#{type}: #{e.message}")
    22	          outcome = :failed
    23	        end
    24	        hand_off_to_journal(account) if account.trading_enabled?
    25	        outcome
    26	      end
    27	    end
    28	
    29	    private
    30	      def hand_off_to_journal(account)
    31	        Journal::LinkFillsJob.perform_later(account)
    32	        Snapshots::RebuildJob.perform_later(account, from: @earliest_flow) if @earliest_flow
    33	      end
    34	
    35	      # A directional type whose cash sign points the other way is recorded but called out.
    36	      def sign_disagrees?(activity, kind)
    37	        return false if activity.net_amount.nil? || activity.net_amount.zero?
    38	        (kind == :deposit && activity.net_amount.negative?) || (kind == :withdrawal && activity.net_amount.positive?)
    39	      end
    40	
    41	      def upsert(account, raw, run)
    42	        activity = Schwab::Activity.from(raw)
    43	        instrument = activity.instrument && Instrument.resolve(activity.instrument)
    44	        if activity.instrument && instrument.nil?
    45	          run.quarantine(:activities_unresolved, activity.instrument.to_h)
    46	          return
    47	        end
    48	        row = account.activities.find_or_initialize_by(broker_activity_id: activity.activity_id)
    49	        kind = activity.kind
    50	        new_record = row.new_record?
    51	        run.quarantine(:activity_kinds_other, activity.summary) if kind == :other && new_record
    52	        row.update!(instrument: instrument, order: activity.order_id && account.orders.find_by(broker_order_id: activity.order_id),
    53	                    broker_order_id: activity.order_id, kind: kind, status: activity.status, sub_type: activity.type, side: activity.side,
    54	                    quantity: activity.quantity, price: activity.price, commission: activity.commission, fees: activity.fees,
    55	                    net_amount: activity.net_amount, trade_date: activity.trade_date, settlement_date: activity.settlement_date,
    56	                    executed_at: activity.executed_at, raw: activity.raw)
    57	        changed = row.saved_changes.keys.intersect?(%w[ quantity price status net_amount kind order_id ])
    58	        row.unjournal! if row.journaled? && changed && !new_record
    59	        run.quarantine(:flow_sign_disagreement, activity.summary) if new_record && sign_disagrees?(activity, kind)
    60	        if row.cash_flow? && (new_record || changed) && row.trade_date
    61	          @earliest_flow = [ @earliest_flow, row.trade_date ].compact.min
    62	        end
    63	      rescue Schwab::MappingError, ActiveRecord::RecordInvalid => e
    64	        run.quarantine(:activities_unmapped, e.message)
    65	      end
    66	  end
    67	end

