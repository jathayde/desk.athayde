     1	module Sync
     2	  # Shared shape of the per-account feeds: a client, the account hash, the cursor window, and the gap audit.
     3	  class FeedJob < ApplicationJob
     4	    LOOKBACK = 364.days # live probe 2026-09-01: orders and transactions accept a one-year window; a day inside it for safety
     5	
     6	    private
     7	      def client = Schwab.client
     8	
     9	      # Cursor: from the last advanced window, overlapping by `overlap`; capped at the lookback. When the
    10	      # cursor is older than the lookback, Schwab cannot return the gap and the run says so.
    11	      def window_for(feed, account, overlap:)
    12	        now = Time.current
    13	        cursor = SyncRun.last_window_to(feed, account)
    14	        floor = now - LOOKBACK
    15	        from = cursor ? [ cursor - overlap, floor ].max : floor
    16	        gap_from = cursor if cursor && cursor < floor
    17	        [ from, now.utc.end_of_day, gap_from ]
    18	      end
    19	
    20	      # Audited once per gap, not once per run.
    21	      def note_gap(run, gap_from, account)
    22	        return unless gap_from
    23	        run.update!(gap_from: gap_from)
    24	        return if AuditEvent.where(kind: "sync_gap_unrecoverable", subject: account).where("data->>'feed' = ? AND data->>'gap_from' = ?", run.feed, gap_from.iso8601).exists?
    25	        AuditEvent.log("sync_gap_unrecoverable", actor: :system, subject: account, data: { feed: run.feed, gap_from: gap_from.iso8601, lookback_days: LOOKBACK.in_days.to_i })
    26	      end
    27	  end
    28	end
     1	# One row per feed run. Wraps the work so token loss, Schwab failures, and quarantined records all
     2	# land as a status; anything else is recorded as failed and re-raised so the queue sees it too.
     3	class SyncRun < ApplicationRecord
     4	  STALE_AFTER = 10.minutes # a running row older than this is a crashed or restarted worker, not a run
     5	  ACCOUNT_FEEDS = %i[ positions orders activities ].freeze
     6	
     7	  belongs_to :account, optional: true
     8	
     9	  enum :feed, {
    10	    accounts: "accounts", positions: "positions", orders: "orders", activities: "activities",
    11	    market_hours: "market_hours", memory_repo: "memory_repo", snapshots: "snapshots"
    12	  }, prefix: true
    13	  enum :status, { running: "running", succeeded: "succeeded", partial: "partial", failed: "failed", skipped_token: "skipped_token" }
    14	
    15	  scope :recent_first, -> { order(started_at: :desc) }
    16	  scope :for, ->(feed, account) { where(feed: feed, account: account) }
    17	  scope :advanced_cursor, -> { where(status: %w[ succeeded partial ]) }
    18	  scope :live, -> { running.where(started_at: STALE_AFTER.ago..) }
    19	
    20	  def self.record(feed, account: nil, window_from: nil, window_to: nil)
    21	    run = create!(feed: feed, account: account, status: :running, started_at: Time.current, window_from: window_from, window_to: window_to)
    22	    outcome = yield run
    23	    run.finish!(outcome == :failed ? :failed : (outcome == :partial || run.unmapped_values.any? ? :partial : :succeeded), error: run.error)
    24	  rescue Schwab::NoUsableToken, Schwab::AuthError => e
    25	    run.finish!(:skipped_token, error: e.message)
    26	  rescue Schwab::Error => e
    27	    run.finish!(:failed, error: e.message)
    28	  rescue StandardError => e
    29	    run.finish!(:failed, error: "#{e.class}: #{e.message}")
    30	    raise
    31	  ensure
    32	    run&.finish!(:failed, error: "left running") if run&.running? && !run.destroyed?
    33	  end
    34	
    35	  def self.last_window_to(feed, account) = self.for(feed, account).advanced_cursor.maximum(:window_to)
    36	  def self.last_started_at(feed, account) = self.for(feed, account).maximum(:started_at)
    37	  def self.running?(feed, account) = self.for(feed, account).live.exists?
    38	
    39	  # Due when nothing is live and the last start is older than the interval, with a minute of slack for cron drift.
    40	  def self.due?(feed, account, every:)
    41	    return false if running?(feed, account)
    42	    last = last_started_at(feed, account)
    43	    last.nil? || last <= (every - 1.minute).ago
    44	  end
    45	
    46	  def finish!(status, error: nil)
    47	    update!(status: status, finished_at: Time.current, error: error&.truncate(1000))
    48	    self
    49	  end
    50	
    51	  def touched(count) = update!(records_touched: records_touched.to_i + count)
    52	
    53	  def quarantine(key, detail)
    54	    unmapped_values[key.to_s] = Array(unmapped_values[key.to_s]) << detail
    55	    save!
    56	  end
    57	end

