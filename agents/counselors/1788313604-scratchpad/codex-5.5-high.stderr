     1	# Seeded states for the clickable UI. Rows are written directly, never by driving jobs, and every time is
     2	# relative so the state reads the same under either sync cadence.
     3	module Playwright::Scenario
     4	  extend self
     5	
     6	  ACCOUNT_HASH = Schwab::FakeClient::ACCOUNT_HASH
     7	  SCENARIOS = %w[ not_connected waiting_for_accounts needs_setup healthy expiring expired halted unprotected sync_failed review_queue closed_trade ].freeze
     8	
     9	  # Guarded here as well as at the route: reset! empties the database.
    10	  def load!(name)
    11	    raise "scenarios are test-only" unless Rails.env.test? && Schwab.fake?
    12	    name = name.to_s.tr("-", "_")
    13	    raise ArgumentError, "unknown scenario #{name}" unless SCENARIOS.include?(name)
    14	    reset!
    15	    public_send(name)
    16	  end
    17	
    18	  def reset!
    19	    Schwab::FakeClient.instance.reset!
    20	    Rails.cache.clear
    21	    [ TradeLeg, Trade, Snapshot, Position, Balance, Activity, Order, OrderProposal, SyncRun, MarketDay, SchwabToken, Session, Account, Instrument, Setup ].each(&:delete_all)
    22	    SystemSettings.instance.update!(shadow_mode: true, manual_halt: false, manual_halt_reason: nil, manual_halt_at: nil, sync_paused_reason: nil)
    23	    Rails.application.load_seed
    24	    MarketDay.for(MarketDay.today)
    25	  end
    26	
    27	  def not_connected = nil
    28	
    29	  def waiting_for_accounts = token!
    30	
    31	  def needs_setup
    32	    token!
    33	    Account.create!(schwab_hash: ACCOUNT_HASH, account_type: nil, trading_enabled: false)
    34	  end
    35	
    36	  def healthy
    37	    token!
    38	    populate(account!)
    39	  end
    40	
    41	  def expiring
    42	    token!(issued_at: 6.days.ago - 2.hours)
    43	    populate(account!)
    44	  end
    45	
    46	  def expired
    47	    token!(issued_at: 8.days.ago)
    48	    populate(account!, synced_at: 3.hours.ago)
    49	    SystemSettings.instance.update!(sync_paused_reason: "Schwab token unusable; re-authenticate")
    50	    SyncRun.create!(feed: :positions, status: :skipped_token, started_at: 2.hours.ago, finished_at: 2.hours.ago, error: "token expired")
    51	  end
    52	
    53	  def halted
    54	    healthy
    55	    SystemSettings.instance.update!(manual_halt: true, manual_halt_reason: "daily loss limit, by hand", manual_halt_at: 1.hour.ago)
    56	    AuditEvent.log("manual_halt_set", actor: :human, user: User.first, reason: "daily loss limit, by hand")
    57	  end
    58	
    59	  def unprotected
    60	    healthy
    61	    position = Position.find_by!(instrument: Instrument.find_by!(symbol: "DEF"))
    62	    position.working_stop_order.update!(status: "CANCELED")
    63	    position.update!(working_stop_order: nil)
    64	  end
    65	
    66	  # The failure is the latest thing that happened to the orders feed, so it is still unresolved.
    67	  def sync_failed
    68	    token!
    69	    populate(account!, synced_at: 10.minutes.ago)
    70	    SyncRun.create!(feed: :orders, account: Account.first, status: :failed, started_at: 5.minutes.ago, finished_at: 5.minutes.ago, error: "Schwab responded 503")
    71	  end
    72	
    73	  def review_queue
    74	    healthy
    75	    account = Account.first
    76	    %w[ LBAS SLV ].each do |symbol|
    77	      instrument = Instrument.create!(symbol: symbol, cusip: SecureRandom.hex(4).upcase.ljust(9, "0"), asset_type: "EQUITY")
    78	      account.positions.create!(instrument: instrument, quantity: 10, average_price: 20, cost_basis: 200, market_value: 210, last_price: 21, synced_at: Time.current)
    79	      trade = account.trades.create!(instrument: instrument, status: :open, needs_review: true, review_reason: "bootstrapped", bootstrapped: true, avg_entry: 20, quantity: 10, peak_quantity: 10)
    80	      trade.trade_legs.create!(kind: :entry, quantity: 10, price: 20, cash_amount: -200, note: "plug")
    81	    end
    82	  end
    83	
    84	  def closed_trade
    85	    healthy
    86	    account = Account.first
    87	    xyz = Instrument.find_by!(symbol: "XYZ")
    88	    trade = account.trades.create!(instrument: xyz, status: :closed, avg_entry: 51.18, avg_exit: 55.31, peak_quantity: 40, realized_pnl: 165.2, initial_risk: 91.2, realized_r: 1.81,
    89	                                   planned_stop: 48.9, setup: Setup.create!(name: "breakout-A"), opened_at: 5.days.ago, closed_at: 1.day.ago)
    90	    trade.trade_legs.create!(kind: :entry, quantity: 40, price: 51.18, cash_amount: -2047.2, executed_at: 5.days.ago)
    91	    trade.trade_legs.create!(kind: :exit, quantity: 40, price: 55.31, cash_amount: 2212.4, executed_at: 1.day.ago)
    92	  end
    93	
    94	  private
    95	    def token!(issued_at: Time.current)
    96	      SchwabToken.create!(access_token: "fake-access", refresh_token: "fake-refresh", issued_at: issued_at, access_expires_at: issued_at + 29.minutes,
    97	                          refresh_expires_at: issued_at + SchwabToken::REFRESH_LIFETIME, scope: "api")
    98	    end
    99	
   100	    def account! = Account.create!(schwab_hash: ACCOUNT_HASH, account_type: :taxable, trading_enabled: true, nickname: "Taxable")
   101	
   102	    def populate(account, synced_at: Time.current)
   103	      account.balances.create!(as_of: synced_at, equity: 10_240, settled_cash: 2_110, unsettled_cash: 980, cash_available_for_trading: 3_090)
   104	      account.snapshots.create!(as_of: MarketDay.today.prev_weekday, equity: 10_180, index_value: 1, high_water_index: 1)
   105	      { "XYZ" => [ 40, 51.18, 53.0, 48.9 ], "DEF" => [ 15, 88.02, 86.57, 85.6 ] }.each do |symbol, (qty, avg, last, stop)|
   106	        instrument = Instrument.create!(symbol: symbol, cusip: symbol == "XYZ" ? "037833100" : "594918104", asset_type: "EQUITY")
   107	        stop_order = account.orders.create!(instrument: instrument, broker_order_id: "stop-#{symbol}", status: Schwab::Order::WORKING, side: Schwab::Order::SELL, order_type: Schwab::Order::STOP_TYPES.first,
   108	                                             quantity: qty, remaining_quantity: qty, stop_price: stop, entered_at: 2.days.ago)
   109	        account.positions.create!(instrument: instrument, quantity: qty, average_price: avg, cost_basis: qty * avg, market_value: qty * last, last_price: last,
   110	                                  working_stop_order: stop_order, synced_at: synced_at)
   111	      end
   112	      %w[ positions orders activities ].each { |feed| SyncRun.create!(feed: feed, account: account, status: :succeeded, started_at: synced_at, finished_at: synced_at, window_to: synced_at) }
   113	    end
