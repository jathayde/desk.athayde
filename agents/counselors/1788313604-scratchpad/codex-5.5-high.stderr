     1	# One Messages API conversation over the read-only tool registry, bounded four ways: turns, tool calls,
     2	# input tokens, and wall clock. Every stop reason is handled deliberately and the row records how it ended.
     3	# The email is the job's business: a run that produced text can be delivered whatever else happened.
     4	class Agent::Run
     5	  MAX_TURNS = 12 # one Messages API round trip is a turn; parallel tool_use blocks in one response are one turn
     6	  MAX_TOOL_CALLS = 20
     7	  MAX_INPUT_TOKENS = 400_000 # cumulative across turns, cache reads included: a spend bound, not a context bound
     8	  MAX_OUTPUT_TOKENS = 8192 # thinking bills as output and counts here, so small values hit the ceiling before any tool_use
     9	  DEADLINE = 10.minutes
    10	  TOOL_RESULT_LIMIT = 24.kilobytes
    11	  BUDGET_EXHAUSTED = "tool budget exhausted; write the brief from what you have"
    12	
    13	  Ended = Class.new(StandardError)
    14	
    15	  def initialize(agent_run, context: Agent::Context.new(kind: agent_run.kind, date: agent_run.market_date), client: Agent.client)
    16	    @run, @context, @client = agent_run, context, client
    17	    @messages = []
    18	    @degraded_reasons = context.degraded_reasons.dup
    19	    @turns = @tool_calls = 0
    20	    @usage = Hash.new(0)
    21	    @texts = [] # one entry per turn, so a dropped response drops only its own words
    22	    @max_tokens = MAX_OUTPUT_TOKENS
    23	    @capped_by = nil
    24	  end
    25	
    26	  attr_reader :run
    27	
    28	  def perform
    29	    @started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    30	    run.update!(model: Agent::MODEL, started_at: run.started_at || Time.current)
    31	    @messages << { role: :user, content: @context.user_prompt }
    32	    converse
    33	    finish(@capped_by ? :capped : :succeeded, error: @capped_by && "budget spent: #{@capped_by}")
    34	  rescue Ended => e
    35	    finish(:failed, error: e.message)
    36	  rescue Anthropic::Errors::Error => e # API, transport, timeout, and request-shape errors are all deliverable failures
    37	    finish(:failed, error: "Anthropic #{e.class.name.demodulize}: #{e.message.to_s.truncate(300)}")
    38	  rescue StandardError => e
    39	    finish(:failed, error: "#{e.class}: #{e.message.truncate(300)}")
    40	    raise
    41	  end
    42	
    43	  private
    44	    def converse
    45	      loop do
    46	        @capped_by ||= budget_spent
    47	        forced = @capped_by.present?
    48	        response = call(tool_choice: forced ? { type: :none } : { type: :auto })
    49	        @messages << { role: :assistant, content: response.content.map(&:to_h) } # verbatim: thinking blocks carry signatures
    50	        @texts << response.content.select { |b| b.type == :text }.map(&:text).join("\n")
    51	        @stop = response.stop_reason
    52	        case @stop
    53	        when :end_turn, :stop_sequence
    54	          raise Ended, "the model ended without writing anything" if text.blank?
    55	          return
    56	        when :tool_use
    57	          @messages << { role: :user, content: answer(response.content.select { |b| b.type == :tool_use }, forced: forced) }
    58	        when :max_tokens
    59	          return @capped_by ||= "output tokens" unless retry_larger? # once, dropping the cut response
    60	        when :refusal, :pause_turn, :model_context_window_exceeded
    61	          raise Ended, "the model stopped with #{@stop}#{": #{text.truncate(200)}" if text.present?}"
    62	        else
    63	          raise Ended, "unexpected stop reason #{@stop.inspect}"
    64	        end
    65	      end
    66	    end
    67	
    68	    def call(tool_choice:)
    69	      raise Ended, "deadline of #{DEADLINE.inspect} passed before turn #{@turns + 1}" if elapsed > DEADLINE
    70	      raise Ended, "#{MAX_TURNS} turns passed without a final answer" if @turns >= MAX_TURNS
    71	      @turns += 1
    72	      response = @client.messages.create(
    73	        model: Agent::MODEL, max_tokens: @max_tokens, system_: @context.system_prompt, messages: @messages,
    74	        tools: Agent::Tools.definitions(:scheduled), tool_choice: tool_choice, cache_control: { type: :ephemeral },
    75	        request_options: { timeout: Agent::REQUEST_TIMEOUT } # the client-level timeout is ignored by the SDK when this is absent
    76	      )
    77	      %i[ input_tokens output_tokens cache_creation_input_tokens cache_read_input_tokens ].each { |field| @usage[field] += response.usage.public_send(field).to_i }
    78	      response
    79	    end
    80	
    81	    # Which budget, if any, leaves no room for another tool turn plus the final call MAX_TURNS reserves.
    82	    def budget_spent
    83	      return "turns" if @turns >= MAX_TURNS - 1
    84	      return "tool calls" if @tool_calls >= MAX_TOOL_CALLS
    85	      "input tokens" if input_tokens >= MAX_INPUT_TOKENS
    86	    end
    87	
    88	    def input_tokens = @usage[:input_tokens] + @usage[:cache_read_input_tokens] + @usage[:cache_creation_input_tokens]
    89	
    90	    # The brief is the final response's text; interim narration from tool turns counts only when nothing followed it.
    91	    def text = @texts.last.presence || @texts.reject(&:blank?).join("\n")
    92	
    93	    # Every tool_use id is answered in one user message, results first. A batch that would pass the call cap,
    94	    # or one asked for after tools were withdrawn, runs nothing: each id gets an error result and the next call carries no tools.
    95	    def answer(tool_uses, forced:)
    96	      if forced || @tool_calls + tool_uses.size > MAX_TOOL_CALLS
    97	        @capped_by ||= "tool calls"
    98	        return tool_uses.map { |use| { type: :tool_result, tool_use_id: use.id, is_error: true, content: BUDGET_EXHAUSTED } }
    99	      end
   100	      tool_uses.map { |use| tool_result(use) }
   101	    end
   102	
   103	    def tool_result(use)
   104	      @tool_calls += 1
   105	      result = Agent::Tools.call(use.name, use.input, transport: :scheduled, agent_run: run)
   106	      @degraded_reasons << "#{use.name} failed: #{result.error}" unless result.ok?
   107	      @degraded_reasons << "#{use.name} returned stale data" if result.ok? && stale?(result.value)
   108	      text = result.text
   109	      text = text.truncate_bytes(TOOL_RESULT_LIMIT, omission: "") + "\n[truncated at #{TOOL_RESULT_LIMIT / 1024} KB; ask for a narrower range or fewer rows]" if text.bytesize > TOOL_RESULT_LIMIT
   110	      { type: :tool_result, tool_use_id: use.id, content: text, is_error: !result.ok? }
   111	    end
   112	
   113	    def stale?(value)
   114	      case value
   115	      when Hash then value["stale"] == true || value.values.any? { |v| stale?(v) }
   116	      when Array then value.any? { |v| stale?(v) }
   117	      else false
   118	      end
   119	    end
   120	
   121	    # One retry at double the output budget when max_tokens cut into a tool call or the prose; the second time counts as capped.
   122	    def retry_larger?
   123	      return false if @retried
   124	      @retried = true
   125	      @messages.pop
   126	      @texts.pop
   127	      @max_tokens *= 2
   128	      true
   129	    end
   130	
   131	    def elapsed = (Process.clock_gettime(Process::CLOCK_MONOTONIC) - @started).seconds
   132	
   133	    def finish(status, error: nil)
   134	      if status != :failed && text.blank?
   135	        status, error = :failed, "stopped by #{@stop || 'nothing'} with no text"
   136	      end
   137	      run.finish!(status, error: error, output_markdown: text.presence, stop_reason: @stop&.to_s, tool_turns: @turns, tool_calls_count: @tool_calls,
   138	                  degraded: @degraded_reasons.any?, degraded_reasons: @degraded_reasons.uniq, transcript: Agent.serialize(@messages),
   139	                  estimated_cost: Agent::Pricing.cost(Agent::MODEL, **@usage.slice(:input_tokens, :output_tokens, :cache_creation_input_tokens, :cache_read_input_tokens)),
   140	                  **@usage.slice(:input_tokens, :output_tokens, :cache_creation_input_tokens, :cache_read_input_tokens))
   141	      run
   142	    end
   143	end
     1	# The agent-facing surface: one tool registry, two transports (MCP for the Claude app, in-process for
     2	# the scheduled runtime). See docs/phase-1-plan.md §3.
     3	module Agent
     4	  MODEL = "claude-sonnet-5" # synthesis over structured data; see Agent::Pricing for what it costs
     5	  REQUEST_TIMEOUT = 120 # seconds per call; the SDK default of ten minutes would outlive the run's own deadline
     6	  MAX_RETRIES = 2
     7	
     8	  def self.fake? = Rails.configuration.x.agent.adapter == :fake
     9	
    10	  # One client per process. The key is passed explicitly: the SDK would otherwise read an environment variable.
    11	  def self.client
    12	    return FakeAnthropic.instance if fake?
    13	    @client ||= Anthropic::Client.new(api_key: Rails.application.credentials.dig(:anthropic, :api_key).presence || raise(NotConfigured, "anthropic.api_key is not in credentials"),
    14	                                      timeout: REQUEST_TIMEOUT, max_retries: MAX_RETRIES)
    15	  end
    16	
    17	  class NotConfigured < StandardError; end
    18	
    19	  # Decimal strings for money and quantities, ISO 8601 New York timestamps, nothing else touched.
    20	  def self.serialize(value)
    21	    case value
    22	    when BigDecimal then value.to_s("F")
    23	    when ActiveSupport::TimeWithZone, Time then value.in_time_zone(MarketDay::ZONE).iso8601
    24	    when Date then value.iso8601
    25	    when Symbol then value.to_s
    26	    when Hash then value.to_h { |k, v| [ k.to_s, serialize(v) ] }
    27	    when Array then value.map { |v| serialize(v) }
    28	    else value
    29	    end
    30	  end
    31	end

