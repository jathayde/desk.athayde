     1	module Schwab
     2	  # Same interface as Client, same raw shapes (already scrubbed), served from lib/schwab_fixtures so seeds,
     3	  # Playwright, and specs all run the real mappers. A per-call queue scripts failures and alternate payloads:
     4	  #   Schwab::FakeClient.instance.enqueue(:orders) { raise Schwab::RateLimited.new(retry_after: 30) }
     5	  #   Schwab::FakeClient.instance.enqueue(:orders, sticky: true) { raise Schwab::ServerError }   # every call
     6	  # One process-wide instance, unsynchronized: fine for a single Puma thread in dev and Playwright.
     7	  class FakeClient
     8	    include Singleton
     9	
    10	    FIXTURES = Rails.root.join("lib/schwab_fixtures")
    11	    ACCOUNT_HASH = "9313A0737C4E1B2D5F6A7B8C9D0E1F2A3B4C5D6E7F8091A2B3C4D5E6F708192A"
    12	    FAKE_CODE = "fake-authorization-code@"
    13	    NEW_YORK = "America/New_York"
    14	
    15	    attr_reader :calls
    16	
    17	    def initialize = reset!
    18	
    19	    def reset!
    20	      @queues = Hash.new { |h, k| h[k] = [] }
    21	      @sticky = {}
    22	      @calls = []
    23	      @closed_dates = Set.new
    24	      self
    25	    end
    26	
    27	    # Script the next response for a method (or every response with sticky: true). The block receives the call's arguments.
    28	    def enqueue(method_name, sticky: false, &block)
    29	      sticky ? @sticky[method_name] = block : @queues[method_name] << block
    30	    end
    31	
    32	    def close_market_on(date) = @closed_dates << date.to_date
    33	
    34	    # ---- OAuth: the fake authorize page lives in the app (step 4) and redirects straight back
    35	    def authorize_url(state:) = "/schwab/fake_authorize?#{ { state: state }.to_query }"
    36	    def exchange_code(code) = scripted(:exchange_code, code) { code == FAKE_CODE ? token_fixture : raise(ReauthRequired.new("invalid_grant", status: 400)) }
    37	    def refresh(refresh_token) = scripted(:refresh, refresh_token) { token_fixture }
    38	
    39	    # ---- Trader API
    40	    def account_numbers = scripted(:account_numbers) { fixture("account_numbers").map { |row| row["hashValue"] } }
    41	    def account(hash, fields: [ :positions ]) = scripted(:account, hash, fields) { fixture("account") }
    42	    def orders(hash, from:, to: ::Time.current, status: nil) = scripted(:orders, hash, from, to, status) { fixture("orders") }
    43	    def order(hash, order_id) = scripted(:order, hash, order_id) { find_order(fixture("orders"), order_id.to_s) or raise RequestError.new("order not found", status: 404) }
    44	    def transactions(hash, from:, to: ::Time.current, type:) = scripted(:transactions, hash, from, to, type) { fixture("transactions").select { |a| a["type"] == type } }
    45	
    46	    # ---- Market Data API
    47	    def market_hours(date, markets: [ :equity ])
    48	      scripted(:market_hours, date, markets) do
    49	        closed = @closed_dates.include?(date.to_date) || date.to_date.on_weekend?
    50	        closed ? closed_day(date) : open_day(date)
    51	      end
    52	    end
    53	    def quotes(symbols, fields: %w[ quote reference ])
    54	      scripted(:quotes, symbols, fields) do
    55	        known = fixture("quotes").except("errors")
    56	        requested = Array(symbols).map(&:to_s)
    57	        [ known.slice(*requested).merge("errors" => { "invalidSymbols" => requested - known.keys }) ]
    58	      end
    59	    end
    60	    def price_history(symbol, period_type: :month, period: 3, frequency_type: :daily, frequency: 1, from: nil, to: nil) = scripted(:price_history, symbol) { fixture("price_history").merge("symbol" => symbol) }
    61	    def instrument_by_symbol(symbol) = scripted(:instrument_by_symbol, symbol) { fixture("instruments")["instruments"].select { |i| i["symbol"] == symbol } }
    62	    def instrument_by_cusip(cusip) = scripted(:instrument_by_cusip, cusip) { fixture("instruments")["instruments"].select { |i| i["cusip"] == cusip } }
    63	
    64	    private
    65	      def scripted(method_name, *args)
    66	        @calls << [ method_name, *args ]
    67	        block = @queues[method_name].shift || @sticky[method_name]
    68	        block ? block.call(*args) : yield
    69	      end
    70	
    71	      def fixture(name) = Scrub.json(JSON.parse(FIXTURES.join("#{name}.json").read))
    72	
    73	      # The token response is the one body that legitimately carries tokens; the real client never scrubs it either.
    74	      def token_fixture = JSON.parse(FIXTURES.join("token.json").read).except("id_token")
    75	
    76	      def find_order(orders, order_id)
    77	        orders.each do |raw|
    78	          return raw if raw["orderId"].to_s == order_id
    79	          found = find_order(Array(raw["childOrderStrategies"]) + Array(raw["replacingOrderCollection"]), order_id)
    80	          return found if found
    81	        end
    82	        nil
    83	      end
    84	
    85	      # Session times are built for the requested date in New York, so the offset is right year-round.
    86	      def open_day(date)
    87	        day = date.to_date
    88	        at = ->(hour, minute = 0) { ::Time.find_zone!(NEW_YORK).local(day.year, day.month, day.day, hour, minute).iso8601 }
    89	        { "equity" => { "EQ" => { "date" => day.iso8601, "marketType" => "EQUITY", "product" => "EQ", "productName" => "equity", "isOpen" => true,
    90	          "sessionHours" => { "preMarket" => [ { "start" => at.(7), "end" => at.(9, 30) } ],
    91	                              "regularMarket" => [ { "start" => at.(9, 30), "end" => at.(16) } ],
    92	                              "postMarket" => [ { "start" => at.(16), "end" => at.(20) } ] } } } }
    93	      end
    94	
    95	      def closed_day(date)
    96	        { "equity" => { "equity" => { "date" => date.to_date.iso8601, "marketType" => "EQUITY", "product" => "equity", "productName" => "equity", "isOpen" => false } } }
    97	      end
    98	  end
    99	end
