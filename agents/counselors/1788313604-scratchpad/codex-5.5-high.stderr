app/views/trades/index.html.erb
<% content_for :title, "Journal" %>
<h1>Journal</h1>
<nav class="filters">
  <% TradesController::FILTERS.each do |key, (label, _)| %>
    <%= link_to (key == "needs_review" ? "#{label} (#{@review_count})" : label), trades_path(filter: key), class: [ "chip", ("active" if @filter == key) ] %>
  <% end %>
</nav>
<% if @trades.empty? %>
  <p class="empty"><%= TradesController::FILTERS.fetch(@filter).last %></p>
<% else %>
  <ul class="trades">
    <% @trades.each do |trade| %>
      <li class="kv">
        <span><%= link_to trade.instrument.symbol, (trade.needs_review? ? trade_review_path(trade) : trade_path(trade)) %> · <%= quantity(trade.peak_quantity) %><% if trade.setup %> · <%= trade.setup.name %><% end %></span>
        <b><% if trade.closed? %><%= r_multiple(trade) %><% else %>open<% end %><% if trade.needs_review? %> · <em class="warn"><%= review_reason_label(trade) %></em><% end %></b>
      </li>
    <% end %>
  </ul>
<% end %>
app/views/trades/reviews/show.html.erb
<% content_for :title, "Review #{@trade.instrument.symbol}" %>
<h1>Is this part of a setup? <small><%= pluralize(@queue.count, "more") %> to review</small></h1>
<p class="callout"><%= review_reason_label(@trade) %>. <%= @trade.instrument.symbol %> · <%= quantity(@trade.quantity) %> held · avg entry <%= money(@trade.avg_entry) %><% if @position %> · <%= @position.protection == :protected ? "stop #{money(@position.stop_price)}" : protection_label(@position.protection) %><% end %>. Saving records the setup and clears this from the queue.</p>

<%= form_with url: trade_review_path(@trade), method: :patch do |f| %>
  <%= f.label :setup_id, "Setup" %>
  <%= f.select :setup_id, options_from_collection_for_select(@setups, :id, :name, @trade.setup_id), include_blank: "Pick a setup" %>
  <%= f.text_field :new_setup, placeholder: "or create a new setup by name" %>
  <% if @trade.closed? && @trade.bootstrapped? %>
    <p class="muted">Closed legacy holding: setup and thesis only, R stays blank.</p>
  <% else %>
    <%= f.label :planned_stop, "Planned stop" %>
    <%= f.text_field :planned_stop, value: @trade.planned_stop, inputmode: "decimal" %>
    <% if @trade.bootstrapped? %>
      <p class="muted">Legacy holding: the stop is recorded, R stays blank until the entry is known.</p>
    <% else %>
      <p class="muted">Without a stop, R stays blank. A stop at or above the average entry gives no risk to measure.</p>
    <% end %>
  <% end %>
  <%= f.label :thesis, "Thesis" %>
  <%= f.text_area :thesis, value: @trade.thesis, rows: 3 %>
  <%= f.submit "Save" %>
<% end %>
<div class="choice">
  <%= button_to "Skip for now", trade_deferral_path(@trade), method: :post, class: "button secondary" %>
</div>
<hr>
<p class="muted">Not a setup trade? It stays in the journal but out of the stats. Cannot be undone in Phase 1.</p>
<%= button_to "Not a setup trade", trade_exclusion_path(@trade), method: :post, class: "button secondary" %>
app/views/trades/show.html.erb
<% content_for :title, "#{@trade.instrument.symbol} trade" %>
<h1>Trade #<%= @trade.id %> · <%= @trade.instrument.symbol %> <small><%= @trade.status %><% if @trade.closed? && @trade.realized_r %> · <%= r_multiple(@trade) %><% end %></small></h1>
<% if @trade.needs_review? %><p class="callout"><%= review_reason_label(@trade) %>. <%= link_to "Review this trade", trade_review_path(@trade) %></p><% end %>

<dl class="kv-list">
  <div class="kv"><dt>Setup</dt><dd><%= @trade.setup&.name || "none" %></dd></div>
  <div class="kv"><dt>Planned / actual stop</dt><dd><%= money(@trade.current_planned_stop) %> / <% if @trade.closed? %><%= @trade.stopped_out? ? money(@trade.avg_exit) : "not hit" %><% else %><%= money(@position&.stop_price) %><% end %></dd></div>
  <div class="kv"><dt>Entry → exit</dt><dd><%= money(@trade.avg_entry) %> → <%= @trade.avg_exit ? money(@trade.avg_exit) : "open" %></dd></div>
  <div class="kv"><dt>Realized P&amp;L</dt><dd><%= signed_money(@trade.realized_pnl) %></dd></div>
  <div class="kv"><dt>Initial risk</dt><dd><%= money(@trade.initial_risk) %></dd></div>
</dl>
<% if @trade.thesis.present? %><p class="thesis"><%= @trade.thesis %></p><% end %>

<section>
  <h2 class="sec">Legs</h2>
  <ul class="legs">
    <% @trade.ordered_legs.each do |leg| %>
      <li class="kv"><span><%= leg.kind %><%= " (plug)" if leg.plug? %> <%= quantity(leg.quantity) %><% if leg.ratio %> ×<%= quantity(leg.ratio) %><% end %></span><b><%= leg.price ? money(leg.price) : signed_money(leg.cash_amount) %> · <%= leg.executed_at ? l(leg.executed_at, format: :weekday_time) : "unknown" %></b></li>
    <% end %>
  </ul>
</section>

<% if @trade.closed? %>
  <section class="post-mortem">
    <h2 class="sec">Post-mortem</h2>
    <% if @trade.post_mortem %><p class="thesis"><%= @trade.post_mortem %> · <%= @trade.followed_setup ? "followed setup" : "improvised" %></p><% end %>
    <%= form_with url: trade_path(@trade), method: :patch do |f| %>
      <%= f.text_field :post_mortem, value: @trade.post_mortem, placeholder: "What actually happened…", required: true %>
      <div class="choice">
        <label><%= f.radio_button :followed_setup, 1, checked: @trade.followed_setup == true %> Followed setup</label>
        <label><%= f.radio_button :followed_setup, 0, checked: @trade.followed_setup == false %> Improvised</label>
      </div>
      <%= f.submit "Save" %>
    <% end %>
  </section>
<% end %>

