app/models/stop_collar/calculator.rb:30:    return refuse("every method lands at or above the entry") if methods.values_at(:atr, :swing, :percent).all? { |v| v >= @entry }
app/models/stop_collar/calculator.rb:31:    candidates = methods.values_at(:atr, :swing, :percent).select { |v| v < @entry }
app/models/stop_collar/calculator.rb:32:    StopCollar::Collar.new(methods: methods, tight: candidates.max, wide: [ candidates.min, methods[:percent] ].max, floor: methods[:percent], quality: "ok")
