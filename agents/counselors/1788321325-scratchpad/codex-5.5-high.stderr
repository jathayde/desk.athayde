app/models/stop_collar/calculator.rb:16:    candles = Array(history[:candles]).map { |c| c.transform_keys(&:to_sym) }.sort_by { |c| c[:date] }
app/models/stop_collar/calculator.rb:17:    return refuse("only #{candles.size} daily candles; #{MIN_CANDLES} needed") if candles.size < MIN_CANDLES
app/models/stop_collar/calculator.rb:18:    return refuse("latest candle is #{candles.last[:date]}") if candles.last[:date].to_date < MAX_CANDLE_AGE.ago.to_date
app/models/stop_collar/calculator.rb:19:    return refuse("history is stale (Schwab unavailable)") if history[:stale]
app/models/stop_collar/calculator.rb:20:    quote = Agent::MarketData.quotes([ @instrument.symbol ])[:quotes].first
app/models/stop_collar/calculator.rb:21:    return refuse("no fresh quote") if quote.nil? || quote[:stale]
app/models/stop_collar/calculator.rb:22:
app/models/stop_collar/calculator.rb:23:    atr14 = atr(candles, 14)
app/models/stop_collar/calculator.rb:24:    methods = {
app/models/stop_collar/calculator.rb:25:      atr: @entry - param(:atr_k) * atr14,
app/models/stop_collar/calculator.rb:26:      swing: candles.last(param(:swing_bars).to_i).map { |c| c[:low] }.min - param(:swing_buffer_atr) * atr14,
app/models/stop_collar/calculator.rb:27:      percent: @entry * (1 - param(:percent) / 100),
app/models/stop_collar/calculator.rb:28:      chandelier: candles.last(param(:chandelier_bars).to_i).map { |c| c[:high] }.max - param(:chandelier_k) * atr(candles, param(:chandelier_bars).to_i)
