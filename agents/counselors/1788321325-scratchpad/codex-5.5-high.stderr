app/models/agent/tools.rb:1:# The registry and the one dispatch entry point every transport uses.
app/models/agent/tools.rb:2:module Agent::Tools
app/models/agent/tools.rb:3:  Result = Data.define(:value, :error, :retry_after) do
app/models/agent/tools.rb:4:    def self.success(value) = new(value: value, error: nil, retry_after: nil)
app/models/agent/tools.rb:5:    def self.failure(error, retry_after: nil) = new(value: nil, error: error, retry_after: retry_after)
app/models/agent/tools.rb:6:    def ok? = error.nil?
app/models/agent/tools.rb:7:    # The text a model reads: the JSON on success, the message on failure.
app/models/agent/tools.rb:8:    def text = ok? ? JSON.generate(value) : error
app/models/agent/tools.rb:9:  end
app/models/agent/tools.rb:10:
app/models/agent/tools.rb:11:  def self.all = [ GetPortfolio, GetAccountHealth, GetQuotes, GetPriceHistory, GetJournal, GetSetupStats, GetRiskRules, EvaluateHypotheticalOrder ]
app/models/agent/tools.rb:12:
app/models/agent/tools.rb:13:  def self.for(transport)
app/models/agent/tools.rb:14:    case transport.to_sym
app/models/agent/tools.rb:15:    when :mcp then all.select(&:mcp_allowed?)
app/models/agent/tools.rb:16:    when :scheduled then all.select { |t| t.scheduled_allowed? && t.read_only? }
app/models/agent/tools.rb:17:    else raise ArgumentError, "unknown transport #{transport}"
app/models/agent/tools.rb:18:    end
app/models/agent/tools.rb:19:  end
app/models/agent/tools.rb:20:
app/models/agent/tools.rb:21:  def self.definitions(transport) = self.for(transport).map(&:definition)
app/models/agent/tools.rb:22:  def self.find(name, transport:) = self.for(transport).find { |t| t.tool_name == name.to_s }
app/models/agent/tools.rb:23:
app/models/agent/tools.rb:24:  # Permission check, argument validation, telemetry, timing, and error normalization in one place.
app/models/agent/tools.rb:25:  # Never raises to the caller: Schwab and tool failures become results the agent can read and act on.
app/models/agent/tools.rb:26:  # Every call writes a tool_calls row, including a call the transport is not allowed to make.
app/models/agent/tools.rb:27:  def self.call(name, arguments = {}, transport:, agent_run: nil)
app/models/agent/tools.rb:28:    arguments = arguments.to_h.deep_symbolize_keys
app/models/agent/tools.rb:29:    record = ToolCall.new(agent_run: agent_run, transport: transport, tool_name: name.to_s, arguments: Agent.serialize(arguments))
app/models/agent/tools.rb:30:    started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
app/models/agent/tools.rb:31:    result = if (tool = find(name, transport: transport))
app/models/agent/tools.rb:32:      invoke(tool, arguments)
app/models/agent/tools.rb:33:    elsif all.any? { |t| t.tool_name == name.to_s }
app/models/agent/tools.rb:34:      Result.failure("#{name} is not available on the #{transport} transport")
app/models/agent/tools.rb:35:    else
app/models/agent/tools.rb:36:      Result.failure("unknown tool #{name}")
app/models/agent/tools.rb:37:    end
app/models/agent/tools.rb:38:    record.duration_ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round
app/models/agent/tools.rb:39:    record.error = result.error
app/models/agent/tools.rb:40:    record.save!
app/models/agent/tools.rb:41:    # An audited tool's row says what was asked and how it ended, after the fact, linked to its telemetry.
app/models/agent/tools.rb:42:    AuditEvent.log("agent_tool_used", actor: :agent, reason: result.error, data: { tool: tool.tool_name, transport: transport.to_s, arguments: Agent.serialize(arguments), ok: result.ok?, tool_call_id: record.id }) if tool&.audited?
app/models/agent/tools.rb:43:    result
app/models/agent/tools.rb:44:  end
app/models/agent/tools.rb:45:
app/models/agent/tools.rb:46:  def self.invoke(tool, arguments)
app/models/agent/tools.rb:47:    tool.validate!(arguments)
app/models/agent/tools.rb:48:    Result.success(Agent.serialize(tool.new.call(**arguments)))
app/models/agent/tools.rb:49:  rescue Schwab::RateLimited => e
app/models/agent/tools.rb:50:    Result.failure("Schwab rate limit: try again in #{e.retry_after || 60} seconds", retry_after: e.retry_after || 60)
app/models/agent/tools.rb:51:  rescue Schwab::NoUsableToken, Schwab::AuthError => e
app/models/agent/tools.rb:52:    Result.failure("Schwab connection needs re-authentication: #{e.message}")
app/models/agent/tools.rb:53:  rescue Schwab::Error => e
app/models/agent/tools.rb:54:    Result.failure("Schwab unavailable: #{e.message}")
app/models/agent/tools.rb:55:  rescue Agent::Tool::InvalidArguments => e
app/models/agent/tools.rb:56:    Result.failure("bad arguments: #{e.message}")
app/models/agent/tools.rb:57:  rescue StandardError, NotImplementedError => e # NotImplementedError is a ScriptError: the base class's own contract
app/models/agent/tools.rb:58:    Rails.error.report(e, handled: true, context: { tool: tool.tool_name })
app/models/agent/tools.rb:59:    Result.failure("#{tool.tool_name} failed: #{e.class.name}")
app/models/agent/tools.rb:60:  end
app/models/agent/tools.rb:61:  private_class_method :invoke
app/models/agent/tools.rb:62:end
