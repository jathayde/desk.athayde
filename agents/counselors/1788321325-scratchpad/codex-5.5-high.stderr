spec/support/candles.rb:3:  def script_price_history(symbol: "XYZ", days: 60, close: 50, range: 1, ending: MarketDay.today)
spec/support/candles.rb:4:    candles = (1..days).map do |i|
spec/support/candles.rb:5:      date = ending - (days - i)
spec/support/candles.rb:6:      zone = Time.find_zone!(MarketDay::ZONE)
spec/support/candles.rb:7:      c = close + Math.sin(i / 3.0) # a gentle wave, never flat
spec/support/candles.rb:8:      { "datetime" => zone.local(date.year, date.month, date.day, 6).to_i * 1000, "open" => c - 0.2, "high" => c + range, "low" => c - range, "close" => c, "volume" => 1_000_000 }
spec/support/candles.rb:9:    end
spec/support/candles.rb:10:    Schwab::FakeClient.instance.enqueue(:price_history, sticky: true) { { "candles" => candles, "symbol" => symbol, "empty" => false, "previousClose" => close } }
spec/support/candles.rb:11:  end
spec/support/candles.rb:12:end
