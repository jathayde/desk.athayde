db/seeds.rb:13:end
db/seeds.rb:14:
db/seeds.rb:15:# A development desk through the fake broker and the fake model, so every screen and a brief render without
db/seeds.rb:16:# Schwab or Anthropic. Never in production, never against the real adapters, never twice.
db/seeds.rb:17:return unless Rails.env.development? && Schwab.fake? && Agent.fake?
db/seeds.rb:18:return puts("desk already seeded; bin/rails db:reset to start over") if Account.any?
db/seeds.rb:19:
db/seeds.rb:20:ActiveJob::Base.queue_adapter = :inline # the sync jobs hand off to the journal with perform_later
db/seeds.rb:21:Schwab::FakeClient.instance.reset!
db/seeds.rb:22:
db/seeds.rb:23:now = Time.current
db/seeds.rb:24:SchwabToken.create!(access_token: "fake-access", refresh_token: "fake-refresh", issued_at: now, access_expires_at: now + 29.minutes,
db/seeds.rb:25:                    refresh_expires_at: now + SchwabToken::REFRESH_LIFETIME, scope: "api")
db/seeds.rb:26:(MarketDay.today..MarketDay.today + 7).each { |date| MarketDay.for(date) }
db/seeds.rb:27:
db/seeds.rb:28:Sync::AccountsJob.perform_now
db/seeds.rb:29:account = Account.first.tap { |a| a.update!(account_type: :taxable, trading_enabled: true, nickname: "Taxable") }
db/seeds.rb:30:Sync::PositionsJob.perform_now(account)
db/seeds.rb:31:Sync::OrdersJob.perform_now(account)
db/seeds.rb:32:Sync::ActivitiesJob.perform_now(account)
db/seeds.rb:33:Journal::BootstrapJob.perform_now(account)
db/seeds.rb:34:Journal::LinkFillsJob.perform_now(account)
db/seeds.rb:35:
db/seeds.rb:36:# One setup, one reviewed trade, one left in the review queue, one closed trade with an R so the stats have a row.
db/seeds.rb:37:john = User.find_by!(email_address: "john@athayde.com")
db/seeds.rb:38:breakout = Setup.create!(name: "Breakout", definition: "Buy the break of a tight range on volume; stop under the range low.")
db/seeds.rb:39:reviewed, *queued = account.trades.needing_review.order(:id).to_a
db/seeds.rb:40:reviewed&.review!(setup: breakout, planned_stop: reviewed.avg_entry * BigDecimal("0.95"), thesis: "Seeded thesis: range break on volume.", user: john)
db/seeds.rb:41:queued.first&.defer_review! # one trade stays in the review queue, skipped once
db/seeds.rb:42:closed = account.trades.create!(instrument: Instrument.find_by!(symbol: "XYZ"), status: :closed, setup: breakout, avg_entry: 51.18, avg_exit: 55.31, peak_quantity: 40,
db/seeds.rb:43:                                realized_pnl: 165.2, initial_risk: 91.2, realized_r: 1.81, planned_stop: 48.9, opened_at: 9.days.ago, closed_at: 2.days.ago,
db/seeds.rb:44:                                thesis: "Seeded closed trade.", followed_setup: true)
db/seeds.rb:45:closed.trade_legs.create!(kind: :entry, quantity: 40, price: 51.18, cash_amount: -2047.2, executed_at: 9.days.ago)
db/seeds.rb:46:closed.trade_legs.create!(kind: :exit, quantity: 40, price: 55.31, cash_amount: 2212.4, executed_at: 2.days.ago)
db/seeds.rb:47:Journal::RecomputeSetupStatsJob.perform_now(breakout)
db/seeds.rb:48:
db/seeds.rb:49:# A short equity history so drawdown and day change have something to read, and one failed run for the system page.
db/seeds.rb:50:balance = account.current_balance
db/seeds.rb:51:[ 3, 2, 1 ].each_with_index do |days_ago, i|
db/seeds.rb:52:  account.snapshots.create!(as_of: MarketDay.today - days_ago, equity: balance.equity - 60 + i * 20, index_value: 1 + i * 0.002, high_water_index: 1.004,
db/seeds.rb:53:                            drawdown: [ 0.004 - i * 0.002, 0 ].max, open_risk_amount: 120, open_risk_ratio: 0.012, unprotected_count: 0)
db/seeds.rb:54:end
db/seeds.rb:55:SyncRun.create!(feed: :orders, account: account, status: :failed, started_at: 2.hours.ago, finished_at: 2.hours.ago, error: "seeded: Schwab 503 (see /system)")
db/seeds.rb:56:
