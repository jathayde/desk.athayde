     1	# One row, enforced by a check constraint on id = 1. Holds the global flags the PRD calls out:
     2	# shadow mode (on by default), the manual halt, and why sync is paused.
     3	class SystemSettings < ApplicationRecord
     4	  # Two halts (docs/phase-2-plan.md §0.3): the kill switch stops everything; a rule halt (daily loss, drawdown)
     5	  # blocks new entries only, so exits and tighten-only stop adjustments stay available. Shadow mode is not a
     6	  # gate: it is the branch between "would have submitted" and a real call.
     7	  LIVE_CONFIRMATION, SHADOW_CONFIRMATION = "go live", "shadow"
     8	
     9	  def halted? = manual_halt? || rule_halted?
    10	  def entries_allowed? = !halted?
    11	  def exits_allowed? = !manual_halt?
    12	  def rule_halted? = rule_halt_tripped_at.present? && (rule_halt_resets_at.nil? || rule_halt_resets_at > Time.current)
    13	
    14	  # Under the row lock, since two evaluators can trip at once. A second rule tripping during a halt extends
    15	  # it to the later reset and records the rule; a lapsed halt is cleared with its own audit row by the tick.
    16	  def trip_rule_halt!(rule:, reason:, resets_at:)
    17	    with_lock do
    18	      if rule_halted?
    19	        # nil means until cleared by hand, later than any time; only a strictly later reset changes anything,
    20	        # so a rule re-evaluated during its own halt writes nothing.
    21	        indefinite_already = rule_halt_resets_at.nil?
    22	        extends_the_halt = !indefinite_already && (resets_at.nil? || resets_at > rule_halt_resets_at)
    23	        if extends_the_halt
    24	          update!(rule_halt_rule: rule, rule_halt_reason: reason, rule_halt_resets_at: resets_at)
    25	          AuditEvent.log("rule_halt_tripped", actor: :system, reason: reason, data: { rule: rule, resets_at: resets_at, extended: true })
    26	        end
    27	      else
    28	        update!(rule_halt_rule: rule, rule_halt_reason: reason, rule_halt_tripped_at: Time.current, rule_halt_resets_at: resets_at)
    29	        AuditEvent.log("rule_halt_tripped", actor: :system, reason: reason, data: { rule: rule, resets_at: resets_at })
    30	      end
    31	    end
    32	    self
    33	  end
    34	
    35	  def clear_rule_halt!(user: nil, reason: nil)
    36	    with_lock do
    37	      next unless rule_halt_tripped_at
    38	      AuditEvent.log("rule_halt_cleared", actor: user ? :human : :system, user: user, reason: reason, data: { rule: rule_halt_rule })
    39	      update!(rule_halt_rule: nil, rule_halt_reason: nil, rule_halt_tripped_at: nil, rule_halt_resets_at: nil)
    40	    end
    41	    self
    42	  end
    43	
    44	  # Shadow mode off means the next approve reaches Schwab; on is the same gesture in reverse. Audited both ways
    45	  # with the shadow evidence that justified it, under the row lock so two toggles cannot cross.
    46	  def toggle_shadow_mode!(user:, reason:)
    47	    with_lock do
    48	      status = SystemStatus.new
    49	      update!(shadow_mode: !shadow_mode?, shadow_mode_changed_at: Time.current)
    50	      AuditEvent.log("shadow_mode_toggled", actor: :human, user: user, reason: reason,
    51	                     data: { shadow_mode: shadow_mode, shadowed_approvals: status.shadowed_approvals, shadow_reconciled: status.shadow_reconciled })
    52	    end
    53	    self
    54	  end
    55	
    56	  def confirmation_word = shadow_mode? ? LIVE_CONFIRMATION : SHADOW_CONFIRMATION
    57	
    58	  def sweep_rule_halt!
    59	    clear_rule_halt!(reason: "reset time passed") if rule_halt_tripped_at && !rule_halted?
    60	  end
    61	
    62	  def self.instance = find_or_create_by!(id: 1)
    63	
    64	  # The two halves of the token pause, under the same row lock so a re-auth landing mid-tick cannot be
    65	  # marked paused: pause while the token is unusable (one audit per episode) and resume on a new token.
    66	  def self.pause_for_token!
    67	    transaction do
    68	      settings = instance.lock!
    69	      next nil if SchwabToken.usable?
    70	      unless settings.sync_paused_reason
    71	        settings.update!(sync_paused_reason: "Schwab token unusable; re-authenticate")
    72	        AuditEvent.log("sync_paused_token_expired", actor: :system)
    73	      end
    74	      settings.sync_paused_reason
    75	    end
    76	  end
    77	
    78	  def self.resume_sync!
    79	    settings = instance.lock!
    80	    AuditEvent.log("sync_resumed", actor: :system, reason: settings.sync_paused_reason) if settings.sync_paused_reason
    81	    settings.update!(sync_paused_reason: nil)
    82	  end
    83	end

