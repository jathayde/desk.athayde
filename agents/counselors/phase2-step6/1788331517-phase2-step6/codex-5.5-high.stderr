     1	# One row, enforced by a check constraint on id = 1. Holds the global flags the PRD calls out:
     2	# shadow mode (on by default), the manual halt, and why sync is paused.
     3	class SystemSettings < ApplicationRecord
     4	  # Two halts (docs/phase-2-plan.md §0.3): the kill switch stops everything; a rule halt (daily loss, drawdown)
     5	  # blocks new entries only, so exits and tighten-only stop adjustments stay available. Shadow mode is not a
     6	  # gate: it is the branch between "would have submitted" and a real call.
     7	  def entries_allowed? = !manual_halt? && !rule_halted?
     8	  def exits_allowed? = !manual_halt?
     9	  def rule_halted? = rule_halt_tripped_at.present? && (rule_halt_resets_at.nil? || rule_halt_resets_at > Time.current)
    10	
    11	  # Under the row lock, since two evaluators can trip at once. A second rule tripping during a halt extends
    12	  # it to the later reset and records the rule; a lapsed halt is cleared with its own audit row by the tick.
    13	  def trip_rule_halt!(rule:, reason:, resets_at:)
    14	    with_lock do
    15	      if rule_halted?
    16	        # nil means until cleared by hand, later than any time; only a strictly later reset changes anything,
    17	        # so a rule re-evaluated during its own halt writes nothing.
    18	        indefinite_already = rule_halt_resets_at.nil?
    19	        extends_the_halt = !indefinite_already && (resets_at.nil? || resets_at > rule_halt_resets_at)
    20	        if extends_the_halt
    21	          update!(rule_halt_rule: rule, rule_halt_reason: reason, rule_halt_resets_at: resets_at)
    22	          AuditEvent.log("rule_halt_tripped", actor: :system, reason: reason, data: { rule: rule, resets_at: resets_at, extended: true })
    23	        end
    24	      else
    25	        update!(rule_halt_rule: rule, rule_halt_reason: reason, rule_halt_tripped_at: Time.current, rule_halt_resets_at: resets_at)
    26	        AuditEvent.log("rule_halt_tripped", actor: :system, reason: reason, data: { rule: rule, resets_at: resets_at })
    27	      end
    28	    end
    29	    self
    30	  end
    31	
    32	  def clear_rule_halt!(user: nil, reason: nil)
    33	    with_lock do
    34	      next unless rule_halt_tripped_at
    35	      AuditEvent.log("rule_halt_cleared", actor: user ? :human : :system, user: user, reason: reason, data: { rule: rule_halt_rule })
    36	      update!(rule_halt_rule: nil, rule_halt_reason: nil, rule_halt_tripped_at: nil, rule_halt_resets_at: nil)
    37	    end
    38	    self
    39	  end
    40	
    41	  def sweep_rule_halt!
    42	    clear_rule_halt!(reason: "reset time passed") if rule_halt_tripped_at && !rule_halted?
    43	  end
    44	
    45	  def self.instance = find_or_create_by!(id: 1)
    46	
    47	  # The two halves of the token pause, under the same row lock so a re-auth landing mid-tick cannot be
    48	  # marked paused: pause while the token is unusable (one audit per episode) and resume on a new token.
    49	  def self.pause_for_token!
    50	    transaction do
    51	      settings = instance.lock!
    52	      next nil if SchwabToken.usable?
    53	      unless settings.sync_paused_reason
    54	        settings.update!(sync_paused_reason: "Schwab token unusable; re-authenticate")
    55	        AuditEvent.log("sync_paused_token_expired", actor: :system)
    56	      end
    57	      settings.sync_paused_reason
    58	    end
    59	  end
    60	
    61	  def self.resume_sync!
    62	    settings = instance.lock!
    63	    AuditEvent.log("sync_resumed", actor: :system, reason: settings.sync_paused_reason) if settings.sync_paused_reason
    64	    settings.update!(sync_paused_reason: nil)
    65	  end
    66	end

