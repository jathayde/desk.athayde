    21	  <% if Current.user&.approver? %>
    22	    <%= form_with url: shadow_system_path, method: :post, class: "account-form" do |f| %>
    23	      <%= f.label :reason, status.settings.shadow_mode ? "Turn shadow mode off (the next approve places a real order): why" : "Turn shadow mode back on: why" %>
    24	      <%= f.text_field :reason, required: true %>
    25	      <%= f.label :confirmation, "Type #{status.settings.shadow_mode ? SystemController::LIVE_CONFIRMATION : SystemController::SHADOW_CONFIRMATION} to confirm" %>
    26	      <%= f.text_field :confirmation, autocomplete: "off" %>
    27	      <%= f.submit status.settings.shadow_mode ? "Go live" : "Back to shadow", class: status.settings.shadow_mode ? "danger" : nil %>
    28	    <% end %>
    29	    <p class="muted"><%= link_to "Rules", risk_rules_path %> · every edit is a new version.</p>
    30	  <% end %>
    31	  <div class="kv"><dt>API spend this month</dt><dd><%= money(status.api_spend_this_month, precision: 2) %><% if status.unpriced_runs? %> <small>plus unpriced runs</small><% end %></dd></div>
    32	  <div class="kv"><dt>Memory repo</dt>
    33	    <dd><% if status.memory_repo.present? %><%= pluralize(status.memory_repo.paths.size, "file") %>, changed <%= as_of(status.memory_repo.last_modified_at) %><% else %>missing<% end %><% if status.memory_run %> · pull <%= status.memory_run.status %> <%= as_of(status.memory_run.finished_at || status.memory_run.started_at) %><% if status.memory_run.error %> <small><%= status.memory_run.error.truncate(80) %></small><% end %><% end %></dd></div>
    34	</dl>
    35	
    36	<dl class="kv-list">
    37	  <h2 class="sec">Briefs</h2>
    38	  <% status.agent_runs.each do |run| %>
    39	    <div class="kv"><dt><%= run.title %></dt>
    40	      <dd><%= run.status %><%= " · degraded" if run.degraded? %><%= " · not emailed" if run.deliverable? && !run.delivered? %><% if run.estimated_cost || run.unpriced? %> · <%= run.cost_label %><% end %><% if run.error %> <small><%= run.error.truncate(80) %></small><% end %></dd></div>
    41	  <% end %>
    42	  <% if status.agent_runs.empty? %><div class="kv"><dt>Runs</dt><dd>none yet</dd></div><% end %>
    43	</dl>
    44	
    45	<section>
    46	  <h2 class="sec">Accounts</h2>
    47	  <% status.accounts.each do |row| %>
    48	    <% account = row.account %>
    49	    <%= form_with url: account_path(account), method: :patch, class: "account-form" do |f| %>
    50	      <div class="kv"><span><%= account.label %></span>
    51	        <b><%= money(row.equity) %> · <%= row.symbols.join(", ").presence || "no positions" %></b></div>
    52	      <div class="fields">
    53	        <%= f.text_field :nickname, value: account.nickname, placeholder: "Nickname" %>
    54	        <%= f.select :account_type, options_for_select([ [ "Unclassified", "" ], [ "Taxable", "taxable" ], [ "IRA", "ira" ] ], account.account_type) %>
    55	        <label><%= f.check_box :trading_enabled, checked: account.trading_enabled? %> Journal this account (taxable only)</label>
    56	        <%= f.submit "Save" %>
    57	      </div>
    58	      <% if account.needs_setup? %><p class="warn">Needs setup: classify this account before anything journals.</p><% end %>
    59	    <% end %>
    60	  <% end %>
    61	</section>
    62	
    63	<section>
    64	  <h2 class="sec">Holdings</h2>
    65	  <dl class="kv-list">
    66	    <% status.holdings.each do |position| %>
    67	      <div class="kv"><dt><%= position.instrument.symbol %><% if position.instrument.delisted? %> <small>delisted</small><% end %></dt>
    68	        <dd><%= button_to position.instrument.delisted? ? "Relist" : "Mark delisted", instrument_path(position.instrument), method: :patch, params: { delisted: position.instrument.delisted? ? "0" : "1" }, class: "link-button" %></dd></div>
    69	    <% end %>
    70	    <% if status.holdings.empty? %><div class="kv"><dt>Positions</dt><dd>none yet</dd></div><% end %>
    71	  </dl>
    72	  <p class="muted">A delisted holding still syncs and stays in the journal; it leaves the unprotected count and the risk sums, and comes back on its own if Schwab prints a different price.</p>
    73	</section>
    74	
    75	<section>
    76	  <h2 class="sec">Feeds</h2>
    77	  <dl class="kv-list">
    78	    <% status.feed_rows.each do |row| %>
    79	      <div class="kv"><dt><%= row.account.label %> · <%= row.feed %></dt>
    80	        <dd><% if row.latest %><%= row.latest.status %> <%= as_of(row.latest.finished_at || row.latest.started_at) %><% if row.latest.status != "succeeded" %> · last success <%= as_of(row.last_success) %><% end %><% if row.latest.error %> <small><%= row.latest.error.truncate(80) %></small><% end %><% else %>never<% end %></dd></div>
    81	    <% end %>
    82	  </dl>
    83	  <% status.gaps.each do |run| %>
    84	    <p class="warn"><%= run.account&.label %> <%= run.feed %>: Schwab cannot return history before <%= l(run.gap_from, format: :connection) %>.</p>
    85	  <% end %>
    86	</section>
    87	
    88	<dl class="kv-list">
    89	  <h2 class="sec">Failures, 7 days</h2>
    90	  <div class="kv"><dt>Failed sync runs</dt><dd><%= status.failed_run_count %></dd></div>
    91	  <div class="kv"><dt>Failed jobs</dt><dd><%= status.failed_job_count %></dd></div>
    92	  <% status.failed_runs_sample.each do |run| %>
    93	    <p class="muted"><%= l(run.started_at, format: :weekday_time) %> <%= run.feed %>: <%= run.error.to_s.truncate(120) %></p>
    94	  <% end %>
    95	</dl>
    96	
    97	<section class="halt">
    98	  <h2 class="sec">Halt</h2>
    99	  <% if status.settings.manual_halt? %>
   100	    <p class="warn">Halted<% if status.halted_by %> by <%= status.halted_by.user&.name %>, <%= l(status.halted_by.created_at, format: :weekday_time) %><% end %>: <%= status.settings.manual_halt_reason %></p>
   101	    <%= form_with url: resume_system_path, method: :post do |f| %>
   102	      <%= f.label :confirmation, "Type resume to clear the halt" %>
   103	      <%= f.text_field :confirmation, autocomplete: "off" %>
   104	      <%= f.submit "Resume" %>
   105	    <% end %>
   106	  <% else %>
   107	    <p>Halting stops proposal creation and submission once Phase 2 ships; in Phase 1 it marks the dashboard.</p>
   108	    <%= form_with url: halt_system_path, method: :post do |f| %>
   109	      <%= f.label :reason, "Reason" %>
   110	      <%= f.text_field :reason, required: true %>
   111	      <%= f.submit "Halt", class: "danger" %>
   112	    <% end %>
   113	  <% end %>
   114	</section>

