     1	class SystemController < ApplicationController
     2	  RESUME_CONFIRMATION = "resume".freeze
     3	  LIVE_CONFIRMATION = "go live".freeze
     4	  SHADOW_CONFIRMATION = "shadow".freeze
     5	
     6	  before_action :require_approver, only: :shadow
     7	
     8	  def show
     9	    @status = SystemStatus.new
    10	  end
    11	
    12	  # Halt: a reason is required. Resume: the operator types the word.
    13	  def halt
    14	    reason = params[:reason].to_s.strip
    15	    return redirect_to system_path, alert: "A reason is required to halt." if reason.blank?
    16	    SystemSettings.instance.update!(manual_halt: true, manual_halt_reason: reason, manual_halt_at: Time.current)
    17	    AuditEvent.log("manual_halt_set", actor: :human, user: Current.user, reason: reason)
    18	    redirect_to system_path, notice: "Halted."
    19	  end
    20	
    21	  # Shadow mode off means the next approve reaches Schwab: the operator types the words and says why; on is the
    22	  # same gesture in reverse. Audited both ways, with the shadow evidence in the data.
    23	  def shadow
    24	    settings = SystemSettings.instance
    25	    turning_off = settings.shadow_mode?
    26	    word = turning_off ? LIVE_CONFIRMATION : SHADOW_CONFIRMATION
    27	    return redirect_to system_path, alert: "Type #{word} to confirm." unless params[:confirmation].to_s.strip.casecmp?(word)
    28	    reason = params[:reason].to_s.strip
    29	    return redirect_to system_path, alert: "A reason is required." if reason.blank?
    30	    status = SystemStatus.new
    31	    settings.update!(shadow_mode: !turning_off, shadow_mode_changed_at: Time.current)
    32	    AuditEvent.log("shadow_mode_toggled", actor: :human, user: Current.user, reason: reason,
    33	                   data: { shadow_mode: settings.shadow_mode, shadowed_approvals: status.shadowed_approvals, shadow_reconciled: status.shadow_reconciled })
    34	    redirect_to system_path, notice: turning_off ? "Shadow mode is off: the next approve places a real order." : "Shadow mode is on."
    35	  end
    36	
    37	  def resume
    38	    settings = SystemSettings.instance
    39	    return redirect_to system_path, alert: "Nothing is halted." unless settings.manual_halt?
    40	    return redirect_to system_path, alert: "Type #{RESUME_CONFIRMATION} to confirm." unless params[:confirmation].to_s.strip.casecmp?(RESUME_CONFIRMATION)
    41	    AuditEvent.log("manual_halt_cleared", actor: :human, user: Current.user, reason: settings.manual_halt_reason)
    42	    settings.update!(manual_halt: false, manual_halt_reason: nil, manual_halt_at: nil)
    43	    redirect_to system_path, notice: "Resumed."
    44	  end
    45	end

