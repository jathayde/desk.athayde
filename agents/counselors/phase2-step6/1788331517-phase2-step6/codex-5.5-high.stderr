 succeeded in 0ms:
     1	# The rule editor (Flow 6): one row per active rule, edited by superseding, with an effect preview over the
     2	# proposals waiting today. Locked while any halt is engaged, except through the override: a typed reason, so
     3	# a misconfigured rule that caused a false halt can be fixed without waiting for the reset.
     4	class RiskRulesController < ApplicationController
     5	  before_action :require_approver
     6	
     7	  def index
     8	    @rules = RiskRule.active.includes(:setup).order(:rule_type, :setup_id)
     9	    @settings = SystemSettings.instance
    10	  end
    11	
    12	  def update
    13	    rule = RiskRule.active.find(params[:id])
    14	    override = params[:override_reason].to_s.strip
    15	    if halted? && override.blank?
    16	      return redirect_to risk_rules_path, alert: "Rules are locked while a halt is engaged. To edit anyway, type why."
    17	    end
    18	    successor = rule.supersede!(params: rule_params(rule), mode: params[:mode].presence || rule.mode, user: Current.user,
    19	                                note: [ params[:note].presence, (override.present? ? "override during halt: #{override}" : nil) ].compact.join(" · ").presence)
    20	    redirect_to risk_rules_path, notice: "#{successor.rule_type.humanize} is now version #{successor.version}."
    21	  rescue ActiveRecord::RecordInvalid => e
    22	    redirect_to risk_rules_path, alert: e.record.errors.full_messages.to_sentence
    23	  end
    24	
    25	  # What the waiting proposals would say under the candidate params, next to what they say now. Nothing is written.
    26	  def preview
    27	    rule = RiskRule.active.find(params[:id])
    28	    candidate = RiskRule.new(rule_type: rule.rule_type, params: rule_params(rule), mode: params[:mode].presence || rule.mode, setup: rule.setup, version: rule.version + 1)
    29	    @rule, @candidate = rule, candidate
    30	    @rows = OrderProposal.validated.includes(:instrument).order(:id).map do |proposal|
    31	      context = Guardrails::Context.new(proposal.account)
    32	      [ proposal, proposal.guardrail_results.dig(rule.rule_type, "outcome"), Guardrails::Rule.for(rule.rule_type).new(rule: candidate, proposal: proposal, context: context).call ]
    33	    end
    34	    render :preview
    35	  end
    36	
    37	  private
    38	    def halted? = SystemSettings.instance.manual_halt? || SystemSettings.instance.rule_halted?
    39	
    40	    def rule_params(rule)
    41	      keys = (rule.params.keys + Array(RiskRule::REQUIRED_PARAMS[rule.rule_type])).uniq
    42	      keys.to_h { |key| [ key, params.dig(:params, key).to_s.strip ] }.compact_blank
    43	    end
    44	end

