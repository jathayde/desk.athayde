     1	# A guardrail as data (docs/phase-2-plan.md §0.8): one active row per type and setup, edited by superseding,
     2	# never in place, so every proposal's results point at the exact version that judged it.
     3	class RiskRule < ApplicationRecord
     4	  TYPES = %w[ max_risk_per_trade max_positions max_position_exposure max_sector_exposure daily_loss_halt max_drawdown_halt
     5	              earnings_blackout wash_sale notional_cap stop_collar ].freeze
     6	  REQUIRED_PARAMS = { "max_risk_per_trade" => %w[ percent ], "max_positions" => %w[ count ], "max_position_exposure" => %w[ percent ],
     7	                      "daily_loss_halt" => %w[ percent ], "max_drawdown_halt" => %w[ percent ], "notional_cap" => %w[ per_order per_day ] }.freeze
     8	
     9	  belongs_to :setup, optional: true
    10	  belongs_to :superseded_by, class_name: "RiskRule", optional: true
    11	  belongs_to :changed_by, class_name: "User", optional: true
    12	
    13	  enum :mode, { block: "block", warn: "warn" }, prefix: true
    14	
    15	  validates :rule_type, inclusion: { in: TYPES }
    16	  validate :required_params_present
    17	
    18	  scope :active, -> { where(active: true) }
    19	
    20	  def self.active_for(rule_type, setup: nil) = active.find_by(rule_type: rule_type, setup: setup) || (setup && active.find_by(rule_type: rule_type, setup: nil))
    21	
    22	  # The next version of this rule, superseding this one, in one transaction and one audit row.
    23	  def supersede!(params:, user:, mode: self.mode, note: nil)
    24	    transaction do
    25	      update!(active: false) # first, so the one-active index admits the successor
    26	      successor = self.class.create!(rule_type: rule_type, setup: setup, params: params, mode: mode, note: note, version: version + 1, changed_by: user)
    27	      update!(superseded_by: successor)
    28	      AuditEvent.log("rule_changed", actor: :human, user: user, subject: successor, reason: note, data: { rule_type: rule_type, setup: setup&.name, before: self.params, after: params, version: successor.version })
    29	      successor
    30	    end
    31	  end
    32	
    33	  def param(name) = params.fetch(name.to_s) { raise KeyError, "#{rule_type} rule has no #{name}" }
    34	
    35	  private
    36	    def required_params_present
    37	      missing = REQUIRED_PARAMS.fetch(rule_type.to_s, []).reject { |key| params.to_h[key].present? }
    38	      errors.add(:params, "is missing #{missing.to_sentence}") if missing.any?
    39	    end
    40	end

