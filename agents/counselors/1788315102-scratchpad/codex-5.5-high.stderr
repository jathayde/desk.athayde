 succeeded in 0ms:
module Schwab
  # GET /accounts/{hash}?fields=positions, mapped.
  AccountSummary = Data.define(:account_type, :positions, :balances, :raw) do
    def self.from(raw)
      account = raw.fetch("securitiesAccount") { raise MappingError, "securitiesAccount missing" }
      new(account_type: account["type"],
          positions: Array(account["positions"]).map { |p| Position.from(p) },
          balances: Balances.from(account["currentBalances"]),
          raw: raw)
    end

    # The account-level payload without the positions array, which is large and lives on the position rows.
    def raw_without_positions = raw.deep_dup.tap { |r| r["securitiesAccount"]&.delete("positions") }
  end
end
module Schwab
  Position = Data.define(:instrument, :quantity, :average_price, :market_value, :cost_basis, :raw) do
    def cash_equivalent? = instrument&.asset_type == "CASH_EQUIVALENT"

    def self.from(raw)
      quantity = Decimal.parse_or_zero(raw["longQuantity"]) - Decimal.parse_or_zero(raw["shortQuantity"])
      new(instrument: InstrumentRef.from(raw.fetch("instrument") { raise MappingError, "position without instrument" }),
          quantity: quantity, average_price: Decimal.parse(raw["averagePrice"]), market_value: Decimal.parse(raw["marketValue"]),
          cost_basis: Decimal.parse(raw["averagePrice"])&.*(quantity), raw: raw)
    end
  end
end
module Schwab
  # The instrument block that appears on positions, order legs, transfer items, and quotes.
  # nil when the block is absent (container orders with no legs).
  InstrumentRef = Data.define(:symbol, :cusip, :instrument_id, :asset_type, :description) do
    def self.from(raw)
      return nil if raw.blank?
      new(symbol: raw["symbol"], cusip: raw["cusip"].presence, instrument_id: raw["instrumentId"],
          asset_type: raw["assetType"], description: raw["description"])
    end

    def currency? = asset_type == "CURRENCY"
  end
end
module Schwab
  # JSON floats through Float drift; every money and quantity value goes through here.
  module Decimal
    ZERO = BigDecimal("0")

    def self.parse(value)
      return nil if value.nil? || value == ""
      BigDecimal(value.to_s)
    rescue ArgumentError
      nil
    end

    def self.parse_or_zero(value) = parse(value) || ZERO
  end
end

