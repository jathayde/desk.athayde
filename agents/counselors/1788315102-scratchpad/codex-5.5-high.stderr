class TradesController < ApplicationController
  FILTERS = {
    "open" => [ "Open", "No open trades." ],
    "closed" => [ "Closed", "No closed trades." ],
    "needs_review" => [ "Needs review", "Nothing waiting on you." ],
    "missing_post_mortem" => [ "Missing post-mortem", "Every closed trade has its post-mortem." ]
  }.freeze

  def index
    @filter = params[:filter].presence_in(FILTERS.keys) || "open"
    @trades = Trade.listing(@filter).includes(:instrument, :setup)
    @review_count = Trade.needing_review.count
  end

  def show
    @trade = Trade.find(params[:id])
    @position = @trade.open? ? @trade.account.positions.find_by(instrument: @trade.instrument) : nil
  end

  # The 30-second post-mortem: one line plus followed or improvised.
  def update
    @trade = Trade.find(params[:id])
    if params[:post_mortem].to_s.strip.blank? || params[:followed_setup].nil?
      return redirect_to trade_path(@trade), alert: "One line and a followed-or-improvised choice, both required."
    end
    @trade.update!(post_mortem: params[:post_mortem], followed_setup: params[:followed_setup] == "1")
    redirect_to trade_path(@trade), notice: "Saved."
  end
end
class Trades::ReviewsController < ApplicationController
  include ReviewFlow

  before_action :set_trade

  def show
    @queue = Trade.review_queue.excluding(@trade)
    @setups = Setup.active.order(:name)
    @position = @trade.account.positions.find_by(instrument: @trade.instrument)
  end

  def update
    if @trade.review(setup: chosen_setup, planned_stop: planned_stop, thesis: params[:thesis], user: Current.user)
      redirect_to next_review_path(@trade), notice: "Reviewed #{@trade.instrument.symbol}."
    else
      flash.now[:alert] = @trade.errors.full_messages.to_sentence
      show
      render :show, status: :unprocessable_content
    end
  end

  private
    def set_trade = @trade = Trade.find(params[:trade_id])
    def chosen_setup = Setup.find_by(id: params[:setup_id]) || Setup.named(params[:new_setup])
    # Garbage is nil, never zero: a zero stop would manufacture a fake R.
    def planned_stop = BigDecimal(params[:planned_stop].to_s.strip, exception: false)
end
class Trades::ExclusionsController < ApplicationController
  include ReviewFlow

  def create
    trade = Trade.find(params[:trade_id])
    trade.exclude!(user: Current.user)
    redirect_to next_review_path(trade), notice: "#{trade.instrument.symbol} marked not a setup trade."
  end
end
class Trades::DeferralsController < ApplicationController
  include ReviewFlow

  def create
    trade = Trade.find(params[:trade_id])
    trade.defer_review!
    redirect_to next_review_path(trade)
  end
end

