<% content_for :title, "Dashboard" %>
<% dashboard = @dashboard %>

<%= render "dashboard/banner", dashboard: dashboard %>

<% case dashboard.state
   when :not_connected %>
  <%= render "empty_state", heading: "Connect Schwab", body: "Nothing is synced until Schwab is connected. The connection lasts seven days; the Sunday email will remind you to renew it.", cta: "Connect Schwab", path: schwab_authorize_path %>
<% when :waiting_for_accounts %>
  <%= render "empty_state", heading: "Discovering accounts", body: "Schwab is connected. Accounts arrive on the first sync, within a few minutes.", cta: "Sync status", path: system_path %>
<% when :needs_setup %>
  <%= render "empty_state", heading: "Set up the trading account", body: "Accounts have synced but none is enabled for trading yet. Classify the taxable account and enable it on the System page; nothing journals until then.", cta: "Go to System", path: system_path %>
<% when :waiting_first_sync %>
  <%= render "empty_state", heading: "Waiting for the first sync", body: "#{dashboard.account.label} is enabled. Positions and balances arrive on the next tick, within a few minutes.", cta: "Sync status", path: system_path %>
<% else %>
  <%= render "dashboard/glance", dashboard: dashboard %>
<% end %>
<% case dashboard.banner
   when :halted %>
  <div class="banner halted">
    <b>Halted</b><% if dashboard.halted_by %> by <%= dashboard.halted_by.user&.name %>, <%= l(dashboard.halted_by.created_at, format: :weekday_time) %><% end %>: <%= dashboard.halt_reason %>.
    Clear it on the <%= link_to "System page", system_path %>.
  </div>
<% when :revoked %>
  <div class="banner expired"><b>Schwab rejected the connection.</b> <%= dashboard.token.last_refresh_error %> Sync is paused. <%= link_to "Re-authenticate with Schwab", schwab_authorize_path, class: "button" %></div>
<% when :expired %>
  <div class="banner expired"><b>Token expired.</b> Sync paused<% if dashboard.sync_paused_since %> since <%= l(dashboard.sync_paused_since, format: :weekday_time) %><% end %>. Every number below carries its age. <%= link_to "Re-authenticate with Schwab", schwab_authorize_path, class: "button" %></div>
<% when :expiring %>
  <div class="banner expiring"><b>Token expires <%= l(dashboard.token.refresh_expires_at, format: :weekday_time) %>.</b> <%= link_to "Re-authenticate now", schwab_authorize_path %><% if dashboard.token.covered_by_sunday_email? %>, or wait for Sunday's email<% end %>.</div>
<% end %>
<% dashboard.secondary_statuses.each do |status| %>
  <p class="status-line">
    <% case status
       when :revoked, :expired, :missing %>Schwab connection is down; <%= link_to "re-authenticate", schwab_authorize_path %>.
    <% when :expiring %>Token expires <%= l(dashboard.token.refresh_expires_at, format: :weekday_time) %>; <%= link_to "re-authenticate", schwab_authorize_path %>.
    <% when :sync_paused %>Sync paused: <%= dashboard.sync_paused_reason %>.
    <% when :sync_failed %>Last <%= dashboard.sync_failure.feed %> sync failed: <%= dashboard.sync_failure.error.to_s.truncate(100) %>.
    <% when :calendar_fallback %>Market calendar unavailable from Schwab today; assuming a normal session.
    <% end %>
  </p>
<% end %>
<section class="hero">
  <div class="stat">
    <span class="lbl">Equity</span>
    <span class="num"><%= money(dashboard.equity) %></span>
    <span class="sub">
      <% if dashboard.day_change %><%= signed_money(dashboard.day_change) %> (<%= signed_percent(dashboard.day_change_ratio) %>) <%= dashboard.day_change_label %><% else %><%= dashboard.day_change_label %><% end %>
      · <%= as_of(dashboard.balance.as_of, stale: dashboard.balance_stale?) %>
    </span>
  </div>
  <div class="stat">
    <span class="lbl">Open risk</span>
    <span class="num"><%= percent(dashboard.open_risk_ratio) %></span>
    <span class="sub"><%= money(dashboard.open_risk) %> on protected positions<% if dashboard.excluded_by_reason.any? %>; excludes <%= excluded_summary(dashboard.excluded_by_reason) %><% end %></span>
  </div>
</section>

<dl class="kv-list">
  <div class="kv"><dt>Settled / unsettled cash</dt><dd><%= money(dashboard.balance.settled_cash) %> / <%= money(dashboard.balance.unsettled_cash) %></dd></div>
  <% if dashboard.review_count.positive? %>
    <div class="kv callout"><dt><%= pluralize(dashboard.review_count, "trade") %> <%= dashboard.review_count == 1 ? "needs" : "need" %> review</dt><dd><%= link_to "Review now", trades_path(filter: "needs_review") %></dd></div>
  <% end %>
  <div class="kv muted"><dt>Proposals</dt><dd>Phase 2</dd></div>
</dl>

<section>
  <h2 class="sec">Positions</h2>
  <% if dashboard.rows.empty? %>
    <p class="empty">No open positions. All cash.</p>
  <% else %>
    <ul class="positions">
      <% dashboard.rows.each do |row| %>
        <% position = row.position %>
        <li class="pos <%= row.protection == :protected ? "protected" : "at-risk" %>">
          <div class="top">
            <span><%= row.trade ? link_to(position.instrument.symbol, trade_path(row.trade)) : position.instrument.symbol %> · <%= quantity(position.quantity) %></span>
            <span class="primary"><% if position.distance_to_stop %><%= percent(position.distance_to_stop) %> to stop<% else %><%= protection_label(row.protection) %><% end %></span>
          </div>
          <div class="sub">
            <span>in @ <%= money(position.average_price) %><% if row.protection != :protected && position.distance_to_stop %> · <em class="warn"><%= protection_label(row.protection) %></em><% end %></span>
            <span><%= signed_money(position.unrealized_pnl) %> · <%= as_of(row.as_of, stale: row.stale) %></span>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

