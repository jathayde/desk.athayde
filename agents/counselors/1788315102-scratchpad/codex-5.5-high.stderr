# The registry and the one dispatch entry point every transport uses.
module Agent::Tools
  Result = Data.define(:value, :error, :retry_after) do
    def self.success(value) = new(value: value, error: nil, retry_after: nil)
    def self.failure(error, retry_after: nil) = new(value: nil, error: error, retry_after: retry_after)
    def ok? = error.nil?
    # The text a model reads: the JSON on success, the message on failure.
    def text = ok? ? JSON.generate(value) : error
  end

  def self.all = [ GetPortfolio, GetAccountHealth, GetQuotes, GetPriceHistory, GetJournal, GetSetupStats, GetRiskRules ]

  def self.for(transport)
    case transport.to_sym
    when :mcp then all.select(&:mcp_allowed?)
    when :scheduled then all.select { |t| t.scheduled_allowed? && t.read_only? }
    else raise ArgumentError, "unknown transport #{transport}"
    end
  end

  def self.definitions(transport) = self.for(transport).map(&:definition)
  def self.find(name, transport:) = self.for(transport).find { |t| t.tool_name == name.to_s }

  # Permission check, argument validation, telemetry, timing, and error normalization in one place.
  # Never raises to the caller: Schwab and tool failures become results the agent can read and act on.
  # Every call writes a tool_calls row, including a call the transport is not allowed to make.
  def self.call(name, arguments = {}, transport:, agent_run: nil)
    arguments = arguments.to_h.deep_symbolize_keys
    record = ToolCall.new(agent_run: agent_run, transport: transport, tool_name: name.to_s, arguments: Agent.serialize(arguments))
    started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    result = if (tool = find(name, transport: transport))
      invoke(tool, arguments)
    elsif all.any? { |t| t.tool_name == name.to_s }
      Result.failure("#{name} is not available on the #{transport} transport")
    else
      Result.failure("unknown tool #{name}")
    end
    record.duration_ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round
    record.error = result.error
    record.save!
    result
  end

  def self.invoke(tool, arguments)
    tool.validate!(arguments)
    Result.success(Agent.serialize(tool.new.call(**arguments)))
  rescue Schwab::RateLimited => e
    Result.failure("Schwab rate limit: try again in #{e.retry_after || 60} seconds", retry_after: e.retry_after || 60)
  rescue Schwab::NoUsableToken, Schwab::AuthError => e
    Result.failure("Schwab connection needs re-authentication: #{e.message}")
  rescue Schwab::Error => e
    Result.failure("Schwab unavailable: #{e.message}")
  rescue Agent::Tool::InvalidArguments => e
    Result.failure("bad arguments: #{e.message}")
  rescue StandardError, NotImplementedError => e # NotImplementedError is a ScriptError: the base class's own contract
    Rails.error.report(e, handled: true, context: { tool: tool.tool_name })
    Result.failure("#{tool.tool_name} failed: #{e.class.name}")
  end
  private_class_method :invoke
end
# A read tool: a name derived from the class, a description, JSON schemas, permission metadata, and a call.
# Transport-neutral: the MCP adapter and the scheduled runtime both go through Agent::Tools.call.
class Agent::Tool
  # Raised by a tool for arguments the schema cannot catch; reported to the agent as its own mistake.
  class InvalidArguments < ArgumentError; end

  class << self
    attr_reader :description, :input_schema, :output_schema

    # Every output key is required unless listed in output_optional; a half-declared schema is worse than none.
    def tool(description:, output:, input: {}, required: [], output_optional: [], read_only: true, mcp: true, scheduled: true)
      @description = description
      @input_schema = { type: "object", properties: input, required: required.map(&:to_s), additionalProperties: false }
      @output_schema = { type: "object", properties: output, required: (output.keys - output_optional).map(&:to_s), additionalProperties: false }
      @read_only, @mcp_allowed, @scheduled_allowed = read_only, mcp, scheduled
      raise ArgumentError, "#{tool_name}: an unattended tool must be read-only" if scheduled && !read_only
    end

    def tool_name = @tool_name ||= name.to_s.demodulize.underscore.presence || "anonymous"
    def read_only? = @read_only
    def mcp_allowed? = @mcp_allowed
    def scheduled_allowed? = @scheduled_allowed

    def annotations = { read_only_hint: read_only?, destructive_hint: !read_only?, idempotent_hint: read_only?, open_world_hint: false }

    # The shape the Anthropic Messages API and the MCP gem both consume.
    def definition = { name: tool_name, description: description, input_schema: input_schema }

    # One gate for both transports, so the scheduled runtime gets the same checks the MCP gem applies.
    def validate!(arguments)
      validator.validate_arguments(arguments)
    rescue MCP::Tool::InputSchema::ValidationError => e
      raise InvalidArguments, e.message
    end

    private
      def validator = @validator ||= MCP::Tool::InputSchema.new(input_schema)
  end

  def call(**) = raise(NotImplementedError, "#{self.class.tool_name} does not implement #call")
end
# Builds the MCP server from the registry: the gem's Tool classes are thin adapters over Agent::Tools.call.
module Agent::McpServer
  VERSION = "1.0.0"

  def self.build
    MCP::Server.new(name: "athayde-desk", version: VERSION, tools: tools, capabilities: { tools: {} },
                    instructions: "Read-only tools over the Athayde trading desk. Numbers carry as_of and stale; null risk means unknown, never zero.",
                    configuration: MCP::Configuration.new(validate_tool_call_arguments: true, validate_tool_call_results: !Rails.env.production?,
                                                          exception_reporter: ->(e, context) { Rails.error.report(e, handled: true, context: context.to_h) }))
  end

  def self.tools
    @tools ||= Agent::Tools.for(:mcp).map do |tool|
      MCP::Tool.define(name: tool.tool_name, description: tool.description, input_schema: tool.input_schema, output_schema: tool.output_schema,
                       annotations: tool.annotations) do |server_context: nil, **arguments|
        result = Agent::Tools.call(tool.tool_name, arguments, transport: :mcp)
        if result.ok?
          MCP::Tool::Response.new([ { type: "text", text: result.text } ], structured_content: result.value)
        else
          MCP::Tool::Response.new([ { type: "text", text: result.text } ], error: true, meta: { retry_after: result.retry_after }.compact.presence)
        end
      end
    end
  end
end

