# One row, enforced by a check constraint on id = 1. Holds the global flags the PRD calls out:
# shadow mode (on by default), the manual halt, and why sync is paused.
class SystemSettings < ApplicationRecord
  def self.instance = find_or_create_by!(id: 1)

  def halted? = manual_halt
end
class CreateSystemSettings < ActiveRecord::Migration[8.1]
  def change
    create_table :system_settings do |t|
      t.boolean :shadow_mode, null: false, default: true
      t.boolean :manual_halt, null: false, default: false
      t.text :manual_halt_reason
      t.datetime :manual_halt_at
      t.string :sync_paused_reason

      t.timestamps
      t.check_constraint "id = 1", name: "system_settings_singleton"
    end
  end
end

