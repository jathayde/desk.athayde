class OrderProposal < ApplicationRecord
  belongs_to :account
  belongs_to :instrument
  belongs_to :target_order, class_name: "Order", optional: true
  belongs_to :user, optional: true
  belongs_to :setup, optional: true
  has_many :orders, dependent: :restrict_with_exception
  has_many :submission_attempts, dependent: :restrict_with_exception
  has_one :trade, dependent: :restrict_with_exception

  enum :kind, { entry: "entry", exit: "exit", stop_adjustment: "stop_adjustment" }, prefix: true
  enum :origin, { agent: "agent", human: "human" }
  enum :status, {
    proposed: "proposed", validated: "validated", rejected: "rejected", approved: "approved",
    submitted: "submitted", submission_unknown: "submission_unknown", filled: "filled", cancelled: "cancelled"
  }
end
class SubmissionAttempt < ApplicationRecord
  belongs_to :order_proposal
  belongs_to :reconciled_order, class_name: "Order", optional: true

  enum :outcome, { submitted: "submitted", unknown: "unknown", failed: "failed", reconciled: "reconciled", shadowed: "shadowed" }
end
class RiskRule < ApplicationRecord
  belongs_to :setup, optional: true
  belongs_to :superseded_by, class_name: "RiskRule", optional: true

  scope :active, -> { where(active: true) }
end
# Append-only. Every "logged" action in the PRD is a row here; the database triggers reject
# UPDATE, DELETE, and TRUNCATE, and Active Record refuses updates before it gets that far.
class AuditEvent < ApplicationRecord
  KINDS = %w[
    re_auth_succeeded re_auth_failed token_refresh_failed sync_paused_token_expired sync_resumed
    token_nag_sent shadow_mode_toggled manual_halt_set manual_halt_cleared
    instrument_identity_fallback sync_gap_unrecoverable trade_reviewed account_configured
  ].freeze

  belongs_to :user, optional: true
  belongs_to :subject, polymorphic: true, optional: true

  enum :actor, { human: "human", system: "system", agent: "agent" }, prefix: true

  validates :kind, inclusion: { in: KINDS }

  def self.log(kind, actor:, data: {}, user: nil, subject: nil, reason: nil)
    create!(kind: kind, actor: actor, user: user, subject: subject, reason: reason, data: data)
  end

  def readonly? = persisted?
end

