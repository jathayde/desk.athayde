class SessionsController < ApplicationController
  allow_unauthenticated_access only: %i[ new create ]
  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { redirect_to new_session_path, alert: "Try again later." }

  def new
  end

  def create
    User.find_by(email_address: params.expect(:email_address))&.send_magic_link
    redirect_to new_session_path, notice: "If that address has access, a sign-in link is on its way."
  end

  def destroy
    terminate_session
    redirect_to new_session_path, status: :see_other
  end
end
# The emailed URL lands on a page with no side effects, so mail scanners and link previews
# cannot consume the link. Only the POST from that page signs the user in.
class MagicLinksController < ApplicationController
  allow_unauthenticated_access

  def show
    @token = params.expect(:token)
  end

  def create
    if user = User.consume_magic_link(params.expect(:token))
      start_new_session_for user
      redirect_to after_authentication_url
    else
      redirect_to new_session_path, alert: "That sign-in link is invalid or has expired. Request a new one."
    end
  end
end
class MagicLinkMailer < ApplicationMailer
  def sign_in(user)
    @user = user
    @url = magic_link_url(token: user.magic_link_token)
    mail to: user.email_address, subject: "Your Athayde Desk sign-in link"
  end
end
