    26	      # Whatever raises, the row ends failed with the reason and the email still goes out before the queue hears about it.
    27	      def converse(run)
    28	        Agent::Run.new(run).perform
    29	      rescue StandardError => e
    30	        run.finish!(:failed, error: "#{e.class}: #{e.message.truncate(300)}") if run.reload.running?
    31	        run.deliver!
    32	        raise
    33	      end
    34	
    35	      # A brief reading positions mid-upsert, or memory files mid-pull, would see mixed stamps; give live runs a bounded head start.
    36	      def wait_for_sync
    37	        deadline = Time.current + WAIT_FOR_SYNC
    38	        while SyncRun.live.where(feed: WAITED_FEEDS).exists? && Time.current < deadline
    39	          sleep POLL
    40	        end

