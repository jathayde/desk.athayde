class Agent::Tools::GetPriceHistory < Agent::Tool
  tool description: "Daily or weekly candles for one symbol over a preset range (1m, 3m, 6m, 1y daily; 2y, 5y weekly), cached five minutes. " \
                    "Candle dates are New York trading days; includes the previous close when Schwab supplies one.",
       input: { symbol: { type: "string", minLength: 1 }, range: { type: "string", enum: Agent::MarketData::RANGES.keys, default: "3m" } },
       required: [ :symbol ],
       output: { symbol: { type: "string" }, range: { type: "string" }, candles: { type: "array", items: { type: "object" } },
                 previous_close: { type: [ "string", "null" ] }, empty: { type: "boolean" }, fetched_at: { type: "string" },
                 stale: { type: "boolean" }, warning: { type: "string" } },
       output_optional: [ :warning ]

  def call(symbol:, range: "3m") = Agent::MarketData.price_history(symbol, range: range)
end

### app/models/agent/tools/get_quotes.rb
class Agent::Tools::GetQuotes < Agent::Tool
  MAX_SYMBOLS = 50

  tool description: "Live quotes for up to 50 symbols from Schwab, cached for two minutes. Unknown symbols are listed in invalid_symbols. " \
                    "When Schwab is unavailable the last cached quote is returned with stale: true and a warning; symbols with no cached " \
                    "quote are listed in unavailable_symbols.",
       input: { symbols: { type: "array", items: { type: "string" }, minItems: 1, maxItems: MAX_SYMBOLS, description: "Ticker symbols" } },
       required: [ :symbols ],
       output: { quotes: { type: "array", items: { type: "object" } }, invalid_symbols: { type: "array", items: { type: "string" } },
                 unavailable_symbols: { type: "array", items: { type: "string" } }, warning: { type: [ "string", "null" ] } }

  def call(symbols:)
    symbols = symbols.map { |s| s.to_s.strip.upcase }.reject(&:blank?).uniq
    raise InvalidArguments, "symbols must be 1 to #{MAX_SYMBOLS} tickers" unless symbols.size.between?(1, MAX_SYMBOLS)
    Agent::MarketData.quotes(symbols)
  end
end

### app/models/agent/tools/get_risk_rules.rb
class Agent::Tools::GetRiskRules < Agent::Tool
  tool description: "The active guardrail rules. The guardrail engine ships in Phase 2; until then this returns no rules and available: false, " \
                    "which means unknown, not unlimited.",
       output: { rules: { type: "array", items: { type: "object" } }, available: { type: "boolean" }, phase: { type: "integer" } }

  # Phase 1 has no guardrail engine, so no rows are read: a rule row without an engine would be a lie to the agent.
  def call = { available: false, phase: 1, rules: [] }
end

### app/models/agent/tools/get_setup_stats.rb
class Agent::Tools::GetSetupStats < Agent::Tool
  tool description: "Per-setup expectancy over closed, reviewed, included trades with a positive initial risk (legacy holdings and excluded trades " \
                    "never count). A win is R above zero. Treat a small sample_size as no evidence.",
       output: { setups: { type: "array", items: { type: "object" } }, eligibility: { type: "string" } }

  def call
    { setups: Setup.order(:name).map { |s| { name: s.name, active: s.active?, definition: s.definition, sample_size: s.sample_size, win_rate: s.win_rate,
                                             avg_r: s.avg_r, expectancy: s.expectancy, stats_computed_at: s.stats_computed_at } },
      eligibility: "closed, reviewed, not excluded, not bootstrapped, initial_risk > 0" }
  end
end

