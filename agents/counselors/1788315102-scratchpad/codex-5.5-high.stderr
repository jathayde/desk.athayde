     2	  # The only scheduled sync entry point. Refreshes the calendar, checks the token once, and enqueues what is due.
     3	  class TickJob < ApplicationJob
     4	    INTRADAY = { positions: 15.minutes, orders: 5.minutes, activities: 5.minutes }.freeze
     5	    OFF_HOURS = 60.minutes
