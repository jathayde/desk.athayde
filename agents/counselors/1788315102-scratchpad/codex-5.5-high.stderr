# Solid Queue recurring tasks. Cron with an explicit zone so a config.time_zone change cannot shift them,
# and because Solid Queue skips a schedule it cannot parse without failing boot (spec/config/recurring_spec.rb).
shared: &shared
  schwab_refresh_access_token:
    class: Schwab::RefreshAccessTokenJob
    queue: critical
    schedule: "*/25 * * * * America/New_York"
  schwab_token_health:
    class: Schwab::TokenHealthJob
    schedule: "0 8,20 * * * America/New_York"
  sync_tick:
    class: Sync::TickJob
    schedule: "*/5 * * * * America/New_York"
  sync_accounts:
    class: Sync::AccountsJob
    schedule: "5 6 * * * America/New_York"
  agent_morning_brief:
    class: Agent::MorningBriefJob
    schedule: "3 7 * * 1-5 America/New_York" # after the 07:00 tick has enqueued the syncs
  agent_end_of_day:
    class: Agent::EndOfDayJob
    schedule: "30 16 * * 1-5 America/New_York"
  agent_sunday_review:
    class: Agent::SundayReviewJob
    schedule: "0 18 * * 0 America/New_York"
  memory_check_repo:
    class: Memory::CheckRepoJob
    schedule: "*/30 * * * * America/New_York"
  failure_digest:
    class: Jobs::FailureDigestJob
    schedule: "15 17 * * * America/New_York"

development:
  <<: *shared

production:
  <<: *shared
Rails.application.routes.draw do
  root "dashboard#show"

  match "/mcp", to: "mcp#handle", via: %i[ post get delete ]

  resource :system, only: :show, controller: "system" do
    post :halt
    post :resume
  end
  resources :accounts, only: :update
  resources :trades, only: %i[ index show update ] do
    scope module: :trades do
      resource :review, only: %i[ show update ]
      resource :exclusion, only: :create
      resource :deferral, only: :create
    end
  end

  resource :session, only: %i[ new create destroy ]
  resource :magic_link, only: %i[ show create ]

  get "schwab/authorize", to: "schwab#authorize"
  get "schwab/callback", to: "schwab#callback"
  get "schwab/connected", to: "schwab#connected"
  get "schwab/fake_authorize", to: "schwab#fake_authorize"

  get "playwright/scenarios/:name", to: "playwright/scenarios#show", as: :playwright_scenario if Rails.env.test?

  get "up" => "rails/health#show", as: :rails_health_check
  get "manifest" => "rails/pwa#manifest", as: :pwa_manifest
end
