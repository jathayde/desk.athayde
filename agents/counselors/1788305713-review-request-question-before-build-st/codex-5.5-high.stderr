# One instrument's position lifecycle from zero back to zero. Every aggregate here is a pure function of
# the legs, recomputed after any leg changes; nothing is updated incrementally.
class Trade < ApplicationRecord
  DIVIDEND_AFTER_CLOSE_WINDOW = 90.days

  belongs_to :account
  belongs_to :instrument
  belongs_to :setup, optional: true
  belongs_to :order_proposal, optional: true
  has_many :trade_legs, dependent: :destroy

  enum :status, { open: "open", closed: "closed" }
  enum :review_reason, {
    missing_setup: "missing_setup", missing_stop: "missing_stop", bootstrapped: "bootstrapped",
    ordering_ambiguous: "ordering_ambiguous", corporate_action: "corporate_action", position_missing: "position_missing"
  }, prefix: :review, validate: { allow_nil: true }

  normalizes :post_mortem, with: ->(text) { text.presence }

  scope :needing_review, -> { where(needs_review: true) }
  scope :missing_post_mortem, -> { closed.where(post_mortem: nil, needs_review: false, excluded_from_stats: false) }
  scope :eligible_for_stats, -> { closed.where(needs_review: false, excluded_from_stats: false).where("initial_risk > 0") }

  def realized_r_available? = initial_risk.present? && initial_risk.positive?

  # Reasons in order of seriousness; a more serious reason replaces a lesser one, never the reverse.
  REVIEW_PRIORITY = %w[ corporate_action ordering_ambiguous position_missing bootstrapped missing_stop missing_setup ].freeze

  def flag!(reason)
    reason = reason.to_s
    return if needs_review? && review_reason.present? && REVIEW_PRIORITY.index(review_reason) <= REVIEW_PRIORITY.index(reason)
    update!(needs_review: true, review_reason: reason)
  end

  # The synthetic entry leg that reconciles the journal to the broker: quantity = broker quantity minus the net
  # of the linked fill legs. Recomputed after every bootstrap and link run, deleted when it reaches zero.
  def reconcile_plug!(broker_quantity, average_price:)
    linked = trade_legs.where.not(activity_id: nil)
    net = linked.kind_entry.sum(:quantity) - linked.kind_exit.sum(:quantity)
    plug_quantity = broker_quantity - net
    plug = trade_legs.find_by(activity_id: nil, kind: :entry)
    if plug_quantity.positive?
      (plug || trade_legs.build(kind: :entry, note: "plug")).update!(quantity: plug_quantity, price: average_price, cash_amount: -(plug_quantity * (average_price || 0)))
      update!(bootstrapped: true) unless bootstrapped?
      flag!(:bootstrapped)
    else
      plug&.destroy!
    end
    recompute!
  end

  # Legs in execution order; the plug (no time) sorts first.
  def ordered_legs = trade_legs.order(Arel.sql("executed_at ASC NULLS FIRST"), :id)

  def recompute!
    running = BigDecimal("0"); peak = BigDecimal("0")
    entry_qty = BigDecimal("0"); entry_cost = BigDecimal("0"); exit_qty = BigDecimal("0"); exit_proceeds = BigDecimal("0")
    cash = BigDecimal("0"); closing_leg = nil; first_fill = nil
    ordered_legs.each do |leg|
      case leg.kind.to_sym
      when :entry
        running += leg.quantity; entry_qty += leg.quantity; entry_cost += leg.quantity * (leg.price || 0)
        first_fill ||= leg if leg.activity_id
      when :exit
        running -= leg.quantity; exit_qty += leg.quantity; exit_proceeds += leg.quantity * (leg.price || 0)
        closing_leg = leg if running.zero?
      when :adjustment
        if leg.ratio.present?
          running *= leg.ratio; entry_qty *= leg.ratio; exit_qty *= leg.ratio
        elsif leg.quantity.present?
          running += leg.quantity
        end
      end
      cash += leg.cash_amount || 0
      peak = running if running > peak
    end
    closed = running.zero? && closing_leg.present?
    assign_attributes(
      quantity: running, peak_quantity: peak, status: closed ? :closed : :open, closed_at: closed ? closing_leg.executed_at : nil,
      avg_entry: entry_qty.positive? ? entry_cost / entry_qty : nil, avg_exit: exit_qty.positive? ? exit_proceeds / exit_qty : nil,
      opened_at: opened_at || first_fill&.executed_at,
      initial_quantity: initial_quantity_from(first_fill),
      realized_pnl: closed ? cash : nil
    )
    self.initial_risk = compute_initial_risk
    self.total_risk = compute_total_risk
    self.realized_r = closed && realized_r_available? ? realized_pnl / initial_risk : nil
    save!
  end

  # Called by the review form: the stop and setup are known now, so risk and R can be computed.
  def review!(setup:, planned_stop:, thesis:, user:)
    update!(setup: setup, planned_stop: planned_stop, thesis: thesis, needs_review: false, review_reason: nil, journal_completed_at: Time.current)
    recompute!
    AuditEvent.log("trade_reviewed", actor: :human, user: user, subject: self, data: { setup: setup&.name, planned_stop: planned_stop&.to_s })
    Journal::RecomputeSetupStatsJob.perform_later(setup) if setup
    self
  end

  def exclude!(user:)
    update!(excluded_from_stats: true, needs_review: false, review_reason: nil)
    AuditEvent.log("trade_reviewed", actor: :human, user: user, subject: self, data: { excluded: true })
    Journal::RecomputeSetupStatsJob.perform_later(setup) if setup
  end

  private
    # Every entry fill from the first fill's order (a partial fill is still one entry); without an order id, the first fill alone.
    def initial_quantity_from(first_fill)
      return nil unless first_fill
      legs = ordered_legs.to_a.select(&:activity_id)
      same_order = first_fill.activity&.broker_order_id
      group = same_order ? legs.select { |l| l.kind_entry? && l.activity&.broker_order_id == same_order } : [ first_fill ]
      group.sum(&:quantity)
    end

    # Splits after a leg scale its quantity up and its price down; risk in dollars is unchanged.
    def split_factor_after(leg)
      ordered_legs.to_a.drop_while { |l| l.id != leg.id }.drop(1).select { |l| l.kind_adjustment? && l.ratio }.reduce(BigDecimal("1")) { |f, l| f * l.ratio }
    end

    # Fixed to the initial entry. Nil, never a number, when the stop is unknown, above the entry, or the entry is synthetic.
    def compute_initial_risk
      return nil if planned_stop.blank? || initial_quantity.blank? || initial_quantity.zero?
      first = ordered_legs.find { |l| l.kind_entry? && l.activity_id } or return nil
      factor = split_factor_after(first)
      risk = initial_quantity * ((first.price || 0) - planned_stop * factor)
      risk.positive? ? risk : nil
    end

    def compute_total_risk
      return nil if planned_stop.blank?
      ordered_legs.select { |l| l.kind_entry? && l.price }.sum { |l| [ l.quantity * (l.price - planned_stop * split_factor_after(l)), 0 ].max }
    end
end

