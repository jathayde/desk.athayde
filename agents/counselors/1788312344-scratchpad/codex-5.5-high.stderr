module Agent
  # The shared shape of a scheduled brief: one run per kind and market day, sweep what a killed worker left,
  # skip a closed day with a row that says so, let the 07:00 syncs land, run, then deliver whatever the run
  # produced. A mail failure never costs a second API run: the row is saved first and can be resent.
  class BriefJob < ApplicationJob
    WAIT_FOR_SYNC = 90.seconds
    POLL = 5.seconds

    limits_concurrency to: 1, key: ->(*) { self.class.name }, on_conflict: :discard

    def perform(date = MarketDay.today)
      AgentRun.sweep_stale!
      return if AgentRun.served?(kind, date)
      day = MarketDay.for(date)
      return AgentRun.create!(kind: kind, market_date: date, status: :skipped, started_at: Time.current, finished_at: Time.current, error: "market closed") unless day.trading?
      run = AgentRun.create!(kind: kind, market_date: date, status: :running, started_at: Time.current)
      wait_for_sync
      Agent::Run.new(run).perform
      deliver(run)
    end

    def self.deliver(run)
      BriefMailer.brief(run).deliver_now
      run.update!(emailed_at: Time.current)
    end
    delegate :deliver, to: :class

    private
      def kind = raise(NotImplementedError)

      # A brief reading positions mid-upsert would see mixed as-of stamps; give live feed runs a bounded head start.
      def wait_for_sync
        deadline = Time.current + WAIT_FOR_SYNC
        while SyncRun.live.where(feed: SyncRun::ACCOUNT_FEEDS).exists? && Time.current < deadline
          sleep POLL
        end
      end
  end
end
module Agent
  # 07:00 New York on weekdays; the calendar row decides whether the day trades.
  class MorningBriefJob < BriefJob
    private def kind = :morning_brief
  end
end
module Agent
  # 16:30 New York on weekdays. The day's snapshot usually exists by then; the email says so when it does not.
  class EndOfDayJob < BriefJob
    private def kind = :eod
  end
end
module Agent
  # Phase 1 stub: no API call. The Sunday email is the re-auth link, token age, sync health, job failures,
  # and the stored setup stats; it records a run row so the system page and the digest can see it.
  class SundayReviewJob < ApplicationJob
    limits_concurrency to: 1, key: ->(*) { name }, on_conflict: :discard

    def perform(date = MarketDay.today)
      return if AgentRun.served?(:sunday_review, date)
      run = AgentRun.create!(kind: :sunday_review, market_date: date, status: :succeeded, started_at: Time.current, finished_at: Time.current, tool_turns: 0)
      BriefMailer.sunday_review(run).deliver_now
      run.update!(emailed_at: Time.current)
    end
  end
end

