     1	# Quotes and price history for the tools, cached beyond their freshness window so a Schwab failure can
     2	# still answer with the last known value marked stale. Draws on a ceiling below the shared Schwab budget so a
     3	# chatty session cannot starve sync.
     4	module Agent::MarketData
     5	  QUOTE_FRESH = 2.minutes
     6	  HISTORY_FRESH = 5.minutes
     7	  # Entries hold BigDecimal, TimeWithZone, and symbol keys: fine under the default Marshal serializer,
     8	  # not under message_pack.
     9	  KEEP = 12.hours
    10	  BUDGET_CEILING = 70
    11	  RANGES = {
    12	    "1m" => [ :month, 1, :daily ], "3m" => [ :month, 3, :daily ], "6m" => [ :month, 6, :daily ],
    13	    "1y" => [ :year, 1, :daily ], "2y" => [ :year, 2, :weekly ], "5y" => [ :year, 5, :weekly ]
    14	  }.freeze
    15	
    16	  Fetch = Data.define(:quotes, :invalid_symbols, :error)
    17	
    18	  def self.quotes(symbols)
    19	    symbols = symbols.map { |s| s.to_s.strip.upcase }.reject(&:blank?).uniq
    20	    cutoff = QUOTE_FRESH.ago
    21	    cached = Rails.cache.read_multi(*symbols.map { |s| quote_key(s) })
    22	    missing = symbols.reject { |s| cached[quote_key(s)]&.dig(:fetched_at)&.>(cutoff) }
    23	    fetch = fetch_quotes(missing)
    24	    quotes = symbols.filter_map do |symbol|
    25	      entry = fetch.quotes[symbol] || cached[quote_key(symbol)]
    26	      entry && entry.merge(stale: entry[:fetched_at] <= cutoff)
    27	    end
    28	    raise fetch.error if fetch.error && quotes.empty? # nothing cached to degrade to: the failure is the answer
    29	    unavailable = missing - fetch.quotes.keys - fetch.invalid_symbols - quotes.map { |q| q[:symbol] }
    30	    warning = fetch.error && "Schwab unavailable (#{fetch.error.message}); cached values shown where they exist"
    31	    { quotes: quotes, invalid_symbols: fetch.invalid_symbols, unavailable_symbols: unavailable, warning: warning }
    32	  end
    33	
    34	  def self.price_history(symbol, range:)
    35	    symbol = symbol.to_s.strip.upcase
    36	    key = "agent:history:#{symbol}:#{range}"
    37	    entry = Rails.cache.read(key)
    38	    return entry.merge(stale: false) if entry && entry[:fetched_at] > HISTORY_FRESH.ago
    39	    period_type, period, frequency_type = RANGES.fetch(range.to_s) { raise Agent::Tool::InvalidArguments, "range must be one of #{RANGES.keys.join(', ')}" }
    40	    begin
    41	      history = Schwab::PriceHistory.from(client.price_history(symbol, period_type: period_type, period: period, frequency_type: frequency_type))
    42	      fresh = { symbol: symbol, range: range, candles: history.candles.map(&:to_h), previous_close: history.previous_close, empty: history.empty?, fetched_at: Time.current }
    43	      Rails.cache.write(key, fresh, expires_in: KEEP)
    44	      fresh.merge(stale: false)
    45	    rescue Schwab::RateLimited
    46	      raise # a rate limit is a tool error carrying retry_after, never a degraded answer
    47	    rescue Schwab::Error => e
    48	      raise e unless entry
    49	      entry.merge(stale: true, warning: "Schwab unavailable (#{e.message}); last fetched #{entry[:fetched_at].iso8601}")
    50	    end
    51	  end
    52	
    53	  class << self
    54	    private
    55	      def client = Schwab.client(wait: false, budget: BUDGET_CEILING)
    56	      def quote_key(symbol) = "agent:quote:#{symbol}"
    57	
    58	      def fetch_quotes(symbols)
    59	        return Fetch.new({}, [], nil) if symbols.empty?
    60	        batch = Schwab::Quote.batch(client.quotes(symbols))
    61	        now = Time.current
    62	        quotes = batch.quotes.to_h do |q|
    63	          entry = { symbol: q.symbol, cusip: q.cusip, last: q.last, bid: q.bid, ask: q.ask, mark: q.mark, net_change: q.net_change,
    64	                    net_percent_change: q.net_percent_change, quote_time: q.quote_time, trade_time: q.trade_time, fetched_at: now }
    65	          Rails.cache.write(quote_key(q.symbol), entry, expires_in: KEEP)
    66	          [ q.symbol, entry ]
    67	        end
    68	        Fetch.new(quotes, batch.invalid_symbols, nil)
    69	      rescue Schwab::RateLimited
    70	        raise # a rate limit is a tool error carrying retry_after, never a degraded answer
    71	      rescue Schwab::Error => e
    72	        Fetch.new({}, [], e)
    73	      end
    74	  end
    75	end
     1	# The glance screen's read model: one place that decides the banner, the numbers, and their freshness.
     2	# Everything it reads is already in the database; a page render never calls Schwab.
     3	class Dashboard
     4	  STALE_MULTIPLIER = 2
     5	  Row = Data.define(:position, :protection, :as_of, :stale, :trade)
     6	
     7	  def initialize
     8	    @settings = SystemSettings.instance
     9	    @account = Account.trading.order(:id).first
    10	    @in_session = MarketDay.known_session_open?
    11	  end
    12	
    13	  attr_reader :account
    14	
    15	  def state
    16	    return :not_connected if token_status == :missing
    17	    return :waiting_for_accounts if Account.none?
    18	    return :needs_setup if account.nil?
    19	    return :waiting_first_sync if balance.nil?
    20	    :ready
    21	  end
    22	
    23	  def token_status = @token_status ||= SchwabToken.status
    24	  def token = @token ||= SchwabToken.current
    25	  def halted? = @settings.manual_halt?
    26	  def halt_reason = @settings.manual_halt_reason
    27	  def halted_by = @halted_by ||= AuditEvent.where(kind: "manual_halt_set").order(created_at: :desc).first
    28	  def sync_paused_reason = @settings.sync_paused_reason
    29	
    30	  # The current pause episode, not the first one in history.
    31	  def sync_paused_since
    32	    since = token ? SyncRun.skipped_token.where(started_at: token.issued_at..) : SyncRun.skipped_token
    33	    since.minimum(:started_at)
    34	  end
    35	
    36	  # The primary banner, highest severity first. Everything else active shows as a secondary status line.
    37	  def banner
    38	    return :halted if halted?
    39	    token_status if %i[ revoked expired expiring ].include?(token_status)
    40	  end
    41	
    42	  def secondary_statuses
    43	    statuses = []
    44	    statuses << token_status if halted? && token_status != :healthy
    45	    statuses << :sync_paused if sync_paused_reason.present? && %i[ revoked expired missing ].exclude?(token_status)
    46	    statuses << :sync_failed if sync_failure
    47	    statuses << :calendar_fallback if MarketDay.find_by(date: MarketDay.today)&.fallback?
    48	    statuses
    49	  end
    50	
    51	  # The latest feed failure nothing has succeeded since. Nil until an account exists and the token works.
    52	  def sync_failure
    53	    return @sync_failure if defined?(@sync_failure)
    54	    @sync_failure = account && SchwabToken.usable? ? unresolved_failures.max_by(&:started_at) : nil
    55	  end
    56	
    57	  def ready? = state == :ready
    58	  def balance = @balance ||= account&.current_balance
    59	  def latest_snapshot = @latest_snapshot ||= account && account.snapshots.chronological.last
    60	  def equity = balance&.equity
    61	
    62	  # Flow-adjusted change since the prior snapshot by date, never by recency.
    63	  def prior_snapshot
    64	    return @prior_snapshot if defined?(@prior_snapshot)
    65	    @prior_snapshot = account && account.snapshots.where(as_of: ...MarketDay.today).order(as_of: :desc).first
    66	  end
    67	
    68	  def day_change
    69	    return nil unless equity && prior_snapshot
    70	    equity - Snapshot.net_flows(account, after: prior_snapshot.as_of, through: MarketDay.today) - prior_snapshot.equity
    71	  end
    72	
    73	  def day_change_ratio = day_change && prior_snapshot.equity.positive? ? day_change / prior_snapshot.equity : nil
    74	  def day_change_label = prior_snapshot ? "since #{prior_snapshot.as_of.strftime('%a')} close" : "first snapshot after today's close"
    75	
    76	  def rows
    77	    @rows ||= begin
    78	      trades = account.trades.open.index_by(&:instrument_id)
    79	      account.positions.includes(:instrument, :working_stop_order).map do |position|
    80	        Row.new(position: position, protection: position.protection, as_of: as_of_for(position), stale: stale_row?(position), trade: trades[position.instrument_id])
    81	      end.sort_by { |r| [ r.protection == :protected ? 1 : 0, r.position.distance_to_stop || -BigDecimal("Infinity"), r.position.instrument.symbol ] }
    82	    end
    83	  end
    84	
    85	  def open_risk = rows.select { |r| r.protection == :protected }.sum { |r| r.position.open_risk }
    86	  def open_risk_ratio = equity && equity.positive? ? open_risk / equity : nil
    87	  def excluded_by_reason = rows.reject { |r| r.protection == :protected }.group_by(&:protection).transform_values(&:size)
    88	  def review_count = account ? account.trades.needing_review.count : 0
    89	  def balance_stale? = balance && stale?(balance.as_of, :positions)
    90	  def orders_as_of = @orders_as_of ||= account&.last_sync(:orders)
    91	
    92	  # Stale: older than twice the cadence the tick would use right now plus its minute of slack, or any age once sync is paused.
    93	  def stale?(time, feed)
    94	    return true if time.nil? || sync_paused_reason.present?
    95	    time < Time.current - (sync_interval(feed) * STALE_MULTIPLIER + 1.minute)
    96	  end
    97	
    98	  private
    99	    def sync_interval(feed) = (@intervals ||= {})[feed] ||= account.sync_interval(feed, in_session: @in_session)
   100	
   101	    # A number that depends on a stop depends on the orders feed too, judged by its own cadence.
   102	    def stale_row?(position)
   103	      stale?(position.synced_at, :positions) || (position.working_stop_order.present? && stale?(orders_as_of, :orders))
   104	    end
   105	
   106	    def as_of_for(position) = position.working_stop_order ? [ position.synced_at, orders_as_of ].compact.min : position.synced_at
   107	
   108	    def unresolved_failures
   109	      SyncRun::ACCOUNT_FEEDS.filter_map { |feed| account.last_sync_failure(feed) }.select { |run| unresolved?(run) }
   110	    end
   111	
   112	    # Unresolved: nothing has succeeded on that feed since it failed.
   113	    def unresolved?(run)
   114	      succeeded_at = account.last_sync(run.feed)
   115	      succeeded_at.nil? || run.started_at > succeeded_at
   116	    end
   117	end
     1	# One row per feed run. Wraps the work so token loss, Schwab failures, and quarantined records all
     2	# land as a status; anything else is recorded as failed and re-raised so the queue sees it too.
     3	class SyncRun < ApplicationRecord
     4	  STALE_AFTER = 10.minutes # a running row older than this is a crashed or restarted worker, not a run
     5	  ACCOUNT_FEEDS = %i[ positions orders activities ].freeze
     6	
     7	  belongs_to :account, optional: true
     8	
     9	  enum :feed, {
    10	    accounts: "accounts", positions: "positions", orders: "orders", activities: "activities",
    11	    market_hours: "market_hours", memory_repo: "memory_repo", snapshots: "snapshots"
    12	  }, prefix: true
    13	  enum :status, { running: "running", succeeded: "succeeded", partial: "partial", failed: "failed", skipped_token: "skipped_token" }
    14	
    15	  scope :recent_first, -> { order(started_at: :desc) }
    16	  scope :for, ->(feed, account) { where(feed: feed, account: account) }
    17	  scope :advanced_cursor, -> { where(status: %w[ succeeded partial ]) }
    18	  scope :live, -> { running.where(started_at: STALE_AFTER.ago..) }
    19	
    20	  def self.record(feed, account: nil, window_from: nil, window_to: nil)
    21	    run = create!(feed: feed, account: account, status: :running, started_at: Time.current, window_from: window_from, window_to: window_to)
    22	    outcome = yield run
    23	    run.finish!(outcome == :failed ? :failed : (outcome == :partial || run.unmapped_values.any? ? :partial : :succeeded))
    24	  rescue Schwab::NoUsableToken, Schwab::AuthError => e
    25	    run.finish!(:skipped_token, error: e.message)
    26	  rescue Schwab::Error => e
    27	    run.finish!(:failed, error: e.message)
    28	  rescue StandardError => e
    29	    run.finish!(:failed, error: "#{e.class}: #{e.message}")
    30	    raise
    31	  ensure
    32	    run&.finish!(:failed, error: "left running") if run&.running? && !run.destroyed?
    33	  end
    34	
    35	  def self.last_window_to(feed, account) = self.for(feed, account).advanced_cursor.maximum(:window_to)
    36	  def self.last_started_at(feed, account) = self.for(feed, account).maximum(:started_at)
    37	  def self.running?(feed, account) = self.for(feed, account).live.exists?
    38	
    39	  # Due when nothing is live and the last start is older than the interval, with a minute of slack for cron drift.
    40	  def self.due?(feed, account, every:)
    41	    return false if running?(feed, account)
    42	    last = last_started_at(feed, account)
    43	    last.nil? || last <= (every - 1.minute).ago
    44	  end
    45	
    46	  def finish!(status, error: nil)
    47	    update!(status: status, finished_at: Time.current, error: error&.truncate(1000))
    48	    self
    49	  end
    50	
    51	  def touched(count) = update!(records_touched: records_touched.to_i + count)
    52	
    53	  def quarantine(key, detail)
    54	    unmapped_values[key.to_s] = Array(unmapped_values[key.to_s]) << detail
    55	    save!
    56	  end
    57	end
     1	# The market calendar, one row per date, sourced from Schwab (which serves 7 days back to a year ahead). A fallback row (weekday 9:30 to 16:00 ET)
     2	# drives cadence only and is re-fetched until Schwab answers.
     3	class MarketDay < ApplicationRecord
     4	  ZONE = "America/New_York"
     5	
     6	  enum :source, { schwab: "schwab", fallback: "fallback" }
     7	
     8	  validates :date, uniqueness: true
     9	
    10	  scope :trading, -> { where(trading: true) }
    11	
    12	  def self.today = Time.current.in_time_zone(ZONE).to_date
    13	
    14	  def self.for(date)
    15	    date = date.to_date
    16	    existing = find_by(date: date)
    17	    return existing if existing&.schwab?
    18	    fetch(date) || existing || fallback_for(date)
    19	  end
    20	
    21	  def self.fetch(date)
    22	    hours = Schwab::MarketHours.from(Schwab.client(wait: false).market_hours(date), date: date)
    23	    row = find_or_initialize_by(date: date)
    24	    row.update!(trading: hours.open?, session_opens_at: hours.session_opens_at, regular_opens_at: hours.regular_opens_at,
    25	                regular_closes_at: hours.regular_closes_at, session_closes_at: hours.session_closes_at,
    26	                raw: hours.raw, fetched_at: Time.current, source: :schwab)
    27	    row
    28	  rescue Schwab::Error
    29	    nil
    30	  end
    31	
    32	  def self.fallback_for(date)
    33	    zone = Time.find_zone!(ZONE)
    34	    trading = date.on_weekday?
    35	    create!(date: date, trading: trading, source: :fallback, fetched_at: Time.current,
    36	            session_opens_at: trading ? zone.local(date.year, date.month, date.day, 7) : nil,
    37	            regular_opens_at: trading ? zone.local(date.year, date.month, date.day, 9, 30) : nil,
    38	            regular_closes_at: trading ? zone.local(date.year, date.month, date.day, 16) : nil,
    39	            session_closes_at: trading ? zone.local(date.year, date.month, date.day, 20) : nil)
    40	  rescue ActiveRecord::RecordNotUnique
    41	    find_by!(date: date)
    42	  end
    43	
    44	  def self.session_open?(now = Time.current) = self.for(now.in_time_zone(ZONE).to_date).session_open_at?(now)
    45	
    46	  # For requests: reads the calendar the tick maintains and never fetches. Unknown means closed.
    47	  def self.known_session_open?(now = Time.current) = find_by(date: now.in_time_zone(ZONE).to_date)&.session_open_at?(now) || false
    48	
    49	  def session_open_at?(now) = trading && session_opens_at <= now && now < session_closes_at
    50	  def closed_by?(now) = trading && regular_closes_at <= now
    51	end

