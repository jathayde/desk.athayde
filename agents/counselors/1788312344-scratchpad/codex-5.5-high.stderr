 succeeded in 0ms:
# Solid Queue recurring tasks. Cron with an explicit zone so a config.time_zone change cannot shift them,
# and because Solid Queue skips a schedule it cannot parse without failing boot (spec/config/recurring_spec.rb).
shared: &shared
  schwab_refresh_access_token:
    class: Schwab::RefreshAccessTokenJob
    queue: critical
    schedule: "*/25 * * * * America/New_York"
  schwab_token_health:
    class: Schwab::TokenHealthJob
    schedule: "0 8,20 * * * America/New_York"
  sync_tick:
    class: Sync::TickJob
    schedule: "*/5 * * * * America/New_York"
  sync_accounts:
    class: Sync::AccountsJob
    schedule: "5 6 * * * America/New_York"
  agent_morning_brief:
    class: Agent::MorningBriefJob
    schedule: "0 7 * * 1-5 America/New_York"
  agent_end_of_day:
    class: Agent::EndOfDayJob
    schedule: "30 16 * * 1-5 America/New_York"
  agent_sunday_review:
    class: Agent::SundayReviewJob
    schedule: "0 18 * * 0 America/New_York"
  memory_pull_repo:
    class: Memory::PullRepoJob
    schedule: "*/30 * * * * America/New_York"
  failure_digest:
    class: Jobs::FailureDigestJob
    schedule: "15 17 * * * America/New_York"

development:
  <<: *shared

production:
  <<: *shared
# The scheduled runtime's model client: real in production, scripted everywhere else unless asked otherwise.
adapter = ENV.fetch("ANTHROPIC_ADAPTER") { Rails.env.production? ? "http" : "fake" }.to_sym
raise "ANTHROPIC_ADAPTER=fake is not allowed in production" if Rails.env.production? && adapter == :fake
Rails.application.config.x.agent.adapter = adapter
Rails.application.config.x.memory.repo_path = ENV["MEMORY_REPO_PATH"].presence
namespace :agent do
  desc "Run a brief now: bin/rails agent:brief[morning_brief] or agent:brief[eod]"
  task :brief, [ :kind ] => :environment do |_, args|
    job = { "morning_brief" => Agent::MorningBriefJob, "eod" => Agent::EndOfDayJob }.fetch(args[:kind]) { abort "kind must be morning_brief or eod" }
    job.perform_now
    puts AgentRun.recent_first.first.then { |run| "#{run.title}: #{run.status}#{" (#{run.error})" if run.error}" }
  end

  desc "Resend a stored run's email without calling the API: bin/rails agent:resend[ID]"
  task :resend, [ :id ] => :environment do |_, args|
    run = AgentRun.find(args[:id])
    abort "#{run.title} is #{run.status}; nothing to send" unless run.brief? && !run.running?
    Agent::BriefJob.deliver(run)
    puts "sent #{run.title} to #{User.pluck(:email_address).join(', ')}"
  end
end

