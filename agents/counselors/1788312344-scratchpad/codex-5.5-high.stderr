     1	module Sync
     2	  # The only scheduled sync entry point. Refreshes the calendar, checks the token once, and enqueues what is due.
     3	  class TickJob < ApplicationJob
     4	    INTRADAY = { positions: 15.minutes, orders: 5.minutes, activities: 5.minutes }.freeze
     5	    OFF_HOURS = 60.minutes
     6	    CALENDAR_DAYS = 7
     7	    SNAPSHOT_DELAY = 20.minutes
     8	
     9	    def perform
    10	      refresh_calendar
    11	      return pause! unless SchwabToken.usable?
    12	
    13	      in_session = MarketDay.session_open?
    14	      Account.find_each do |account|
    15	        INTRADAY.each_key do |feed|
    16	          next unless SyncRun.due?(feed, account, every: account.sync_interval(feed, in_session: in_session))
    17	          job_for(feed).perform_later(account)
    18	        end
    19	        Snapshots::DailyJob.perform_later(account, today) if snapshot_due?(account, today)
    20	      end
    21	    end
    22	
    23	    private
    24	      # Once per Schwab-sourced market day, 20 minutes after the regular close, after a positions sync since the close.
    25	      def snapshot_due?(account, date)
    26	        day = MarketDay.find_by(date: date)
    27	        return false unless account.trading_enabled? && day&.schwab? && day.trading? && Time.current >= day.regular_closes_at + SNAPSHOT_DELAY
    28	        return false if account.snapshots.exists?(as_of: date)
    29	        SyncRun.for(:positions, account).advanced_cursor.where(started_at: day.regular_closes_at..).exists?
    30	      end
    31	
    32	      def today = MarketDay.today
    33	
    34	      def refresh_calendar
    35	        (today..today + CALENDAR_DAYS).each { |date| MarketDay.for(date) }
    36	      end
    37	
    38	      # One skipped row per hour and one audit per episode; nothing is enqueued, so the queue cannot grow.
    39	      # The settings row lock serializes this against issue!, so a re-auth landing mid-tick cannot be marked paused.
    40	      def pause!
    41	        reason = SystemSettings.transaction do
    42	          settings = SystemSettings.instance.lock!
    43	          next nil if SchwabToken.usable?
    44	          unless settings.sync_paused_reason
    45	            settings.update!(sync_paused_reason: "Schwab token unusable; re-authenticate")
    46	            AuditEvent.log("sync_paused_token_expired", actor: :system)
    47	          end
    48	          settings.sync_paused_reason
    49	        end
    50	        return if reason.nil? || SyncRun.where(status: :skipped_token, started_at: 1.hour.ago..).exists?
    51	        SyncRun.create!(feed: :positions, status: :skipped_token, started_at: Time.current, finished_at: Time.current, error: reason)
    52	      end
    53	
    54	      def job_for(feed) = { positions: PositionsJob, orders: OrdersJob, activities: ActivitiesJob }.fetch(feed)
    55	  end
    56	end
     1	module Sync
     2	  # Discovers accounts by hash. New ones arrive unclassified and read-only until the operator sets them up.
     3	  class AccountsJob < FeedJob
     4	    def perform
     5	      SyncRun.record(:accounts) do |run|
     6	        hashes = client.account_numbers
     7	        hashes.each { |hash| Account.find_or_create_by!(schwab_hash: hash) }
     8	        run.touched(hashes.size)
     9	      end
    10	    end
    11	  end
    12	end

