     1	module Agent
     2	  # The shared shape of a scheduled brief: one run per kind and market day, sweep what a killed worker left,
     3	  # skip a closed day with a row that says so, let the 07:00 syncs land, run, then deliver whatever the run
     4	  # produced. A mail failure never costs a second API run: the row is saved first and can be resent.
     5	  class BriefJob < ApplicationJob
     6	    WAIT_FOR_SYNC = 90.seconds
     7	    POLL = 5.seconds
     8	
     9	    limits_concurrency to: 1, key: ->(*) { self.class.name }, on_conflict: :discard
    10	
    11	    def perform(date = MarketDay.today)
    12	      AgentRun.sweep_stale!
    13	      return if AgentRun.served?(kind, date)
    14	      day = MarketDay.for(date)
    15	      return AgentRun.create!(kind: kind, market_date: date, status: :skipped, started_at: Time.current, finished_at: Time.current, error: "market closed") unless day.trading?
    16	      run = AgentRun.create!(kind: kind, market_date: date, status: :running, started_at: Time.current)
    17	      wait_for_sync
    18	      Agent::Run.new(run).perform
    19	      deliver(run)
    20	    end
    21	
    22	    def self.deliver(run)
    23	      BriefMailer.brief(run).deliver_now
    24	      run.update!(emailed_at: Time.current)
    25	    end
    26	    delegate :deliver, to: :class
    27	
    28	    private
    29	      def kind = raise(NotImplementedError)
    30	
    31	      # A brief reading positions mid-upsert would see mixed as-of stamps; give live feed runs a bounded head start.
    32	      def wait_for_sync
    33	        deadline = Time.current + WAIT_FOR_SYNC
    34	        while SyncRun.live.where(feed: SyncRun::ACCOUNT_FEEDS).exists? && Time.current < deadline
    35	          sleep POLL
    36	        end
    37	      end
    38	  end
    39	end

