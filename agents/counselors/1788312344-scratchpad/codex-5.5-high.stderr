     1	module Schwab
     2	  # Runs 08:00 and 20:00 ET. Nags when there is no usable token (every run), on Monday and Tuesday when the
     3	  # token will not outlive the coming Sunday email, and once per token when it enters the 24-hour window
     4	  # without the Sunday email covering it.
     5	  class TokenHealthJob < ApplicationJob
     6	    def perform
     7	      token = SchwabToken.current
     8	      reason = nag_reason(token)
     9	      return unless reason
    10	      TokenMailer.nag(reason, token).deliver_now
    11	      AuditEvent.log("token_nag_sent", actor: :system, subject: token, reason: reason.to_s)
    12	    end
    13	
    14	    private
    15	      def nag_reason(token)
    16	        case SchwabToken.status(token)
    17	        when :missing, :revoked, :expired then SchwabToken.status(token)
    18	        else
    19	          return :missed_sunday if missed_sunday?(token)
    20	          :expiring if token.refresh_expiring_soon? && !covered_by_sunday_email?(token) && !already_warned?(token)
    21	        end
    22	      end
    23	
    24	      # A 168-hour token issued before the most recent Sunday email cannot reach the next one.
    25	      def missed_sunday?(token)
    26	        now = Time.current
    27	        return false unless now.monday? || now.tuesday?
    28	        token.issued_at < SchwabToken.most_recent_sunday_email(now)
    29	      end
    30	
    31	      # The weekly ritual already covers a token that lives past the coming Sunday email.
    32	      def covered_by_sunday_email?(token) = token.covered_by_sunday_email?
    33	
    34	      def already_warned?(token)
    35	        AuditEvent.where(kind: "token_nag_sent", subject: token, reason: "expiring").exists?
    36	      end
    37	  end
    38	end
