### app/models/agent/tools/get_account_health.rb
     1	class Agent::Tools::GetAccountHealth < Agent::Tool
     2	  include Agent::Tool::Desk
     3	
     4	  tool description: "System and account health: Schwab token status and expiry, sync status per feed, pause reason, shadow mode, manual halt, " \
     5	                    "equity, settled and unsettled cash, drawdown from the latest snapshot, and unprotected position counts by reason.",
     6	       output: { state: { type: "string" }, shadow_mode: { type: "boolean" }, halted: { type: "boolean" }, halt_reason: { type: [ "string", "null" ] },
     7	                 token: { type: "object" }, sync: { type: "object" }, equity: { type: [ "object", "null" ] }, drawdown: { type: [ "object", "null" ] },
     8	                 unprotected: { type: [ "object", "null" ] }, trades_needing_review: { type: "integer" } }
     9	
    10	  def call
    11	    token = dashboard.token
    12	    {
    13	      state: dashboard.state, shadow_mode: SystemSettings.instance.shadow_mode, halted: dashboard.halted?, halt_reason: dashboard.halt_reason,
    14	      token: { status: dashboard.token_status, issued_at: token&.issued_at, refresh_expires_at: token&.refresh_expires_at,
    15	               next_sunday_email: SchwabToken.next_sunday_email, last_refresh_error: token&.last_refresh_error },
    16	      sync: { paused_reason: dashboard.sync_paused_reason, paused_since: dashboard.sync_paused_since, last_failure: last_failure, feeds: feeds },
    17	      equity: equity, drawdown: drawdown, unprotected: dashboard.ready? ? dashboard.excluded_by_reason : nil,
    18	      trades_needing_review: dashboard.review_count
    19	    }
    20	  end
    21	
    22	  private
    23	    def feeds
    24	      return {} unless account
    25	      SyncRun::ACCOUNT_FEEDS.to_h { |feed| [ feed, { last_success_at: account.last_sync(feed), last_failure: account.last_sync_failure(feed)&.error } ] }
    26	    end
    27	
    28	    def last_failure
    29	      run = dashboard.sync_failure
    30	      run && { feed: run.feed, at: run.started_at, error: run.error }
    31	    end
    32	
    33	    def equity
    34	      balance = dashboard.balance or return nil
    35	      { value: balance.equity, settled_cash: balance.settled_cash, unsettled_cash: balance.unsettled_cash,
    36	        day_change: dashboard.day_change, day_change_label: dashboard.day_change_label, **stamp(balance.as_of, dashboard.balance_stale?) }
    37	    end
    38	
    39	    def drawdown
    40	      snapshot = dashboard.latest_snapshot or return nil
    41	      { as_of: snapshot.as_of, drawdown: snapshot.drawdown, index_value: snapshot.index_value, high_water_index: snapshot.high_water_index }
    42	    end
    43	end

### app/models/agent/tools/get_journal.rb
     1	class Agent::Tools::GetJournal < Agent::Tool
     2	  MAX_LIMIT = 100 # with legs, 200 trades sent twice (text plus structured) would pass the Claude app's result cap
     3	
     4	  tool description: "Trades from the journal, newest first, paginated. Filter by status (open, closed), needs_review, missing_post_mortem, " \
     5	                    "setup name, symbol, and opened/closed date ranges. Legs are included only on request. R is null when no planned stop was known at entry.",
     6	       input: { status: { type: "string", enum: %w[ open closed ] }, needs_review: { type: "boolean" }, missing_post_mortem: { type: "boolean" },
     7	                setup: { type: "string" }, symbol: { type: "string" }, opened_after: { type: "string", format: "date" }, closed_after: { type: "string", format: "date" },
     8	                include_legs: { type: "boolean", default: false }, limit: { type: "integer", minimum: 1, maximum: MAX_LIMIT, default: 50 }, offset: { type: "integer", minimum: 0, default: 0 } },
     9	       output: { trades: { type: "array", items: { type: "object" } }, total: { type: "integer" }, limit: { type: "integer" }, offset: { type: "integer" } }
    10	
    11	  def call(status: nil, needs_review: nil, missing_post_mortem: nil, setup: nil, symbol: nil, opened_after: nil, closed_after: nil, include_legs: false, limit: 50, offset: 0)
    12	    scope = Trade.journaled
    13	    scope = scope.where(status: status) if status
    14	    scope = scope.where(needs_review: needs_review) unless needs_review.nil?
    15	    scope = scope.missing_post_mortem if missing_post_mortem
    16	    scope = scope.in_setup(setup) if setup
    17	    scope = scope.in_symbol(symbol) if symbol
    18	    scope = scope.opened_after(date(opened_after)) if opened_after
    19	    scope = scope.closed_after(date(closed_after)) if closed_after
    20	    limit = limit.to_i.clamp(1, MAX_LIMIT)
    21	    offset = offset.to_i.clamp(0..)
    22	    trades = scope.newest_first.preload(:instrument, :setup).offset(offset).limit(limit)
    23	    { total: scope.count, limit: limit, offset: offset, trades: trades.map { |t| trade(t, include_legs: include_legs) } }
    24	  end
    25	
    26	  private
    27	    def date(value)
    28	      Date.parse(value.to_s)
    29	    rescue Date::Error
    30	      raise InvalidArguments, "#{value.inspect} is not a date"
    31	    end
    32	
    33	    def trade(trade, include_legs:)
    34	      hash = { id: trade.id, symbol: trade.instrument.symbol, cusip: trade.instrument.cusip, status: trade.status, setup: trade.setup&.name,
    35	               opened_at: trade.opened_at, closed_at: trade.closed_at, quantity: trade.quantity, peak_quantity: trade.peak_quantity,
    36	               avg_entry: trade.avg_entry, avg_exit: trade.avg_exit, planned_stop: trade.current_planned_stop, initial_risk: trade.initial_risk,
    37	               realized_pnl: trade.realized_pnl, realized_r: trade.realized_r, stopped_out: trade.stopped_out?, bootstrapped: trade.bootstrapped?,
    38	               needs_review: trade.needs_review?, review_reason: trade.review_reason, excluded_from_stats: trade.excluded_from_stats?,
    39	               thesis: trade.thesis, post_mortem: trade.post_mortem, followed_setup: trade.followed_setup }
    40	      hash[:legs] = trade.ordered_legs.map { |l| { kind: l.kind, plug: l.plug?, quantity: l.quantity, price: l.price, ratio: l.ratio, cash_amount: l.cash_amount, executed_at: l.executed_at } } if include_legs
    41	      hash
    42	    end
    43	end

### app/models/agent/tools/get_portfolio.rb
     1	class Agent::Tools::GetPortfolio < Agent::Tool
     2	  include Agent::Tool::Desk
     3	
     4	  tool description: "Open positions in the trading account with last price, unrealized P&L, the working stop and its protection state, " \
     5	                    "distance to stop, and open risk. Unknown risk is null, never zero. Every number carries as_of and stale. " \
     6	                    "Money and quantities are decimal strings.",
     7	       output: { state: { type: "string" }, account: { type: "string" }, positions: { type: "array", items: { type: "object" } },
