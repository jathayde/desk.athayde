    74	        tools: Agent::Tools.definitions(:scheduled), tool_choice: tool_choice, cache_control: { type: :ephemeral }
    75	      )
    76	      %i[ input_tokens output_tokens cache_creation_input_tokens cache_read_input_tokens ].each { |field| @usage[field] += response.usage.public_send(field).to_i }
    77	      response
    78	    end
    79	
    80	    # Room for another tool turn and, after it, the final call that MAX_TURNS reserves.
    81	    def budget_left? = @turns < MAX_TURNS - 1 && @tool_calls < MAX_TOOL_CALLS && input_tokens < MAX_INPUT_TOKENS
    82	
    83	    def input_tokens = @usage[:input_tokens] + @usage[:cache_read_input_tokens] + @usage[:cache_creation_input_tokens]
    84	    def append_text(response)
    85	      text = response.content.select { |b| b.type == :text }.map(&:text).join("\n")
