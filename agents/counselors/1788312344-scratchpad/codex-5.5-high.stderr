     1	# Everything that went wrong in a fixed window ending now: failed feeds, failed or stuck agent runs, briefs
     2	# that never left, and jobs the queue gave up on. Token-skipped runs are the nag's business, not this one's.
     3	class FailureDigest
     4	  WINDOW = 24.hours
     5	
     6	  def initialize(now: Time.current)
     7	    @since = now - WINDOW
     8	    @now = now
     9	  end
    10	
    11	  attr_reader :since, :now
    12	
    13	  def sync_failures = SyncRun.where(status: %w[ failed partial ]).where(finished_at: window).recent_first
    14	  def agent_failures = AgentRun.where(status: %w[ failed capped ]).where(finished_at: window).recent_first
    15	  def stuck_runs = AgentRun.running.where(started_at: ...AgentRun::STALE_AFTER.ago)
    16	  def undelivered = AgentRun.unemailed.where(finished_at: window).recent_first
    17	  def failed_jobs = SolidQueue::FailedExecution.where(created_at: window).includes(:job).order(created_at: :desc)
    18	
    19	  def sync_by_feed = sync_failures.group_by { |run| [ run.account&.label, run.feed ].compact.join(" · ") }
    20	  def jobs_by_class = failed_jobs.group_by { |failure| failure.job.class_name }
    21	
    22	  def empty? = sync_failures.none? && agent_failures.none? && stuck_runs.none? && undelivered.none? && failed_jobs.none?
    23	
    24	  private
    25	    def window = since..now
    26	end
     1	module Jobs
