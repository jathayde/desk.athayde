     1	# One Messages API conversation over the read-only tool registry, bounded four ways: turns, tool calls,
     2	# input tokens, and wall clock. Every stop reason is handled deliberately and the row records how it ended.
     3	# The email is the job's business: a run that produced text can be delivered whatever else happened.
     4	class Agent::Run
     5	  MAX_TURNS = 12 # one Messages API round trip is a turn; parallel tool_use blocks in one response are one turn
     6	  MAX_TOOL_CALLS = 20
     7	  MAX_INPUT_TOKENS = 400_000 # cumulative across turns; the 1M window would not error, only bill
     8	  MAX_OUTPUT_TOKENS = 8192 # thinking bills as output and counts here, so small values hit the ceiling before any tool_use
     9	  DEADLINE = 10.minutes
    10	  TOOL_RESULT_LIMIT = 24.kilobytes
    11	  BUDGET_EXHAUSTED = "tool budget exhausted; write the brief from what you have"
    12	
    13	  Ended = Class.new(StandardError)
    14	
    15	  def initialize(agent_run, context: Agent::Context.new(kind: agent_run.kind, date: agent_run.market_date), client: Agent.client)
    16	    @run, @context, @client = agent_run, context, client
    17	    @messages = []
    18	    @degraded_reasons = context.degraded_reasons.dup
    19	    @turns = @tool_calls = 0
    20	    @usage = Hash.new(0)
    21	    @text = +""
    22	    @max_tokens = MAX_OUTPUT_TOKENS
    23	    @capped = false
    24	  end
    25	
    26	  attr_reader :run
    27	
    28	  def perform
    29	    @started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    30	    run.update!(model: Agent::MODEL, started_at: run.started_at || Time.current)
