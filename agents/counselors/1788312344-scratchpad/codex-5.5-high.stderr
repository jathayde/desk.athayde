     1	class Agent::Tools::GetQuotes < Agent::Tool
     2	  MAX_SYMBOLS = 50
     3	
     4	  tool description: "Live quotes for up to 50 symbols from Schwab, cached for two minutes. Unknown symbols are listed in invalid_symbols. " \
     5	                    "When Schwab is unavailable the last cached quote is returned with stale: true and a warning; symbols with no cached " \
     6	                    "quote are listed in unavailable_symbols.",
     7	       input: { symbols: { type: "array", items: { type: "string" }, minItems: 1, maxItems: MAX_SYMBOLS, description: "Ticker symbols" } },
     8	       required: [ :symbols ],
     9	       output: { quotes: { type: "array", items: { type: "object" } }, invalid_symbols: { type: "array", items: { type: "string" } },
    10	                 unavailable_symbols: { type: "array", items: { type: "string" } }, warning: { type: [ "string", "null" ] } }
    11	
    12	  def call(symbols:)
    13	    symbols = symbols.map { |s| s.to_s.strip.upcase }.reject(&:blank?).uniq
    14	    raise InvalidArguments, "symbols must be 1 to #{MAX_SYMBOLS} tickers" unless symbols.size.between?(1, MAX_SYMBOLS)
    15	    Agent::MarketData.quotes(symbols)
    16	  end
    17	end

### app/models/agent/tools/get_risk_rules.rb
     1	class Agent::Tools::GetRiskRules < Agent::Tool
