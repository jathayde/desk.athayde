     2	module Memory
     3	end
     1	# The human-authored strategy files at MEMORY_REPO_PATH, read as text for the scheduled prompt. Rails never
     2	# writes here. Files are snapshotted in one pass, capped, and scrubbed so a mid-pull read or a stray byte
     3	# cannot break a run; a missing checkout is a degraded reason, not an exception.
     4	class Memory::Repo
     5	  FILES = %w[ investor-profile.md strategy.md watchlist.md prompts.md instructions.md edge.md ].freeze
     6	  PER_FILE_LIMIT = 32.kilobytes
     7	  TOTAL_LIMIT = 128.kilobytes
     8	  STALE_AFTER = 24.hours
     9	
    10	  Entry = Data.define(:name, :text, :truncated)
    11	
    12	  def self.configured = new(Rails.configuration.x.memory.repo_path)
    13	
    14	  def initialize(path)
    15	    @path = path.present? ? Pathname(path) : nil
    16	  end
    17	
    18	  attr_reader :path
    19	
    20	  def present? = path&.directory? || false
    21	  def git? = present? && path.join(".git").exist?
    22	
    23	  def files
    24	    @files ||= begin
    25	      budget = TOTAL_LIMIT
    26	      FILES.filter_map do |name|
    27	        file = path&.join(name)
    28	        next unless present? && file.file?
    29	        text = file.binread.force_encoding(Encoding::UTF_8).scrub("\u{FFFD}").truncate_bytes([ PER_FILE_LIMIT, budget ].min, omission: "")
    30	        budget -= text.bytesize
    31	        Entry.new(name, text, text.bytesize < file.size)
    32	      end
    33	    end
    34	  end
    35	
    36	  def truncated = files.select(&:truncated).map(&:name)
    37	  def head_sha = git? ? git("rev-parse", "--short", "HEAD") : nil
    38	  def last_modified_at = files.any? ? files.map { |f| path.join(f.name).mtime }.max : nil
    39	  def stale? = !present? || (last_modified_at || Time.at(0)) < STALE_AFTER.ago
    40	
    41	  # A fast-forward pull; any other state (dirty, diverged, missing, dubious ownership) is the error text.
    42	  def pull!
    43	    raise ArgumentError, "MEMORY_REPO_PATH is not set" unless path
    44	    raise ArgumentError, "#{path} is not a git checkout" unless git?
    45	    git("pull", "--ff-only", "--quiet")
    46	    head_sha
    47	  end
    48	
    49	  private
    50	    def git(*args)
    51	      output, status = Open3.capture2e("git", "-C", path.to_s, "-c", "safe.directory=#{path}", *args)
    52	      raise ArgumentError, "git #{args.first}: #{output.strip.lines.last.to_s.strip}" unless status.success?
    53	      output.strip
    54	    end
    55	end
     1	module Memory
     2	  # Fast-forwards the memory checkout every half hour and records the outcome as a memory_repo sync run.
     3	  # A pull that cannot fast-forward is a failed run for the digest, not an exception for the queue; the
     4	  # briefs keep reading whatever is on disk.
     5	  class PullRepoJob < ApplicationJob
     6	    limits_concurrency to: 1, key: ->(*) { name }, on_conflict: :discard
     7	
     8	    def perform(repo = Memory::Repo.configured)
     9	      run = SyncRun.create!(feed: :memory_repo, status: :running, started_at: Time.current)
    10	      repo.pull!
    11	      run.finish!(:succeeded)
    12	    rescue ArgumentError => e
    13	      run.finish!(:failed, error: e.message)
    14	    end
    15	  end
    16	end
     1	# syntax=docker/dockerfile:1
     2	# check=error=true
     3	
     4	# This Dockerfile is designed for production, not development. Use with Kamal or build'n'run by hand:
     5	# docker build -t athayde_desk .
     6	# docker run -d -p 80:80 -e RAILS_MASTER_KEY=<value from config/master.key> --name athayde_desk athayde_desk
     7	
     8	# For a containerized dev environment, see Dev Containers: https://guides.rubyonrails.org/getting_started_with_devcontainer.html
     9	
    10	# Make sure RUBY_VERSION matches the Ruby version in .ruby-version
    11	ARG RUBY_VERSION=3.4.9
    12	FROM docker.io/library/ruby:$RUBY_VERSION-slim AS base
    13	
    14	# Rails app lives here
    15	WORKDIR /rails
    16	
    17	# Install base packages
    18	RUN apt-get update -qq && \
    19	    apt-get install --no-install-recommends -y curl git libjemalloc2 libvips postgresql-client && \
    20	    ln -s /usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2 /usr/local/lib/libjemalloc.so && \
    21	    rm -rf /var/lib/apt/lists /var/cache/apt/archives
    22	
    23	# Set production environment variables and enable jemalloc for reduced memory usage and latency.
    24	ENV RAILS_ENV="production" \
    25	    BUNDLE_DEPLOYMENT="1" \
    26	    BUNDLE_PATH="/usr/local/bundle" \
    27	    BUNDLE_WITHOUT="development" \
    28	    LD_PRELOAD="/usr/local/lib/libjemalloc.so"
    29	
    30	# Throw-away build stage to reduce size of final image
    31	FROM base AS build
    32	
    33	# Install packages needed to build gems
    34	RUN apt-get update -qq && \
    35	    apt-get install --no-install-recommends -y build-essential git libpq-dev libvips libyaml-dev pkg-config && \
    36	    rm -rf /var/lib/apt/lists /var/cache/apt/archives
    37	
    38	# Install application gems
    39	COPY vendor/* ./vendor/
    40	COPY Gemfile Gemfile.lock ./
    41	
    42	RUN bundle install && \
    43	    rm -rf ~/.bundle/ "${BUNDLE_PATH}"/ruby/*/cache "${BUNDLE_PATH}"/ruby/*/bundler/gems/*/.git && \
    44	    # -j 1 disable parallel compilation to avoid a QEMU bug: https://github.com/rails/bootsnap/issues/495
    45	    bundle exec bootsnap precompile -j 1 --gemfile
    46	
    47	# Copy application code
    48	COPY . .
    49	
    50	# Precompile bootsnap code for faster boot times.
    51	# -j 1 disable parallel compilation to avoid a QEMU bug: https://github.com/rails/bootsnap/issues/495
    52	RUN bundle exec bootsnap precompile -j 1 app/ lib/
    53	
    54	# Precompiling assets for production without requiring secret RAILS_MASTER_KEY
    55	RUN SECRET_KEY_BASE_DUMMY=1 ./bin/rails assets:precompile
    56	
    57	
    58	
    59	
    60	# Final stage for app image
    61	FROM base
    62	
    63	# Run and own only the runtime files as a non-root user for security
    64	RUN groupadd --system --gid 1000 rails && \
    65	    useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash
    66	USER 1000:1000
    67	
    68	# Copy built artifacts: gems, application
    69	COPY --chown=rails:rails --from=build "${BUNDLE_PATH}" "${BUNDLE_PATH}"
    70	COPY --chown=rails:rails --from=build /rails /rails
    71	
    72	# Entrypoint prepares the database.
    73	ENTRYPOINT ["/rails/bin/docker-entrypoint"]
    74	
    75	# Start server via Thruster by default, this can be overwritten at runtime
    76	EXPOSE 80
    77	CMD ["./bin/thrust", "./bin/rails", "server"]

