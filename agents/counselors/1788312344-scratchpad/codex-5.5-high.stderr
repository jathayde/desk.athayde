    35	<section>
    36	  <h2 class="sec">Accounts</h2>
    37	  <% status.accounts.each do |row| %>
    38	    <% account = row.account %>
    39	    <%= form_with url: account_path(account), method: :patch, class: "account-form" do |f| %>
    40	      <div class="kv"><span><%= account.label %> <small>…<%= account.schwab_hash.last(4) %></small></span>
    41	        <b><%= money(row.equity) %> · <%= row.symbols.join(", ").presence || "no positions" %></b></div>
    42	      <div class="fields">
    43	        <%= f.text_field :nickname, value: account.nickname, placeholder: "Nickname" %>
    44	        <%= f.select :account_type, options_for_select([ [ "Unclassified", "" ], [ "Taxable", "taxable" ], [ "IRA", "ira" ] ], account.account_type) %>
    45	        <label><%= f.check_box :trading_enabled, checked: account.trading_enabled? %> Journal this account (taxable only)</label>
    46	        <%= f.submit "Save" %>
    47	      </div>
    48	      <% if account.needs_setup? %><p class="warn">Needs setup: classify this account before anything journals.</p><% end %>
    49	    <% end %>
    50	  <% end %>
    51	</section>
    52	
    53	<section>
    54	  <h2 class="sec">Feeds</h2>
    55	  <dl class="kv-list">
    56	    <% status.feed_rows.each do |row| %>
    57	      <div class="kv"><dt><%= row.account.label %> · <%= row.feed %></dt>
    58	        <dd><% if row.latest %><%= row.latest.status %> <%= as_of(row.latest.finished_at || row.latest.started_at) %><% if row.latest.status != "succeeded" %> · last success <%= as_of(row.last_success) %><% end %><% if row.latest.error %> <small><%= row.latest.error.truncate(80) %></small><% end %><% else %>never<% end %></dd></div>
    59	    <% end %>
    60	  </dl>
    61	  <% status.gaps.each do |run| %>
    62	    <p class="warn"><%= run.account&.label %> <%= run.feed %>: Schwab cannot return history before <%= l(run.gap_from, format: :connection) %>.</p>
    63	  <% end %>
    64	</section>
    65	
    66	<dl class="kv-list">
    67	  <h2 class="sec">Failures, 7 days</h2>
    68	  <div class="kv"><dt>Failed sync runs</dt><dd><%= status.failed_run_count %></dd></div>
    69	  <div class="kv"><dt>Failed jobs</dt><dd><%= status.failed_job_count %></dd></div>
    70	  <% status.failed_runs_sample.each do |run| %>
    71	    <p class="muted"><%= l(run.started_at, format: :weekday_time) %> <%= run.feed %>: <%= run.error.to_s.truncate(120) %></p>
    72	  <% end %>
    73	</dl>
    74	
    75	<section class="halt">
    76	  <h2 class="sec">Halt</h2>
    77	  <% if status.settings.manual_halt? %>
    78	    <p class="warn">Halted<% if status.halted_by %> by <%= status.halted_by.user&.name %>, <%= l(status.halted_by.created_at, format: :weekday_time) %><% end %>: <%= status.settings.manual_halt_reason %></p>
    79	    <%= form_with url: resume_system_path, method: :post do |f| %>
    80	      <%= f.label :confirmation, "Type resume to clear the halt" %>
    81	      <%= f.text_field :confirmation, autocomplete: "off" %>
    82	      <%= f.submit "Resume" %>
    83	    <% end %>
    84	  <% else %>
    85	    <p>Halting stops proposal creation and submission once Phase 2 ships; in Phase 1 it marks the dashboard.</p>
    86	    <%= form_with url: halt_system_path, method: :post do |f| %>
    87	      <%= f.label :reason, "Reason" %>
    88	      <%= f.text_field :reason, required: true %>
    89	      <%= f.submit "Halt", class: "danger" %>
    90	    <% end %>
    91	  <% end %>
    92	</section>

