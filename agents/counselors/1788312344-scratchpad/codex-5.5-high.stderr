     1	<% content_for :title, "System" %>
     2	<% status = @status %>
     3	<h1>System</h1>
     4	
     5	<dl class="kv-list">
     6	  <h2 class="sec">Schwab connection</h2>
     7	  <% if status.token %>
     8	    <div class="kv"><dt>Status</dt><dd class="status-<%= status.token_status %>"><%= status.token_status.to_s.humanize %></dd></div>
     9	    <div class="kv"><dt>Token age</dt><dd><%= distance_of_time_in_words(status.token.issued_at, Time.current) %> of 7 days</dd></div>
    10	    <div class="kv"><dt>Expires</dt><dd><%= l(status.token.refresh_expires_at, format: :connection) %></dd></div>
    11	    <div class="kv"><dt>Next Sunday email</dt><dd><%= l(status.next_sunday_email, format: :connection) %></dd></div>
    12	    <% if status.token_dies_before_sunday? %>
    13	      <p class="warn">The token dies before Sunday's email. <%= link_to "Re-authenticate now", schwab_authorize_path %>.</p>
    14	    <% end %>
    15	    <% if status.token.last_refresh_error %><div class="kv"><dt>Last refresh error</dt><dd><%= status.token.last_refresh_error %></dd></div><% end %>
    16	  <% else %>
    17	    <p>Not connected. <%= link_to "Connect Schwab", schwab_authorize_path, class: "button" %></p>
    18	  <% end %>
    19	  <div class="kv"><dt>Sync</dt><dd><% if status.settings.sync_paused_reason %>paused: <%= status.settings.sync_paused_reason %><% if status.sync_paused_since %> since <%= l(status.sync_paused_since, format: :weekday_time) %><% end %><% else %>running<% end %></dd></div>
    20	  <div class="kv"><dt>Shadow mode</dt><dd><%= status.settings.shadow_mode ? "on" : "off" %></dd></div>
    21	  <div class="kv"><dt>API spend this month</dt><dd><%= money(status.api_spend_this_month, precision: 2) %><% if status.unpriced_runs? %> <small>plus unpriced runs</small><% end %></dd></div>
    22	  <div class="kv"><dt>Memory repo</dt>
    23	    <dd><% if status.memory_repo.present? %><%= status.memory_repo.files.size %> files<% if status.memory_repo.head_sha %> at <%= status.memory_repo.head_sha %><% end %>, changed <%= as_of(status.memory_repo.last_modified_at) %><% else %>missing<% end %><% if status.memory_run %> · pull <%= status.memory_run.status %> <%= as_of(status.memory_run.finished_at || status.memory_run.started_at) %><% if status.memory_run.error %> <small><%= status.memory_run.error.truncate(80) %></small><% end %><% end %></dd></div>
    24	</dl>
    25	
    26	<dl class="kv-list">
    27	  <h2 class="sec">Briefs</h2>
    28	  <% status.agent_runs.each do |run| %>
    29	    <div class="kv"><dt><%= run.title %></dt>
    30	      <dd><%= run.status %><%= " · degraded" if run.degraded? %><%= " · not emailed" if run.brief? && !run.running? && !run.delivered? %><% if run.estimated_cost %> · $<%= '%.4f' % run.estimated_cost %><% elsif run.unpriced? %> · unpriced<% end %><% if run.error %> <small><%= run.error.truncate(80) %></small><% end %></dd></div>
    31	  <% end %>
    32	  <% if status.agent_runs.empty? %><div class="kv"><dt>Runs</dt><dd>none yet</dd></div><% end %>
    33	</dl>
