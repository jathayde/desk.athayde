     3	  class FailureDigestJob < ApplicationJob
     4	    def perform
     5	      AgentRun.sweep_stale!
     6	      digest = FailureDigest.new
     7	      return if digest.empty?
     8	      BriefMailer.failure_digest(digest).deliver_now
     9	    end
    10	  end
    11	end
