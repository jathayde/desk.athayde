    33	    proposal = approve
    34	    expect(proposal).to be_submission_failed
    35	    expect(proposal.submission_attempts.sole).to have_attributes(outcome: "failed", response: { "error" => "Schwab responded 400: quantity invalid" })
    36	    expect(OrderProposal.instrument_locked?(xyz)).to be(false)
    37	  end
    38	
    39	  it "records a timeout after send as unknown, mails the operator, and hands the proposal to the reconcile job after the quiet period" do
    40	    fake.enqueue(:place_order) { raise Schwab::UnknownOutcome.new("Net::ReadTimeout", attempts: 1) }
    41	    expect { approve }.to have_enqueued_job(Submission::ReconcileJob).at(a_value_within(5.seconds).of(Submission::ReconcileJob::QUIET_PERIOD.from_now))
    42	      .and have_enqueued_mail(AlertMailer, :submission_unknown)
    43	    proposal = OrderProposal.last
    44	    expect(proposal).to be_submission_unknown
    45	    expect(OrderProposal.instrument_locked?(xyz)).to be(true)
    46	    expect(proposal.submission_attempts.sole).to have_attributes(outcome: "unknown", response: { "error" => "UnknownOutcome: Net::ReadTimeout" })
    47	  end
    48	
    49	  it "cancels the working stop before a full exit and shrinks it before a partial one, audited, and does not sell when the stop cannot be adjusted" do
    50	    stop = create(:order, :working_stop, account: account, instrument: xyz, quantity: 40, remaining_quantity: 40, stop_price: 47, broker_order_id: "stop-1")
    51	    create(:position, account: account, instrument: xyz, quantity: 40, last_price: 50, market_value: 2000, working_stop_order: stop)
    52	    account.reload
    53	    partial = approve(kind: :exit, quantity: 10, limit: 55)
    54	    expect(partial).to have_attributes(status: "submitted", child_action: "replace_stop")
    55	    expect(fake.calls.map(&:first)).to include(:replace_order, :place_order)
    56	    expect(AuditEvent.where(subject: partial, kind: "proposal_submitting").last.reason).to eq("stop replace stop")
    57	
    58	    partial.record_broker_outcome!(:filled)
    59	    fake.enqueue(:cancel_order) { raise Schwab::RequestError.new("Schwab responded 404: order not found", status: 404) }
    60	    full = approve(kind: :exit, quantity: 40, limit: 55)
    61	    expect(full).to be_submission_failed
    62	    expect(fake.calls.map(&:first).last).to eq(:cancel_order) # the sell never went in
    63	  end
    64	end

