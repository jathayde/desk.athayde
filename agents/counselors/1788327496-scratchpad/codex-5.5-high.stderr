     1	# The real branch (docs/phase-2-plan.md §0.5, §0.6): the exit's stop action first, then the order, one call each,
     2	# never retried; every answer Schwab can give lands as one named outcome on the proposal, and a timeout after
     3	# send is unknown until the reconcile job says otherwise.
     4	class Submission::Place
     5	  def self.call(proposal, attempt) = new(proposal, attempt).call
     6	
     7	  def initialize(proposal, attempt)
     8	    @proposal, @attempt = proposal, attempt
     9	    @account = proposal.account
    10	  end
    11	
    12	  def call
    13	    adjust_stop if @proposal.kind_exit?
    14	    order_id = client.place_order(@account.schwab_hash, @attempt.payload)
    15	    @proposal.record_submitted!(@attempt, broker_order_id: order_id)
    16	  rescue Schwab::RequestError => e
    17	    @proposal.record_rejected!(@attempt, error: e.message)
    18	  rescue Schwab::UnknownOutcome, Schwab::ServerError, Schwab::TransportError, Schwab::RateLimited => e
    19	    @proposal.record_unknown!(@attempt, error: "#{e.class.name.demodulize}: #{e.message}")
    20	    Submission::ReconcileJob.set(wait: Submission::ReconcileJob::QUIET_PERIOD).perform_later(@proposal)
    21	  end
    22	
    23	  private
    24	    def client = Schwab.client(wait: false)
    25	
    26	    # Selling what a working stop covers: cancel the stop for a full exit, shrink it for a partial one, before
    27	    # the sell goes in; a stop that cannot be adjusted means the sell is not placed.
    28	    def adjust_stop
    29	      stop = @account.positions.find_by(instrument: @proposal.instrument)&.working_stop_order
    30	      return unless stop&.working?
    31	      remaining = stop.remaining.to_d - @proposal.quantity.to_d
    32	      if remaining <= 0
    33	        client.cancel_order(@account.schwab_hash, stop.broker_order_id)
    34	        @proposal.update!(child_action: :cancel_stop)
    35	      else
    36	        payload = Schwab::OrderPayload.stop(symbol: @proposal.instrument.symbol, quantity: remaining, stop_price: stop.stop_price)
    37	        client.replace_order(@account.schwab_hash, stop.broker_order_id, payload)
    38	        @proposal.update!(child_action: :replace_stop)
    39	      end
    40	      AuditEvent.log("proposal_submitting", actor: :system, subject: @proposal, reason: "stop #{@proposal.child_action.to_s.humanize.downcase}", data: { stop_order: stop.broker_order_id, remaining: remaining })
    41	    end
    42	end

