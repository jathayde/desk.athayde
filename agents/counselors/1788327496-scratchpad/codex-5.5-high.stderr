    18	  # Why this position is or is not protected. Only :protected counts; every other state is unknown or
    19	  # insufficient risk, and the dashboard says which. Memoized: it costs a query and views ask repeatedly.
    20	  def protection
    21	    @protection = @live_stops = nil if @protection_for != working_stop_order_id
    22	    @protection_for = working_stop_order_id
    23	    @protection ||= compute_protection
    24	  end
    25	
    26	  def reload(...)
    27	    @protection = @live_stops = nil
    28	    super
    29	  end
    30	
    31	  def compute_protection
    32	    return :delisted if instrument.delisted?
    33	    return :unprotected unless working_stop_order&.working?
    34	    return :awaiting if !working_stop_order.live?
    35	    return :trailing_unknown if stop_price.blank? || live_stops.any? { |o| o.stop_price.blank? }
    36	    return :oversized if covered_quantity > quantity
    37	    return :partial if covered_quantity < quantity
    38	    return :unpriced if last_price.blank?
    39	    :protected
    40	  end
    41	
    42	  def protected? = protection == :protected
    43	  def delisted? = protection == :delisted
    44	  def unprotected? = !protected? && !delisted?
