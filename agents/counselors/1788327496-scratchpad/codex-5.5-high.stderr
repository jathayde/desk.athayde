     1	# Approve is the submission. Transaction one: lock the proposal, check the approver and the gates, re-evaluate
     2	# over the frozen sizing and refuse anything that changed, move to submitting with the attempt row. Then the
     3	# branch: shadow audits what would have been sent; real places it (Submission::Place). A refusal rolls
     4	# transaction one back, leaves the row as it was, and is audited outside it.
     5	class Submission::Submit
     6	  # A blocking re-evaluation carries its report out of the transaction, so the halt it asked for is engaged after the rollback.
     7	  class Blocked < StandardError
     8	    attr_reader :report
     9	    def initialize(report) = (@report = report; super("blocked"))
    10	  end
    11	
    12	  def self.call(proposal, **) = new(proposal, **).call
    13	
    14	  def initialize(proposal, user:, acknowledged: [], override_reason: nil)
    15	    @proposal, @user, @acknowledged, @override_reason = proposal, user, Array(acknowledged).map(&:to_s), override_reason.presence
    16	  end
    17	
    18	  def call
    19	    attempt = OrderProposal.transaction { first_transaction }
    20	    attempt.order_proposal.shadow? ? @proposal.record_shadow!(attempt) : Submission::Place.call(@proposal, attempt)
    21	  rescue Blocked => e
    22	    Guardrails.engage_halts!(e.report)
    23	    refuse "the desk changed: #{e.report.results.select(&:block?).map { |r| r.rule_type.humanize.downcase }.to_sentence} now block; re-propose"
    24	  rescue Submission::Refused => e
    25	    refuse e.message
    26	  end
    27	
    28	  private
    29	    def first_transaction
    30	      @proposal.lock!
    31	      raise Submission::Refused, "only the approver can approve" unless @user&.approver?
    32	      raise Submission::Refused, "proposal #{@proposal.id} is #{@proposal.status}, not waiting for a decision" unless @proposal.approvable?
    33	      settings = SystemSettings.instance
    34	      raise Submission::Refused, "halted: #{settings.manual_halt_reason}" if settings.manual_halt?
    35	      raise Submission::Refused, "entries are halted by #{settings.rule_halt_rule}" if @proposal.kind_entry? && !settings.entries_allowed?
    36	      report = Guardrails::Evaluator.new(@proposal).call
    37	      raise Blocked.new(report) if report.blocked?
    38	      raise Submission::Refused, "the desk changed: sizing would differ; re-propose" if sizing_changed?
    39	      new_warnings = report.warnings - @proposal.warnings
    40	      raise Submission::Refused, "the desk changed: #{new_warnings.map { |r| r.humanize.downcase }.to_sentence} now warn; re-propose" if new_warnings.any?
    41	      unacknowledged = report.warnings - @acknowledged
    42	      raise Submission::Refused, "acknowledge #{unacknowledged.map { |r| r.humanize.downcase }.to_sentence} first" if unacknowledged.any?
    43	      raise Submission::Refused, "the stop is outside the collar; an override reason is required" if report.needs_override? && @override_reason.nil?
    44	      @proposal.update!(guardrail_results: report.to_h, evaluated_at: Time.current)
    45	      @proposal.start_submission!(user: @user, acknowledged: @acknowledged, override_reason: @override_reason, payload: payload, shadow: settings.shadow_mode?)
    46	    end
    47	
    48	    # The operator pressed approve and the desk said no: on the record, outside the rolled-back transaction.
    49	    def refuse(message)
    50	      AuditEvent.log("proposal_approval_refused", actor: @user ? :human : :system, user: @user, subject: @proposal, reason: message)
    51	      raise Submission::Refused, message
    52	    end
    53	
    54	    def sizing_changed?
    55	      return false unless @proposal.kind_entry?
    56	      desk = Desk.new(account: @proposal.account)
    57	      fresh = Sizing.for(limit_price: @proposal.limit_price, stop_price: @proposal.stop_price, equity: desk.balance_stale? ? nil : desk.equity,
    58	                         rule: RiskRule.active_for("max_risk_per_trade", setup: @proposal.setup))
    59	      fresh.quantity != @proposal.quantity.to_i
    60	    end
    61	
    62	    def payload
    63	      symbol = @proposal.instrument.symbol
    64	      if @proposal.kind_entry?
    65	        Schwab::OrderPayload.bracket(symbol: symbol, quantity: @proposal.quantity, limit_price: @proposal.limit_price, stop_price: @proposal.stop_price)
    66	      else
    67	        Schwab::OrderPayload.sell(symbol: symbol, quantity: @proposal.quantity, limit_price: @proposal.limit_price, tax_lot_method: @proposal.tax_lot_method)
    68	      end
    69	    end
    70	end

