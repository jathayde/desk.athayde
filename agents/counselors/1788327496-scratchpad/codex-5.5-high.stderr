     1	# An unknown submission is resolved only by looking (docs/phase-2-plan.md §0.7): after a quiet period, sync
     2	# the orders feed and search; exactly one unlinked match links it, two stay with the operator, and nothing
     3	# found is believed only when a second look ten minutes later agrees. Never a retry without that.
     4	class Submission::ReconcileJob < ApplicationJob
     5	  QUIET_PERIOD = 60.seconds
     6	  CONFIRMATION_GAP = 10.minutes
     7	  REAL_WINDOW = 15.minutes
     8	
     9	  limits_concurrency to: 1, key: ->(proposal) { "reconcile-#{proposal.instrument_id}" }, on_conflict: :discard
    10	
    11	  def perform(proposal)
    12	    return unless proposal.submission_unknown?
    13	    attempt = proposal.submission_attempts.unknown.first or return
    14	    Sync::OrdersJob.perform_now(proposal.account)
    15	    matcher = Submission::Matcher.new(proposal, attempt, window: REAL_WINDOW)
    16	    if (order = matcher.match)
    17	      order.update!(order_proposal: proposal, placed_via: :app)
    18	      proposal.record_reconciled!(attempt, order: order)
    19	    elsif matcher.ambiguous?
    20	      note(attempt, "ambiguous", matcher.candidates.map(&:broker_order_id)) # the operator resolves it at Schwab
    21	    else
    22	      absent = Array(attempt.response["absent_at"]) << Time.current.iso8601
    23	      attempt.update!(response: attempt.response.merge("absent_at" => absent))
    24	      if absent.size >= 2 && Time.zone.parse(absent.last) - Time.zone.parse(absent.first) >= CONFIRMATION_GAP - 1.second
    25	        proposal.record_not_placed!(attempt)
    26	      else
    27	        self.class.set(wait: CONFIRMATION_GAP).perform_later(proposal)
    28	      end
    29	    end
    30	  end
    31	
    32	  private
    33	    def note(attempt, key, value) = attempt.update!(response: attempt.response.merge(key => value))
    34	end

