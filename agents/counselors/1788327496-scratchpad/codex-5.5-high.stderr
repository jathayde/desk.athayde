    75	    # ---- Orders: a placed order is remembered and served by the next orders call, as Schwab would.
    76	    def place_order(hash, payload)
    77	      scripted(:place_order, hash, payload) do
    78	        id = (@next_order_id += 1).to_s
    79	        @placed << placed_order(id, payload)
    80	        id
    81	      end
    82	    end
    83	
    84	    def preview_order(hash, payload) = scripted(:preview_order, hash, payload) { { "orderStrategy" => payload, "orderBalance" => {} } }
    85	    def cancel_order(hash, order_id) = scripted(:cancel_order, hash, order_id) { @placed.find { |o| o["orderId"].to_s == order_id.to_s }&.store("status", "CANCELED"); true }
    86	    def replace_order(hash, order_id, payload) = scripted(:replace_order, hash, order_id, payload) { cancel_order(hash, order_id); place_order(hash, payload) }
    87	
    88	    def price_history(symbol, period_type: :month, period: 3, frequency_type: :daily, frequency: 1, from: nil, to: nil) = scripted(:price_history, symbol) { fixture("price_history").merge("symbol" => symbol) }
    89	    def instrument_by_symbol(symbol) = scripted(:instrument_by_symbol, symbol) { fixture("instruments")["instruments"].select { |i| i["symbol"] == symbol } }
    90	    def instrument_by_cusip(cusip) = scripted(:instrument_by_cusip, cusip) { fixture("instruments")["instruments"].select { |i| i["cusip"] == cusip } }
    91	
    92	    private
    93	      def scripted(method_name, *args)
    94	        @calls << [ method_name, *args ]
    95	        block = @queues[method_name].shift || @sticky[method_name]
    96	        block ? block.call(*args) : yield
    97	      end
    98	
    99	      # The raw shape an order the fake placed comes back in, close enough for the mappers and the matcher.
   100	      def placed_order(id, payload, status: "WORKING")
   101	        now = ::Time.current.utc.iso8601(3)
   102	        base = payload.except("childOrderStrategies").merge("orderId" => id.to_i, "status" => status, "enteredTime" => now, "filledQuantity" => 0,
   103	                                                              "remainingQuantity" => payload.dig("orderLegCollection", 0, "quantity"), "quantity" => payload.dig("orderLegCollection", 0, "quantity"),
   104	                                                              "orderLegCollection" => payload["orderLegCollection"].map { |leg| leg.merge("instrument" => leg["instrument"].merge("assetType" => "EQUITY", "cusip" => cusip_for(leg.dig("instrument", "symbol")))) })
   105	        children = Array(payload["childOrderStrategies"]).map { |child| placed_order((@next_order_id += 1), child, status: "AWAITING_PARENT_ORDER") }
   106	        children.any? ? base.merge("childOrderStrategies" => children) : base
   107	      end
   108	
   109	      def cusip_for(symbol) = fixture("instruments")["instruments"].find { |i| i["symbol"] == symbol }&.dig("cusip") || Instrument.find_by(symbol: symbol)&.cusip
   110	
   111	      def fixture(name) = Scrub.json(JSON.parse(FIXTURES.join("#{name}.json").read))
   112	
   113	      # The token response is the one body that legitimately carries tokens; the real client never scrubs it either.
   114	      def token_fixture = JSON.parse(FIXTURES.join("token.json").read).except("id_token")
   115	
   116	      def find_order(orders, order_id)
   117	        orders.each do |raw|
   118	          return raw if raw["orderId"].to_s == order_id
   119	          found = find_order(Array(raw["childOrderStrategies"]) + Array(raw["replacingOrderCollection"]), order_id)
   120	          return found if found
   121	        end
   122	        nil
   123	      end
   124	
   125	      # Session times are built for the requested date in New York, so the offset is right year-round.

