     9	      # Cursor: from the last advanced window, overlapping by `overlap`; capped at the lookback. When the
    10	      # cursor is older than the lookback, Schwab cannot return the gap and the run says so.
    11	      def window_for(feed, account, overlap:)
    12	        now = Time.current
    13	        cursor = SyncRun.last_window_to(feed, account)
    14	        floor = now - LOOKBACK
    15	        from = cursor ? [ cursor - overlap, floor ].max : floor
    16	        gap_from = cursor if cursor && cursor < floor
    17	        [ from, now.utc.end_of_day, gap_from ]
    18	      end
    19	
    20	      # Audited once per gap, not once per run.
    21	      def note_gap(run, gap_from, account)
    22	        return unless gap_from
    23	        run.update!(gap_from: gap_from)
    24	        return if AuditEvent.where(kind: "sync_gap_unrecoverable", subject: account).where("data->>'feed' = ? AND data->>'gap_from' = ?", run.feed, gap_from.iso8601).exists?
    25	        AuditEvent.log("sync_gap_unrecoverable", actor: :system, subject: account, data: { feed: run.feed, gap_from: gap_from.iso8601, lookback_days: LOOKBACK.in_days.to_i })
    26	      end
    27	  end
    28	end
    29	# One row per feed run. Wraps the work so token loss, Schwab failures, and quarantined records all
    30	# land as a status; anything else is recorded as failed and re-raised so the queue sees it too.
    31	class SyncRun < ApplicationRecord
    32	  STALE_AFTER = 10.minutes # a running row older than this is a crashed or restarted worker, not a run
    33	  ACCOUNT_FEEDS = %i[ positions orders activities ].freeze
    34	
    35	  belongs_to :account, optional: true
    36	
    37	  enum :feed, {
    38	    accounts: "accounts", positions: "positions", orders: "orders", activities: "activities",
    39	    market_hours: "market_hours", memory_repo: "memory_repo", snapshots: "snapshots"
    40	  }, prefix: true
    41	  enum :status, { running: "running", succeeded: "succeeded", partial: "partial", failed: "failed", skipped_token: "skipped_token" }
    42	
    43	  scope :recent_first, -> { order(started_at: :desc, id: :desc) }
    44	  scope :for, ->(feed, account) { where(feed: feed, account: account) }
    45	  scope :advanced_cursor, -> { where(status: %w[ succeeded partial ]) }
    46	  scope :live, -> { running.where(started_at: STALE_AFTER.ago..) }
    47	  scope :stale_running, -> { running.where(started_at: ..STALE_AFTER.ago) }
    48	
    49	  # A worker killed mid-feed leaves a running row; the tick and the digest both sweep it so the system page and
    50	  # the digest see a failure, not a run that never ends.
    51	  def self.sweep_stale!
    52	    stale_running.find_each { |run| run.finish!(:failed, error: "left running") }
    53	  end
    54	
    55	  def self.record(feed, account: nil, window_from: nil, window_to: nil)
    56	    run = create!(feed: feed, account: account, status: :running, started_at: Time.current, window_from: window_from, window_to: window_to)
    57	    outcome = yield run
    58	    run.finish!(outcome == :failed ? :failed : (outcome == :partial || run.unmapped_values.any? ? :partial : :succeeded), error: run.error)
    59	  rescue Schwab::NoUsableToken, Schwab::AuthError => e
    60	    run.finish!(:skipped_token, error: e.message)
    61	  rescue Schwab::Error => e
    62	    run.finish!(:failed, error: e.message)
    63	  rescue StandardError => e
    64	    run.finish!(:failed, error: "#{e.class}: #{e.message}")
    65	    raise
    66	  ensure
    67	    run&.finish!(:failed, error: "left running") if run&.running? && !run.destroyed?
    68	  end
    69	
    70	  def self.last_window_to(feed, account) = self.for(feed, account).advanced_cursor.maximum(:window_to)
    71	  def self.last_started_at(feed, account) = self.for(feed, account).maximum(:started_at)
    72	  def self.running?(feed, account) = self.for(feed, account).live.exists?
    73	
    74	  # Due when nothing is live and the last start is older than the interval, with a minute of slack for cron drift.
    75	  def self.due?(feed, account, every:)
    76	    return false if running?(feed, account)
    77	    last = last_started_at(feed, account)
    78	    last.nil? || last <= (every - 1.minute).ago
    79	  end
    80	
    81	  def finish!(status, error: nil)
    82	    update!(status: status, finished_at: Time.current, error: error&.truncate(1000))
    83	    self
    84	  end
    85	
    86	  def touched(count) = update!(records_touched: records_touched.to_i + count)
    87	
    88	  def quarantine(key, detail)
    89	    unmapped_values[key.to_s] = Array(unmapped_values[key.to_s]) << detail
    90	    save!
    91	  end
    92	end

