    27	
    28	  TERMINAL = %w[ rejected_by_rules rejected expired submission_failed filled cancelled ].freeze
    29	  APPROVABLE = %w[ validated ].freeze
    30	  UNRESOLVED = %w[ submitting submission_unknown ].freeze # locks the instrument for every other proposal
