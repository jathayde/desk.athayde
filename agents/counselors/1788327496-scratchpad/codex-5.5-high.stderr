     1	# Finds the broker order a submission produced when Schwab never told us its id: an ambiguous real submission
     2	# (step 4) or a shadowed one the operator placed by hand. Conservative by design: unlinked orders only, alive
     3	# or filled, the same instrument, side, quantity, type, price, and shape (a bracket parent for an entry, a
     4	# single for an exit), entered inside the attempt's window; two matches are ambiguous for the operator, never
     5	# "found".
     6	class Submission::Matcher
     7	  PRICE_TOLERANCE = BigDecimal("0.01")
     8	  SHADOW_WINDOW = 3.days
     9	
    10	  def initialize(proposal, attempt, window: SHADOW_WINDOW)
    11	    @proposal, @attempt, @window = proposal, attempt, window
    12	  end
    13	
    14	  def candidates
    15	    @candidates ||= find_candidates
    16	  end
    17	
    18	  # Exactly one, or nothing: the caller decides what "two" means.
    19	  def match = candidates.one? ? candidates.first : nil
    20	  def ambiguous? = candidates.many?
    21	
    22	  private
    23	    def find_candidates
    24	      window = @attempt.attempted_at - 5.minutes..@attempt.attempted_at + @window
    25	    scope = @proposal.account.orders.where(order_proposal_id: nil, parent_order_id: nil, instrument: @proposal.instrument, side: OrderProposal.sides.fetch(@proposal.side),
    26	                                           order_type: @proposal.order_type, entered_at: window).where.not(status: Schwab::Order::DEAD_STATUSES + [ Schwab::Order::GONE ])
    27	    scope.includes(:child_orders).select { |o| o.quantity.to_d == @proposal.quantity.to_d && (o.limit_price.to_d - @proposal.limit_price.to_d).abs <= PRICE_TOLERANCE && shape_matches?(o) }
    28	  end
    29	
    30	    def shape_matches?(order) = @proposal.kind_entry? ? order.child_orders.any? : order.child_orders.none?
    31	end

