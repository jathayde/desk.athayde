 succeeded in 0ms:
     1	module Sync
     2	  # The only scheduled sync entry point. Refreshes the calendar, checks the token once, and enqueues what is due.
     3	  class TickJob < ApplicationJob
     4	    INTRADAY = { positions: 15.minutes, orders: 5.minutes, activities: 5.minutes }.freeze
     5	    OFF_HOURS = 60.minutes
     6	    CALENDAR_DAYS = 7
     7	    SNAPSHOT_DELAY = 20.minutes
     8	
     9	    def perform
    10	      SyncRun.sweep_stale!
    11	      SystemSettings.instance.sweep_rule_halt!
    12	      Submission::Sweep.call
    13	      OrderProposal.expiring.find_each { |proposal| proposal.expire! rescue OrderProposal::IllegalTransition } # a race with an approve is not the tick's problem
    14	      refresh_calendar
    15	      return pause! unless SchwabToken.usable?
    16	
    17	      in_session = MarketDay.session_open?
    18	      Account.find_each do |account|
    19	        INTRADAY.each_key do |feed|
    20	          next unless SyncRun.due?(feed, account, every: account.sync_interval(feed, in_session: in_session))
    21	          job_for(feed).perform_later(account)
    22	        end
    23	        Snapshots::DailyJob.perform_later(account, today) if snapshot_due?(account, today)
    24	      end
    25	    end
    26	
    27	    private
    28	      # Once per Schwab-sourced market day, 20 minutes after the regular close, after positions and orders both synced
    29	      # since the close: the risk columns are written once and read stops.
    30	      def snapshot_due?(account, date)
    31	        day = MarketDay.find_by(date: date)
    32	        return false unless account.trading_enabled? && day&.schwab? && day.trading? && Time.current >= day.regular_closes_at + SNAPSHOT_DELAY
    33	        return false if account.snapshots.exists?(as_of: date)
    34	        %i[ positions orders ].all? { |feed| SyncRun.for(feed, account).advanced_cursor.where(started_at: day.regular_closes_at..).exists? }
    35	      end
    36	
    37	      def today = MarketDay.today
    38	
    39	      def refresh_calendar
    40	        (today..today + CALENDAR_DAYS).each { |date| MarketDay.for(date) }
    41	      end
    42	
    43	      # One skipped row per hour; nothing is enqueued, so the queue cannot grow.
    44	      def pause!
    45	        reason = SystemSettings.pause_for_token!
    46	        return if reason.nil? || SyncRun.where(status: :skipped_token, started_at: 1.hour.ago..).exists?
    47	        SyncRun.create!(feed: :positions, status: :skipped_token, started_at: Time.current, finished_at: Time.current, error: reason)
    48	      end
    49	
    50	      def job_for(feed) = { positions: PositionsJob, orders: OrdersJob, activities: ActivitiesJob }.fetch(feed)
    51	  end
    52	end

