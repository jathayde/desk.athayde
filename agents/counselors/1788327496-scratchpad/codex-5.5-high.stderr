    96	    # SCHWAB_SHAPE_UNVERIFIED: the 201 with the order id in the Location header, previewOrder's existence, and
    97	    # replace semantics on a TRIGGER child (docs/verify-on-approval.md items 50, 56, 57).
    98	
    99	    # The new order's id, from the Location header; a success without one is an unknown outcome, never a guess.
   100	    def place_order(hash, payload)
   101	      response = write(:post, TRADER, "/accounts/#{hash}/orders", payload)
   102	      order_id_from(response) or raise UnknownOutcome.new("Schwab accepted the order without a Location header", status: response.code.to_i, body: Scrub.body(response.body), attempts: 1)
   103	    end
   104	
   105	    def preview_order(hash, payload)
   106	      response = write(:post, TRADER, "/accounts/#{hash}/previewOrder", payload, idempotent: true)
   107	      Scrub.json(parse(response, attempts: 1, idempotent: true))
   108	    end
   109	
   110	    def cancel_order(hash, order_id)
   111	      write(:delete, TRADER, "/accounts/#{hash}/orders/#{order_id}")
   112	      true
   113	    end
   114	
   115	    def replace_order(hash, order_id, payload)
   116	      response = write(:put, TRADER, "/accounts/#{hash}/orders/#{order_id}", payload)
   117	      order_id_from(response) or raise UnknownOutcome.new("Schwab replaced the order without a Location header", status: response.code.to_i, body: Scrub.body(response.body), attempts: 1)
   118	    end
   119	
   120	    def instrument_by_cusip(cusip)
   121	      get(MARKET, "/instruments/#{cusip}").fetch("instruments", [])
   122	    end
   123	
   124	    private
   125	      def token_request(form, idempotent:)
   126	        request = Net::HTTP::Post.new(URI("#{OAUTH}/token"))
   127	        request.basic_auth(@app_key, @app_secret)
   128	        request["Accept"] = "application/json"
   129	        request.set_form_data(form)
   130	        response, attempts = perform(request, template: "/v1/oauth/token", idempotent: idempotent)
   131	        error = Error.for_response(response, attempts: attempts, idempotent: idempotent)
   132	        case response.code.to_i
   133	        when 200..299 then parse(response, attempts: attempts, idempotent: idempotent).except("id_token")
   134	        when 400, 401, 403 then raise ReauthRequired.new(error.message, status: error.status, body: error.body, attempts: attempts)
   135	        else raise error
   136	        end
   137	      end
   138	
   139	      def get(base, path, **params)
   140	        uri = URI("#{base}#{path}")
   141	        uri.query = URI.encode_www_form(params) if params.any?
   142	        response, attempts = authorized(uri)
   143	        raise Error.for_response(response, attempts: attempts, idempotent: true) unless response.is_a?(Net::HTTPSuccess)
   144	        Scrub.json(parse(response, attempts: attempts, idempotent: true))
   145	      end
   146	
   147	      # One attempt, no retries, the response itself on success; a 5xx or a dropped connection is an UnknownOutcome
   148	      # for a write that may have landed.
   149	      def write(method, base, path, payload = nil, idempotent: false)
   150	        uri = URI("#{base}#{path}")
   151	        request = { post: Net::HTTP::Post, put: Net::HTTP::Put, delete: Net::HTTP::Delete }.fetch(method).new(uri)
   152	        if payload
   153	          request["Content-Type"] = "application/json"
   154	          request.body = JSON.generate(payload)
   155	        end
   156	        response, attempts = authorized(uri, request: request, idempotent: idempotent)
   157	        raise Error.for_response(response, attempts: attempts, idempotent: idempotent) unless response.is_a?(Net::HTTPSuccess)
   158	        response
   159	      end
   160	
   161	      def order_id_from(response) = response["Location"].to_s[%r{/orders/(\d+)\z}, 1]
   162	
   163	      # A non-JSON success body is a gateway page, not data.
   164	      def parse(response, attempts:, idempotent:)
   165	        JSON.parse(response.body.to_s)
   166	      rescue JSON::ParserError
   167	        raise (idempotent ? ServerError : UnknownOutcome).new("Schwab returned a non-JSON body", status: response.code.to_i,
   168	                                                              body: Scrub.body(response.body), attempts: attempts)
   169	      end
   170	
   171	      # One refresh-and-retry on 401, outside the backoff budget. The token model decides whether a
   172	      # refresh is still needed, so two processes seeing the same 401 cannot double-refresh.
   173	      # A 401 means nothing was accepted, so the one refresh-and-retry is safe for writes too.
   174	      def authorized(uri, request: Net::HTTP::Get.new(uri), idempotent: true, refreshed: false)
   175	        request["Authorization"] = "Bearer #{@token.access_token}"
   176	        request["Accept"] = "application/json"
   177	        response, attempts = perform(request, template: Scrub.path(uri.path), idempotent: idempotent)
   178	        if response.code.to_i == 401 && !refreshed && @token.respond_to?(:refresh!)
   179	          @token.refresh!(wait: @wait)
   180	          return authorized(uri, request: request.dup, idempotent: idempotent, refreshed: true)
   181	        end
   182	        [ response, attempts ]
   183	      end
   184	
   185	      # Returns [response, attempts]. Retries live here and nowhere else.
   186	      def perform(request, template:, idempotent:)
   187	        final = idempotent && @wait ? MAX_ATTEMPTS : 1
   188	        1.upto(final) do |attempt|
   189	          begin
   190	            response = dispatch(request, template)
   191	          rescue *TRANSPORT_FAILURES => e
   192	            raise transport_failure(e, attempt, idempotent) if attempt == final
   193	            @sleeper.call(jittered(BACKOFF[attempt - 1]))
   194	            next
   195	          end
   196	          return [ response, attempt ] unless retriable?(response) && attempt < final
   197	          @sleeper.call(delay_for(response, attempt))
   198	        end
   199	      end
   200	
   201	      def dispatch(request, template)
   202	        RateBudget.take!(budget: @budget)
   203	        started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
   204	        http(request.uri).request(request).tap { |response| log(request, template, response.code, started) }
   205	      rescue *TRANSPORT_FAILURES
   206	        log(request, template, "transport", started)
   207	        raise
   208	      end
   209	
   210	      def transport_failure(error, attempts, idempotent)
   211	        (idempotent ? TransportError : UnknownOutcome).new("#{error.class}: #{error.message}", attempts: attempts)
   212	      end
   213	
   214	      def retriable?(response) = response.code.to_i == 429 || response.code.to_i >= 500
   215	
   216	      def delay_for(response, attempt)
   217	        retry_after = Error.retry_after_in(response)
   218	        retry_after ? [ retry_after, RETRY_AFTER_CAP ].min : jittered(BACKOFF[attempt - 1])
   219	      end
   220	
   221	      def jittered(seconds) = seconds + rand * seconds * 0.25
   222	
   223	      def http(uri)
   224	        Net::HTTP.new(uri.host, uri.port).tap do |h|
   225	          h.use_ssl = true
   226	          h.open_timeout = OPEN_TIMEOUT
   227	          h.read_timeout = READ_TIMEOUT
   228	        end
   229	      end
   230	

