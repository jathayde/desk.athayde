# The glance screen's read model: one place that decides the banner, the numbers, and their freshness.
class Dashboard
  STALE_MULTIPLIER = 2
  Row = Data.define(:position, :as_of, :stale)

  attr_reader :now

  def initialize(now: Time.current)
    @now = now
    @settings = SystemSettings.instance
    @account = Account.trading.order(:id).first
  end

  attr_reader :account

  def state
    return :not_connected if token_status == :missing
    return :needs_setup if Account.needing_setup.exists? && account.nil?
    return :no_trading_account if account.nil?
    return :waiting_first_sync if balance.nil?
    :ready
  end

  def token_status = @token_status ||= SchwabToken.status
  def token = SchwabToken.current
  def halted? = @settings.manual_halt?
  def halt = @settings
  def halted_by = AuditEvent.where(kind: "manual_halt_set").order(created_at: :desc).first
  def sync_paused_reason = @settings.sync_paused_reason
  def sync_paused_since = SyncRun.skipped_token.minimum(:started_at)

  # The primary banner, highest severity first. Everything else active shows as a secondary status line.
  def banner
    return :halted if halted?
    return token_status if %i[ revoked expired missing expiring ].include?(token_status)
    nil
  end

  def secondary_statuses
    statuses = []
    statuses << token_status if halted? && token_status != :healthy
    statuses << :sync_paused if sync_paused_reason.present? && %i[ revoked expired missing ].exclude?(token_status)
    statuses << :sync_failed if sync_failure
    statuses << :calendar_fallback if MarketDay.find_by(date: MarketDay.today)&.fallback?
    statuses
  end

  def sync_failure
    return nil unless account && SchwabToken.usable?
    %i[ positions orders activities ].filter_map { |feed| account.last_sync_failure(feed) }.select { |run| run.started_at > account.last_sync(run.feed) || run.started_at > 1.day.ago }.max_by(&:started_at)
  end

  def balance = @balance ||= account&.current_balance
  def equity = balance&.equity

  # Flow-adjusted change since the prior snapshot by date, never by recency.
  def prior_snapshot = @prior_snapshot ||= account&.snapshots&.where(as_of: ...MarketDay.today)&.order(as_of: :desc)&.first

  def day_change
    return nil unless equity && prior_snapshot
    equity - Snapshot.net_flows(account, after: prior_snapshot.as_of, through: MarketDay.today) - prior_snapshot.equity
  end

  def day_change_ratio = day_change && prior_snapshot.equity.positive? ? day_change / prior_snapshot.equity : nil
  def day_change_label = prior_snapshot ? "since #{prior_snapshot.as_of.strftime('%a')} close" : "first snapshot after today's close"

  def rows
    @rows ||= account.positions.includes(:instrument, :working_stop_order).map { |p| Row.new(position: p, as_of: as_of_for(p), stale: stale?(as_of_for(p), :positions)) }
      .sort_by { |r| [ r.position.protected? ? 1 : 0, r.position.distance_to_stop || -BigDecimal("Infinity"), r.position.instrument.symbol ] }
  end

  def open_risk = rows.map(&:position).select(&:protected?).sum(&:open_risk)
  def open_risk_ratio = equity && equity.positive? ? open_risk / equity : nil
  def excluded_by_reason = rows.map(&:position).reject(&:protected?).group_by(&:protection).transform_values(&:size)
  def review_count = account ? account.trades.needing_review.count : 0
  def balance_stale? = balance && stale?(balance.as_of, :positions)
  def orders_as_of = account&.last_sync(:orders)

  # Stale: older than twice the cadence the tick would use right now plus its minute of slack, or any age once sync is paused.
  def stale?(time, feed)
    return true if time.nil? || sync_paused_reason.present?
    time < now - (account.sync_interval(feed) * STALE_MULTIPLIER + 1.minute)
  end

  private
    def as_of_for(position) = [ position.synced_at, orders_as_of ].compact.min
end

 succeeded in 0ms:
class Position < ApplicationRecord
  belongs_to :account
  belongs_to :instrument
  belongs_to :working_stop_order, class_name: "Order", optional: true

  validates :instrument_id, uniqueness: { scope: :account_id }

  scope :protected_by_stop, -> { where.not(working_stop_order_id: nil) }
  scope :unprotected, -> { where(working_stop_order_id: nil) }

  def stop_price = working_stop_order&.stop_price

  # Every live terminal sell stop on this instrument, so a scale-in covered by two stops reads as covered.
  def live_stops = account.orders.where(instrument: instrument).stops.sells.live.terminal

  def covered_quantity
    return nil unless working_stop_order
    live_stops.filter_map(&:remaining).sum
  end

  # Why this position is or is not protected. Only :protected counts; every other state is unknown or
  # insufficient risk, and the dashboard says which.
  def protection
    return :unprotected unless working_stop_order&.working?
    return :awaiting if !working_stop_order.live?
    return :trailing_unknown if stop_price.blank?
    return :oversized if covered_quantity > quantity
    return :partial if covered_quantity < quantity
    :protected
  end

  def protected? = protection == :protected
  def unprotected? = !protected?

  # Signed fraction of price between here and the stop; negative once price has gapped through it. Shown
  # whenever a stop price exists, since a partially covered stop is still the number to act on.
  def distance_to_stop
    return unless working_stop_order&.working? && stop_price.present? && last_price.present? && last_price.nonzero?
    (last_price - stop_price) / last_price
  end

  def unrealized_pnl = market_value && cost_basis ? market_value - cost_basis : nil

  # Dollars still at risk if the stop fills. Unknown (nil) without a usable stop, never zero for that reason,
  # and never negative: a position already through its stop has nothing left to protect.
  def open_risk
    return unless protected? && last_price.present?
    [ quantity * (last_price - stop_price), 0 ].max
  end

  # The newest terminal working sell stop on this instrument, preferring live statuses over AWAITING_* so a
  # new bracket child cannot displace the stop on an existing lot. Assigned regardless of price; #protection decides.
  def assign_working_stop!
    candidates = account.orders.where(instrument: instrument).stops.sells.working.terminal.to_a
    pick = newest(candidates.select(&:live?)) || newest(candidates)
    update!(working_stop_order: pick)
  end

  private
    def newest(orders) = orders.max_by { |o| o.entered_at || Time.at(0) }
end

