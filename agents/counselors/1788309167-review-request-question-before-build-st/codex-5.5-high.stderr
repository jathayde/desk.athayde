# Solid Queue recurring tasks. Cron with an explicit zone so a config.time_zone change cannot shift them,
# and because Solid Queue skips a schedule it cannot parse without failing boot (spec/config/recurring_spec.rb).
shared: &shared
  schwab_refresh_access_token:
    class: Schwab::RefreshAccessTokenJob
    queue: critical
    schedule: "*/25 * * * * America/New_York"
  schwab_token_health:
    class: Schwab::TokenHealthJob
    schedule: "0 8,20 * * * America/New_York"
  sync_tick:
    class: Sync::TickJob
    schedule: "*/5 * * * * America/New_York"
  sync_accounts:
    class: Sync::AccountsJob
    schedule: "5 6 * * * America/New_York"

development:
  <<: *shared

production:
  <<: *shared

