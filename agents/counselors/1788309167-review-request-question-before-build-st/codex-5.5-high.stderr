# A read tool: a name, a description, JSON schemas, permission metadata, and a call. Transport-neutral.
class Agent::Tool
  class << self
    attr_reader :tool_name, :description, :input_schema, :output_schema

    def tool(name, description:, input: {}, output:, read_only: true, interactive: true, scheduled: true)
      @tool_name, @description = name, description
      @input_schema = { type: "object", properties: input, additionalProperties: false }
      @output_schema = { type: "object", properties: output, additionalProperties: true }
      @read_only, @interactive_allowed, @scheduled_allowed = read_only, interactive, scheduled
      raise ArgumentError, "#{name}: an unattended tool must be read-only" if scheduled && !read_only
    end

    def read_only? = @read_only
    def interactive_allowed? = @interactive_allowed
    def scheduled_allowed? = @scheduled_allowed

    def annotations = { read_only_hint: read_only?, destructive_hint: !read_only?, idempotent_hint: read_only?, open_world_hint: false }

    # The shape the Anthropic Messages API and the MCP gem both consume.
    def definition = { name: tool_name, description: description, input_schema: input_schema }
  end

  def call(**) = raise(NotImplementedError)

  private
    def dashboard = @dashboard ||= Dashboard.new
    def account = dashboard.account
    def stamp(time, stale) = { as_of: time, stale: stale }
end

