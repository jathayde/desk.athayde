 succeeded in 0ms:
# The registry and the one dispatch entry point every transport uses.
module Agent::Tools
  Result = Data.define(:ok, :value, :error, :retry_after) do
    def self.success(value) = new(ok: true, value: value, error: nil, retry_after: nil)
    def self.failure(error, retry_after: nil) = new(ok: false, value: nil, error: error, retry_after: retry_after)
  end

  def self.all = [ GetPortfolio, GetAccountHealth, GetQuotes, GetPriceHistory, GetJournal, GetSetupStats, GetRiskRules ]

  def self.for(transport)
    case transport.to_sym
    when :mcp then all.select(&:interactive_allowed?)
    when :scheduled then all.select { |t| t.scheduled_allowed? && t.read_only? }
    else raise ArgumentError, "unknown transport #{transport}"
    end
  end

  def self.definitions(transport) = self.for(transport).map(&:definition)
  def self.find(name, transport:) = self.for(transport).find { |t| t.tool_name == name.to_s }

  # Permission check, argument normalization, telemetry, timing, and error normalization in one place.
  # Never raises to the caller: Schwab and tool failures become results the agent can read and act on.
  def self.call(name, arguments = {}, transport:, agent_run: nil)
    tool = find(name, transport: transport) or return Result.failure("unknown tool #{name} for #{transport}")
    dispatch(tool, arguments, transport, agent_run)
  end

  def self.dispatch(tool, arguments, transport, agent_run)
    record = ToolCall.new(agent_run: agent_run, transport: transport, tool_name: tool.tool_name, arguments: Agent.serialize(arguments.to_h))
    started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    result = Result.success(Agent.serialize(tool.new.call(**arguments.to_h.deep_symbolize_keys)))
  rescue Schwab::RateLimited => e
    result = Result.failure("Schwab rate limit: try again in #{e.retry_after || 60} seconds", retry_after: e.retry_after || 60)
  rescue Schwab::NoUsableToken, Schwab::AuthError => e
    result = Result.failure("Schwab connection needs re-authentication: #{e.message}")
  rescue Schwab::Error => e
    result = Result.failure("Schwab unavailable: #{e.message}")
  rescue ArgumentError => e
    result = Result.failure("bad arguments: #{e.message}")
  rescue StandardError => e
    Rails.error.report(e, handled: true, context: { tool: name })
    result = Result.failure("#{tool.tool_name} failed: #{e.class.name}")
  ensure
    record.duration_ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round
    record.error = result&.error
    record.save!
    return result
  end
  private_class_method :dispatch
end

