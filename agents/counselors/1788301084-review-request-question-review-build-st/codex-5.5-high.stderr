     8	  def authorize
     9	    session[:schwab_state] = { "value" => SecureRandom.hex(16), "at" => Time.current.to_i }
    10	    redirect_to Schwab.client.authorize_url(state: session[:schwab_state]["value"]), allow_other_host: true
    11	  end
    12	
    13	  def callback
    14	    pending = session.delete(:schwab_state)
