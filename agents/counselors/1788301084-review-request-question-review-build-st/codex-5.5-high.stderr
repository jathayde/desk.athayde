    15	      message = "Schwab responded #{status}: #{summarize(json, body)}"
    16	      opts = { status: status, body: body, request_id: request_id_in(json), attempts: attempts }
    17	      case status
    18	      when 401 then AuthError.new(message, **opts)
    19	      when 429 then RateLimited.new(message, retry_after: retry_after_in(response), **opts)
