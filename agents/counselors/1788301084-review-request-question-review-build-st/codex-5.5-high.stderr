    98	    private
    99	      def token_request(form, idempotent:)
   100	        request = Net::HTTP::Post.new(URI("#{OAUTH}/token"))
   101	        request.basic_auth(@app_key, @app_secret)
   102	        request["Accept"] = "application/json"
   103	        request.set_form_data(form)
   104	        response, attempts = perform(request, template: "/v1/oauth/token", idempotent: idempotent)
   105	        error = Error.for_response(response, attempts: attempts, idempotent: idempotent)
   106	        case response.code.to_i
   107	        when 200..299 then parse(response, attempts: attempts, idempotent: idempotent).except("id_token")
   108	        when 400, 401, 403 then raise ReauthRequired.new(error.message, status: error.status, body: error.body, attempts: attempts)
   109	        else raise error
   110	        end
   111	      end
   112	
   113	      def get(base, path, **params)
   114	        uri = URI("#{base}#{path}")
   115	        uri.query = URI.encode_www_form(params) if params.any?
   116	        response, attempts = authorized(uri)
   117	        raise Error.for_response(response, attempts: attempts, idempotent: true) unless response.is_a?(Net::HTTPSuccess)
   118	        Scrub.json(parse(response, attempts: attempts, idempotent: true))
   119	      end
   120	
   121	      # A non-JSON success body is a gateway page, not data.
   122	      def parse(response, attempts:, idempotent:)
   123	        JSON.parse(response.body.to_s)
   124	      rescue JSON::ParserError
   125	        raise (idempotent ? ServerError : UnknownOutcome).new("Schwab returned a non-JSON body", status: response.code.to_i,
   126	                                                              body: Scrub.body(response.body), attempts: attempts)
   127	      end
   128	
   129	      # One refresh-and-retry on 401, outside the backoff budget. The token model decides whether a
   130	      # refresh is still needed, so two processes seeing the same 401 cannot double-refresh.
   131	      def authorized(uri, refreshed: false)
   132	        request = Net::HTTP::Get.new(uri)
   133	        request["Authorization"] = "Bearer #{@token.access_token}"
   134	        request["Accept"] = "application/json"
   135	        response, attempts = perform(request, template: Scrub.path(uri.path), idempotent: true)
   136	        if response.code.to_i == 401 && !refreshed && @token.respond_to?(:refresh!)
   137	          @token.refresh!
   138	          return authorized(uri, refreshed: true)
   139	        end
   140	        [ response, attempts ]
   141	      end
   142	
   143	      # Returns [response, attempts]. Retries live here and nowhere else.
   144	      def perform(request, template:, idempotent:)
   145	        final = idempotent && @wait ? MAX_ATTEMPTS : 1
   146	        1.upto(final) do |attempt|
   147	          begin
   148	            response = dispatch(request, template)
   149	          rescue *TRANSPORT_FAILURES => e
   150	            raise transport_failure(e, attempt, idempotent) if attempt == final
   151	            @sleeper.call(jittered(BACKOFF[attempt - 1]))
   152	            next
   153	          end
   154	          return [ response, attempt ] unless retriable?(response) && attempt < final
   155	          @sleeper.call(delay_for(response, attempt))
   156	        end
   157	      end
   158	
   159	      def dispatch(request, template)
   160	        RateBudget.take!
   161	        started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
   162	        http(request.uri).request(request).tap { |response| log(request, template, response.code, started) }
   163	      rescue *TRANSPORT_FAILURES
   164	        log(request, template, "transport", started)
   165	        raise
   166	      end
   167	
   168	      def transport_failure(error, attempts, idempotent)
   169	        (idempotent ? TransportError : UnknownOutcome).new("#{error.class}: #{error.message}", attempts: attempts)
   170	      end
   171	
   172	      def retriable?(response) = response.code.to_i == 429 || response.code.to_i >= 500
   173	
   174	      def delay_for(response, attempt)
   175	        retry_after = Error.retry_after_in(response)
   176	        retry_after ? [ retry_after, RETRY_AFTER_CAP ].min : jittered(BACKOFF[attempt - 1])
   177	      end
   178	
   179	      def jittered(seconds) = seconds + rand * seconds * 0.25
   180	
   181	      def http(uri)
   182	        Net::HTTP.new(uri.host, uri.port).tap do |h|
   183	          h.use_ssl = true
   184	          h.open_timeout = OPEN_TIMEOUT
   185	          h.read_timeout = READ_TIMEOUT
   186	        end
   187	      end
   188	
   189	      def log(request, template, status, started)
   190	        ms = started ? ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round : 0
   191	        Rails.logger.info("schwab #{request.method} #{template} #{status} #{ms}ms")
   192	      end
   193	  end
   194	end

