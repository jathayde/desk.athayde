     1	# One re-auth: exchange the code, make sure the login is for the accounts we know, then issue the token.
     2	# Nothing is written until the last step, so a failure leaves the previous token untouched.
     3	class SchwabToken::Reauth
     4	  class Failure < StandardError; end
     5	
     6	  Candidate = Data.define(:access_token)
     7	
     8	  def initialize(code, user:)
     9	    @code, @user = code, user
    10	  end
    11	
    12	  def call
    13	    response = Schwab.client.exchange_code(@code)
    14	    verify_accounts!(response.fetch("access_token"))
    15	    token = SchwabToken.issue!(response)
    16	    AuditEvent.log("re_auth_succeeded", actor: :human, user: @user, subject: token, data: { refresh_expires_at: token.refresh_expires_at })
    17	    Sync::CatchUpJob.perform_later
    18	    token
    19	  end
    20	
    21	  private
    22	    # Defense in depth for an unverified state echo: a later auth must be for at least one known account.
    23	    def verify_accounts!(access_token)
    24	      known = Account.pluck(:schwab_hash)
    25	      return if known.empty?
    26	      seen = Schwab.client(token: Candidate.new(access_token: access_token)).account_numbers
    27	      raise Failure, "That Schwab login does not include any known account" if (known & seen).empty?
    28	    end
    29	end

