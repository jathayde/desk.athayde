     1	module Schwab
     2	  # Runs 08:00 and 20:00 ET. Nags when there is no usable token (every run), once per token when it enters
     3	  # the 24-hour window, and on Monday and Tuesday when the Sunday re-auth did not happen.
     4	  class TokenHealthJob < ApplicationJob
     5	    SUNDAY_EMAIL_HOUR = 18
     6	
     7	    def perform(now: Time.current)
     8	      token = SchwabToken.current
     9	      reason = nag_reason(token, now)
    10	      return unless reason
    11	      TokenMailer.nag(reason, token).deliver_now
    12	      AuditEvent.log("token_nag_sent", actor: :system, subject: token, reason: reason.to_s, data: { token_id: token&.id })
    13	    end
    14	
    15	    private
    16	      def nag_reason(token, now)
    17	        return :missing if token.nil?
    18	        return :revoked if token.revoked?
    19	        return :expired if token.refresh_expired?(now: now)
    20	        return :missed_sunday if missed_sunday?(token, now)
    21	        return :expiring if token.refresh_expiring_within?(now: now) && !already_warned?(token)
    22	        nil
    23	      end
    24	
    25	      def missed_sunday?(token, now)
    26	        local = now.in_time_zone("America/New_York")
    27	        return false unless local.monday? || local.tuesday?
    28	        token.issued_at < most_recent_sunday_email(local)
    29	      end
    30	
    31	      def most_recent_sunday_email(local)
    32	        sunday = local.to_date - ((local.to_date.wday - 0) % 7)
    33	        local.time_zone.local(sunday.year, sunday.month, sunday.day, SUNDAY_EMAIL_HOUR)
    34	      end
    35	
    36	      def already_warned?(token)
    37	        AuditEvent.where(kind: "token_nag_sent", subject: token).where("data->>'reason' = ? OR reason = ?", "expiring", "expiring").exists?
    38	      end
    39	  end
    40	end

