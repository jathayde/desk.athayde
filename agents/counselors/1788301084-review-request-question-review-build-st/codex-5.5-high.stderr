    22	    # token responds to #access_token and, if it can renew itself, #refresh!
    23	    # wait: false raises on the first retriable failure instead of sleeping; web callers use it.
    24	    def initialize(token: nil, app_key: Schwab.app_key, app_secret: Schwab.app_secret, callback_url: Schwab.callback_url,
    25	                   sleeper: method(:sleep), wait: true)
    26	      @token, @app_key, @app_secret, @callback_url, @sleeper, @wait = token, app_key, app_secret, callback_url, sleeper, wait
