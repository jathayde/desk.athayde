     4	  module Scrub
     5	    REDACTED_KEYS = %w[ accountNumber user ].freeze
     6	    ACCOUNT_HASH = /[0-9A-F]{64}/i
     7	    LONG_DIGIT_RUN = /\b\d{8,}\b/
     8	
     9	    def self.json(value)
    10	      case value
    11	      when Hash then value.each_with_object({}) { |(k, v), h| h[k] = REDACTED_KEYS.include?(k) ? nil : json(v) }
    12	      when Array then value.map { |v| json(v) }
    13	      else value
    14	      end
    15	    end
