diff --git a/app/models/schwab_token.rb b/app/models/schwab_token.rb
index a4ea68b..c20efb0 100644
--- a/app/models/schwab_token.rb
+++ b/app/models/schwab_token.rb
@@ -1,5 +1,75 @@
+# One row per authorization-code grant. The newest row is current; older rows are history.
+# Pause state is derived from the current token (usable?), never written by a failure.
 class SchwabToken < ApplicationRecord
+  REFRESH_LIFETIME = 168.hours # elapsed time, not calendar days; never extended by a refresh
+  ACCESS_MARGIN = 60.seconds
+  REFRESH_DEBOUNCE = 1.minute
+  EXPIRING_SOON = 24.hours
+
   encrypts :access_token, :refresh_token
 
-  def self.current = order(issued_at: :desc).first
+  def self.current = order(issued_at: :desc, id: :desc).first
+
+  def self.usable? = current&.usable? || false
+
+  # A successful code exchange. Clears the pause in the same transaction; catch-up sync runs after commit.
+  def self.issue!(response, now: Time.current)
+    transaction do
+      create!(access_token: response.fetch("access_token"), refresh_token: response.fetch("refresh_token"),
+              access_expires_at: now + response.fetch("expires_in").to_i.seconds - ACCESS_MARGIN,
+              refresh_expires_at: now + REFRESH_LIFETIME, issued_at: now, scope: response["scope"]).tap do
+        SystemSettings.instance.update!(sync_paused_reason: nil)
+      end
+    end
+  end
+
+  def current? = self.class.current&.id == id
+  def revoked? = revoked_at.present?
+  def refresh_expired?(now: Time.current) = refresh_expires_at <= now
+  def access_expired?(now: Time.current) = access_expires_at <= now
+  def refresh_expiring_within?(window = EXPIRING_SOON, now: Time.current) = refresh_expires_at <= now + window
+  def usable?(now: Time.current) = !revoked? && !refresh_expired?(now: now)
+  def age(now: Time.current) = now - issued_at
+
+  # Refreshes the access token under the row lock. Reloads first, so a stale row does nothing and two
+  # workers holding the same 401 refresh once. Raises what the client raised after recording it.
+  def refresh!
+    outcome = with_lock do
+      next :stale unless current? && usable?
+      next :recent if last_refreshed_at && last_refreshed_at > REFRESH_DEBOUNCE.ago
+      apply_refresh(Schwab.client(token: self).refresh(refresh_token))
+      :refreshed
+    end
+    outcome
+  rescue Schwab::ReauthRequired => e
+    record_failure(e, revoke: true)
+    raise
+  rescue Schwab::Error => e
+    record_failure(e, revoke: false)
+    raise
+  end
+
+  # Refresh ahead of expiry so a 401 is the safety net, not the routine path.
+  def ensure_fresh!(margin: 5.minutes)
+    refresh! if access_expires_at <= margin.from_now
+    self
+  end
+
+  private
+    def apply_refresh(response, now: Time.current)
+      update!(access_token: response.fetch("access_token"),
+              refresh_token: response["refresh_token"].presence || refresh_token,
+              access_expires_at: now + response.fetch("expires_in").to_i.seconds - ACCESS_MARGIN,
+              last_refreshed_at: now, last_refresh_error: nil)
+    end
+
+    # Outside the lock, so a rolled-back transaction cannot lose the record of what happened.
+    def record_failure(error, revoke:)
+      reload
+      update_columns(last_refresh_error: error.message.truncate(500), updated_at: Time.current)
+      return unless revoke && current?
+      update_columns(revoked_at: Time.current)
+      SystemSettings.instance.update!(sync_paused_reason: "Schwab refresh token rejected; re-authenticate")
+      AuditEvent.log("token_refresh_failed", actor: :system, subject: self, reason: error.message.truncate(200), data: { status: error.status })
+    end
 end

