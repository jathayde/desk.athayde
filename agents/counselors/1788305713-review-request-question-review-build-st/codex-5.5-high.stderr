     1	class Instrument < ApplicationRecord
     2	  belongs_to :predecessor_instrument, class_name: "Instrument", optional: true
     3	  has_many :positions, dependent: :restrict_with_exception
     4	  has_many :orders, dependent: :restrict_with_exception
     5	  has_many :activities, dependent: :restrict_with_exception
     6	  has_many :trades, dependent: :restrict_with_exception
     7	
     8	  normalizes :cusip, with: ->(c) { c.strip.upcase.presence }
     9	  normalizes :symbol, with: ->(s) { s.strip.upcase }
    10	
    11	  validates :symbol, presence: true
    12	  validate :predecessor_is_another_instrument
    13	
    14	  # Identity in order of trust: CUSIP, Schwab instrument id, then symbol and asset type among rows that have
    15	  # no CUSIP, then a Schwab lookup by symbol, then a provisional row. A weaker match backfills a missing
    16	  # identifier from the ref but never overwrites a differing one.
    17	  def self.resolve(ref, attempt: 1)
    18	    return nil if ref.nil? || ref.symbol.blank?
    19	    found = find_by(cusip: ref.cusip) if ref.cusip.present?
    20	    found ||= find_by(schwab_instrument_id: ref.instrument_id) if ref.instrument_id.present?
    21	    found ||= where(cusip: nil, symbol: ref.symbol, asset_type: ref.asset_type).first
    22	    found ? found.absorb(ref) : create_from(ref)
    23	  rescue ActiveRecord::RecordNotUnique
    24	    # Another feed created or backfilled it between our lookup and our write; look once more, then give up.
    25	    raise Schwab::MappingError, "instrument #{ref.symbol} keeps colliding on identity" if attempt > 1
    26	    resolve(ref, attempt: attempt + 1)
    27	  end
    28	
    29	  def self.create_from(ref)
    30	    cusip = ref.cusip.presence || lookup_cusip(ref.symbol)
    31	    if cusip && (existing = find_by(cusip: cusip))
    32	      return existing.absorb(ref.with(cusip: cusip))
    33	    end
    34	    create!(cusip: cusip, schwab_instrument_id: ref.instrument_id, symbol: ref.symbol, asset_type: ref.asset_type, description: ref.description).tap do |instrument|
    35	      AuditEvent.log("instrument_identity_fallback", actor: :system, subject: instrument, data: { symbol: ref.symbol, asset_type: ref.asset_type }) if cusip.blank?
    36	    end
    37	  end
    38	
    39	  def self.lookup_cusip(symbol)
    40	    Schwab::InstrumentRef.from(Schwab.client(wait: false).instrument_by_symbol(symbol).first)&.cusip
    41	  rescue Schwab::Error
    42	    nil
    43	  end
    44	
    45	  # A weaker-key match learns identifiers it lacked; a conflicting identifier already owned elsewhere is left alone.
    46	  def absorb(ref)
    47	    update!(cusip: ref.cusip) if cusip.blank? && ref.cusip.present? && !self.class.exists?(cusip: ref.cusip)
    48	    update!(schwab_instrument_id: ref.instrument_id) if schwab_instrument_id.blank? && ref.instrument_id.present? && !self.class.exists?(schwab_instrument_id: ref.instrument_id)
    49	    rename!(ref.symbol) if cusip.present? && cusip == ref.cusip && symbol != ref.symbol
    50	    self
    51	  end
    52	
    53	  def rename!(new_symbol, at: Time.current)
    54	    return if new_symbol == symbol
    55	    update!(symbol: new_symbol, symbol_history: symbol_history + [ { "symbol" => symbol, "until" => at.utc.iso8601 } ])
    56	  end
    57	
    58	  private
    59	    def predecessor_is_another_instrument
    60	      errors.add(:predecessor_instrument, "cannot be itself") if persisted? && predecessor_instrument_id == id
    61	    end
    62	end

