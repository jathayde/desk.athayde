     1	# One row per account per market day, chain-linked so deposits and withdrawals never move the drawdown.
     2	class Snapshot < ApplicationRecord
     3	  belongs_to :account
     4	
     5	  scope :chronological, -> { order(:as_of) }
     6	
     7	  # Builds (or rebuilds) the snapshot for one day from balances, flows, and positions. Returns nil, writing
     8	  # nothing, when the day has no usable balance: a stale balance is never smeared across days.
     9	  def self.build!(account, date)
    10	    day = MarketDay.find_by(date: date)
    11	    return nil unless day&.schwab? && day.trading?
    12	    balance = balance_for(account, day) or return nil
    13	    return nil unless balance.equity&.positive?
    14	
    15	    prior = account.snapshots.where(as_of: ...date).order(as_of: :desc).first
    16	    flows = net_flows(account, after: prior&.as_of, through: date)
    17	    daily_return = prior ? (balance.equity - flows - prior.equity) / prior.equity : BigDecimal("0")
    18	    index = prior ? prior.index_value * (1 + daily_return) : BigDecimal("1")
    19	    high_water = [ prior&.high_water_index || BigDecimal("1"), index ].max
    20	    protected_positions = account.positions.includes(:working_stop_order).select(&:protected?)
    21	    open_risk = protected_positions.sum(&:open_risk)
    22	
    23	    snapshot = account.snapshots.find_or_initialize_by(as_of: date)
    24	    snapshot.update!(equity: balance.equity, net_flows: flows, daily_return: daily_return, index_value: index, high_water_index: high_water,
    25	                     drawdown: 1 - index / high_water, open_risk_amount: open_risk, open_risk_ratio: open_risk / balance.equity,
    26	                     unprotected_count: account.positions.count - protected_positions.size)
    27	    snapshot
    28	  end
    29	
    30	  # Latest balance at or after the regular close on the day, else the day's latest, else nothing.
    31	  def self.balance_for(account, day)
    32	    on_day = account.balances.where(as_of: day.regular_opens_at.beginning_of_day..day.regular_opens_at.end_of_day)
    33	    on_day.where(as_of: day.regular_closes_at..).order(as_of: :desc).first || on_day.order(as_of: :desc).first
    34	  end
    35	
    36	  # Deposits positive, withdrawals negative, over every day since the prior snapshot so a flow on a
    37	  # missing day is still neutralized. Share transfers count at the position's current price when known.
    38	  def self.net_flows(account, after:, through:)
    39	    range = after ? (after + 1)..through : ..through
    40	    cash = account.activities.where(kind: %w[ deposit withdrawal ], trade_date: range).sum(:net_amount)
    41	    shares = account.activities.where(kind: :transfer, trade_date: range).where.not(instrument_id: nil).sum do |a|
    42	      price = account.positions.find_by(instrument_id: a.instrument_id)&.last_price
    43	      price && a.quantity ? a.quantity * price * (a.net_amount&.negative? ? -1 : 1) : 0
    44	    end
    45	    cash + shares
    46	  end
    47	end

