     1	module Journal
     2	  # Every open position in a trading account has one open trade; the plug leg reconciles the journal to the
     3	  # broker. After a complete positions sync, an open trade with no position is flagged.
     4	  class BootstrapJob < ApplicationJob
     5	    limits_concurrency to: 1, key: ->(account) { "journal-#{account.id}" }, on_conflict: :discard
     6	
     7	    def perform(account)
     8	      return unless account.trading_enabled?
     9	      account.positions.includes(:instrument).find_each do |position|
    10	        next if position.quantity <= 0 || position.average_price.nil?
    11	        trade = account.trades.open.find_or_create_by!(instrument: position.instrument)
    12	        trade.reconcile_plug!(position.quantity, average_price: position.average_price)
    13	      rescue ActiveRecord::RecordNotUnique
    14	        retry
    15	      end
    16	      held = account.positions.pluck(:instrument_id)
    17	      account.trades.open.where.not(instrument_id: held).find_each do |trade|
    18	        trade.flag!(:position_missing) unless account.activities.unjournaled.where(instrument_id: trade.instrument_id).exists?
    19	      end
    20	    end
    21	  end
    22	end

