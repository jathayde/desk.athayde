     1	module Schwab
     2	  # One transaction activity. The primary security transfer item gives instrument, quantity, and price
     3	  # (trades only; on a dividend the item's amount is dollars); fee items are summed; every security item
     4	  # is kept in `securities` because a CUSIP succession arrives as two of them in one activity.
     5	  # Sign conventions are SCHWAB_SHAPE_UNVERIFIED; side prefers positionEffect, then the sign of netAmount.
     6	  class Activity < Data.define(:activity_id, :type, :activity_type, :status, :sub_account, :description, :order_id,
     7	                               :net_amount, :trade_date, :settlement_date, :executed_at, :instrument, :securities, :quantity, :price,
     8	                               :position_effect, :commission, :fees, :raw)
     9	    Security = Data.define(:instrument, :amount, :cost, :price, :position_effect)
    10	
    11	    # The transaction types a cash account produces; one request each. SCHWAB_SHAPE_UNVERIFIED.
    12	    CASH_ACCOUNT_TYPES = %w[ TRADE RECEIVE_AND_DELIVER DIVIDEND_OR_INTEREST ELECTRONIC_FUND ACH_RECEIPT ACH_DISBURSEMENT WIRE_IN WIRE_OUT
    13	                             JOURNAL CASH_RECEIPT CASH_DISBURSEMENT MONEY_MARKET ].freeze
    14	    VALID = "VALID"
    15	    INBOUND_TYPES = %w[ ACH_RECEIPT WIRE_IN CASH_RECEIPT ].freeze
    16	    OUTBOUND_TYPES = %w[ ACH_DISBURSEMENT WIRE_OUT CASH_DISBURSEMENT ].freeze
    17	    SIGNED_TYPES = %w[ ELECTRONIC_FUND ].freeze # direction only from the sign of netAmount
    18	
    19	    def self.from(raw)
    20	      activity_id = raw.fetch("activityId") { raise MappingError, "activity without activityId" }.to_s
    21	      items = Array(raw["transferItems"])
    22	      securities = items.select { |i| i["feeType"].blank? && !(InstrumentRef.from(i["instrument"])&.currency?) }
    23	        .map { |i| Security.new(instrument: InstrumentRef.from(i["instrument"]), amount: Decimal.parse(i["amount"]), cost: Decimal.parse(i["cost"]),
    24	                                price: Decimal.parse(i["price"]), position_effect: i["positionEffect"]) }
    25	      fee_items = items.select { |i| i["feeType"].present? }
    26	      executed_at = Timestamp.parse(raw["time"]) || Timestamp.parse(raw["tradeDate"]) or raise MappingError, "activity #{activity_id} has no time or tradeDate"
    27	      primary = securities.first
    28	      trade = raw["type"] == "TRADE"
    29	
    30	      new(activity_id: activity_id, type: raw["type"], activity_type: raw["activityType"], status: raw["status"],
    31	          sub_account: raw["subAccount"], description: raw["description"], order_id: raw["orderId"]&.to_s,
    32	          net_amount: Decimal.parse(raw["netAmount"]),
    33	          trade_date: Timestamp.parse_date(raw["tradeDate"]), settlement_date: Timestamp.parse_date(raw["settlementDate"]),
    34	          executed_at: executed_at,
    35	          instrument: primary&.instrument, securities: securities,
    36	          quantity: trade ? primary&.amount&.abs : nil,
    37	          price: trade ? primary&.price : nil,
    38	          position_effect: primary&.position_effect,
    39	          commission: fee_items.select { |i| i["feeType"] == "COMMISSION" }.sum(Decimal::ZERO) { |i| Decimal.parse_or_zero(i["amount"]).abs },
    40	          fees: fee_items.reject { |i| i["feeType"] == "COMMISSION" }.sum(Decimal::ZERO) { |i| Decimal.parse_or_zero(i["amount"]).abs },
    41	          raw: raw)
    42	    end
    43	
    44	    def trade? = type == "TRADE"
    45	    def valid? = status.nil? || status == "VALID"
    46	
    47	    # The app's classification of this activity. :other is never a quiet success; the sync counts it.
    48	    def kind
    49	      return :fee if fee_only?
    50	      cash_equivalent = instrument&.asset_type == "CASH_EQUIVALENT"
    51	      case type
    52	      when "TRADE" then cash_equivalent ? :sweep : :fill
    53	      when "MONEY_MARKET" then :sweep
    54	      when "DIVIDEND_OR_INTEREST" then instrument && !cash_equivalent ? :dividend : :interest
    55	      when *INBOUND_TYPES then :deposit
    56	      when *OUTBOUND_TYPES then :withdrawal
    57	      when *SIGNED_TYPES then net_amount&.negative? ? :withdrawal : :deposit
    58	      when "JOURNAL", "RECEIVE_AND_DELIVER"
    59	        if securities.size >= 2 then :corporate_action
    60	        elsif securities.one? then :transfer
    61	        elsif type == "JOURNAL" then net_amount&.negative? ? :withdrawal : :deposit
    62	        else :other
    63	        end
    64	      else :other
    65	      end
    66	    end
    67	    def fee_only? = raw.fetch("transferItems", []).then { |items| items.any? && items.all? { |i| i["feeType"].present? } }
    68	
    69	    # What the sync records about an activity it could not classify.
    70	    def summary = { type: type, activity_type: activity_type, sub_account: sub_account, description: description, net_amount: net_amount&.to_s }
    71	
    72	    def side
    73	      return nil unless trade?
    74	      case position_effect
    75	      when "OPENING" then "BUY"
    76	      when "CLOSING" then "SELL"
    77	      else net_amount&.negative? ? "BUY" : (net_amount ? "SELL" : nil)
    78	      end
    79	    end
    80	  end
    81	end

