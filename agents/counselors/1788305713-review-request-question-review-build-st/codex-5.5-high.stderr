/bin/zsh -lc "nl -ba app/models/position.rb | sed -n '1,220p'" in /Users/jathayde/Development/Personal/desk.athayde
 succeeded in 0ms:
     1	class Position < ApplicationRecord
     2	  belongs_to :account
     3	  belongs_to :instrument
     4	  belongs_to :working_stop_order, class_name: "Order", optional: true
     5	
     6	  validates :instrument_id, uniqueness: { scope: :account_id }
     7	
     8	  scope :protected_by_stop, -> { where.not(working_stop_order_id: nil) }
     9	  scope :unprotected, -> { where(working_stop_order_id: nil) }
    10	
    11	  def stop_price = working_stop_order&.stop_price
    12	
    13	  # Every live terminal sell stop on this instrument, so a scale-in covered by two stops reads as covered.
    14	  def live_stops = account.orders.where(instrument: instrument).stops.sells.live.terminal
    15	
    16	  def covered_quantity
    17	    return nil unless working_stop_order
    18	    live_stops.filter_map(&:remaining).sum
    19	  end
    20	
    21	  # Why this position is or is not protected. Only :protected counts; every other state is unknown or
    22	  # insufficient risk, and the dashboard says which.
    23	  def protection
    24	    return :unprotected unless working_stop_order&.working?
    25	    return :awaiting if !working_stop_order.live?
    26	    return :trailing_unknown if stop_price.blank?
    27	    return :oversized if covered_quantity > quantity
    28	    return :partial if covered_quantity < quantity
    29	    :protected
    30	  end
    31	
    32	  def protected? = protection == :protected
    33	  def unprotected? = !protected?
    34	
    35	  # Signed fraction of price between here and the stop; negative once price has gapped through it.
    36	  def distance_to_stop
    37	    return unless protected? && last_price.present? && last_price.nonzero?
    38	    (last_price - stop_price) / last_price
    39	  end
    40	
    41	  # Dollars still at risk if the stop fills. Unknown (nil) without a usable stop, never zero for that reason,
    42	  # and never negative: a position already through its stop has nothing left to protect.
    43	  def open_risk
    44	    return unless protected? && last_price.present?
    45	    [ quantity * (last_price - stop_price), 0 ].max
    46	  end
    47	
    48	  # The newest terminal working sell stop on this instrument, preferring live statuses over AWAITING_* so a
    49	  # new bracket child cannot displace the stop on an existing lot. Assigned regardless of price; #protection decides.
    50	  def assign_working_stop!
    51	    candidates = account.orders.where(instrument: instrument).stops.sells.working.terminal.to_a
    52	    pick = newest(candidates.select(&:live?)) || newest(candidates)
    53	    update!(working_stop_order: pick)
    54	  end
    55	
    56	  private
    57	    def newest(orders) = orders.max_by { |o| o.entered_at || Time.at(0) }
    58	end

