     1	module Sync
     2	  # The only scheduled sync entry point. Refreshes the calendar, checks the token once, and enqueues what is due.
     3	  class TickJob < ApplicationJob
     4	    INTRADAY = { positions: 15.minutes, orders: 5.minutes, activities: 5.minutes }.freeze
     5	    OFF_HOURS = 60.minutes
     6	    CALENDAR_DAYS = 7
     7	    SNAPSHOT_DELAY = 20.minutes
     8	
     9	    def perform
    10	      refresh_calendar
    11	      return pause! unless SchwabToken.usable?
    12	
    13	      in_session = MarketDay.session_open?
    14	      Account.find_each do |account|
    15	        intraday = in_session && account.trading_enabled?
    16	        INTRADAY.each do |feed, interval|
    17	          every = intraday ? interval : OFF_HOURS
    18	          next unless SyncRun.due?(feed, account, every: every)
    19	          job_for(feed).perform_later(account)
    20	        end
    21	        Snapshots::DailyJob.perform_later(account, today) if snapshot_due?(account, today)
    22	      end
    23	    end
    24	
    25	    private
    26	      # Once per Schwab-sourced market day, 20 minutes after the regular close, after a positions sync since the close.
    27	      def snapshot_due?(account, date)
    28	        day = MarketDay.find_by(date: date)
    29	        return false unless account.trading_enabled? && day&.schwab? && day.trading? && Time.current >= day.regular_closes_at + SNAPSHOT_DELAY
    30	        return false if account.snapshots.exists?(as_of: date)
    31	        SyncRun.for(:positions, account).advanced_cursor.where(started_at: day.regular_closes_at..).exists?
    32	      end
    33	
    34	      def today = MarketDay.today
    35	
    36	
    37	      def refresh_calendar
    38	        today = MarketDay.today
    39	        (today..today + CALENDAR_DAYS).each { |date| MarketDay.for(date) }
    40	      end
    41	
    42	      # One skipped row per hour and one audit per episode; nothing is enqueued, so the queue cannot grow.
    43	      # The settings row lock serializes this against issue!, so a re-auth landing mid-tick cannot be marked paused.
    44	      def pause!
    45	        reason = SystemSettings.transaction do
    46	          settings = SystemSettings.instance.lock!
    47	          next nil if SchwabToken.usable?
    48	          unless settings.sync_paused_reason
    49	            settings.update!(sync_paused_reason: "Schwab token unusable; re-authenticate")
    50	            AuditEvent.log("sync_paused_token_expired", actor: :system)
    51	          end
    52	          settings.sync_paused_reason
    53	        end
    54	        return if reason.nil? || SyncRun.where(status: :skipped_token, started_at: 1.hour.ago..).exists?
    55	        SyncRun.create!(feed: :positions, status: :skipped_token, started_at: Time.current, finished_at: Time.current, error: reason)
    56	      end
    57	
    58	      def job_for(feed) = { positions: PositionsJob, orders: OrdersJob, activities: ActivitiesJob }.fetch(feed)
    59	  end
    60	end

