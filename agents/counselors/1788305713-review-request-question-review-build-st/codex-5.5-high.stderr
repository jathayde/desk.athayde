     1	# Links one account's unjournaled activities into trades, one activity per transaction: find or insert the leg,
     2	# recompute the trade from its legs, then stamp journaled_at last. A rerun finds the leg and recomputes.
     3	class Journal::Linker
     4	  def initialize(account)
     5	    @account = account
     6	  end
     7	
     8	  def link_all!
     9	    @account.activities.unjournaled.valid_for_journal.chronological.includes(:instrument, :order).each { |activity| link!(activity) }
    10	    @account.activities.unjournaled.where.not(status: Schwab::Activity::VALID).update_all(journaled_at: Time.current)
    11	  end
    12	
    13	  def link!(activity)
    14	    Activity.transaction do
    15	      case activity.kind.to_sym
    16	      when :fill then link_fill(activity)
    17	      when :dividend, :interest then link_income(activity)
    18	      when :transfer then link_transfer(activity)
    19	      when :corporate_action then link_corporate_action(activity)
    20	      end
    21	      activity.update!(journaled_at: Time.current)
    22	    end
    23	  end
    24	
    25	  private
    26	    def open_trade_for(instrument) = @account.trades.open.find_by(instrument: instrument)
    27	
    28	    def link_fill(activity)
    29	      return if activity.instrument.nil? || activity.side.nil? || activity.quantity.nil?
    30	      trade = open_trade_for(activity.instrument) || open_trade_from(activity)
    31	      leg = trade.trade_legs.find_or_create_by!(activity: activity) do |l|
    32	        l.kind = activity.buy? ? :entry : :exit
    33	        l.quantity = activity.quantity
    34	        l.price = activity.price
    35	        l.cash_amount = activity.net_amount
    36	        l.executed_at = activity.executed_at
    37	      end
    38	      latest = trade.trade_legs.where.not(id: leg.id).where.not(activity_id: nil).maximum(:executed_at)
    39	      trade.flag!(:ordering_ambiguous) if latest && leg.executed_at < latest
    40	      trade.recompute!
    41	      trade.update!(stopped_out: true) if trade.closed? && leg.kind_exit? && activity.order&.stop?
    42	    end
    43	
    44	    # A buy with no open trade starts one, copying the proposal's plan when the fill came from the app.
    45	    # A sell with no open trade is a legacy holding: bootstrap a plug that covers what was held before the sale.
    46	    def open_trade_from(activity)
    47	      proposal = activity.order&.order_proposal
    48	      trade = @account.trades.create!(instrument: activity.instrument, status: :open, order_proposal: proposal, setup: proposal&.setup,
    49	                                      thesis: proposal&.thesis, planned_stop: proposal&.planned_stop, planned_target: proposal&.target_price)
    50	      if !activity.buy?
    51	        position = @account.positions.find_by(instrument: activity.instrument)
    52	        held_before = (position&.quantity || 0) + activity.quantity
    53	        trade.reconcile_plug!(held_before, average_price: position&.average_price || activity.price)
    54	      elsif proposal.nil?
    55	        trade.flag!(:missing_setup)
    56	      elsif trade.planned_stop.nil?
    57	        trade.flag!(:missing_stop)
    58	      end
    59	      trade
    60	    rescue ActiveRecord::RecordNotUnique
    61	      open_trade_for(activity.instrument)
    62	    end
    63	
    64	    # Income lands on the open trade, else on a trade closed recently enough to have held the shares on the record date.
    65	    def link_income(activity)
    66	      return if activity.instrument.nil?
    67	      trade = open_trade_for(activity.instrument) ||
    68	        @account.trades.closed.where(instrument: activity.instrument, closed_at: (activity.executed_at - Trade::DIVIDEND_AFTER_CLOSE_WINDOW)..).order(closed_at: :desc).first
    69	      return unless trade
    70	      trade.trade_legs.find_or_create_by!(activity: activity) { |l| l.kind = :income; l.cash_amount = activity.net_amount; l.executed_at = activity.executed_at }
    71	      trade.recompute!
    72	    end
    73	
    74	    # Shares delivered onto an open trade (split, stock dividend, ACAT in): an adjustment with the derived ratio.
    75	    def link_transfer(activity)
    76	      return if activity.instrument.nil? || activity.quantity.nil?
    77	      trade = open_trade_for(activity.instrument) or return
    78	      return if trade.trade_legs.exists?(activity: activity)
    79	      running = trade.quantity
    80	      delivered = activity.net_amount&.negative? ? -activity.quantity : activity.quantity
    81	      if running.positive? && delivered.positive? && ((running + delivered) / running).then { |r| r == r.round(6) && r > 1 }
    82	        ratio = (running + delivered) / running
    83	        trade.trade_legs.create!(activity: activity, kind: :adjustment, ratio: ratio, quantity: delivered, cash_amount: 0, executed_at: activity.executed_at, note: "split or stock dividend")
    84	        trade.update!(planned_stop: trade.planned_stop && trade.planned_stop / ratio, planned_target: trade.planned_target && trade.planned_target / ratio)
    85	      else
    86	        trade.trade_legs.create!(activity: activity, kind: :adjustment, quantity: delivered, cash_amount: activity.net_amount, executed_at: activity.executed_at, note: "transfer")
    87	        trade.flag!(:corporate_action)
    88	      end
    89	      trade.recompute!
    90	    end
    91	
    92	    # CUSIP succession: the old instrument's open trade moves to the new instrument, absorbing any unreviewed
    93	    # bootstrapped trade already opened there by the positions sync.
    94	    def link_corporate_action(activity)
    95	      securities = Schwab::Activity.from(activity.raw).securities
    96	      out_ref = securities.find { |s| s.amount&.negative? }&.instrument
    97	      in_ref = securities.find { |s| s.amount&.positive? }&.instrument
    98	      old = out_ref && Instrument.resolve(out_ref)
    99	      new = in_ref && Instrument.resolve(in_ref)
   100	      trade = old && open_trade_for(old)
   101	      return flag_orphans(activity, old, new) unless trade && new
   102	      Trade.transaction do
   103	        if (bootstrapped = open_trade_for(new)) && bootstrapped.bootstrapped? && bootstrapped.needs_review?
   104	          bootstrapped.trade_legs.where.not(activity_id: nil).update_all(trade_id: trade.id)
   105	          bootstrapped.destroy!
   106	        end
   107	        new.update!(predecessor_instrument: old) if new.predecessor_instrument_id.nil? && new != old
   108	        old_quantity = trade.quantity
   109	        new_quantity = securities.find { |s| s.amount&.positive? }.amount
   110	        ratio = old_quantity.positive? ? new_quantity / old_quantity : nil
   111	        trade.update!(instrument: new)
   112	        trade.trade_legs.create!(activity: activity, kind: :adjustment, ratio: ratio, cash_amount: activity.net_amount, executed_at: activity.executed_at, note: "succession #{old.symbol} -> #{new.symbol}")
   113	        trade.update!(planned_stop: ratio && trade.planned_stop && trade.planned_stop / ratio, planned_target: ratio && trade.planned_target && trade.planned_target / ratio)
   114	        trade.flag!(:corporate_action) unless ratio
   115	        trade.recompute!
   116	      end
   117	    end
   118	
   119	    def flag_orphans(activity, old, new)
   120	      [ old, new ].compact.each { |instrument| open_trade_for(instrument)&.flag!(:corporate_action) }
   121	    end
   122	end

