     1	module Sync
     2	  # Activities for one account, one request per transaction type a cash account produces. A bad request on
     3	  # one type fails the run so the cursor does not advance past rows that were never fetched; the rows that
     4	  # did arrive are still upserted and will simply be seen again. A malformed record is quarantined alone.
     5	  class ActivitiesJob < FeedJob
     6	    OVERLAP = 3.days
     7	
     8	    limits_concurrency to: 1, key: ->(account) { "activities-#{account.id}" }, on_conflict: :discard
     9	
    10	    def perform(account)
    11	      from, to, gap_from = window_for(:activities, account, overlap: OVERLAP)
    12	      SyncRun.record(:activities, account: account, window_from: from, window_to: to) do |run|
    13	        note_gap(run, gap_from, account)
    14	        @earliest_flow = nil
    15	        outcome = :succeeded
    16	        Schwab::Activity::CASH_ACCOUNT_TYPES.each do |type|
    17	          raws = client.transactions(account.schwab_hash, from: from, to: to, type: type)
    18	          raws.each { |raw| upsert(account, raw, run) }
    19	          run.touched(raws.size)
    20	        rescue Schwab::RequestError => e
    21	          run.quarantine(:activity_types_rejected, "#{type}: #{e.message}")
    22	          outcome = :failed
    23	        end
    24	        Journal::LinkFillsJob.perform_later(account) if account.trading_enabled?
    25	        Snapshots::RebuildJob.perform_later(account, from: @earliest_flow) if @earliest_flow && account.trading_enabled?
    26	        outcome
    27	      end
    28	    end
    29	
    30	    private
    31	      def upsert(account, raw, run)
    32	        activity = Schwab::Activity.from(raw)
    33	        instrument = activity.instrument && Instrument.resolve(activity.instrument)
    34	        if activity.instrument && instrument.nil?
    35	          run.quarantine(:activities_unresolved, activity.instrument.to_h)
    36	          return
    37	        end
    38	        row = account.activities.find_or_initialize_by(broker_activity_id: activity.activity_id)
    39	        kind = activity.kind
    40	        new_record = row.new_record?
    41	        run.quarantine(:activity_kinds_other, activity.summary) if kind == :other && new_record
    42	        row.update!(instrument: instrument, order: activity.order_id && account.orders.find_by(broker_order_id: activity.order_id),
    43	                    broker_order_id: activity.order_id, kind: kind, status: activity.status, sub_type: activity.type, side: activity.side,
    44	                    quantity: activity.quantity, price: activity.price, commission: activity.commission, fees: activity.fees,
    45	                    net_amount: activity.net_amount, trade_date: activity.trade_date, settlement_date: activity.settlement_date,
    46	                    executed_at: activity.executed_at, raw: activity.raw)
    47	        changed = row.saved_changes.keys.intersect?(%w[ quantity price status net_amount kind ])
    48	        row.unjournal! if row.journaled? && changed && !new_record
    49	        if row.cash_flow? && (new_record || changed) && row.trade_date
    50	          @earliest_flow = [ @earliest_flow, row.trade_date ].compact.min
    51	        end
    52	      rescue Schwab::MappingError, ActiveRecord::RecordInvalid => e
    53	        run.quarantine(:activities_unmapped, e.message)
    54	      end
    55	  end
    56	end

