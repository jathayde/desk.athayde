   107	    # Every entry fill from the first fill's order (a partial fill is still one entry); without an order id, the first fill alone.
   108	    def initial_quantity_from(first_fill)
   109	      return nil unless first_fill
   110	      legs = ordered_legs.to_a.select(&:activity_id)
   111	      same_order = first_fill.activity&.broker_order_id
   112	      group = same_order ? legs.select { |l| l.kind_entry? && l.activity&.broker_order_id == same_order } : [ first_fill ]
   113	      group.sum(&:quantity)
   114	    end
   115	
   116	    # Splits after a leg scale its quantity up and its price down; risk in dollars is unchanged.
   117	    def split_factor_after(leg)
   118	      ordered_legs.to_a.drop_while { |l| l.id != leg.id }.drop(1).select { |l| l.kind_adjustment? && l.ratio }.reduce(BigDecimal("1")) { |f, l| f * l.ratio }
   119	    end
   120	
   121	    # Fixed to the initial entry. Nil, never a number, when the stop is unknown, above the entry, or the entry is synthetic.
   122	    def compute_initial_risk
   123	      return nil if planned_stop.blank? || initial_quantity.blank? || initial_quantity.zero?
   124	      first = ordered_legs.find { |l| l.kind_entry? && l.activity_id } or return nil
   125	      factor = split_factor_after(first)
   126	      risk = initial_quantity * ((first.price || 0) - planned_stop * factor)
   127	      risk.positive? ? risk : nil
   128	    end
   129	
   130	    def compute_total_risk
   131	      return nil if planned_stop.blank?
   132	      ordered_legs.select { |l| l.kind_entry? && l.price }.sum { |l| [ l.quantity * (l.price - planned_stop * split_factor_after(l)), 0 ].max }
   133	    end
   134	end

