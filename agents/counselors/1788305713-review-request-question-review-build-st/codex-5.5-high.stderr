     1	module Sync
     2	  # Positions and balances for one account. Rows absent from the broker are deleted only when every
     3	  # position resolved and the payload is sane. Zero-quantity positions are treated as absent.
     4	  class PositionsJob < FeedJob
     5	    limits_concurrency to: 1, key: ->(account) { "positions-#{account.id}" }, on_conflict: :discard
     6	
     7	    def perform(account)
     8	      SyncRun.record(:positions, account: account) do |run|
     9	        summary = Schwab::AccountSummary.from(client.account(account.schwab_hash))
    10	        raise Schwab::MappingError, "no positions but positive long market value" if summary.positions.empty? && summary.balances.long_market_value&.positive?
    11	
    12	        now = Time.current
    13	        held = summary.positions.reject { |p| p.quantity.zero? }
    14	        kept = held.filter_map do |position|
    15	          instrument = Instrument.resolve(position.instrument)
    16	          unless instrument
    17	            run.quarantine(:positions_unresolved, position.instrument.to_h)
    18	            next
    19	          end
    20	          account.positions.find_or_initialize_by(instrument: instrument).tap do |row|
    21	            row.update!(quantity: position.quantity, average_price: position.average_price, cost_basis: position.cost_basis,
    22	                        market_value: position.market_value, last_price: last_price_for(position), synced_at: now, raw: position.raw)
    23	          end
    24	        rescue Schwab::MappingError => e
    25	          run.quarantine(:positions_unmapped, e.message)
    26	          nil
    27	        end
    28	        complete = kept.size == held.size
    29	        account.positions.where.not(id: kept.map(&:id)).destroy_all if complete
    30	        account.balances.create!(as_of: now, equity: summary.balances.equity, cash_available_for_trading: summary.balances.cash_available_for_trading,
    31	                                 unsettled_cash: summary.balances.unsettled_cash, settled_cash: summary.balances.settled_cash,
    32	                                 buying_power: summary.balances.buying_power, raw: summary.balances.raw)
    33	        account.update!(last_synced_at: now, raw: summary.raw_without_positions)
    34	        run.touched(kept.size)
    35	        if complete && account.trading_enabled?
    36	          Journal::BootstrapJob.perform_later(account)
    37	          Snapshots::RebuildJob.perform_later(account, from: now.in_time_zone(MarketDay::ZONE).to_date) if account.snapshots.exists?(as_of: now.in_time_zone(MarketDay::ZONE).to_date)
    38	        end
    39	        complete ? :succeeded : :partial
    40	      end
    41	    end
    42	
    43	    private
    44	      def last_price_for(position)
    45	        return nil if position.quantity.zero? || position.market_value.nil?
    46	        position.market_value / position.quantity
    47	      end
    48	  end
    49	end

